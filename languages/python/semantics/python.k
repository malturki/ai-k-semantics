  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), {}, Else:Block) =>
           forStarUnpackElseItems(Prefix, Star, Suffix, Rest, {}, Else)
