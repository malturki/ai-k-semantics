    requires notBool isIteratorRef(InnerIter)
  rule <k> setCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Elem:Exp, RestOuter:ArgVals, #noArgVals, Acc:ArgVals, Rho:Map) =>
           setCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, Acc, Rho)
       ... </k>
  rule <k> setCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, #noFilters, Elem:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:ArgVals, Rho:Map) =>
           Elem ~> setCompForIfsNext(X, OuterFilters, Inner, Y, #noFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> setCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:CompFilters, Elem:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:ArgVals, Rho:Map) =>
           setCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, InnerFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> setCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           Filter ~> setCompForIfsInnerFilterNext(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> setCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filter(Filter:Exp), Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           Filter ~> setCompForIfsInnerFilterLast(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> V:Val ~> setCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, RestFilters:CompFilters, Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           setCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> setCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, _:CompFilters, Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           setCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> setCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           Elem ~> setCompForIfsNext(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> setCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           setCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> setCompForIfsNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Elem:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:ArgVals, Rho:Map) =>
           setCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Elem, RestOuter, RestInner, appendArgVal(Acc, V), Rho)
       ... </k>
  rule <k> setCompManyExp(iteratorRef(I:Int), T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Elem:Exp) =>
           #listCtor(iteratorRef(I)) ~> setCompManyIteratorApply(T, Filters, RestClauses, Elem, #noArgVals, #noCompArgStack, Rho, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> setCompManyExp(Iter:Val, T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Elem:Exp) =>
           setCompManyIter(T, Filters, RestClauses, Elem, iterableArgVals(Iter), #noArgVals, #noCompArgStack, Rho, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> setCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, #noArgVals, #noArgVals, #noCompArgStack, _:Map, OuterRho:Map) =>
           set() ~> restoreEnv(OuterRho)
       ... </k>
  rule <k> setCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, #noArgVals, Acc:ArgVals, #noCompArgStack, _:Map, OuterRho:Map) =>
           setFromArgVals(Acc) ~> restoreEnv(OuterRho)
       ... </k>
    requires notBool emptyArgVals(Acc)
  rule <k> setCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, #noArgVals, Acc:ArgVals, compArgFrame(ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, ParentElem:Exp, ParentRestItems:ArgVals, ParentBaseRho:Map, ParentStack:CompArgStack), _:Map, OuterRho:Map) =>
           setCompManyIter(ParentT, ParentFilters, ParentRest, ParentElem, ParentRestItems, Acc, ParentStack, ParentBaseRho, OuterRho)
       ... </k>
  rule <k> setCompManyIter(T:Target, #noFilters, RestClauses:MaybeCompClauses, Elem:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyAfter(T, #noFilters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> setCompManyIter(T:Target, Filters:CompFilters, RestClauses:MaybeCompClauses, Elem:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyFilter(T, Filters, Filters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> setCompManyFilter(T:Target, Filters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> setCompManyFilterNext(T, Filters, RestFilters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> setCompManyFilter(T:Target, Filters:MaybeCompFilters, #filter(Filter:Exp), RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> setCompManyFilterLast(T, Filters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> V:Val ~> setCompManyFilterNext(T:Target, Filters:MaybeCompFilters, RestFilters:CompFilters, RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyFilter(T, Filters, RestFilters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> setCompManyFilterNext(T:Target, Filters:MaybeCompFilters, _:CompFilters, RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyIter(T, Filters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> setCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyAfter(T, Filters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> setCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyIter(T, Filters, RestClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> setCompManyAfter(T:Target, Filters:MaybeCompFilters, #noCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           Elem ~> setCompManyNext(T, Filters, #noCompClauses, Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> setCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClause(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters)), Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> setCompManyDescend(NextT, NextFilters, #noCompClauses, T, Filters, #compRest(#compClause(NextIter, NextT, NextFilters)), Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> setCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClauses(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters, More:CompClauses)), Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> setCompManyDescend(NextT, NextFilters, #compRest(More), T, Filters, #compRest(#compClauses(NextIter, NextT, NextFilters, More)), Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> setCompManyDescend(NextT:Target, NextFilters:MaybeCompFilters, NextRest:MaybeCompClauses, ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, Elem:Exp, ParentRestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, ParentBaseRho:Map, OuterRho:Map) =>
           #listCtor(iteratorRef(I)) ~> setCompManyIteratorApply(NextT, NextFilters, NextRest, Elem, Acc, compArgFrame(ParentT, ParentFilters, ParentRest, Elem, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
       ... </k>
       <env> CurrentBaseRho </env>
  rule <k> NextIter:Val ~> setCompManyDescend(NextT:Target, NextFilters:MaybeCompFilters, NextRest:MaybeCompClauses, ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, Elem:Exp, ParentRestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, ParentBaseRho:Map, OuterRho:Map) =>
           setCompManyIter(NextT, NextFilters, NextRest, Elem, iterableArgVals(NextIter), Acc, compArgFrame(ParentT, ParentFilters, ParentRest, Elem, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
       ... </k>
       <env> CurrentBaseRho </env>
    requires notBool isIteratorRef(NextIter)
  rule <k> V:Val ~> setCompManyNext(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Elem:Exp, RestItems:ArgVals, Acc:ArgVals, Stack:CompArgStack, BaseRho:Map, OuterRho:Map) =>
           setCompManyIter(T, Filters, RestClauses, Elem, RestItems, appendArgVal(Acc, V), Stack, BaseRho, OuterRho)
       ... </k>

  rule <k> tupleDisplayExp(Args:ArgExps) => evalArgs(Args, #noArgVals) ~> buildTuple ... </k>
  rule <k> argsVal(#noArgVals) ~> buildTuple => () ... </k>
  rule <k> argsVal(VS:ArgVals) ~> buildTuple => tupleVal(argValsToValItems(VS)) ... </k>
    requires notBool emptyArgVals(VS)

  rule <k> setDisplayExp(Args:ArgExps) => evalArgs(Args, #noArgVals) ~> buildSet ... </k>
  rule <k> argsVal(#noArgVals) ~> buildSet => set() ... </k>
  rule <k> argsVal(VS:ArgVals) ~> buildSet => setVal(argValsToSetItems(VS)) ... </k>
    requires notBool emptyArgVals(VS)

  rule <k> dictDisplayExp(Items:DictExps) => evalDict(Items, #noDictVals) ~> buildDict ... </k>
  rule <k> evalDict(#noDictItems, DVS:DictVals) => dictArgsVal(DVS) ... </k>
  rule <k> evalDict(dictExpItem(K:Exp, V:Exp), DVS:DictVals) =>
           K ~> evalDictValue(V, #noDictItems, DVS)
       ... </k>
  rule <k> evalDict(dictExpsCons(K:Exp, V:Exp, Rest:DictExps), DVS:DictVals) =>
           K ~> evalDictValue(V, Rest, DVS)
       ... </k>
  rule <k> evalDict(dictStarExpItem(E:Exp), DVS:DictVals) =>
           E ~> evalDictStarNext(#noDictItems, DVS)
       ... </k>
  rule <k> evalDict(dictStarExpsCons(E:Exp, Rest:DictExps), DVS:DictVals) =>
           E ~> evalDictStarNext(Rest, DVS)
       ... </k>
  rule <k> K:Val ~> evalDictValue(V:Exp, Rest:DictExps, DVS:DictVals) =>
           V ~> evalDictNext(Rest, DVS, K)
       ... </k>
  rule <k> V:Val ~> evalDictNext(Rest:DictExps, DVS:DictVals, K:Val) =>
           evalDict(Rest, appendDictVal(DVS, K, V))
       ... </k>
  rule <k> V:Val ~> evalDictStarNext(Rest:DictExps, DVS:DictVals) =>
           evalDict(Rest, appendDictUnpack(DVS, V))
       ... </k>
  rule <k> dictArgsVal(#noDictVals) ~> buildDict => ({}):Val ... </k>
  rule <k> dictArgsVal(DVS:DictVals) ~> buildDict => dictVal(dictValsToDictItems(DVS)) ... </k>
    requires notBool emptyDictVals(DVS)
  rule <k> dictCompExp(iteratorRef(I:Int), X:Id, Key:Exp, Value:Exp) =>
           #listCtor(iteratorRef(I)) ~> dictCompIteratorApply(X, Key, Value, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompExp(Iter:Val, X:Id, Key:Exp, Value:Exp) =>
           dictCompIter(X, Key, Value, iterableArgVals(Iter), #noDictVals, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> dictCompIter(_:Id, _:Exp, _:Exp, #noArgVals, #noDictVals, Rho:Map) =>
           ({}):Val ~> restoreEnv(Rho)
       ... </k>
  rule <k> dictCompIter(_:Id, _:Exp, _:Exp, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(Rho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompIter(X:Id, Key:Exp, Value:Exp, argValsCons(V:Val, Rest:ArgVals), Acc:DictVals, Rho:Map) =>
           Key ~> dictCompKey(X, Key, Value, Rest, Acc, Rho)
       ... </k>
       <env> _ => Rho [ X <- V ] </env>
  rule <k> K:Val ~> dictCompKey(X:Id, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompValue(X, Key, Value, Rest, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompValue(X:Id, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompIter(X, Key, Value, Rest, appendDictVal(Acc, K, V), Rho)
       ... </k>
  rule <k> dictCompTargetExp(iteratorRef(I:Int), T:Target, Key:Exp, Value:Exp) =>
           #listCtor(iteratorRef(I)) ~> dictCompTargetIteratorApply(T, Key, Value, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompTargetExp(Iter:Val, T:Target, Key:Exp, Value:Exp) =>
           dictCompTargetIter(T, Key, Value, iterableArgVals(Iter), #noDictVals, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> dictCompTargetIter(_:Target, _:Exp, _:Exp, #noArgVals, #noDictVals, Rho:Map) =>
           ({}):Val ~> restoreEnv(Rho)
       ... </k>
  rule <k> dictCompTargetIter(_:Target, _:Exp, _:Exp, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(Rho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompTargetIter(T:Target, Key:Exp, Value:Exp, argValsCons(V:Val, Rest:ArgVals), Acc:DictVals, Rho:Map) =>
           Key ~> dictCompTargetKey(T, Key, Value, Rest, Acc, Rho)
       ... </k>
       <env> _ => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> K:Val ~> dictCompTargetKey(T:Target, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompTargetValue(T, Key, Value, Rest, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompTargetValue(T:Target, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompTargetIter(T, Key, Value, Rest, appendDictVal(Acc, K, V), Rho)
       ... </k>
  rule <k> dictCompTargetIfsExp(iteratorRef(I:Int), T:Target, Filters:CompFilters, Key:Exp, Value:Exp) =>
           #listCtor(iteratorRef(I)) ~> dictCompTargetIfsIteratorApply(T, Filters, Key, Value, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompTargetIfsExp(Iter:Val, T:Target, Filters:CompFilters, Key:Exp, Value:Exp) =>
           dictCompTargetIfsIter(T, Filters, Key, Value, iterableArgVals(Iter), #noDictVals, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> dictCompTargetIfsIter(_:Target, _:CompFilters, _:Exp, _:Exp, #noArgVals, #noDictVals, Rho:Map) =>
           ({}):Val ~> restoreEnv(Rho)
       ... </k>
  rule <k> dictCompTargetIfsIter(_:Target, _:CompFilters, _:Exp, _:Exp, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(Rho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompTargetIfsIter(T:Target, Filters:CompFilters, Key:Exp, Value:Exp, argValsCons(V:Val, Rest:ArgVals), Acc:DictVals, Rho:Map) =>
           dictCompTargetIfsFilter(T, Filters, Filters, Key, Value, Rest, Acc, Rho)
       ... </k>
       <env> _ => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> dictCompTargetIfsFilter(T:Target, Filters:CompFilters, #filters(Filter:Exp, RestFilters:CompFilters), Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompTargetIfsFilterNext(T, Filters, RestFilters, Key, Value, Rest, Acc, Rho)
       ... </k>
  rule <k> dictCompTargetIfsFilter(T:Target, Filters:CompFilters, #filter(Filter:Exp), Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompTargetIfsFilterLast(T, Filters, Key, Value, Rest, Acc, Rho)
       ... </k>
  rule <k> V:Val ~> dictCompTargetIfsFilterNext(T:Target, Filters:CompFilters, RestFilters:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompTargetIfsFilter(T, Filters, RestFilters, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompTargetIfsFilterNext(T:Target, Filters:CompFilters, _:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompTargetIfsIter(T, Filters, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompTargetIfsFilterLast(T:Target, Filters:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Key ~> dictCompTargetIfsKey(T, Filters, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompTargetIfsFilterLast(T:Target, Filters:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompTargetIfsIter(T, Filters, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> K:Val ~> dictCompTargetIfsKey(T:Target, Filters:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompTargetIfsValue(T, Filters, Key, Value, Rest, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompTargetIfsValue(T:Target, Filters:CompFilters, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompTargetIfsIter(T, Filters, Key, Value, Rest, appendDictVal(Acc, K, V), Rho)
       ... </k>
  rule <k> dictCompIfExp(iteratorRef(I:Int), X:Id, Filter:Exp, Key:Exp, Value:Exp) =>
           #listCtor(iteratorRef(I)) ~> dictCompIfIteratorApply(X, Filter, Key, Value, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompIfExp(Iter:Val, X:Id, Filter:Exp, Key:Exp, Value:Exp) =>
           dictCompIfIter(X, Filter, Key, Value, iterableArgVals(Iter), #noDictVals, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> dictCompIfIter(_:Id, _:Exp, _:Exp, _:Exp, #noArgVals, #noDictVals, Rho:Map) =>
           ({}):Val ~> restoreEnv(Rho)
       ... </k>
  rule <k> dictCompIfIter(_:Id, _:Exp, _:Exp, _:Exp, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(Rho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompIfIter(X:Id, Filter:Exp, Key:Exp, Value:Exp, argValsCons(V:Val, Rest:ArgVals), Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompIfFilter(X, Filter, Key, Value, Rest, Acc, Rho)
       ... </k>
       <env> _ => Rho [ X <- V ] </env>
  rule <k> V:Val ~> dictCompIfFilter(X:Id, Filter:Exp, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Key ~> dictCompIfKey(X, Filter, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompIfFilter(X:Id, Filter:Exp, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompIfIter(X, Filter, Key, Value, Rest, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> K:Val ~> dictCompIfKey(X:Id, Filter:Exp, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompIfValue(X, Filter, Key, Value, Rest, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompIfValue(X:Id, Filter:Exp, Key:Exp, Value:Exp, Rest:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompIfIter(X, Filter, Key, Value, Rest, appendDictVal(Acc, K, V), Rho)
       ... </k>
