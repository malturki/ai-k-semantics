  rule <k> forTargetUnpackElseStmt(TS:Targets, E:Exp, Body:Block, Else:Block) =>
           E ~> forTargetUnpackElseIter(TS, Body, Else)
       ... </k>
  rule <k> [] ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> () ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> S:String ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, dictKeysToValItems(DS), Body, Else)
       ... </k>
  rule <k> set() ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> frozenset() ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForTargetUnpackElseIter(TS, Body, Else)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForTargetUnpackElseIter(TS, Body, Else)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body, Else)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body, Else)
       ... </k>
