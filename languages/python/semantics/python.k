      andBool isSpecialFloatVal(F)
  rule <k> Spec:String ~> formatApply(F:Float)
        => exceptionSignal(#exception(#token("NotImplementedError", "Id"))) ... </k>
    requires formatFloatSpecialSpecSupported(Spec)
