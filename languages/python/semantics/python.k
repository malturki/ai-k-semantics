  rule digitValue(_:String) => -1 [owise]

  rule intStringValue(S:String, B:Int) => intStringAccum(S, B, 1, 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "+"
  rule intStringValue(S:String, B:Int) => 0 -Int intStringAccum(S, B, 1, 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "-"
  rule intStringValue(S:String, B:Int) => intStringAccum(S, B, 0, 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) =/=String "+"
      andBool substrString(S, 0, 1) =/=String "-"

  rule intStringAccum(S:String, _:Int, I:Int, Acc:Int) => Acc
    requires I >=Int lengthString(S)
  rule intStringAccum(S:String, B:Int, I:Int, Acc:Int) =>
    intStringAccum(S, B, I +Int 1, Acc)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "_"
  rule intStringAccum(S:String, B:Int, I:Int, Acc:Int) =>
    intStringAccum(S, B, I +Int 1, (Acc *Int B) +Int digitValue(substrString(S, I, I +Int 1)))
    requires I <Int lengthString(S)
      andBool intDigitInBase(substrString(S, I, I +Int 1), B)

  rule intSignStart(S:String) => 1
    requires lengthString(S) >Int 0
      andBool (substrString(S, 0, 1) ==String "+"
        orBool substrString(S, 0, 1) ==String "-")
  rule intSignStart(_:String) => 0 [owise]

  rule intPrefixMatches(S:String, 2, Start:Int) => true
    requires Start +Int 2 <=Int lengthString(S)
      andBool substrString(S, Start, Start +Int 1) ==String "0"
      andBool (substrString(S, Start +Int 1, Start +Int 2) ==String "b"
        orBool substrString(S, Start +Int 1, Start +Int 2) ==String "B")
  rule intPrefixMatches(S:String, 8, Start:Int) => true
    requires Start +Int 2 <=Int lengthString(S)
      andBool substrString(S, Start, Start +Int 1) ==String "0"
      andBool (substrString(S, Start +Int 1, Start +Int 2) ==String "o"
        orBool substrString(S, Start +Int 1, Start +Int 2) ==String "O")
  rule intPrefixMatches(S:String, 16, Start:Int) => true
    requires Start +Int 2 <=Int lengthString(S)
      andBool substrString(S, Start, Start +Int 1) ==String "0"
      andBool (substrString(S, Start +Int 1, Start +Int 2) ==String "x"
        orBool substrString(S, Start +Int 1, Start +Int 2) ==String "X")
  rule intPrefixMatches(_:String, _:Int, _:Int) => false [owise]

  rule intPrefixedBodyStart(S:String, B:Int) => intSignStart(S) +Int 3
    requires intPrefixMatches(S, B, intSignStart(S))
      andBool lengthString(S) >Int intSignStart(S) +Int 3
      andBool substrString(S, intSignStart(S) +Int 2, intSignStart(S) +Int 3) ==String "_"
  rule intPrefixedBodyStart(S:String, _:Int) => intSignStart(S) +Int 2 [owise]

  rule intPrefixedStringOk(S:String, B:Int) =>
    intStringBodyOk(S, B, intPrefixedBodyStart(S, B))
    requires (B ==Int 2 orBool B ==Int 8 orBool B ==Int 16)
      andBool intPrefixMatches(S, B, intSignStart(S))
      andBool intPrefixedBodyStart(S, B) <Int lengthString(S)
  rule intPrefixedStringOk(_:String, _:Int) => false [owise]

  rule intBase0StringOk(S:String) => true
    requires intPrefixedStringOk(S, 2)
  rule intBase0StringOk(S:String) => true
    requires intPrefixedStringOk(S, 8)
  rule intBase0StringOk(S:String) => true
    requires intPrefixedStringOk(S, 16)
  rule intBase0StringOk(S:String) => true
    requires intBase0DecimalOk(S)
  rule intBase0StringOk(_:String) => false [owise]

  rule intBase0DecimalOk(S:String) =>
    intStringOk(S, 10)
    andBool (substrString(S, intSignStart(S), intSignStart(S) +Int 1) =/=String "0"
      orBool intZeroDecimalBodyOk(S, intSignStart(S)))
    requires lengthString(S) >Int intSignStart(S)
  rule intBase0DecimalOk(_:String) => false [owise]

  rule intZeroDecimalBodyOk(S:String, I:Int) => true
    requires I >=Int lengthString(S)
  rule intZeroDecimalBodyOk(S:String, I:Int) =>
    intZeroDecimalBodyOk(S, I +Int 1)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "0"
  rule intZeroDecimalBodyOk(S:String, I:Int) =>
    intZeroDecimalBodyOk(S, I +Int 1)
    requires I >Int intSignStart(S)
      andBool I +Int 1 <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "_"
      andBool substrString(S, I -Int 1, I) ==String "0"
      andBool substrString(S, I +Int 1, I +Int 2) ==String "0"
  rule intZeroDecimalBodyOk(S:String, I:Int) => false
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) =/=String "0"
      andBool notBool (I >Int intSignStart(S)
        andBool I +Int 1 <Int lengthString(S)
        andBool substrString(S, I, I +Int 1) ==String "_"
        andBool substrString(S, I -Int 1, I) ==String "0"
        andBool substrString(S, I +Int 1, I +Int 2) ==String "0")

  rule intPrefixedStringValue(S:String, B:Int) =>
    intStringAccum(S, B, intPrefixedBodyStart(S, B), 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) =/=String "-"
  rule intPrefixedStringValue(S:String, B:Int) =>
    0 -Int intStringAccum(S, B, intPrefixedBodyStart(S, B), 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "-"

  rule intBase0StringValue(S:String) => intPrefixedStringValue(S, 2)
    requires intPrefixedStringOk(S, 2)
  rule intBase0StringValue(S:String) => intPrefixedStringValue(S, 8)
    requires intPrefixedStringOk(S, 8)
  rule intBase0StringValue(S:String) => intPrefixedStringValue(S, 16)
    requires intPrefixedStringOk(S, 16)
  rule intBase0StringValue(S:String) => intStringValue(S, 10)
    requires intBase0DecimalOk(S)

  rule floatDecimalStringOk(S:String) =>
    floatDecimalBodyOk(S, 1, false, false)
    requires lengthString(S) >Int 1
      andBool substrString(S, 0, 1) ==String "+"
  rule floatDecimalStringOk(S:String) =>
    floatDecimalBodyOk(S, 1, false, false)
    requires lengthString(S) >Int 1
      andBool substrString(S, 0, 1) ==String "-"
  rule floatDecimalStringOk(S:String) =>
    floatDecimalBodyOk(S, 0, false, false)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) =/=String "+"
      andBool substrString(S, 0, 1) =/=String "-"
  rule floatDecimalStringOk(_:String) => false [owise]

  rule floatDecimalBodyOk(S:String, I:Int, SeenDot:Bool, SeenDigit:Bool) =>
    SeenDot andBool SeenDigit
    requires I >=Int lengthString(S)
  rule floatDecimalBodyOk(S:String, I:Int, false, SeenDigit:Bool) =>
    floatDecimalBodyOk(S, I +Int 1, true, SeenDigit)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "."
  rule floatDecimalBodyOk(S:String, I:Int, true, _:Bool) => false
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "."
  rule floatDecimalBodyOk(S:String, I:Int, SeenDot:Bool, _:Bool) =>
    floatDecimalBodyOk(S, I +Int 1, SeenDot, true)
    requires I <Int lengthString(S)
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9
  rule floatDecimalBodyOk(S:String, I:Int, SeenDot:Bool, SeenDigit:Bool) =>
    floatDecimalBodyOk(S, I +Int 1, SeenDot, SeenDigit)
    requires I <Int lengthString(S)
      andBool intUnderscoreInBase(S, 10, I)
  rule floatDecimalBodyOk(S:String, I:Int, _:Bool, _:Bool) => false
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) =/=String "."
      andBool (digitValue(substrString(S, I, I +Int 1)) <Int 0
        orBool digitValue(substrString(S, I, I +Int 1)) >Int 9)
      andBool notBool intUnderscoreInBase(S, 10, I)

  rule floatDecimalStringValue(S:String) => floatDecimalMagnitude(S, 1)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "+"
  rule floatDecimalStringValue(S:String) => 0.0 -Float floatDecimalMagnitude(S, 1)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "-"
  rule floatDecimalStringValue(S:String) => floatDecimalMagnitude(S, 0)
    requires lengthString(S) >Int 0
      andBool substrString(S, 0, 1) =/=String "+"
      andBool substrString(S, 0, 1) =/=String "-"

  rule floatDecimalMagnitude(S:String, Start:Int) =>
    Int2Float(floatDecimalDigitsValue(S, Start, 0), 53, 11)
    /Float Int2Float(floatDecimalPow10(floatDecimalFractionDigits(S, Start, 0, false)), 53, 11)

  rule floatDecimalDigitsValue(S:String, I:Int, Acc:Int) => Acc
    requires I >=Int lengthString(S)
  rule floatDecimalDigitsValue(S:String, I:Int, Acc:Int) =>
    floatDecimalDigitsValue(S, I +Int 1, Acc)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "."
  rule floatDecimalDigitsValue(S:String, I:Int, Acc:Int) =>
    floatDecimalDigitsValue(S, I +Int 1, Acc)
    requires I <Int lengthString(S)
      andBool intUnderscoreInBase(S, 10, I)
  rule floatDecimalDigitsValue(S:String, I:Int, Acc:Int) =>
    floatDecimalDigitsValue(S, I +Int 1, (Acc *Int 10) +Int digitValue(substrString(S, I, I +Int 1)))
    requires I <Int lengthString(S)
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9

  rule floatDecimalFractionDigits(S:String, I:Int, Count:Int, _:Bool) => Count
    requires I >=Int lengthString(S)
  rule floatDecimalFractionDigits(S:String, I:Int, Count:Int, false) =>
    floatDecimalFractionDigits(S, I +Int 1, Count, true)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) ==String "."
  rule floatDecimalFractionDigits(S:String, I:Int, Count:Int, SeenDot:Bool) =>
    floatDecimalFractionDigits(S, I +Int 1, Count, SeenDot)
    requires I <Int lengthString(S)
      andBool intUnderscoreInBase(S, 10, I)
  rule floatDecimalFractionDigits(S:String, I:Int, Count:Int, false) =>
    floatDecimalFractionDigits(S, I +Int 1, Count, false)
    requires I <Int lengthString(S)
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9
  rule floatDecimalFractionDigits(S:String, I:Int, Count:Int, true) =>
    floatDecimalFractionDigits(S, I +Int 1, Count +Int 1, true)
    requires I <Int lengthString(S)
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9

  rule floatDecimalPow10(0) => 1
  rule floatDecimalPow10(N:Int) => 10 *Int floatDecimalPow10(N -Int 1)
    requires N >Int 0

  rule floatMantissaStringOk(S:String) => true
    requires intStringOk(S, 10)
  rule floatMantissaStringOk(S:String) => true
    requires floatDecimalStringOk(S)
  rule floatMantissaStringOk(_:String) => false [owise]

  rule floatMantissaStringValue(S:String) => Int2Float(intStringValue(S, 10), 53, 11)
    requires intStringOk(S, 10)
  rule floatMantissaStringValue(S:String) => floatDecimalStringValue(S)
    requires floatDecimalStringOk(S)

  rule floatExponentPartOk(S:String) =>
    intStringValue(S, 10) >=Int -9 andBool intStringValue(S, 10) <=Int 9
    requires intStringOk(S, 10)
  rule floatExponentPartOk(_:String) => false [owise]

  rule floatExponentStringOk(S:String) =>
    floatMantissaStringOk(substrString(S, 0, floatExponentIndex(S)))
    andBool floatExponentPartOk(substrString(S, floatExponentIndex(S) +Int 1, lengthString(S)))
    requires floatExponentIndex(S) >Int 0
      andBool floatExponentIndex(S) <Int lengthString(S) -Int 1
  rule floatExponentStringOk(_:String) => false [owise]

  rule floatExponentIndex(S:String) => floatExponentIndexFrom(S, 0)

  rule floatExponentIndexFrom(S:String, I:Int) => -1
    requires I >=Int lengthString(S)
  rule floatExponentIndexFrom(S:String, I:Int) => I
    requires I <Int lengthString(S)
      andBool (substrString(S, I, I +Int 1) ==String "e"
        orBool substrString(S, I, I +Int 1) ==String "E")
  rule floatExponentIndexFrom(S:String, I:Int) => floatExponentIndexFrom(S, I +Int 1)
    requires I <Int lengthString(S)
      andBool substrString(S, I, I +Int 1) =/=String "e"
      andBool substrString(S, I, I +Int 1) =/=String "E"

  rule floatExponentStringValue(S:String) =>
    floatScale10(
      floatMantissaStringValue(substrString(S, 0, floatExponentIndex(S))),
      intStringValue(substrString(S, floatExponentIndex(S) +Int 1, lengthString(S)), 10))

  rule asciiCaselessEq("I", "i") => true
  rule asciiCaselessEq("N", "n") => true
  rule asciiCaselessEq("F", "f") => true
  rule asciiCaselessEq("T", "t") => true
  rule asciiCaselessEq("Y", "y") => true
  rule asciiCaselessEq("A", "a") => true
  rule asciiCaselessEq(C:String, T:String) => C ==String T [owise]

  rule stringCaselessEq(S:String, T:String) =>
    lengthString(S) ==Int lengthString(T) andBool stringCaselessEqFrom(S, T, 0)

  rule stringCaselessEqFrom(S:String, T:String, I:Int) => true
    requires I >=Int lengthString(S)
      andBool I >=Int lengthString(T)
  rule stringCaselessEqFrom(S:String, T:String, I:Int) =>
    asciiCaselessEq(substrString(S, I, I +Int 1), substrString(T, I, I +Int 1))
    andBool stringCaselessEqFrom(S, T, I +Int 1)
    requires I <Int lengthString(S)
      andBool I <Int lengthString(T)
  rule stringCaselessEqFrom(_:String, _:String, _:Int) => false [owise]

  rule floatSpecialInfStringOk(S:String) =>
    stringCaselessEq(substrString(S, intSignStart(S), lengthString(S)), "inf")
    orBool stringCaselessEq(substrString(S, intSignStart(S), lengthString(S)), "infinity")
    requires lengthString(S) >Int intSignStart(S)
  rule floatSpecialInfStringOk(_:String) => false [owise]

  rule floatSpecialStringOk(S:String) =>
    floatSpecialInfStringOk(S)
    orBool stringCaselessEq(substrString(S, intSignStart(S), lengthString(S)), "nan")
    requires lengthString(S) >Int intSignStart(S)
  rule floatSpecialStringOk(_:String) => false [owise]

  rule floatSpecialStringValue(S:String) => 0.0 -Float Infinity
    requires floatSpecialInfStringOk(S)
      andBool lengthString(S) >Int 0
      andBool substrString(S, 0, 1) ==String "-"
  rule floatSpecialStringValue(S:String) => Infinity
    requires floatSpecialInfStringOk(S)
      andBool notBool (lengthString(S) >Int 0
        andBool substrString(S, 0, 1) ==String "-")
  rule floatSpecialStringValue(S:String) => NaN
    requires floatSpecialStringOk(S)
      andBool notBool floatSpecialInfStringOk(S)

  rule floatStringOk(S:String) =>
    intStringOk(S, 10)
    orBool floatDecimalStringOk(S)
    orBool floatExponentStringOk(S)
    orBool floatSpecialStringOk(S)

  rule floatStringValue(S:String) => Int2Float(intStringValue(S, 10), 53, 11)
    requires intStringOk(S, 10)
  rule floatStringValue(S:String) => floatDecimalStringValue(S)
    requires floatDecimalStringOk(S)
  rule floatStringValue(S:String) => floatExponentStringValue(S)
    requires floatExponentStringOk(S)
  rule floatStringValue(S:String) => floatSpecialStringValue(S)
    requires floatSpecialStringOk(S)

  rule complexImagStringOk(S:String) =>
    substrString(S, 0, lengthString(S) -Int 1) ==String ""
    orBool substrString(S, 0, lengthString(S) -Int 1) ==String "+"
    orBool substrString(S, 0, lengthString(S) -Int 1) ==String "-"
    orBool floatStringOk(substrString(S, 0, lengthString(S) -Int 1))
    requires lengthString(S) >Int 0
      andBool (substrString(S, lengthString(S) -Int 1, lengthString(S)) ==String "j"
        orBool substrString(S, lengthString(S) -Int 1, lengthString(S)) ==String "J")
  rule complexImagStringOk(_:String) => false [owise]

  rule complexImagStringValue(S:String) => 1.0
    requires substrString(S, 0, lengthString(S) -Int 1) ==String ""
  rule complexImagStringValue(S:String) => 1.0
    requires substrString(S, 0, lengthString(S) -Int 1) ==String "+"
  rule complexImagStringValue(S:String) => 0.0 -Float 1.0
    requires substrString(S, 0, lengthString(S) -Int 1) ==String "-"
  rule complexImagStringValue(S:String) => floatStringValue(substrString(S, 0, lengthString(S) -Int 1))
    requires complexImagStringOk(S)
      andBool substrString(S, 0, lengthString(S) -Int 1) =/=String ""
      andBool substrString(S, 0, lengthString(S) -Int 1) =/=String "+"
      andBool substrString(S, 0, lengthString(S) -Int 1) =/=String "-"

  rule complexSplitIndex(S:String) => complexSplitIndexFrom(S, 1)

  rule complexSplitIndexFrom(S:String, I:Int) => -1
    requires I >=Int lengthString(S) -Int 1
  rule complexSplitIndexFrom(S:String, I:Int) => I
    requires I <Int lengthString(S) -Int 1
      andBool (substrString(S, I, I +Int 1) ==String "+"
        orBool substrString(S, I, I +Int 1) ==String "-")
      andBool substrString(S, I -Int 1, I) =/=String "e"
      andBool substrString(S, I -Int 1, I) =/=String "E"
  rule complexSplitIndexFrom(S:String, I:Int) => complexSplitIndexFrom(S, I +Int 1)
    requires I <Int lengthString(S) -Int 1
      andBool notBool ((substrString(S, I, I +Int 1) ==String "+"
        orBool substrString(S, I, I +Int 1) ==String "-")
        andBool substrString(S, I -Int 1, I) =/=String "e"
        andBool substrString(S, I -Int 1, I) =/=String "E")

  rule complexPairStringOk(S:String) =>
    floatStringOk(substrString(S, 0, complexSplitIndex(S)))
    andBool complexImagStringOk(substrString(S, complexSplitIndex(S), lengthString(S)))
    requires complexSplitIndex(S) >Int 0
  rule complexPairStringOk(_:String) => false [owise]

  rule complexParenStringOk(S:String) =>
    complexStringOk(stripPythonStringSpace(substrString(S, 1, lengthString(S) -Int 1)))
    requires lengthString(S) >=Int 2
      andBool substrString(S, 0, 1) ==String "("
      andBool substrString(S, lengthString(S) -Int 1, lengthString(S)) ==String ")"
  rule complexParenStringOk(_:String) => false [owise]

  rule complexStringOk(S:String) =>
    floatStringOk(S)
    orBool complexImagStringOk(S)
    orBool complexPairStringOk(S)
    orBool complexParenStringOk(S)

  rule floatScale10(F:Float, 0) => F
  rule floatScale10(F:Float, N:Int) => floatScale10(F *Float 10.0, N -Int 1)
    requires N >Int 0
  rule floatScale10(F:Float, N:Int) => floatScale10(F /Float 10.0, N +Int 1)
    requires N <Int 0

  rule asciiSpace(" ") => true
  rule asciiSpace("\t") => true
  rule asciiSpace("\n") => true
  rule asciiSpace("\r") => true
  rule asciiSpace("\f") => true
  rule asciiSpace("\u000b") => true
  rule asciiSpace(_:String) => false [owise]

  rule pythonStringSpace(C:String) => true
    requires asciiSpace(C)
  rule pythonStringSpace("\u001c") => true
  rule pythonStringSpace("\u001d") => true
  rule pythonStringSpace("\u001e") => true
  rule pythonStringSpace("\u001f") => true
  rule pythonStringSpace("\u0085") => true
  rule pythonStringSpace("\u00a0") => true
  rule pythonStringSpace("\u1680") => true
  rule pythonStringSpace("\u2000") => true
  rule pythonStringSpace("\u2001") => true
  rule pythonStringSpace("\u2002") => true
  rule pythonStringSpace("\u2003") => true
  rule pythonStringSpace("\u2004") => true
  rule pythonStringSpace("\u2005") => true
  rule pythonStringSpace("\u2006") => true
  rule pythonStringSpace("\u2007") => true
  rule pythonStringSpace("\u2008") => true
  rule pythonStringSpace("\u2009") => true
  rule pythonStringSpace("\u200a") => true
  rule pythonStringSpace("\u2028") => true
  rule pythonStringSpace("\u2029") => true
  rule pythonStringSpace("\u202f") => true
  rule pythonStringSpace("\u205f") => true
  rule pythonStringSpace("\u3000") => true
  rule pythonStringSpace(_:String) => false [owise]

  rule utf8ByteString(A:Int, B:Int) => chrChar(A) +String chrChar(B)
  rule utf8ByteString(A:Int, B:Int, C:Int) => chrChar(A) +String chrChar(B) +String chrChar(C)

  rule pythonStringSpacePrefixLen(S:String) => 1
    requires lengthString(S) >=Int 1
      andBool asciiSpace(substrString(S, 0, 1))
  rule pythonStringSpacePrefixLen(S:String) => 2
    requires lengthString(S) >=Int 2
      andBool (substrString(S, 0, 2) ==String utf8ByteString(194, 133)
        orBool substrString(S, 0, 2) ==String utf8ByteString(194, 160))
  rule pythonStringSpacePrefixLen(S:String) => 3
    requires lengthString(S) >=Int 3
      andBool (substrString(S, 0, 3) ==String utf8ByteString(225, 154, 128)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 128)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 129)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 130)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 131)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 132)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 133)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 134)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 135)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 136)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 137)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 138)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 168)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 169)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 128, 175)
        orBool substrString(S, 0, 3) ==String utf8ByteString(226, 129, 159)
        orBool substrString(S, 0, 3) ==String utf8ByteString(227, 128, 128))
  rule pythonStringSpacePrefixLen(_:String) => 0 [owise]

  rule pythonStringSpaceSuffixLen(S:String) => 1
    requires lengthString(S) >=Int 1
      andBool asciiSpace(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule pythonStringSpaceSuffixLen(S:String) => 2
    requires lengthString(S) >=Int 2
      andBool (substrString(S, lengthString(S) -Int 2, lengthString(S)) ==String utf8ByteString(194, 133)
        orBool substrString(S, lengthString(S) -Int 2, lengthString(S)) ==String utf8ByteString(194, 160))
  rule pythonStringSpaceSuffixLen(S:String) => 3
    requires lengthString(S) >=Int 3
      andBool (substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(225, 154, 128)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 128)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 129)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 130)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 131)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 132)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 133)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 134)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 135)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 136)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 137)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 138)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 168)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 169)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 128, 175)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(226, 129, 159)
        orBool substrString(S, lengthString(S) -Int 3, lengthString(S)) ==String utf8ByteString(227, 128, 128))
  rule pythonStringSpaceSuffixLen(_:String) => 0 [owise]

  rule stripAsciiSpace(S:String) => rstripAsciiSpace(lstripAsciiSpace(S))

  rule lstripAsciiSpace(S:String) => lstripAsciiSpace(substrString(S, 1, lengthString(S)))
    requires lengthString(S) >Int 0
      andBool asciiSpace(substrString(S, 0, 1))
  rule lstripAsciiSpace(S:String) => S
    requires lengthString(S) ==Int 0
  rule lstripAsciiSpace(S:String) => S
    requires lengthString(S) >Int 0
      andBool notBool asciiSpace(substrString(S, 0, 1))

  rule rstripAsciiSpace(S:String) => rstripAsciiSpace(substrString(S, 0, lengthString(S) -Int 1))
    requires lengthString(S) >Int 0
      andBool asciiSpace(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule rstripAsciiSpace(S:String) => S
    requires lengthString(S) ==Int 0
  rule rstripAsciiSpace(S:String) => S
    requires lengthString(S) >Int 0
      andBool notBool asciiSpace(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule stripPythonStringSpace(S:String) => rstripPythonStringSpace(lstripPythonStringSpace(S))

  rule lstripPythonStringSpace(S:String) =>
    lstripPythonStringSpace(substrString(S, pythonStringSpacePrefixLen(S), lengthString(S)))
    requires pythonStringSpacePrefixLen(S) >Int 0
  rule lstripPythonStringSpace(S:String) => S
    requires pythonStringSpacePrefixLen(S) ==Int 0

  rule rstripPythonStringSpace(S:String) =>
    rstripPythonStringSpace(substrString(S, 0, lengthString(S) -Int pythonStringSpaceSuffixLen(S)))
    requires pythonStringSpaceSuffixLen(S) >Int 0
  rule rstripPythonStringSpace(S:String) => S
    requires pythonStringSpaceSuffixLen(S) ==Int 0

  rule isComplexLike(#complex(_:Float, _:Float)) => true
  rule isComplexLike(_:Float) => true
  rule isComplexLike(V:Val) => isIntLike(V) [owise]

  rule complexReal(#complex(R:Float, _:Float)) => R
  rule complexReal(F:Float) => F
  rule complexReal(V:Val) => floatValue(V)
    requires isIntLike(V)

  rule complexImag(#complex(_:Float, I:Float)) => I
  rule complexImag(_:Float) => 0.0
  rule complexImag(V:Val) => 0.0
    requires isIntLike(V)

  rule complexMulVal(#complex(R1:Float, I1:Float), #complex(R2:Float, I2:Float)) =>
    #complex((R1 *Float R2) -Float (I1 *Float I2), (R1 *Float I2) +Float (I1 *Float R2))

  rule complexInv(#complex(R:Float, I:Float)) =>
    #complex(
      R /Float ((R *Float R) +Float (I *Float I)),
      (0.0 -Float I) /Float ((R *Float R) +Float (I *Float I)))
    requires (R *Float R) +Float (I *Float I) =/=Float 0.0

  rule complexPowNonNeg(_:Float, _:Float, 0) => #complex(1.0, 0.0)
  rule complexPowNonNeg(R:Float, I:Float, N:Int) =>
    complexMulVal(#complex(R, I), complexPowNonNeg(R, I, N -Int 1))
    requires N >Int 0

  rule complexPowInt(R:Float, I:Float, N:Int) => complexPowNonNeg(R, I, N)
    requires N >=Int 0
  rule complexPowInt(R:Float, I:Float, N:Int) =>
    complexInv(complexPowNonNeg(R, I, 0 -Int N))
    requires N <Int 0 andBool (R *Float R) +Float (I *Float I) =/=Float 0.0

  rule singletonIdentity(True) => true
  rule singletonIdentity(False) => true
  rule singletonIdentity(None) => true
  rule singletonIdentity(Ellipsis) => true
  rule singletonIdentity(_:Int) => false
  rule singletonIdentity(_:Float) => false
  rule singletonIdentity(#complex(_:Float, _:Float)) => false
  rule singletonIdentity(_:String) => false
  rule singletonIdentity(#bytes()) => false
  rule singletonIdentity(bytesVal(_:ValItems)) => false
  rule singletonIdentity([]) => false
  rule singletonIdentity(listVal(_:ValItems)) => false
  rule singletonIdentity(()) => false
  rule singletonIdentity(tupleVal(_:ValItems)) => false
  rule singletonIdentity({}) => false
  rule singletonIdentity(dictVal(_:DictItems)) => false
  rule singletonIdentity(set()) => false
  rule singletonIdentity(setVal(_:ValItems)) => false
  rule singletonIdentity(#kwDefaultMissing) => false
  rule singletonIdentity(closure(_:Id, _:Exp)) => false
  rule singletonIdentity(closureArgs(_:IdItems, _:Exp)) => false
  rule singletonIdentity(closureDefaults(_:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closureVarArgs(_:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closureVarArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closureVarArgsKwOnly(_:IdItems, _:Id, _:IdItems, _:Exp)) => false
  rule singletonIdentity(closureVarArgsKwDefaults(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closureVarArgsKwOnlyKwArgs(_:IdItems, _:Id, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closureVarArgsKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closureVarKwArgs(_:IdItems, _:Id, _:Id, _:Exp)) => false
  rule singletonIdentity(closureVarKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Id, _:Exp)) => false
  rule singletonIdentity(closureKwArgs(_:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closureKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnly(_:IdItems, _:IdItems, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarKwArgs(_:IdItems, _:IdItems, _:Id, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgsKwOnly(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgsKwDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgsKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyVarArgsKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwOnly(_:IdItems, _:IdItems, _:IdItems, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwOnlyKwArgs(_:IdItems, _:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosOnlyKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closureKwOnly(_:IdItems, _:Exp)) => false
  rule singletonIdentity(closureKwDefaults(_:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closureKwOnlyKwArgs(_:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closureKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosKwOnly(_:IdItems, _:IdItems, _:Exp)) => false
  rule singletonIdentity(closurePosKwDefaults(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Exp)) => false
  rule singletonIdentity(closurePosKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule singletonIdentity(closurePosKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule singletonIdentity(functionVal(_:Id, _:Block)) => false
  rule singletonIdentity(functionValArgs(_:IdItems, _:Block)) => false
  rule singletonIdentity(functionValDefaults(_:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValVarArgs(_:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValVarArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValVarArgsKwOnly(_:IdItems, _:Id, _:IdItems, _:Block)) => false
  rule singletonIdentity(functionValVarArgsKwDefaults(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValVarArgsKwOnlyKwArgs(_:IdItems, _:Id, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValVarArgsKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValVarKwArgs(_:IdItems, _:Id, _:Id, _:Block)) => false
  rule singletonIdentity(functionValVarKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Id, _:Block)) => false
  rule singletonIdentity(functionValKwArgs(_:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnly(_:IdItems, _:IdItems, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarKwArgs(_:IdItems, _:IdItems, _:Id, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgsKwOnly(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgsKwDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgsKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyVarArgsKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwOnly(_:IdItems, _:IdItems, _:IdItems, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwOnlyKwArgs(_:IdItems, _:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosOnlyKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValKwOnly(_:IdItems, _:Block)) => false
  rule singletonIdentity(functionValKwDefaults(_:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValKwOnlyKwArgs(_:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosKwOnly(_:IdItems, _:IdItems, _:Block)) => false
  rule singletonIdentity(functionValPosKwDefaults(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Block)) => false
  rule singletonIdentity(functionValPosKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule singletonIdentity(functionValPosKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule singletonIdentity(rangeVal(_:Int, _:Int)) => false
  rule singletonIdentity(rangeVal(_:Int, _:Int, _:Int)) => false
  rule singletonIdentity(sliceVal(_:Val, _:Val, _:Val)) => false
  rule singletonIdentity(argsVal(_:ArgVals)) => false
  rule singletonIdentity(dictArgsVal(_:DictVals)) => false

  rule intValue(I:Int) => I
  rule intValue(True) => 1
  rule intValue(False) => 0

  rule floatValue(F:Float) => F
  rule floatValue(V:Val) => Int2Float(intValue(V), 53, 11)
    requires isIntLike(V)

  rule pyLen(S:String) => lengthString(S)
  rule pyLen(#bytes()) => 0
  rule pyLen(bytesVal(VS:ValItems)) => valItemsLen(VS)
  rule pyLen([]) => 0
  rule pyLen(listVal(VS:ValItems)) => valItemsLen(VS)
  rule pyLen(()) => 0
  rule pyLen(tupleVal(VS:ValItems)) => valItemsLen(VS)
  rule pyLen({}) => 0
  rule pyLen(dictVal(DS:DictItems)) => dictItemsLen(DS)
  rule pyLen(set()) => 0
  rule pyLen(setVal(VS:ValItems)) => valItemsLen(VS)
  rule pyLen(rangeVal(Start:Int, Stop:Int)) => Stop -Int Start
    requires Start <Int Stop
  rule pyLen(rangeVal(Start:Int, Stop:Int)) => 0
    requires Start >=Int Stop
  rule pyLen(rangeVal(Start:Int, Stop:Int, Step:Int)) => pyRangeLen(Start, Stop, Step)
    requires Step =/=Int 0

  rule pyRangeLen(Start:Int, Stop:Int, Step:Int) => ((Stop -Int Start -Int 1) /Int Step) +Int 1
    requires Step >Int 0 andBool Start <Int Stop
  rule pyRangeLen(Start:Int, Stop:Int, Step:Int) => ((Start -Int Stop -Int 1) /Int (0 -Int Step)) +Int 1
    requires Step <Int 0 andBool Start >Int Stop
  rule pyRangeLen(Start:Int, Stop:Int, Step:Int) => 0
    requires (Step >Int 0 andBool Start >=Int Stop)
      orBool (Step <Int 0 andBool Start <=Int Stop)

  rule rangeContains(V:Val, _Start:Int, _Stop:Int) => false
    requires notBool isIntLike(V) andBool notBool isFloatLike(V)
  rule rangeContains(F:Float, Start:Int, Stop:Int) => rangeContainsFloat(F, Start, Stop, 1, 0)
  rule rangeContains(V:Val, Start:Int, Stop:Int) =>
    intValue(V) >=Int Start andBool intValue(V) <Int Stop
    requires isIntLike(V)
  rule rangeContains(V:Val, _Start:Int, _Stop:Int, Step:Int) => false
    requires notBool isIntLike(V) andBool notBool isFloatLike(V) andBool Step =/=Int 0
  rule rangeContains(F:Float, Start:Int, Stop:Int, Step:Int) => rangeContainsFloat(F, Start, Stop, Step, 0)
    requires Step =/=Int 0
  rule rangeContains(V:Val, Start:Int, Stop:Int, Step:Int) =>
    intValue(V) >=Int Start
      andBool intValue(V) <Int Stop
      andBool ((intValue(V) -Int Start) %Int Step ==Int 0)
    requires isIntLike(V) andBool Step >Int 0
  rule rangeContains(V:Val, Start:Int, Stop:Int, Step:Int) =>
    intValue(V) <=Int Start
      andBool intValue(V) >Int Stop
      andBool ((Start -Int intValue(V)) %Int (0 -Int Step) ==Int 0)
    requires isIntLike(V) andBool Step <Int 0

  rule rangeContainsFloat(_F:Float, Start:Int, Stop:Int, Step:Int, I:Int) => false
    requires Step =/=Int 0 andBool I >=Int pyRangeLen(Start, Stop, Step)
  rule rangeContainsFloat(F:Float, Start:Int, Stop:Int, Step:Int, I:Int) => true
    requires Step =/=Int 0
      andBool I <Int pyRangeLen(Start, Stop, Step)
      andBool F ==Float Int2Float(rangeGet(Start, Stop, Step, I), 53, 11)
  rule rangeContainsFloat(F:Float, Start:Int, Stop:Int, Step:Int, I:Int) =>
    rangeContainsFloat(F, Start, Stop, Step, I +Int 1)
    requires Step =/=Int 0
      andBool I <Int pyRangeLen(Start, Stop, Step)
      andBool F =/=Float Int2Float(rangeGet(Start, Stop, Step, I), 53, 11)

  rule rangeEq(Start1:Int, Stop1:Int, Step1:Int, Start2:Int, Stop2:Int, Step2:Int) =>
    pyRangeLen(Start1, Stop1, Step1) ==Int pyRangeLen(Start2, Stop2, Step2)
      andBool (pyRangeLen(Start1, Stop1, Step1) ==Int 0
        orBool (Start1 ==Int Start2
          andBool (pyRangeLen(Start1, Stop1, Step1) ==Int 1 orBool Step1 ==Int Step2)))
    requires Step1 =/=Int 0 andBool Step2 =/=Int 0

  rule rangeGet(Start:Int, _Stop:Int, Step:Int, Index:Int) => Start +Int (Step *Int Index)
    requires Step =/=Int 0
  rule rangeSlice(Start:Int, Stop:Int, Step:Int, Lower:Int, Upper:Int) =>
    rangeVal(rangeGet(Start, Stop, Step, Lower), rangeGet(Start, Stop, Step, Upper), Step)
    requires Step =/=Int 0
  rule rangeSliceStep(Start:Int, Stop:Int, Step:Int, Lower:Int, Upper:Int, SliceStep:Int) =>
    rangeVal(rangeGet(Start, Stop, Step, Lower), rangeGet(Start, Stop, Step, Upper), Step *Int SliceStep)
    requires Step =/=Int 0 andBool SliceStep =/=Int 0

  rule pySliceLower(None, _:Int) => 0
  rule pySliceLower(True, Len:Int) => pySliceIndex(1, Len)
  rule pySliceLower(False, Len:Int) => pySliceIndex(0, Len)
  rule pySliceLower(I:Int, Len:Int) => pySliceIndex(I, Len)

  rule pySliceUpper(None, Len:Int) => Len
  rule pySliceUpper(True, Len:Int) => pySliceIndex(1, Len)
  rule pySliceUpper(False, Len:Int) => pySliceIndex(0, Len)
  rule pySliceUpper(I:Int, Len:Int) => pySliceIndex(I, Len)

  rule pySliceIndex(I:Int, Len:Int) => 0
    requires I <Int 0 -Int Len
  rule pySliceIndex(I:Int, Len:Int) => Len +Int I
    requires I <Int 0 andBool I >=Int 0 -Int Len
  rule pySliceIndex(I:Int, Len:Int) => Len
    requires I >Int Len
  rule pySliceIndex(I:Int, Len:Int) => I
    requires I >=Int 0 andBool I <=Int Len

  rule pySliceLowerNeg(None, Len:Int) => Len -Int 1
  rule pySliceLowerNeg(True, Len:Int) => pySliceIndexNeg(1, Len)
  rule pySliceLowerNeg(False, Len:Int) => pySliceIndexNeg(0, Len)
  rule pySliceLowerNeg(I:Int, Len:Int) => pySliceIndexNeg(I, Len)

  rule pySliceUpperNeg(None, _:Int) => -1
  rule pySliceUpperNeg(True, Len:Int) => pySliceIndexNeg(1, Len)
  rule pySliceUpperNeg(False, Len:Int) => pySliceIndexNeg(0, Len)
  rule pySliceUpperNeg(I:Int, Len:Int) => pySliceIndexNeg(I, Len)

  rule pySliceIndexNeg(I:Int, Len:Int) => -1
    requires I <Int 0 -Int Len
  rule pySliceIndexNeg(I:Int, Len:Int) => Len +Int I
    requires I <Int 0 andBool I >=Int 0 -Int Len
  rule pySliceIndexNeg(I:Int, Len:Int) => Len -Int 1
    requires I >=Int Len
  rule pySliceIndexNeg(I:Int, Len:Int) => I
    requires I >=Int 0 andBool I <Int Len

  rule sliceStepLen(Start:Int, Stop:Int, Step:Int) => 0
    requires Step >Int 0 andBool Start >=Int Stop
  rule sliceStepLen(Start:Int, Stop:Int, Step:Int) => 1 +Int sliceStepLen(Start +Int Step, Stop, Step)
    requires Step >Int 0 andBool Start <Int Stop
  rule sliceStepLen(Start:Int, Stop:Int, Step:Int) => 0
    requires Step <Int 0 andBool Start <=Int Stop
  rule sliceStepLen(Start:Int, Stop:Int, Step:Int) => 1 +Int sliceStepLen(Start +Int Step, Stop, Step)
    requires Step <Int 0 andBool Start >Int Stop

  rule valItemsLen(valItemsLast(_:Val)) => 1
  rule valItemsLen(valItemsCons(_:Val, VS:ValItems)) => 1 +Int valItemsLen(VS)

  rule idItemsLen(#noIds) => 0
  rule idItemsLen(idItemsLast(_:Id)) => 1
  rule idItemsLen(idItemsCons(_:Id, IDS:IdItems)) => 1 +Int idItemsLen(IDS)

  rule targetsLen(targetsLast(_:Target)) => 1
  rule targetsLen(targetsCons(_:Target, TS:Targets)) => 1 +Int targetsLen(TS)

  rule maybeTargetsLen(#noTargets) => 0
  rule maybeTargetsLen(#targets(TS:Targets)) => targetsLen(TS)

  rule matchPatternsLen(#matchNoPatterns) => 0
  rule matchPatternsLen(#matchPattern(_:MatchPattern, PS:MatchPatterns)) => 1 +Int matchPatternsLen(PS)

  rule concatIdItems(#noIds, IDS:IdItems) => IDS
  rule concatIdItems(IDS:IdItems, #noIds) => IDS
  rule concatIdItems(idItemsLast(X:Id), IDS:IdItems) => idItemsCons(X, IDS)
    requires idItemsLen(IDS) >Int 0
  rule concatIdItems(idItemsCons(X:Id, IDS1:IdItems), IDS2:IdItems) =>
    idItemsCons(X, concatIdItems(IDS1, IDS2))

  rule argValsLen(#noArgVals) => 0
  rule argValsLen(argValsCons(_:Val, VS:ArgVals)) => 1 +Int argValsLen(VS)

  rule kwArgValsLen(#noKwArgVals) => 0
  rule kwArgValsLen(kwArgValsCons(_:Id, _:Val, VS:KwArgVals)) => 1 +Int kwArgValsLen(VS)
  rule kwArgValsLen(kwArgStringValsCons(_:String, _:Val, VS:KwArgVals)) => 1 +Int kwArgValsLen(VS)

  rule dictItemsLen(dictItemsLast(_:Val, _:Val)) => 1
  rule dictItemsLen(dictItemsCons(_:Val, _:Val, DS:DictItems)) => 1 +Int dictItemsLen(DS)

  rule pyFloorDiv(I1:Int, I2:Int) => (I1 /Int I2) -Int 1
    requires I2 =/=Int 0
     andBool I1 %Int I2 =/=Int 0
     andBool ((I1 <Int 0 andBool I2 >Int 0) orBool (I1 >Int 0 andBool I2 <Int 0))
  rule pyFloorDiv(I1:Int, I2:Int) => I1 /Int I2
    requires I2 =/=Int 0
     andBool (I1 %Int I2 ==Int 0
       orBool notBool ((I1 <Int 0 andBool I2 >Int 0) orBool (I1 >Int 0 andBool I2 <Int 0)))

  rule pyModulo(I1:Int, I2:Int) => I1 -Int (I2 *Int pyFloorDiv(I1, I2))
    requires I2 =/=Int 0

  rule intAbs(I:Int) => 0 -Int I
    requires I <Int 0
  rule intAbs(I:Int) => I
    requires I >=Int 0

  rule pyGcd(A:Int, B:Int) => pyGcd(intAbs(A), intAbs(B))
    requires A <Int 0 orBool B <Int 0
  rule pyGcd(A:Int, 0) => A
    requires A >=Int 0
  rule pyGcd(A:Int, B:Int) => pyGcd(B, A %Int B)
    requires A >=Int 0 andBool B >Int 0

  rule pyExtendedGcdX(_:Int, 0) => 1
  rule pyExtendedGcdY(_:Int, 0) => 0
  rule pyExtendedGcdX(A:Int, B:Int) => pyExtendedGcdY(B, A %Int B)
    requires A >=Int 0 andBool B >Int 0
  rule pyExtendedGcdY(A:Int, B:Int) =>
    pyExtendedGcdX(B, A %Int B) -Int ((A /Int B) *Int pyExtendedGcdY(B, A %Int B))
    requires A >=Int 0 andBool B >Int 0

  rule pyModInverse(Base:Int, Mod:Int) =>
    pyModulo(pyExtendedGcdX(pyModulo(Base, intAbs(Mod)), intAbs(Mod)), intAbs(Mod))
    requires intAbs(Mod) >Int 0
      andBool pyGcd(pyModulo(Base, intAbs(Mod)), intAbs(Mod)) ==Int 1

  rule pyFloatFloorDiv(F1:Float, F2:Float) => floorFloat(F1 /Float F2)
    requires F2 =/=Float 0.0

  rule pyFloatModulo(F1:Float, F2:Float) => F1 -Float (F2 *Float pyFloatFloorDiv(F1, F2))
    requires F2 =/=Float 0.0

  rule boolValue(true) => True
  rule boolValue(false) => False

  rule singletonPatternEq(True, True) => true
  rule singletonPatternEq(False, False) => true
  rule singletonPatternEq(None, None) => true
  rule singletonPatternEq(_:Val, _:Val) => false [owise]

  rule matchBuiltinClass(True, C:Id) => true
    requires Id2String(C) ==String "bool" orBool Id2String(C) ==String "int"
  rule matchBuiltinClass(False, C:Id) => true
    requires Id2String(C) ==String "bool" orBool Id2String(C) ==String "int"
  rule matchBuiltinClass(_I:Int, C:Id) => true
    requires Id2String(C) ==String "int"
  rule matchBuiltinClass(_F:Float, C:Id) => true
    requires Id2String(C) ==String "float"
  rule matchBuiltinClass(#complex(_:Float, _:Float), C:Id) => true
    requires Id2String(C) ==String "complex"
  rule matchBuiltinClass(_:String, C:Id) => true
    requires Id2String(C) ==String "str"
  rule matchBuiltinClass(#bytes(), C:Id) => true
    requires Id2String(C) ==String "bytes"
  rule matchBuiltinClass(bytesVal(_:ValItems), C:Id) => true
    requires Id2String(C) ==String "bytes"
  rule matchBuiltinClass([], C:Id) => true
    requires Id2String(C) ==String "list"
  rule matchBuiltinClass(listVal(_:ValItems), C:Id) => true
    requires Id2String(C) ==String "list"
  rule matchBuiltinClass((), C:Id) => true
    requires Id2String(C) ==String "tuple"
  rule matchBuiltinClass(tupleVal(_:ValItems), C:Id) => true
    requires Id2String(C) ==String "tuple"
  rule matchBuiltinClass({}, C:Id) => true
    requires Id2String(C) ==String "dict"
  rule matchBuiltinClass(dictVal(_:DictItems), C:Id) => true
    requires Id2String(C) ==String "dict"
  rule matchBuiltinClass(set(), C:Id) => true
    requires Id2String(C) ==String "set" orBool Id2String(C) ==String "kSetClassName"
  rule matchBuiltinClass(setVal(_:ValItems), C:Id) => true
    requires Id2String(C) ==String "set" orBool Id2String(C) ==String "kSetClassName"
  rule matchBuiltinClass(rangeVal(_:Int, _:Int), C:Id) => true
    requires Id2String(C) ==String "range"
  rule matchBuiltinClass(rangeVal(_:Int, _:Int, _:Int), C:Id) => true
    requires Id2String(C) ==String "range"
  rule matchBuiltinClass(sliceVal(_:Val, _:Val, _:Val), C:Id) => true
    requires Id2String(C) ==String "slice"
  rule matchBuiltinClass(_:Val, _:Id) => false [owise]

  rule builtinClassWholeArg(C:Id) => true
    requires Id2String(C) ==String "bool"
      orBool Id2String(C) ==String "bytes"
      orBool Id2String(C) ==String "dict"
      orBool Id2String(C) ==String "float"
      orBool Id2String(C) ==String "int"
      orBool Id2String(C) ==String "list"
      orBool Id2String(C) ==String "kSetClassName"
      orBool Id2String(C) ==String "set"
      orBool Id2String(C) ==String "str"
      orBool Id2String(C) ==String "tuple"
  rule builtinClassWholeArg(_:Id) => false [owise]

  rule matchBuiltinClassArg(V:Val, C:Id, P:MatchPattern) =>
    matchBuiltinClass(V, C) andBool matchSimplePattern(V, P)
    requires builtinClassWholeArg(C)
  rule matchBuiltinClassArg(_:Val, C:Id, _:MatchPattern) => false
    requires notBool builtinClassWholeArg(C)

  rule matchBuiltinClassKw(V:Val, C:Id, APS:MatchAttrPatterns) =>
    matchBuiltinClass(V, C) andBool matchClassAttrs(V, APS)

  rule matchBuiltinClassArgKw(V:Val, C:Id, P:MatchPattern, APS:MatchAttrPatterns) =>
    matchBuiltinClassArg(V, C, P) andBool matchClassAttrs(V, APS)

  rule matchClassAttrs(_:Val, #matchNoAttrPatterns) => true
  rule matchClassAttrs(V:Val, #matchAttrPattern(A:Id, P:MatchPattern, Rest:MatchAttrPatterns)) =>
    matchSimplePattern(matchClassAttrVal(V, A), P) andBool matchClassAttrs(V, Rest)
    requires classHasMatchAttr(V, A)
  rule matchClassAttrs(V:Val, #matchAttrPattern(A:Id, _P:MatchPattern, _Rest:MatchAttrPatterns)) => false
    requires notBool classHasMatchAttr(V, A)

  rule classHasMatchAttr(rangeVal(_:Int, _:Int), A:Id) => true
    requires Id2String(A) ==String "start" orBool Id2String(A) ==String "stop" orBool Id2String(A) ==String "step"
  rule classHasMatchAttr(rangeVal(_:Int, _:Int, _:Int), A:Id) => true
    requires Id2String(A) ==String "start" orBool Id2String(A) ==String "stop" orBool Id2String(A) ==String "step"
  rule classHasMatchAttr(sliceVal(_:Val, _:Val, _:Val), A:Id) => true
    requires Id2String(A) ==String "start" orBool Id2String(A) ==String "stop" orBool Id2String(A) ==String "step"
  rule classHasMatchAttr(#complex(_:Float, _:Float), A:Id) => true
    requires Id2String(A) ==String "real" orBool Id2String(A) ==String "imag"
  rule classHasMatchAttr(_:Float, A:Id) => true
    requires Id2String(A) ==String "real" orBool Id2String(A) ==String "imag"
  rule classHasMatchAttr(V:Val, A:Id) => true
    requires isIntLike(V)
      andBool (Id2String(A) ==String "real"
        orBool Id2String(A) ==String "imag"
        orBool Id2String(A) ==String "numerator"
        orBool Id2String(A) ==String "denominator")
  rule classHasMatchAttr(_:Val, _:Id) => false [owise]

  rule matchClassAttrVal(rangeVal(Start:Int, _:Int), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule matchClassAttrVal(rangeVal(_:Int, Stop:Int), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule matchClassAttrVal(rangeVal(_:Int, _:Int), Attr:Id) => 1
    requires Id2String(Attr) ==String "step"
  rule matchClassAttrVal(rangeVal(Start:Int, _:Int, _:Int), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule matchClassAttrVal(rangeVal(_:Int, Stop:Int, _:Int), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule matchClassAttrVal(rangeVal(_:Int, _:Int, Step:Int), Attr:Id) => Step
    requires Id2String(Attr) ==String "step"
  rule matchClassAttrVal(sliceVal(Start:Val, _:Val, _:Val), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule matchClassAttrVal(sliceVal(_:Val, Stop:Val, _:Val), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule matchClassAttrVal(sliceVal(_:Val, _:Val, Step:Val), Attr:Id) => Step
    requires Id2String(Attr) ==String "step"
  rule matchClassAttrVal(#complex(R:Float, _:Float), Attr:Id) => R
    requires Id2String(Attr) ==String "real"
  rule matchClassAttrVal(#complex(_:Float, I:Float), Attr:Id) => I
    requires Id2String(Attr) ==String "imag"
  rule matchClassAttrVal(F:Float, Attr:Id) => F
    requires Id2String(Attr) ==String "real"
  rule matchClassAttrVal(_:Float, Attr:Id) => 0.0
    requires Id2String(Attr) ==String "imag"
  rule matchClassAttrVal(V:Val, Attr:Id) => intValue(V)
    requires isIntLike(V) andBool Id2String(Attr) ==String "real"
  rule matchClassAttrVal(V:Val, Attr:Id) => 0
    requires isIntLike(V) andBool Id2String(Attr) ==String "imag"
  rule matchClassAttrVal(V:Val, Attr:Id) => intValue(V)
    requires isIntLike(V) andBool Id2String(Attr) ==String "numerator"
  rule matchClassAttrVal(V:Val, Attr:Id) => 1
    requires isIntLike(V) andBool Id2String(Attr) ==String "denominator"

  rule matchSimplePattern(_:Val, #matchWildcard) => true
  rule matchSimplePattern(_:Val, #matchCapture(_Name:Id)) => true
  rule matchSimplePattern(V:Val, #matchValue(P:Val)) => valEq(V, P)
  rule matchSimplePattern(V:Val, #matchSingleton(P:Val)) => singletonPatternEq(V, P)
  rule matchSimplePattern(V:Val, #matchClass(C:Id)) => matchBuiltinClass(V, C)
  rule matchSimplePattern(V:Val, #matchClassArg(C:Id, P:MatchPattern)) => matchBuiltinClassArg(V, C, P)
  rule matchSimplePattern(V:Val, #matchClassKw(C:Id, APS:MatchAttrPatterns)) => matchBuiltinClassKw(V, C, APS)
  rule matchSimplePattern(V:Val, #matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns)) => matchBuiltinClassArgKw(V, C, P, APS)
  rule matchSimplePattern(V:Val, #matchOr(P1:MatchPattern, P2:MatchPattern)) =>
    matchSimplePattern(V, P1) orBool matchSimplePattern(V, P2)
  rule matchSimplePattern(V:Val, #matchAs(P:MatchPattern, _Name:Id)) => matchSimplePattern(V, P)
  rule matchSimplePattern(V:Val, #matchSequence(PS:MatchPatterns)) => matchFixedSequence(V, PS)
  rule matchSimplePattern(V:Val, #matchSequenceStar(Prefix:MatchPatterns, Suffix:MatchPatterns)) =>
    matchStarSequence(V, Prefix, Suffix)
  rule matchSimplePattern(V:Val, #matchSequenceStarCapture(Prefix:MatchPatterns, _Name:Id, Suffix:MatchPatterns)) =>
    matchStarSequence(V, Prefix, Suffix)
  rule matchSimplePattern(V:Val, #matchMapping(MPS:MatchMapPatterns)) => matchMapping(V, MPS)
  rule matchSimplePattern(V:Val, #matchMappingRest(MPS:MatchMapPatterns, _Name:Id)) => matchMapping(V, MPS)

  rule bindMatchPattern(Rho:Map, V:Val, #matchCapture(Name:Id)) => Rho [ Name <- V ]
  rule bindMatchPattern(Rho:Map, V:Val, #matchAs(P:MatchPattern, Name:Id)) =>
    bindMatchPattern(Rho, V, P) [ Name <- V ]
  rule bindMatchPattern(Rho:Map, V:Val, #matchSequence(PS:MatchPatterns)) =>
    bindMatchSequence(Rho, V, PS)
  rule bindMatchPattern(Rho:Map, V:Val, #matchSequenceStar(Prefix:MatchPatterns, Suffix:MatchPatterns)) =>
    bindMatchStarSequence(Rho, V, Prefix, Suffix)
  rule bindMatchPattern(Rho:Map, V:Val, #matchSequenceStarCapture(Prefix:MatchPatterns, Name:Id, Suffix:MatchPatterns)) =>
    bindMatchStarSequence(Rho, V, Prefix, Suffix) [ Name <- matchStarMiddle(V, Prefix, Suffix) ]
  rule bindMatchPattern(Rho:Map, V:Val, #matchMapping(MPS:MatchMapPatterns)) =>
    bindMatchMapping(Rho, V, MPS)
  rule bindMatchPattern(Rho:Map, V:Val, #matchMappingRest(MPS:MatchMapPatterns, Name:Id)) =>
    bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ]
  rule bindMatchPattern(Rho:Map, V:Val, #matchClassArg(_C:Id, P:MatchPattern)) =>
    bindMatchPattern(Rho, V, P)
  rule bindMatchPattern(Rho:Map, V:Val, #matchClassKw(_C:Id, APS:MatchAttrPatterns)) =>
    bindMatchClassAttrs(Rho, V, APS)
  rule bindMatchPattern(Rho:Map, V:Val, #matchClassArgKw(_C:Id, P:MatchPattern, APS:MatchAttrPatterns)) =>
    bindMatchClassAttrs(bindMatchPattern(Rho, V, P), V, APS)
  rule bindMatchPattern(Rho:Map, V:Val, #matchOr(P1:MatchPattern, _P2:MatchPattern)) =>
    bindMatchPattern(Rho, V, P1)
    requires matchSimplePattern(V, P1)
  rule bindMatchPattern(Rho:Map, V:Val, #matchOr(P1:MatchPattern, P2:MatchPattern)) =>
    bindMatchPattern(Rho, V, P2)
    requires notBool matchSimplePattern(V, P1) andBool matchSimplePattern(V, P2)
  rule bindMatchPattern(Rho:Map, _V:Val, _P:MatchPattern) => Rho [owise]

  rule bindMatchSequence(Rho:Map, [], #matchNoPatterns) => Rho
  rule bindMatchSequence(Rho:Map, (), #matchNoPatterns) => Rho
  rule bindMatchSequence(Rho:Map, listVal(VS:ValItems), PS:MatchPatterns) =>
    bindMatchValItems(Rho, VS, PS)
  rule bindMatchSequence(Rho:Map, tupleVal(VS:ValItems), PS:MatchPatterns) =>
    bindMatchValItems(Rho, VS, PS)
  rule bindMatchSequence(Rho:Map, _V:Val, _PS:MatchPatterns) => Rho [owise]

  rule bindMatchStarSequence(Rho:Map, [], #matchNoPatterns, #matchNoPatterns) => Rho
  rule bindMatchStarSequence(Rho:Map, (), #matchNoPatterns, #matchNoPatterns) => Rho
  rule bindMatchStarSequence(Rho:Map, listVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    bindMatchStarSuffix(bindMatchStarPrefix(Rho, VS, Prefix), VS, Suffix)
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)
  rule bindMatchStarSequence(Rho:Map, tupleVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    bindMatchStarSuffix(bindMatchStarPrefix(Rho, VS, Prefix), VS, Suffix)
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)
  rule bindMatchStarSequence(Rho:Map, _V:Val, _Prefix:MatchPatterns, _Suffix:MatchPatterns) => Rho [owise]

  rule bindMatchStarPrefix(Rho:Map, _VS:ValItems, #matchNoPatterns) => Rho
  rule bindMatchStarPrefix(Rho:Map, VS:ValItems, Prefix:MatchPatterns) =>
    bindMatchValItems(Rho, sliceValItems(VS, 0, matchPatternsLen(Prefix)), Prefix)
    requires matchPatternsLen(Prefix) >Int 0

  rule bindMatchStarSuffix(Rho:Map, _VS:ValItems, #matchNoPatterns) => Rho
  rule bindMatchStarSuffix(Rho:Map, VS:ValItems, Suffix:MatchPatterns) =>
    bindMatchValItems(Rho, dropValItems(VS, valItemsLen(VS) -Int matchPatternsLen(Suffix)), Suffix)
    requires matchPatternsLen(Suffix) >Int 0

  rule bindMatchValItems(Rho:Map, valItemsLast(V:Val), #matchPattern(P:MatchPattern, #matchNoPatterns)) =>
    bindMatchPattern(Rho, V, P)
  rule bindMatchValItems(Rho:Map, valItemsCons(V:Val, VS:ValItems), #matchPattern(P:MatchPattern, PS:MatchPatterns)) =>
    bindMatchValItems(bindMatchPattern(Rho, V, P), VS, PS)
  rule bindMatchValItems(Rho:Map, _VS:ValItems, _PS:MatchPatterns) => Rho [owise]

  rule bindMatchMapping(Rho:Map, {}, #matchNoMapPatterns) => Rho
  rule bindMatchMapping(Rho:Map, dictVal(DS:DictItems), MPS:MatchMapPatterns) =>
    bindMatchDictItems(Rho, DS, MPS)
  rule bindMatchMapping(Rho:Map, _V:Val, _MPS:MatchMapPatterns) => Rho [owise]

  rule bindMatchDictItems(Rho:Map, _DS:DictItems, #matchNoMapPatterns) => Rho
  rule bindMatchDictItems(Rho:Map, DS:DictItems, #matchMapPattern(K:Val, P:MatchPattern, Rest:MatchMapPatterns)) =>
    bindMatchDictItems(bindMatchPattern(Rho, dictGet(DS, K), P), DS, Rest)
    requires containsKey(K, DS)
  rule bindMatchDictItems(Rho:Map, _DS:DictItems, _MPS:MatchMapPatterns) => Rho [owise]

  rule bindMatchClassAttrs(Rho:Map, _V:Val, #matchNoAttrPatterns) => Rho
  rule bindMatchClassAttrs(Rho:Map, V:Val, #matchAttrPattern(A:Id, P:MatchPattern, Rest:MatchAttrPatterns)) =>
    bindMatchClassAttrs(bindMatchPattern(Rho, matchClassAttrVal(V, A), P), V, Rest)
    requires classHasMatchAttr(V, A)
  rule bindMatchClassAttrs(Rho:Map, _V:Val, _APS:MatchAttrPatterns) => Rho [owise]

  rule matchFixedSequence([], #matchNoPatterns) => true
  rule matchFixedSequence([], #matchPattern(_:MatchPattern, _:MatchPatterns)) => false
  rule matchFixedSequence((), #matchNoPatterns) => true
  rule matchFixedSequence((), #matchPattern(_:MatchPattern, _:MatchPatterns)) => false
  rule matchFixedSequence(listVal(VS:ValItems), PS:MatchPatterns) => matchValItemsPatterns(VS, PS)
  rule matchFixedSequence(tupleVal(VS:ValItems), PS:MatchPatterns) => matchValItemsPatterns(VS, PS)
  rule matchFixedSequence(_:Val, _:MatchPatterns) => false [owise]

  rule matchValItemsPatterns(valItemsLast(_:Val), #matchNoPatterns) => false
  rule matchValItemsPatterns(valItemsCons(_:Val, _:ValItems), #matchNoPatterns) => false
  rule matchValItemsPatterns(valItemsLast(V:Val), #matchPattern(P:MatchPattern, #matchNoPatterns)) =>
    matchSimplePattern(V, P)
  rule matchValItemsPatterns(valItemsLast(_:Val), #matchPattern(_:MatchPattern, #matchPattern(_:MatchPattern, _:MatchPatterns))) => false
  rule matchValItemsPatterns(valItemsCons(V:Val, VS:ValItems), #matchPattern(P:MatchPattern, PS:MatchPatterns)) =>
    matchSimplePattern(V, P) andBool matchValItemsPatterns(VS, PS)

  rule matchStarSequence([], Prefix:MatchPatterns, Suffix:MatchPatterns) => true
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) ==Int 0
  rule matchStarSequence([], Prefix:MatchPatterns, Suffix:MatchPatterns) => false
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) >Int 0
  rule matchStarSequence((), Prefix:MatchPatterns, Suffix:MatchPatterns) => true
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) ==Int 0
  rule matchStarSequence((), Prefix:MatchPatterns, Suffix:MatchPatterns) => false
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) >Int 0
  rule matchStarSequence(listVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    matchValItemsPrefix(VS, Prefix) andBool matchValItemsSuffix(VS, Suffix)
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)
  rule matchStarSequence(listVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) => false
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) >Int valItemsLen(VS)
  rule matchStarSequence(tupleVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    matchValItemsPrefix(VS, Prefix) andBool matchValItemsSuffix(VS, Suffix)
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)
  rule matchStarSequence(tupleVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) => false
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) >Int valItemsLen(VS)
  rule matchStarSequence(_:Val, _:MatchPatterns, _:MatchPatterns) => false [owise]

  rule matchValItemsPrefix(_:ValItems, #matchNoPatterns) => true
  rule matchValItemsPrefix(VS:ValItems, Prefix:MatchPatterns) =>
    matchValItemsPatterns(sliceValItems(VS, 0, matchPatternsLen(Prefix)), Prefix)
    requires matchPatternsLen(Prefix) >Int 0
  rule matchValItemsSuffix(_:ValItems, #matchNoPatterns) => true
  rule matchValItemsSuffix(VS:ValItems, Suffix:MatchPatterns) =>
    matchValItemsPatterns(dropValItems(VS, valItemsLen(VS) -Int matchPatternsLen(Suffix)), Suffix)
    requires matchPatternsLen(Suffix) >Int 0

  rule matchStarMiddle([], #matchNoPatterns, #matchNoPatterns) => []
  rule matchStarMiddle((), #matchNoPatterns, #matchNoPatterns) => []
  rule matchStarMiddle(listVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    listSlice(VS, matchPatternsLen(Prefix), valItemsLen(VS) -Int matchPatternsLen(Suffix))
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)
  rule matchStarMiddle(tupleVal(VS:ValItems), Prefix:MatchPatterns, Suffix:MatchPatterns) =>
    listSlice(VS, matchPatternsLen(Prefix), valItemsLen(VS) -Int matchPatternsLen(Suffix))
    requires matchPatternsLen(Prefix) +Int matchPatternsLen(Suffix) <=Int valItemsLen(VS)

  rule matchMapping({}, #matchNoMapPatterns) => true
  rule matchMapping({}, #matchMapPattern(_:Val, _:MatchPattern, _:MatchMapPatterns)) => false
  rule matchMapping(dictVal(DS:DictItems), MPS:MatchMapPatterns) => matchDictItems(DS, MPS)
  rule matchMapping(_:Val, _:MatchMapPatterns) => false [owise]

  rule matchDictItems(_:DictItems, #matchNoMapPatterns) => true
  rule matchDictItems(DS:DictItems, #matchMapPattern(K:Val, P:MatchPattern, Rest:MatchMapPatterns)) =>
    matchSimplePattern(dictGet(DS, K), P) andBool matchDictItems(DS, Rest)
    requires containsKey(K, DS)
  rule matchDictItems(DS:DictItems, #matchMapPattern(K:Val, _P:MatchPattern, _Rest:MatchMapPatterns)) => false
    requires notBool containsKey(K, DS)

  rule matchKeyInPatterns(_:Val, #matchNoMapPatterns) => false
  rule matchKeyInPatterns(K:Val, #matchMapPattern(K0:Val, _P:MatchPattern, _Rest:MatchMapPatterns)) => true
    requires valEq(K, K0)
  rule matchKeyInPatterns(K:Val, #matchMapPattern(K0:Val, _P:MatchPattern, Rest:MatchMapPatterns)) =>
    matchKeyInPatterns(K, Rest)
    requires notBool valEq(K, K0)

  rule matchMappingRestVal({}, #matchNoMapPatterns) => {}
  rule matchMappingRestVal(dictVal(DS:DictItems), MPS:MatchMapPatterns) =>
    dictFromDictVals(matchMappingRestVals(DS, MPS))

  rule matchMappingRestVals(dictItemsLast(K:Val, _V:Val), MPS:MatchMapPatterns) => #noDictVals
    requires matchKeyInPatterns(K, MPS)
  rule matchMappingRestVals(dictItemsLast(K:Val, V:Val), MPS:MatchMapPatterns) =>
    dictValsCons(K, V, #noDictVals)
    requires notBool matchKeyInPatterns(K, MPS)
  rule matchMappingRestVals(dictItemsCons(K:Val, _V:Val, DS:DictItems), MPS:MatchMapPatterns) =>
    matchMappingRestVals(DS, MPS)
    requires matchKeyInPatterns(K, MPS)
  rule matchMappingRestVals(dictItemsCons(K:Val, V:Val, DS:DictItems), MPS:MatchMapPatterns) =>
    dictValsCons(K, V, matchMappingRestVals(DS, MPS))
    requires notBool matchKeyInPatterns(K, MPS)

  rule valEq(I1:Int, I2:Int) => I1 ==Int I2
  rule valEq(F1:Float, F2:Float) => F1 ==Float F2
  rule valEq(I:Int, F:Float) => Int2Float(I, 53, 11) ==Float F
  rule valEq(F:Float, I:Int) => F ==Float Int2Float(I, 53, 11)
  rule valEq(True, F:Float) => Int2Float(1, 53, 11) ==Float F
  rule valEq(False, F:Float) => Int2Float(0, 53, 11) ==Float F
  rule valEq(F:Float, True) => F ==Float Int2Float(1, 53, 11)
  rule valEq(F:Float, False) => F ==Float Int2Float(0, 53, 11)
  rule valEq(#complex(R1:Float, I1:Float), #complex(R2:Float, I2:Float)) =>
    R1 ==Float R2 andBool I1 ==Float I2
  rule valEq(#complex(R:Float, I:Float), V:Val) =>
    R ==Float floatValue(V) andBool I ==Float 0.0
    requires isIntLike(V)
  rule valEq(V:Val, #complex(R:Float, I:Float)) =>
    floatValue(V) ==Float R andBool I ==Float 0.0
    requires isIntLike(V)
  rule valEq(#complex(R:Float, I:Float), F:Float) => R ==Float F andBool I ==Float 0.0
  rule valEq(F:Float, #complex(R:Float, I:Float)) => F ==Float R andBool I ==Float 0.0
  rule valEq(#complex(_:Float, _:Float), _:Val) => false [owise]
  rule valEq(_:Val, #complex(_:Float, _:Float)) => false [owise]
  rule valEq(_:Float, _:Val) => false [owise]
  rule valEq(_:Val, _:Float) => false [owise]
  rule valEq(S1:String, S2:String) => S1 ==String S2
  rule valEq(#bytes(), #bytes()) => true
  rule valEq(#bytes(), bytesVal(_:ValItems)) => false
  rule valEq(bytesVal(_:ValItems), #bytes()) => false
  rule valEq(bytesVal(VS1:ValItems), bytesVal(VS2:ValItems)) => valsEq(VS1, VS2)
  rule valEq(#bytes(), _:Val) => false [owise]
  rule valEq(_:Val, #bytes()) => false [owise]
  rule valEq(bytesVal(_:ValItems), _:Val) => false [owise]
  rule valEq(_:Val, bytesVal(_:ValItems)) => false [owise]
  rule valEq(_:String, _:Int) => false
  rule valEq(_:Int, _:String) => false
  rule valEq([], []) => true
  rule valEq([], listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), []) => false
  rule valEq(listVal(VS1:ValItems), listVal(VS2:ValItems)) => valsEq(VS1, VS2)
  rule valEq((), ()) => true
  rule valEq((), tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), ()) => false
  rule valEq(tupleVal(VS1:ValItems), tupleVal(VS2:ValItems)) => valsEq(VS1, VS2)
  rule valEq({}, {}) => true
  rule valEq({}, dictVal(_:DictItems)) => false
  rule valEq(dictVal(_:DictItems), {}) => false
  rule valEq(dictVal(DS1:DictItems), dictVal(DS2:DictItems)) => dictsEq(DS1, DS2)
  rule valEq(set(), set()) => true
  rule valEq(set(), setVal(_:ValItems)) => false
  rule valEq(setVal(_:ValItems), set()) => false
  rule valEq(setVal(VS1:ValItems), setVal(VS2:ValItems)) => setsEq(VS1, VS2)
  rule valEq(rangeVal(Start1:Int, Stop1:Int), rangeVal(Start2:Int, Stop2:Int)) =>
    rangeEq(Start1, Stop1, 1, Start2, Stop2, 1)
  rule valEq(rangeVal(Start1:Int, Stop1:Int), rangeVal(Start2:Int, Stop2:Int, Step2:Int)) =>
    rangeEq(Start1, Stop1, 1, Start2, Stop2, Step2)
  rule valEq(rangeVal(Start1:Int, Stop1:Int, Step1:Int), rangeVal(Start2:Int, Stop2:Int)) =>
    rangeEq(Start1, Stop1, Step1, Start2, Stop2, 1)
  rule valEq(rangeVal(Start1:Int, Stop1:Int, Step1:Int), rangeVal(Start2:Int, Stop2:Int, Step2:Int)) =>
    rangeEq(Start1, Stop1, Step1, Start2, Stop2, Step2)
  rule valEq(sliceVal(Start1:Val, Stop1:Val, Step1:Val), sliceVal(Start2:Val, Stop2:Val, Step2:Val)) =>
    valEq(Start1, Start2) andBool valEq(Stop1, Stop2) andBool valEq(Step1, Step2)
  rule valEq((), []) => false
  rule valEq([], ()) => false
  rule valEq((), listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), ()) => false
  rule valEq(tupleVal(_:ValItems), []) => false
  rule valEq([], tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), tupleVal(_:ValItems)) => false
  rule valEq(_:String, []) => false
  rule valEq([], _:String) => false
  rule valEq(_:Int, []) => false
  rule valEq([], _:Int) => false
  rule valEq(_:String, ()) => false
  rule valEq((), _:String) => false
  rule valEq(_:Int, ()) => false
  rule valEq((), _:Int) => false
  rule valEq(_:String, tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), _:String) => false
  rule valEq(_:Int, tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), _:Int) => false
  rule valEq(_:String, listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), _:String) => false
  rule valEq(_:Int, listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), _:Int) => false
  rule valEq(True, []) => false
  rule valEq(False, []) => false
  rule valEq([], True) => false
  rule valEq([], False) => false
  rule valEq(True, listVal(_:ValItems)) => false
  rule valEq(False, listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), True) => false
  rule valEq(listVal(_:ValItems), False) => false
  rule valEq(True, ()) => false
  rule valEq(False, ()) => false
  rule valEq((), True) => false
  rule valEq((), False) => false
  rule valEq(True, tupleVal(_:ValItems)) => false
  rule valEq(False, tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), True) => false
  rule valEq(tupleVal(_:ValItems), False) => false
  rule valEq(None, []) => false
  rule valEq([], None) => false
  rule valEq(None, listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), None) => false
  rule valEq(None, ()) => false
  rule valEq((), None) => false
  rule valEq(None, tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), None) => false
  rule valEq(closure(_:Id, _:Exp), _:Int) => false
  rule valEq(_:Int, closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), _:String) => false
  rule valEq(_:String, closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), True) => false
  rule valEq(closure(_:Id, _:Exp), False) => false
  rule valEq(True, closure(_:Id, _:Exp)) => false
  rule valEq(False, closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), None) => false
  rule valEq(None, closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), []) => false
  rule valEq([], closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), listVal(_:ValItems)) => false
  rule valEq(listVal(_:ValItems), closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), ()) => false
  rule valEq((), closure(_:Id, _:Exp)) => false
  rule valEq(closure(_:Id, _:Exp), tupleVal(_:ValItems)) => false
  rule valEq(tupleVal(_:ValItems), closure(_:Id, _:Exp)) => false
  rule valEq(_:String, True) => false
  rule valEq(_:String, False) => false
  rule valEq(_:String, None) => false
  rule valEq(True, _:String) => false
  rule valEq(False, _:String) => false
  rule valEq(None, _:String) => false
  rule valEq(True, I:Int) => 1 ==Int I
  rule valEq(False, I:Int) => 0 ==Int I
  rule valEq(I:Int, True) => I ==Int 1
  rule valEq(I:Int, False) => I ==Int 0
  rule valEq(True, True) => true
  rule valEq(True, False) => false
  rule valEq(False, True) => false
  rule valEq(False, False) => true
  rule valEq(None, None) => true
  rule valEq(Ellipsis, Ellipsis) => true
  rule valEq(#exception(E1:Id), #exception(E2:Id)) => Id2String(E1) ==String Id2String(E2)
  rule valEq(None, _:Int) => false
  rule valEq(_:Int, None) => false
  rule valEq(None, True) => false
  rule valEq(None, False) => false
  rule valEq(True, None) => false
  rule valEq(False, None) => false
  rule valEq(Ellipsis, None) => false
  rule valEq(None, Ellipsis) => false
  rule valEq(Ellipsis, True) => false
  rule valEq(Ellipsis, False) => false
  rule valEq(True, Ellipsis) => false
  rule valEq(False, Ellipsis) => false
  rule valEq(Ellipsis, _:Int) => false
  rule valEq(_:Int, Ellipsis) => false
  rule valEq(Ellipsis, _:Float) => false
  rule valEq(_:Float, Ellipsis) => false
  rule valEq(Ellipsis, _:String) => false
  rule valEq(_:String, Ellipsis) => false

  rule exceptionMatches(#exception(E:Id), F:Id) => Id2String(E) ==String Id2String(F)
  rule exceptionMatches(#exceptionInstance(E:Id, _Args:ArgVals), F:Id) => Id2String(E) ==String Id2String(F)
  rule exceptionMatches(_V:Val, _F:Id) => false [owise]

  rule exceptionIn(#exception(E:Id), IDS:IdItems) => stringIdContains(Id2String(E), IDS)
  rule exceptionIn(#exceptionInstance(E:Id, _Args:ArgVals), IDS:IdItems) => stringIdContains(Id2String(E), IDS)
  rule exceptionIn(_V:Val, _IDS:IdItems) => false [owise]

  rule valIs(V1:Val, V2:Val) => valEq(V1, V2)
    requires singletonIdentity(V1) andBool singletonIdentity(V2)
  rule valIs(V1:Val, V2:Val) => false
    requires singletonIdentity(V1) andBool notBool singletonIdentity(V2)
  rule valIs(V1:Val, V2:Val) => false
    requires notBool singletonIdentity(V1) andBool singletonIdentity(V2)

  rule cmpHolds(#lt, V1:Val, V2:Val) => intValue(V1) <Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule cmpHolds(#lt, F1:Float, F2:Float) => F1 <Float F2
  rule cmpHolds(#lt, F:Float, V:Val) => F <Float floatValue(V)
    requires isIntLike(V)
  rule cmpHolds(#lt, V:Val, F:Float) => floatValue(V) <Float F
    requires isIntLike(V)
  rule cmpHolds(#lt, S1:String, S2:String) => S1 <String S2
  rule cmpHolds(#lt, V1:Val, V2:Val) => seqLt(V1, V2)
    requires seqOrderComparable(V1, V2)
  rule cmpHolds(#lt, setVal(VS1:ValItems), setVal(VS2:ValItems)) =>
    setItemsSubset(VS1, VS2) andBool notBool setsEq(VS1, VS2)
  rule cmpHolds(#lt, set(), set()) => false
  rule cmpHolds(#lt, set(), setVal(_:ValItems)) => true
  rule cmpHolds(#lt, setVal(_:ValItems), set()) => false
  rule cmpHolds(#le, V1:Val, V2:Val) => intValue(V1) <=Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule cmpHolds(#le, F1:Float, F2:Float) => F1 <=Float F2
  rule cmpHolds(#le, F:Float, V:Val) => F <=Float floatValue(V)
    requires isIntLike(V)
  rule cmpHolds(#le, V:Val, F:Float) => floatValue(V) <=Float F
    requires isIntLike(V)
  rule cmpHolds(#le, S1:String, S2:String) => S1 <=String S2
  rule cmpHolds(#le, V1:Val, V2:Val) => seqLt(V1, V2) orBool valEq(V1, V2)
    requires seqOrderComparable(V1, V2)
  rule cmpHolds(#le, setVal(VS1:ValItems), setVal(VS2:ValItems)) =>
    setItemsSubset(VS1, VS2)
  rule cmpHolds(#le, set(), set()) => true
  rule cmpHolds(#le, set(), setVal(_:ValItems)) => true
  rule cmpHolds(#le, setVal(_:ValItems), set()) => false
  rule cmpHolds(#gt, V1:Val, V2:Val) => intValue(V1) >Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule cmpHolds(#gt, F1:Float, F2:Float) => F1 >Float F2
  rule cmpHolds(#gt, F:Float, V:Val) => F >Float floatValue(V)
    requires isIntLike(V)
  rule cmpHolds(#gt, V:Val, F:Float) => floatValue(V) >Float F
    requires isIntLike(V)
  rule cmpHolds(#gt, S1:String, S2:String) => S1 >String S2
  rule cmpHolds(#gt, V1:Val, V2:Val) => seqLt(V2, V1)
    requires seqOrderComparable(V1, V2)
  rule cmpHolds(#gt, setVal(VS1:ValItems), setVal(VS2:ValItems)) =>
    setItemsSubset(VS2, VS1) andBool notBool setsEq(VS1, VS2)
  rule cmpHolds(#gt, set(), set()) => false
  rule cmpHolds(#gt, set(), setVal(_:ValItems)) => false
  rule cmpHolds(#gt, setVal(_:ValItems), set()) => true
  rule cmpHolds(#ge, V1:Val, V2:Val) => intValue(V1) >=Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule cmpHolds(#ge, F1:Float, F2:Float) => F1 >=Float F2
  rule cmpHolds(#ge, F:Float, V:Val) => F >=Float floatValue(V)
    requires isIntLike(V)
  rule cmpHolds(#ge, V:Val, F:Float) => floatValue(V) >=Float F
    requires isIntLike(V)
  rule cmpHolds(#ge, S1:String, S2:String) => S1 >=String S2
  rule cmpHolds(#ge, V1:Val, V2:Val) => seqLt(V2, V1) orBool valEq(V1, V2)
    requires seqOrderComparable(V1, V2)
  rule cmpHolds(#ge, setVal(VS1:ValItems), setVal(VS2:ValItems)) =>
    setItemsSubset(VS2, VS1)
  rule cmpHolds(#ge, set(), set()) => true
  rule cmpHolds(#ge, set(), setVal(_:ValItems)) => false
  rule cmpHolds(#ge, setVal(_:ValItems), set()) => true
  rule cmpHolds(#eq, V1:Val, V2:Val) => valEq(V1, V2)
  rule cmpHolds(#ne, V1:Val, V2:Val) => notBool valEq(V1, V2)
  rule cmpHolds(#is, V1:Val, V2:Val) => valIs(V1, V2)
  rule cmpHolds(#isNot, V1:Val, V2:Val) => notBool valIs(V1, V2)
  rule cmpHolds(#in, Needle:String, Haystack:String) => findString(Haystack, Needle, 0) >=Int 0
  rule cmpHolds(#in, #bytes(), #bytes()) => true
  rule cmpHolds(#in, #bytes(), bytesVal(_:ValItems)) => true
  rule cmpHolds(#in, bytesVal(_:ValItems), #bytes()) => false
  rule cmpHolds(#in, bytesVal(Needle:ValItems), bytesVal(Haystack:ValItems)) =>
    bytesContains(Needle, Haystack)
  rule cmpHolds(#in, V:Val, #bytes()) => false
    requires notBool isBytesSequence(V)
  rule cmpHolds(#in, V:Val, bytesVal(VS:ValItems)) => containsVal(intValue(V), VS)
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule cmpHolds(#in, V:Val, bytesVal(_VS:ValItems)) => false
    requires notBool isIntLike(V) andBool notBool isBytesSequence(V)
  rule cmpHolds(#in, V:Val, bytesVal(_VS:ValItems)) => false
    requires isIntLike(V) andBool (intValue(V) <Int 0 orBool intValue(V) >Int 255)
  rule cmpHolds(#in, _V:Val, []) => false
  rule cmpHolds(#in, V:Val, listVal(VS:ValItems)) => containsVal(V, VS)
  rule cmpHolds(#in, _V:Val, ()) => false
  rule cmpHolds(#in, V:Val, tupleVal(VS:ValItems)) => containsVal(V, VS)
  rule cmpHolds(#in, _V:Val, {}) => false
  rule cmpHolds(#in, V:Val, dictVal(DS:DictItems)) => containsKey(V, DS)
  rule cmpHolds(#in, _V:Val, set()) => false
  rule cmpHolds(#in, V:Val, setVal(VS:ValItems)) => containsVal(V, VS)
  rule cmpHolds(#in, V:Val, rangeVal(Start:Int, Stop:Int)) => rangeContains(V, Start, Stop)
  rule cmpHolds(#in, V:Val, rangeVal(Start:Int, Stop:Int, Step:Int)) => rangeContains(V, Start, Stop, Step)
  rule cmpHolds(#notIn, V1:Val, V2:Val) => notBool cmpHolds(#in, V1, V2)

  rule sameArity(#noIds, #noArgVals) => true
  rule sameArity(#noIds, argValsCons(_:Val, _:ArgVals)) => false
  rule sameArity(idItemsLast(_:Id), #noArgVals) => false
  rule sameArity(idItemsLast(_:Id), argValsCons(_:Val, #noArgVals)) => true
  rule sameArity(idItemsLast(_:Id), argValsCons(_:Val, argValsCons(_:Val, _:ArgVals))) => false
  rule sameArity(idItemsCons(_:Id, _:IdItems), #noArgVals) => false
  rule sameArity(idItemsCons(_:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals)) => sameArity(IDS, VS)

  rule varArgsCallArityOk(IDS:IdItems, VS:ArgVals) => argValsLen(VS) >=Int idItemsLen(IDS)

  rule varArgsDefaultsCallArityOk(IDS:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool (argValsLen(VS) >=Int idItemsLen(IDS)
        orBool idItemsLen(IDS) -Int argValsLen(VS) <=Int argValsLen(Defaults))

  rule varArgsMixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, IDS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool varArgsMixedRequiredPresent(IDS, VS, KWS)

  rule varArgsMixedDefaultsCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, IDS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults)

  rule varArgsKwOnlyKeywordCallArityOk(IDS:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, IDS, KwOnly)
      andBool varArgsMixedRequiredPresent(IDS, #noArgVals, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule varArgsKwOnlyMixedCallArityOk(IDS:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, IDS, KwOnly)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool varArgsMixedRequiredPresent(IDS, VS, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule varArgsKwOnlyKeywordDefaultsCallArityOk(IDS:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, IDS, KwOnly)
      andBool kwRequiredPresent(IDS, KWS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule varArgsKwOnlyMixedDefaultsCallArityOk(IDS:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, IDS, KwOnly)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule varArgsKwOnlyKwArgsKeywordCallArityOk(IDS:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool varArgsMixedRequiredPresent(IDS, #noArgVals, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule varArgsKwOnlyKwArgsMixedCallArityOk(IDS:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool varArgsMixedRequiredPresent(IDS, VS, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule varArgsKwOnlyKwArgsKeywordDefaultsCallArityOk(IDS:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwRequiredPresent(IDS, KWS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule varArgsKwOnlyKwArgsMixedDefaultsCallArityOk(IDS:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule varKwArgsKeywordCallArityOk(IDS:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool varArgsMixedRequiredPresent(IDS, #noArgVals, KWS)

  rule varKwArgsMixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool varArgsMixedRequiredPresent(IDS, VS, KWS)

  rule varKwArgsDefaultsKeywordCallArityOk(IDS:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool kwRequiredPresent(IDS, KWS, Defaults)

  rule varKwArgsDefaultsMixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults)

  rule varArgsMixedNoPosKeyword(#noIds, _:ArgVals, _:KwArgVals) => true
  rule varArgsMixedNoPosKeyword(idItemsLast(_:Id), #noArgVals, _:KwArgVals) => true
  rule varArgsMixedNoPosKeyword(idItemsLast(X:Id), argValsCons(_:Val, _:ArgVals), KWS:KwArgVals) =>
    notBool kwContains(X, KWS)
  rule varArgsMixedNoPosKeyword(idItemsCons(_:Id, _:IdItems), #noArgVals, _:KwArgVals) => true
  rule varArgsMixedNoPosKeyword(idItemsCons(X:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals), KWS:KwArgVals) =>
    notBool kwContains(X, KWS) andBool varArgsMixedNoPosKeyword(IDS, VS, KWS)

  rule varArgsMixedRequiredPresent(#noIds, _:ArgVals, _:KwArgVals) => true
  rule varArgsMixedRequiredPresent(idItemsLast(X:Id), #noArgVals, KWS:KwArgVals) => kwContains(X, KWS)
  rule varArgsMixedRequiredPresent(idItemsLast(_:Id), argValsCons(_:Val, _:ArgVals), _:KwArgVals) => true
  rule varArgsMixedRequiredPresent(idItemsCons(X:Id, IDS:IdItems), #noArgVals, KWS:KwArgVals) =>
    kwContains(X, KWS) andBool varArgsMixedRequiredPresent(IDS, #noArgVals, KWS)
  rule varArgsMixedRequiredPresent(idItemsCons(_:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals), KWS:KwArgVals) =>
    varArgsMixedRequiredPresent(IDS, VS, KWS)

  rule kwargsPosCallArityOk(IDS:IdItems, VS:ArgVals) => sameArity(IDS, VS)

  rule kwargsKeywordCallArityOk(IDS:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwRequiredPresent(IDS, KWS, #noArgVals)

  rule kwargsMixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, VS, KWS, #noArgVals)

  rule kwargsDefaultsKeywordCallArityOk(IDS:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool kwRequiredPresent(IDS, KWS, Defaults)

  rule kwargsDefaultsMixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(IDS)
      andBool argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, VS, KWS, Defaults)

  rule posOnlyArgsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals) =>
    argValsLen(VS) ==Int idItemsLen(Pos) +Int idItemsLen(Rest)

  rule posOnlyKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals) =>
    idItemsLen(Pos) ==Int 0
      andBool keywordOnlyCallArityOk(Rest, KWS, #noArgVals)

  rule posOnlyMixedCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool argValsLen(VS) <=Int idItemsLen(Pos) +Int idItemsLen(Rest)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS, #noArgVals)

  rule posOnlyDefaultsArgsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    defaultsCallArityOk(concatIdItems(Pos, Rest), VS, Defaults)

  rule posOnlyDefaultsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool kwRequiredPresent(concatIdItems(Pos, Rest), KWS, Defaults)

  rule posOnlyDefaultsMixedCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, Defaults)

  rule posOnlyVarArgsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals) =>
    argValsLen(VS) >=Int idItemsLen(concatIdItems(Pos, Rest))

  rule posOnlyVarArgsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool kwRequiredPresent(concatIdItems(Pos, Rest), KWS, #noArgVals)

  rule posOnlyVarArgsMixedCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool varArgsMixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS)

  rule posOnlyVarArgsDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    varArgsDefaultsCallArityOk(concatIdItems(Pos, Rest), VS, Defaults)

  rule posOnlyVarArgsKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool kwRequiredPresent(concatIdItems(Pos, Rest), KWS, Defaults)

  rule posOnlyVarArgsMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, Rest)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), takeArgVals(VS, idItemsLen(concatIdItems(Pos, Rest))), KWS, Defaults)

  rule posOnlyKwArgsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals) =>
    argValsLen(VS) ==Int idItemsLen(concatIdItems(Pos, Rest))

  rule posOnlyKwArgsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals) =>
    posOnlyKwArgsMixedCallArityOk(Pos, Rest, #noArgVals, KWS)

  rule posOnlyKwArgsMixedCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, #noArgVals)

  rule posOnlyKwArgsDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    defaultsCallArityOk(concatIdItems(Pos, Rest), VS, Defaults)

  rule posOnlyKwArgsKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    posOnlyKwArgsMixedDefaultsCallArityOk(Pos, Rest, #noArgVals, KWS, Defaults)

  rule posOnlyKwArgsMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)

  rule posOnlyVarKwArgsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals) =>
    argValsLen(VS) >=Int idItemsLen(concatIdItems(Pos, Rest))

  rule posOnlyVarKwArgsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals) =>
    posOnlyVarKwArgsMixedCallArityOk(Pos, Rest, #noArgVals, KWS)

  rule posOnlyVarKwArgsMixedCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool varArgsMixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS)

  rule posOnlyVarKwArgsDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    posOnlyVarKwArgsMixedDefaultsCallArityOk(Pos, Rest, VS, #noKwArgVals, Defaults)

  rule posOnlyVarKwArgsKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    posOnlyVarKwArgsMixedDefaultsCallArityOk(Pos, Rest, #noArgVals, KWS, Defaults)

  rule posOnlyVarKwArgsMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), takeArgVals(VS, idItemsLen(concatIdItems(Pos, Rest))), KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)

  rule posOnlyVarArgsKwOnlyKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    posOnlyVarArgsKwOnlyMixedCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS)

  rule posOnlyVarArgsKwOnlyMixedCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Rest, KwOnly)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool varArgsMixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posOnlyVarArgsKwOnlyKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    posOnlyVarArgsKwOnlyMixedDefaultsCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS, Defaults, KwDefaults)

  rule posOnlyVarArgsKwOnlyMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Rest, KwOnly)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), takeArgVals(VS, idItemsLen(concatIdItems(Pos, Rest))), KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posOnlyVarArgsKwOnlyKwArgsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    posOnlyVarArgsKwOnlyKwArgsMixedCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS)

  rule posOnlyVarArgsKwOnlyKwArgsMixedCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool varArgsMixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posOnlyVarArgsKwOnlyKwArgsKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    posOnlyVarArgsKwOnlyKwArgsMixedDefaultsCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS, Defaults, KwDefaults)

  rule posOnlyVarArgsKwOnlyKwArgsMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool varArgsMixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), takeArgVals(VS, idItemsLen(concatIdItems(Pos, Rest))), KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posOnlyKwOnlyKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    posOnlyKwOnlyMixedCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS)

  rule posOnlyKwOnlyMixedCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) >=Int idItemsLen(Pos)
      andBool argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Rest, KwOnly)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posOnlyKwOnlyArgsDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    posOnlyKwOnlyMixedDefaultsCallArityOk(Pos, Rest, KwOnly, VS, #noKwArgVals, Defaults, KwDefaults)

  rule posOnlyKwOnlyKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    posOnlyKwOnlyMixedDefaultsCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS, Defaults, KwDefaults)

  rule posOnlyKwOnlyMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Rest, KwOnly)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posOnlyKwOnlyKwArgsKeywordCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    posOnlyKwOnlyKwArgsMixedCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS)

  rule posOnlyKwOnlyKwArgsMixedCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, #noArgVals)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posOnlyKwOnlyKwArgsKeywordDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    posOnlyKwOnlyKwArgsMixedDefaultsCallArityOk(Pos, Rest, KwOnly, #noArgVals, KWS, Defaults, KwDefaults)

  rule posOnlyKwOnlyKwArgsMixedDefaultsCallArityOk(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(Defaults) <=Int idItemsLen(concatIdItems(Pos, Rest))
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS)
      andBool mixedRequiredPresent(concatIdItems(Pos, Rest), VS, KWS, Defaults)
      andBool posOnlyRequiredCovered(Pos, Rest, VS, Defaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posOnlyRequiredCovered(Pos:IdItems, Rest:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    ((idItemsLen(concatIdItems(Pos, Rest)) -Int argValsLen(Defaults) <=Int idItemsLen(Pos))
      andBool argValsLen(VS) >=Int idItemsLen(concatIdItems(Pos, Rest)) -Int argValsLen(Defaults))
    orBool
    ((idItemsLen(concatIdItems(Pos, Rest)) -Int argValsLen(Defaults) >Int idItemsLen(Pos))
      andBool argValsLen(VS) >=Int idItemsLen(Pos))

  rule sameIdValArity(idItemsLast(_:Id), valItemsLast(_:Val)) => true
  rule sameIdValArity(idItemsLast(_:Id), valItemsCons(_:Val, _:ValItems)) => false
  rule sameIdValArity(idItemsCons(_:Id, _:IdItems), valItemsLast(_:Val)) => false
  rule sameIdValArity(idItemsCons(_:Id, IDS:IdItems), valItemsCons(_:Val, VS:ValItems)) =>
    sameIdValArity(IDS, VS)

  rule sameTargetsValArity(targetsLast(T:Target), valItemsLast(V:Val)) =>
    targetValueArityOk(T, V)
  rule sameTargetsValArity(targetsLast(_:Target), valItemsCons(_:Val, _:ValItems)) => false
  rule sameTargetsValArity(targetsCons(_:Target, _:Targets), valItemsLast(_:Val)) => false
  rule sameTargetsValArity(targetsCons(T:Target, TS:Targets), valItemsCons(V:Val, VS:ValItems)) =>
    targetValueArityOk(T, V) andBool sameTargetsValArity(TS, VS)

  rule targetValueArityOk(targetName(_:Id), _:Val) => true
  rule targetValueArityOk(targetSeq(TS:Targets), listVal(VS:ValItems)) =>
    sameTargetsValArity(TS, VS)
  rule targetValueArityOk(targetSeq(_:Targets), []) => false
  rule targetValueArityOk(targetSeq(TS:Targets), tupleVal(VS:ValItems)) =>
    sameTargetsValArity(TS, VS)
  rule targetValueArityOk(targetSeq(_:Targets), ()) => false
  rule targetValueArityOk(targetSeq(TS:Targets), bytesVal(VS:ValItems)) =>
    sameTargetsValArity(TS, VS)
  rule targetValueArityOk(targetSeq(_:Targets), #bytes()) => false
  rule targetValueArityOk(targetSeq(TS:Targets), S:String) =>
    sameTargetsValArity(TS, stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule targetValueArityOk(targetSeq(_:Targets), S:String) => false
    requires lengthString(S) ==Int 0
  rule targetValueArityOk(targetSeq(_:Targets), ({}):Val) => false
  rule targetValueArityOk(targetSeq(TS:Targets), dictVal(DS:DictItems)) =>
    sameTargetsValArity(TS, dictKeysToValItems(DS))
  rule targetValueArityOk(targetSeq(TS:Targets), setVal(VS:ValItems)) =>
    sameTargetsValArity(TS, VS)
  rule targetValueArityOk(targetSeq(_:Targets), set()) => false
  rule targetValueArityOk(targetSeq(TS:Targets), rangeVal(Start:Int, Stop:Int)) =>
    sameTargetsValArity(TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule targetValueArityOk(targetSeq(_:Targets), rangeVal(Start:Int, Stop:Int)) => false
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule targetValueArityOk(targetSeq(TS:Targets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    sameTargetsValArity(TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule targetValueArityOk(targetSeq(_:Targets), rangeVal(Start:Int, Stop:Int, Step:Int)) => false
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), listVal(VS:ValItems)) =>
    targetStarSeqArityOk(Prefix, Suffix, VS)
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), []) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), tupleVal(VS:ValItems)) =>
    targetStarSeqArityOk(Prefix, Suffix, VS)
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), ()) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), bytesVal(VS:ValItems)) =>
    targetStarSeqArityOk(Prefix, Suffix, VS)
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), #bytes()) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), S:String) =>
    targetStarSeqArityOk(Prefix, Suffix, stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), S:String) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
    requires lengthString(S) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), ({}):Val) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), dictVal(DS:DictItems)) =>
    targetStarSeqArityOk(Prefix, Suffix, dictKeysToValItems(DS))
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), setVal(VS:ValItems)) =>
    targetStarSeqArityOk(Prefix, Suffix, VS)
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), set()) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int)) =>
    targetStarSeqArityOk(Prefix, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int)) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    targetStarSeqArityOk(Prefix, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule targetValueArityOk(targetStarSeq(Prefix:MaybeTargets, _:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule targetValueArityOk(targetSeq(_:Targets), _:Val) => false
    [owise]
  rule targetValueArityOk(targetStarSeq(_:MaybeTargets, _:Id, _:MaybeTargets), _:Val) => false
    [owise]

  rule targetStarSeqArityOk(Prefix:MaybeTargets, Suffix:MaybeTargets, VS:ValItems) =>
    maybeTargetsPrefixArityOk(Prefix, VS) andBool maybeTargetsSuffixArityOk(Suffix, VS)
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) <=Int valItemsLen(VS)
  rule targetStarSeqArityOk(Prefix:MaybeTargets, Suffix:MaybeTargets, VS:ValItems) => false
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) >Int valItemsLen(VS)

  rule maybeTargetsPrefixArityOk(#noTargets, _:ValItems) => true
  rule maybeTargetsPrefixArityOk(#targets(TS:Targets), VS:ValItems) =>
    sameTargetsValArity(TS, sliceValItems(VS, 0, targetsLen(TS)))

  rule maybeTargetsSuffixArityOk(#noTargets, _:ValItems) => true
  rule maybeTargetsSuffixArityOk(#targets(TS:Targets), VS:ValItems) =>
    sameTargetsValArity(TS, dropValItems(VS, valItemsLen(VS) -Int targetsLen(TS)))

  rule starUnpackArityOk(Prefix:IdItems, Suffix:IdItems, Len:Int) =>
    idItemsLen(Prefix) +Int idItemsLen(Suffix) <=Int Len

  rule defaultsCallArityOk(IDS:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(IDS)
      andBool idItemsLen(IDS) -Int argValsLen(VS) <=Int argValsLen(Defaults)
      andBool argValsLen(Defaults) <=Int idItemsLen(IDS)

  rule keywordOnlyCallArityOk(IDS:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, IDS)
      andBool kwRequiredPresent(IDS, KWS, Defaults)
      andBool argValsLen(Defaults) <=Int idItemsLen(IDS)

  rule mixedCallArityOk(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(IDS)
      andBool argValsLen(Defaults) <=Int idItemsLen(IDS)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, IDS)
      andBool mixedNoPosKeyword(IDS, VS, KWS)
      andBool mixedRequiredPresent(IDS, VS, KWS, Defaults)

  rule posKwOnlyKeywordCallArityOk(Pos:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Pos, KwOnly)
      andBool kwRequiredPresent(Pos, KWS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posKwOnlyMixedCallArityOk(Pos:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) <=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Pos, KwOnly)
      andBool mixedNoPosKeyword(Pos, VS, KWS)
      andBool mixedRequiredPresent(Pos, VS, KWS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posKwOnlyArgsDefaultsCallArityOk(Pos:IdItems, KwOnly:IdItems, VS:ArgVals, PosDefaults:ArgVals, KwDefaults:ArgVals) =>
    defaultsCallArityOk(Pos, VS, PosDefaults)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwRequiredPresent(KwOnly, #noKwArgVals, KwDefaults)

  rule posKwOnlyKeywordDefaultsCallArityOk(Pos:IdItems, KwOnly:IdItems, KWS:KwArgVals, PosDefaults:ArgVals, KwDefaults:ArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Pos, KwOnly)
      andBool argValsLen(PosDefaults) <=Int idItemsLen(Pos)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwRequiredPresent(Pos, KWS, PosDefaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posKwOnlyMixedDefaultsCallArityOk(Pos:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, PosDefaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(Pos)
      andBool argValsLen(PosDefaults) <=Int idItemsLen(Pos)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInEitherIds(KWS, Pos, KwOnly)
      andBool mixedNoPosKeyword(Pos, VS, KWS)
      andBool mixedRequiredPresent(Pos, VS, KWS, PosDefaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posKwOnlyKwArgsKeywordCallArityOk(Pos:IdItems, KwOnly:IdItems, KWS:KwArgVals) =>
    kwNoDuplicates(KWS)
      andBool kwRequiredPresent(Pos, KWS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posKwOnlyKwArgsMixedCallArityOk(Pos:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    argValsLen(VS) <=Int idItemsLen(Pos)
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Pos, VS, KWS)
      andBool mixedRequiredPresent(Pos, VS, KWS, #noArgVals)
      andBool kwRequiredPresent(KwOnly, KWS, #noArgVals)

  rule posKwOnlyKwArgsKeywordDefaultsCallArityOk(Pos:IdItems, KwOnly:IdItems, KWS:KwArgVals, PosDefaults:ArgVals, KwDefaults:ArgVals) =>
    kwNoDuplicates(KWS)
      andBool argValsLen(PosDefaults) <=Int idItemsLen(Pos)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwRequiredPresent(Pos, KWS, PosDefaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule posKwOnlyKwArgsMixedDefaultsCallArityOk(Pos:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, PosDefaults:ArgVals, KwDefaults:ArgVals) =>
    argValsLen(VS) <=Int idItemsLen(Pos)
      andBool argValsLen(PosDefaults) <=Int idItemsLen(Pos)
      andBool argValsLen(KwDefaults) <=Int idItemsLen(KwOnly)
      andBool kwNoDuplicates(KWS)
      andBool mixedNoPosKeyword(Pos, VS, KWS)
      andBool mixedRequiredPresent(Pos, VS, KWS, PosDefaults)
      andBool kwRequiredPresent(KwOnly, KWS, KwDefaults)

  rule emptyArgVals(#noArgVals) => true
  rule emptyArgVals(argValsCons(_:Val, _:ArgVals)) => false

  rule emptyKwArgVals(#noKwArgVals) => true
  rule emptyKwArgVals(kwArgValsCons(_:Id, _:Val, _:KwArgVals)) => false
  rule emptyKwArgVals(kwArgStringValsCons(_:String, _:Val, _:KwArgVals)) => false

  rule emptyDictVals(#noDictVals) => true
  rule emptyDictVals(dictValsCons(_:Val, _:Val, _:DictVals)) => false

  rule idContains(_:Id, #noIds) => false
  rule idContains(X:Id, idItemsLast(X)) => true
  rule idContains(_X:Id, idItemsLast(_Y:Id)) => false
    [owise]
  rule idContains(X:Id, idItemsCons(X, _:IdItems)) => true
  rule idContains(X:Id, idItemsCons(_Y:Id, IDS:IdItems)) => idContains(X, IDS)
    [owise]

  rule stringIdContains(_:String, #noIds) => false
  rule stringIdContains(S:String, idItemsLast(X:Id)) => S ==String Id2String(X)
  rule stringIdContains(S:String, idItemsCons(X:Id, IDS:IdItems)) =>
    S ==String Id2String(X) orBool stringIdContains(S, IDS)

  rule kwContains(_:Id, #noKwArgVals) => false
  rule kwContains(X:Id, kwArgValsCons(X, _:Val, _:KwArgVals)) => true
  rule kwContains(X:Id, kwArgValsCons(_Y:Id, _:Val, KWS:KwArgVals)) => kwContains(X, KWS)
    [owise]
  rule kwContains(X:Id, kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals)) =>
    Id2String(X) ==String S orBool kwContains(X, KWS)

  rule kwStringContains(_:String, #noKwArgVals) => false
  rule kwStringContains(S:String, kwArgValsCons(X:Id, _:Val, KWS:KwArgVals)) =>
    S ==String Id2String(X) orBool kwStringContains(S, KWS)
  rule kwStringContains(S:String, kwArgStringValsCons(S, _:Val, _:KwArgVals)) => true
  rule kwStringContains(S:String, kwArgStringValsCons(_T:String, _:Val, KWS:KwArgVals)) => kwStringContains(S, KWS)
    [owise]

  rule kwLookup(X:Id, kwArgValsCons(X, V:Val, _:KwArgVals)) => V
  rule kwLookup(X:Id, kwArgValsCons(_Y:Id, _:Val, KWS:KwArgVals)) => kwLookup(X, KWS)
    [owise]
  rule kwLookup(X:Id, kwArgStringValsCons(S:String, V:Val, _:KwArgVals)) => V
    requires Id2String(X) ==String S
  rule kwLookup(X:Id, kwArgStringValsCons(_S:String, _:Val, KWS:KwArgVals)) => kwLookup(X, KWS)
    [owise]

  rule kwNoDuplicates(#noKwArgVals) => true
  rule kwNoDuplicates(kwArgValsCons(X:Id, _:Val, KWS:KwArgVals)) =>
    notBool kwContains(X, KWS) andBool kwNoDuplicates(KWS)
  rule kwNoDuplicates(kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals)) =>
    notBool kwStringContains(S, KWS) andBool kwNoDuplicates(KWS)

  rule kwAllInIds(#noKwArgVals, _:IdItems) => true
  rule kwAllInIds(kwArgValsCons(X:Id, _:Val, KWS:KwArgVals), IDS:IdItems) =>
    idContains(X, IDS) andBool kwAllInIds(KWS, IDS)
  rule kwAllInIds(kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals), IDS:IdItems) =>
    stringIdContains(S, IDS) andBool kwAllInIds(KWS, IDS)

  rule kwAllInEitherIds(#noKwArgVals, _:IdItems, _:IdItems) => true
  rule kwAllInEitherIds(kwArgValsCons(X:Id, _:Val, KWS:KwArgVals), Pos:IdItems, KwOnly:IdItems) =>
    (idContains(X, Pos) orBool idContains(X, KwOnly)) andBool kwAllInEitherIds(KWS, Pos, KwOnly)
  rule kwAllInEitherIds(kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals), Pos:IdItems, KwOnly:IdItems) =>
    (stringIdContains(S, Pos) orBool stringIdContains(S, KwOnly)) andBool kwAllInEitherIds(KWS, Pos, KwOnly)

  rule isKwDefaultMissing(#kwDefaultMissing) => true
  rule isKwDefaultMissing(_:Val) => false
    [owise]

  rule hasKwDefaultMissing(#noArgVals) => false
  rule hasKwDefaultMissing(argValsCons(V:Val, VS:ArgVals)) =>
    isKwDefaultMissing(V) orBool hasKwDefaultMissing(VS)

  rule kwRequiredPresent(#noIds, _:KwArgVals, _:ArgVals) => true
  rule kwRequiredPresent(idItemsLast(X:Id), KWS:KwArgVals, #noArgVals) => kwContains(X, KWS)
  rule kwRequiredPresent(IDS:IdItems, _:KwArgVals, Defaults:ArgVals) => true
    requires idItemsLen(IDS) <=Int argValsLen(Defaults)
      andBool notBool hasKwDefaultMissing(Defaults)
  rule kwRequiredPresent(IDS:IdItems, KWS:KwArgVals, Defaults:ArgVals) =>
    kwRequiredAlignedPresent(IDS, KWS, Defaults)
    requires idItemsLen(IDS) ==Int argValsLen(Defaults)
      andBool hasKwDefaultMissing(Defaults)
  rule kwRequiredPresent(idItemsCons(X:Id, IDS:IdItems), KWS:KwArgVals, Defaults:ArgVals) =>
    kwContains(X, KWS) andBool kwRequiredPresent(IDS, KWS, Defaults)
    requires idItemsLen(idItemsCons(X, IDS)) >Int argValsLen(Defaults)

  rule kwRequiredAlignedPresent(#noIds, _:KwArgVals, #noArgVals) => true
  rule kwRequiredAlignedPresent(idItemsLast(X:Id), KWS:KwArgVals, argValsCons(Default:Val, #noArgVals)) =>
    kwContains(X, KWS)
    requires isKwDefaultMissing(Default)
  rule kwRequiredAlignedPresent(idItemsLast(_:Id), _:KwArgVals, argValsCons(Default:Val, #noArgVals)) => true
    requires notBool isKwDefaultMissing(Default)
  rule kwRequiredAlignedPresent(idItemsCons(X:Id, IDS:IdItems), KWS:KwArgVals, argValsCons(Default:Val, Defaults:ArgVals)) =>
    ((notBool isKwDefaultMissing(Default)) orBool kwContains(X, KWS))
      andBool kwRequiredAlignedPresent(IDS, KWS, Defaults)

  rule mixedNoPosKeyword(#noIds, argValsCons(_:Val, _:ArgVals), _:KwArgVals) => false
  rule mixedNoPosKeyword(_:IdItems, #noArgVals, _:KwArgVals) => true
  rule mixedNoPosKeyword(idItemsLast(X:Id), argValsCons(_:Val, #noArgVals), KWS:KwArgVals) =>
    notBool kwContains(X, KWS)
  rule mixedNoPosKeyword(idItemsLast(_:Id), argValsCons(_:Val, argValsCons(_:Val, _:ArgVals)), _:KwArgVals) =>
    false
  rule mixedNoPosKeyword(idItemsCons(X:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals), KWS:KwArgVals) =>
    notBool kwContains(X, KWS) andBool mixedNoPosKeyword(IDS, VS, KWS)

  rule mixedRequiredPresent(#noIds, argValsCons(_:Val, _:ArgVals), _:KwArgVals, _:ArgVals) => false
  rule mixedRequiredPresent(IDS:IdItems, #noArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    kwRequiredPresent(IDS, KWS, Defaults)
  rule mixedRequiredPresent(idItemsLast(_:Id), argValsCons(_:Val, #noArgVals), _:KwArgVals, _:ArgVals) =>
    true
  rule mixedRequiredPresent(idItemsLast(_:Id), argValsCons(_:Val, argValsCons(_:Val, _:ArgVals)), _:KwArgVals, _:ArgVals) =>
    false
  rule mixedRequiredPresent(idItemsCons(X:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals), KWS:KwArgVals, Defaults:ArgVals) =>
    mixedRequiredPresent(IDS, VS, KWS, Defaults)
    requires idItemsLen(idItemsCons(X, IDS)) >Int argValsLen(Defaults)
  rule mixedRequiredPresent(idItemsCons(X:Id, IDS:IdItems), argValsCons(_:Val, VS:ArgVals), KWS:KwArgVals, argValsCons(_:Val, Defaults:ArgVals)) =>
    mixedRequiredPresent(IDS, VS, KWS, Defaults)
    requires idItemsLen(idItemsCons(X, IDS)) ==Int 1 +Int argValsLen(Defaults)

  rule appendArgVal(#noArgVals, V:Val) => argValsCons(V, #noArgVals)
  rule appendArgVal(argValsCons(V0:Val, VS:ArgVals), V:Val) =>
    argValsCons(V0, appendArgVal(VS, V))

  rule concatArgVals(#noArgVals, VS:ArgVals) => VS
  rule concatArgVals(argValsCons(V:Val, VS1:ArgVals), VS2:ArgVals) =>
    argValsCons(V, concatArgVals(VS1, VS2))

  rule reverseArgVals(VS:ArgVals) => reverseArgVals(VS, #noArgVals)
  rule reverseArgVals(#noArgVals, Acc:ArgVals) => Acc
  rule reverseArgVals(argValsCons(V:Val, VS:ArgVals), Acc:ArgVals) =>
    reverseArgVals(VS, argValsCons(V, Acc))

  rule dropArgVals(VS:ArgVals, 0) => VS
  rule dropArgVals(#noArgVals, N:Int) => #noArgVals
    requires N >Int 0
  rule dropArgVals(argValsCons(_:Val, VS:ArgVals), N:Int) => dropArgVals(VS, N -Int 1)
    requires N >Int 0

  rule takeArgVals(_:ArgVals, 0) => #noArgVals
  rule takeArgVals(#noArgVals, N:Int) => #noArgVals
    requires N >Int 0
  rule takeArgVals(argValsCons(V:Val, VS:ArgVals), N:Int) =>
    argValsCons(V, takeArgVals(VS, N -Int 1))
    requires N >Int 0

  rule varArgTail(VS:ArgVals, 0) => VS
  rule varArgTail(#noArgVals, N:Int) => #noArgVals
    requires N >Int 0
  rule varArgTail(argValsCons(_:Val, VS:ArgVals), N:Int) => varArgTail(VS, N -Int 1)
    requires N >Int 0

  rule completeVarArgsDefaultArgs(IDS:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    concatArgVals(completeDefaultArgs(IDS, takeArgVals(VS, idItemsLen(IDS)), Defaults), varArgTail(VS, idItemsLen(IDS)))
    requires varArgsDefaultsCallArityOk(IDS, VS, Defaults)

  rule buildVarArgsMixedPosArgs(#noIds, _:ArgVals, _:KwArgVals) => #noArgVals
  rule buildVarArgsMixedPosArgs(idItemsLast(X:Id), #noArgVals, KWS:KwArgVals) =>
    argValsCons(kwLookup(X, KWS), #noArgVals)
    requires kwContains(X, KWS)
  rule buildVarArgsMixedPosArgs(idItemsLast(_:Id), argValsCons(V:Val, _:ArgVals), _:KwArgVals) =>
    argValsCons(V, #noArgVals)
  rule buildVarArgsMixedPosArgs(idItemsCons(X:Id, IDS:IdItems), #noArgVals, KWS:KwArgVals) =>
    argValsCons(kwLookup(X, KWS), buildVarArgsMixedPosArgs(IDS, #noArgVals, KWS))
    requires kwContains(X, KWS)
  rule buildVarArgsMixedPosArgs(idItemsCons(_:Id, IDS:IdItems), argValsCons(V:Val, VS:ArgVals), KWS:KwArgVals) =>
    argValsCons(V, buildVarArgsMixedPosArgs(IDS, VS, KWS))

  rule buildVarArgsMixedDefaultArgs(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    concatArgVals(buildMixedDefaultArgs(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults), varArgTail(VS, idItemsLen(IDS)))
    requires varArgsMixedDefaultsCallArityOk(IDS, VS, KWS, Defaults)

  rule buildVarKwArgsMixedDefaultArgs(IDS:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    concatArgVals(buildMixedDefaultArgs(IDS, takeArgVals(VS, idItemsLen(IDS)), KWS, Defaults), varArgTail(VS, idItemsLen(IDS)))
    requires varKwArgsDefaultsMixedCallArityOk(IDS, VS, KWS, Defaults)

  rule defaultsForPosOnlyPrefix(_:IdItems, Rest:IdItems, Defaults:ArgVals) => #noArgVals
    requires argValsLen(Defaults) <=Int idItemsLen(Rest)
  rule defaultsForPosOnlyPrefix(_:IdItems, Rest:IdItems, Defaults:ArgVals) =>
    takeArgVals(Defaults, argValsLen(Defaults) -Int idItemsLen(Rest))
    requires argValsLen(Defaults) >Int idItemsLen(Rest)

  rule defaultsForPosOnlyRest(_:IdItems, Rest:IdItems, Defaults:ArgVals) => Defaults
    requires argValsLen(Defaults) <=Int idItemsLen(Rest)
  rule defaultsForPosOnlyRest(_:IdItems, Rest:IdItems, Defaults:ArgVals) =>
    dropArgVals(Defaults, argValsLen(Defaults) -Int idItemsLen(Rest))
    requires argValsLen(Defaults) >Int idItemsLen(Rest)

  rule buildPosOnlyKwArgs(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    concatArgVals(
      completeDefaultArgs(Pos, takeArgVals(VS, idItemsLen(Pos)), defaultsForPosOnlyPrefix(Pos, Rest, Defaults)),
      buildMixedDefaultArgs(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS, defaultsForPosOnlyRest(Pos, Rest, Defaults)))
    requires posOnlyKwArgsMixedDefaultsCallArityOk(Pos, Rest, VS, KWS, Defaults)

  rule buildPosOnlyVarKwArgs(Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    concatArgVals(
      concatArgVals(
        completeDefaultArgs(Pos, takeArgVals(VS, idItemsLen(Pos)), defaultsForPosOnlyPrefix(Pos, Rest, Defaults)),
        buildMixedDefaultArgs(Rest, dropArgVals(takeArgVals(VS, idItemsLen(concatIdItems(Pos, Rest))), idItemsLen(Pos)), KWS, defaultsForPosOnlyRest(Pos, Rest, Defaults))),
      varArgTail(VS, idItemsLen(concatIdItems(Pos, Rest))))
    requires posOnlyVarKwArgsMixedDefaultsCallArityOk(Pos, Rest, VS, KWS, Defaults)

  rule buildPosOnlyKwOnlyPosArgs(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    concatArgVals(
      completeDefaultArgs(Pos, takeArgVals(VS, idItemsLen(Pos)), defaultsForPosOnlyPrefix(Pos, Rest, Defaults)),
      buildMixedDefaultArgs(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS, defaultsForPosOnlyRest(Pos, Rest, Defaults)))
    requires posOnlyKwOnlyMixedDefaultsCallArityOk(Pos, Rest, KwOnly, VS, KWS, Defaults, KwDefaults)

  rule buildPosOnlyKwOnlyKwArgsPosArgs(Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, Defaults:ArgVals, KwDefaults:ArgVals) =>
    concatArgVals(
      completeDefaultArgs(Pos, takeArgVals(VS, idItemsLen(Pos)), defaultsForPosOnlyPrefix(Pos, Rest, Defaults)),
      buildMixedDefaultArgs(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS, defaultsForPosOnlyRest(Pos, Rest, Defaults)))
    requires posOnlyKwOnlyKwArgsMixedDefaultsCallArityOk(Pos, Rest, KwOnly, VS, KWS, Defaults, KwDefaults)

  rule valItemsToArgVals(valItemsLast(V:Val)) => argValsCons(V, #noArgVals)
  rule valItemsToArgVals(valItemsCons(V:Val, VS:ValItems)) =>
    argValsCons(V, valItemsToArgVals(VS))

  rule iterableArgVals([]) => #noArgVals
  rule iterableArgVals(listVal(VS:ValItems)) => valItemsToArgVals(VS)
  rule iterableArgVals(()) => #noArgVals
  rule iterableArgVals(tupleVal(VS:ValItems)) => valItemsToArgVals(VS)
  rule iterableArgVals(S:String) => #noArgVals
    requires lengthString(S) ==Int 0
  rule iterableArgVals(S:String) => valItemsToArgVals(stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule iterableArgVals(#bytes()) => #noArgVals
  rule iterableArgVals(bytesVal(VS:ValItems)) => valItemsToArgVals(VS)
  rule iterableArgVals(({}):Val) => #noArgVals
  rule iterableArgVals(dictVal(DS:DictItems)) => valItemsToArgVals(dictKeysToValItems(DS))
  rule iterableArgVals(set()) => #noArgVals
  rule iterableArgVals(setVal(VS:ValItems)) => valItemsToArgVals(VS)
  rule iterableArgVals(rangeVal(Start:Int, Stop:Int)) => #noArgVals
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule iterableArgVals(rangeVal(Start:Int, Stop:Int)) =>
    valItemsToArgVals(rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule iterableArgVals(rangeVal(Start:Int, Stop:Int, Step:Int)) => #noArgVals
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule iterableArgVals(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    valItemsToArgVals(rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule completeDefaultArgs(IDS:IdItems, VS:ArgVals, Defaults:ArgVals) =>
    concatArgVals(
      VS,
      dropArgVals(
        Defaults,
        argValsLen(Defaults) -Int (idItemsLen(IDS) -Int argValsLen(VS))))
    requires defaultsCallArityOk(IDS, VS, Defaults)

  rule appendKwArgVal(#noKwArgVals, X:Id, V:Val) => kwArgValsCons(X, V, #noKwArgVals)
  rule appendKwArgVal(kwArgValsCons(X0:Id, V0:Val, KWS:KwArgVals), X:Id, V:Val) =>
    kwArgValsCons(X0, V0, appendKwArgVal(KWS, X, V))
  rule appendKwArgVal(kwArgStringValsCons(S0:String, V0:Val, KWS:KwArgVals), X:Id, V:Val) =>
    kwArgStringValsCons(S0, V0, appendKwArgVal(KWS, X, V))

  rule appendKwStringArgVal(#noKwArgVals, S:String, V:Val) => kwArgStringValsCons(S, V, #noKwArgVals)
  rule appendKwStringArgVal(kwArgValsCons(X0:Id, V0:Val, KWS:KwArgVals), S:String, V:Val) =>
    kwArgValsCons(X0, V0, appendKwStringArgVal(KWS, S, V))
  rule appendKwStringArgVal(kwArgStringValsCons(S0:String, V0:Val, KWS:KwArgVals), S:String, V:Val) =>
    kwArgStringValsCons(S0, V0, appendKwStringArgVal(KWS, S, V))

  rule appendKwUnpack(KWS:KwArgVals, ({}):Val) => KWS
  rule appendKwUnpack(KWS:KwArgVals, dictVal(DS:DictItems)) => appendKwDictItems(KWS, DS)

  rule appendKwDictItems(KWS:KwArgVals, dictItemsLast(S:String, V:Val)) =>
    appendKwStringArgVal(KWS, S, V)
  rule appendKwDictItems(KWS:KwArgVals, dictItemsCons(S:String, V:Val, DS:DictItems)) =>
    appendKwDictItems(appendKwStringArgVal(KWS, S, V), DS)

  rule buildKwDefaultArgs(#noIds, _:KwArgVals, _:ArgVals) => #noArgVals
  rule buildKwDefaultArgs(idItemsLast(X:Id), KWS:KwArgVals, #noArgVals) =>
    argValsCons(kwLookup(X, KWS), #noArgVals)
    requires kwContains(X, KWS)
  rule buildKwDefaultArgs(idItemsLast(X:Id), KWS:KwArgVals, argValsCons(_Default:Val, #noArgVals)) =>
    argValsCons(kwLookup(X, KWS), #noArgVals)
    requires kwContains(X, KWS)
  rule buildKwDefaultArgs(idItemsLast(X:Id), KWS:KwArgVals, argValsCons(Default:Val, #noArgVals)) =>
    argValsCons(Default, #noArgVals)
    requires notBool kwContains(X, KWS)
      andBool notBool isKwDefaultMissing(Default)
  rule buildKwDefaultArgs(idItemsCons(X:Id, IDS:IdItems), KWS:KwArgVals, Defaults:ArgVals) =>
    argValsCons(kwLookup(X, KWS), buildKwDefaultArgs(IDS, KWS, Defaults))
    requires idItemsLen(idItemsCons(X, IDS)) >Int argValsLen(Defaults)
      andBool kwContains(X, KWS)
  rule buildKwDefaultArgs(idItemsCons(X:Id, IDS:IdItems), KWS:KwArgVals, argValsCons(Default:Val, Defaults:ArgVals)) =>
    argValsCons(kwLookup(X, KWS), buildKwDefaultArgs(IDS, KWS, Defaults))
    requires idItemsLen(idItemsCons(X, IDS)) ==Int argValsLen(argValsCons(Default, Defaults))
      andBool kwContains(X, KWS)
  rule buildKwDefaultArgs(idItemsCons(X:Id, IDS:IdItems), KWS:KwArgVals, argValsCons(Default:Val, Defaults:ArgVals)) =>
    argValsCons(Default, buildKwDefaultArgs(IDS, KWS, Defaults))
    requires idItemsLen(idItemsCons(X, IDS)) ==Int argValsLen(argValsCons(Default, Defaults))
      andBool notBool kwContains(X, KWS)
      andBool notBool isKwDefaultMissing(Default)

  rule buildMixedDefaultArgs(IDS:IdItems, #noArgVals, KWS:KwArgVals, Defaults:ArgVals) =>
    buildKwDefaultArgs(IDS, KWS, Defaults)
  rule buildMixedDefaultArgs(idItemsLast(_:Id), argValsCons(V:Val, #noArgVals), _:KwArgVals, _:ArgVals) =>
    argValsCons(V, #noArgVals)
  rule buildMixedDefaultArgs(idItemsCons(X:Id, IDS:IdItems), argValsCons(V:Val, VS:ArgVals), KWS:KwArgVals, Defaults:ArgVals) =>
    argValsCons(V, buildMixedDefaultArgs(IDS, VS, KWS, Defaults))
    requires idItemsLen(idItemsCons(X, IDS)) >Int argValsLen(Defaults)
  rule buildMixedDefaultArgs(idItemsCons(X:Id, IDS:IdItems), argValsCons(V:Val, VS:ArgVals), KWS:KwArgVals, argValsCons(_:Val, Defaults:ArgVals)) =>
    argValsCons(V, buildMixedDefaultArgs(IDS, VS, KWS, Defaults))
    requires idItemsLen(idItemsCons(X, IDS)) ==Int 1 +Int argValsLen(Defaults)

  rule kwExtrasDict(KWS:KwArgVals, IDS:IdItems) => ({}):Val
    requires emptyDictVals(kwExtrasDictVals(KWS, IDS))
  rule kwExtrasDict(KWS:KwArgVals, IDS:IdItems) => dictVal(dictValsToDictItems(kwExtrasDictVals(KWS, IDS)))
    requires notBool emptyDictVals(kwExtrasDictVals(KWS, IDS))

  rule kwExtrasEitherDict(KWS:KwArgVals, IDS1:IdItems, IDS2:IdItems) => ({}):Val
    requires emptyDictVals(kwExtrasEitherDictVals(KWS, IDS1, IDS2))
  rule kwExtrasEitherDict(KWS:KwArgVals, IDS1:IdItems, IDS2:IdItems) => dictVal(dictValsToDictItems(kwExtrasEitherDictVals(KWS, IDS1, IDS2)))
    requires notBool emptyDictVals(kwExtrasEitherDictVals(KWS, IDS1, IDS2))

  rule dictFromDictVals(DVS:DictVals) => ({}):Val
    requires emptyDictVals(DVS)
  rule dictFromDictVals(DVS:DictVals) => dictVal(dictValsToDictItems(DVS))
    requires notBool emptyDictVals(DVS)

  rule dictCtorFromKwArgs(KWS:KwArgVals) => dictFromDictVals(appendKwDictVals(#noDictVals, KWS))

  rule dictCtorMergeKw(({}):Val, KWS:KwArgVals) => dictCtorFromKwArgs(KWS)
  rule dictCtorMergeKw(dictVal(DS:DictItems), KWS:KwArgVals) =>
    dictFromDictVals(appendKwDictVals(appendDictItems(#noDictVals, DS), KWS))
  rule dictCtorMergeKw([], KWS:KwArgVals) => dictCtorFromKwArgs(KWS)
  rule dictCtorMergeKw(listVal(VS:ValItems), KWS:KwArgVals) =>
    dictFromDictVals(appendKwDictVals(dictCtorPairs(VS, #noDictVals), KWS))
  rule dictCtorMergeKw((), KWS:KwArgVals) => dictCtorFromKwArgs(KWS)
  rule dictCtorMergeKw(tupleVal(VS:ValItems), KWS:KwArgVals) =>
    dictFromDictVals(appendKwDictVals(dictCtorPairs(VS, #noDictVals), KWS))

  rule complexCtorRealArg(KWS:KwArgVals) => kwLookup(#token("real", "Id"), KWS)
    requires kwContains(#token("real", "Id"), KWS)
  rule complexCtorRealArg(KWS:KwArgVals) => 0
    requires notBool kwContains(#token("real", "Id"), KWS)

  rule complexCtorImagArg(KWS:KwArgVals) => kwLookup(#token("imag", "Id"), KWS)
    requires kwContains(#token("imag", "Id"), KWS)
  rule complexCtorImagArg(KWS:KwArgVals) => 0
    requires notBool kwContains(#token("imag", "Id"), KWS)

  rule complexCtorFromKwArgs(KWS:KwArgVals) =>
    #complex(
      complexReal(complexCtorRealArg(KWS)) -Float complexImag(complexCtorImagArg(KWS)),
      complexImag(complexCtorRealArg(KWS)) +Float complexReal(complexCtorImagArg(KWS)))
    requires kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, idItemsCons(#token("real", "Id"), idItemsLast(#token("imag", "Id"))))
      andBool isComplexLike(complexCtorRealArg(KWS))
      andBool isComplexLike(complexCtorImagArg(KWS))

  rule complexCtorMergeKw(Base:Val, #noKwArgVals) =>
    #complex(complexReal(Base), complexImag(Base))
    requires isComplexLike(Base)
  rule complexCtorMergeKw(Base:Val, KWS:KwArgVals) =>
    #complex(
      complexReal(Base) -Float complexImag(complexCtorImagArg(KWS)),
      complexImag(Base) +Float complexReal(complexCtorImagArg(KWS)))
    requires notBool emptyKwArgVals(KWS)
      andBool kwNoDuplicates(KWS)
      andBool kwAllInIds(KWS, idItemsLast(#token("imag", "Id")))
      andBool isComplexLike(Base)
      andBool isComplexLike(complexCtorImagArg(KWS))

  rule appendKwDictVals(DVS:DictVals, #noKwArgVals) => DVS
  rule appendKwDictVals(DVS:DictVals, kwArgValsCons(X:Id, V:Val, KWS:KwArgVals)) =>
    appendKwDictVals(appendDictVal(DVS, Id2String(X), V), KWS)
  rule appendKwDictVals(DVS:DictVals, kwArgStringValsCons(S:String, V:Val, KWS:KwArgVals)) =>
    appendKwDictVals(appendDictVal(DVS, S, V), KWS)

  rule kwExtrasDictVals(#noKwArgVals, _:IdItems) => #noDictVals
  rule kwExtrasDictVals(kwArgValsCons(X:Id, _:Val, KWS:KwArgVals), IDS:IdItems) =>
    kwExtrasDictVals(KWS, IDS)
    requires idContains(X, IDS)
  rule kwExtrasDictVals(kwArgValsCons(X:Id, V:Val, KWS:KwArgVals), IDS:IdItems) =>
    dictValsCons(Id2String(X), V, kwExtrasDictVals(KWS, IDS))
    requires notBool idContains(X, IDS)
  rule kwExtrasDictVals(kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals), IDS:IdItems) =>
    kwExtrasDictVals(KWS, IDS)
    requires stringIdContains(S, IDS)
  rule kwExtrasDictVals(kwArgStringValsCons(S:String, V:Val, KWS:KwArgVals), IDS:IdItems) =>
    dictValsCons(S, V, kwExtrasDictVals(KWS, IDS))
    requires notBool stringIdContains(S, IDS)

  rule kwExtrasEitherDictVals(#noKwArgVals, _:IdItems, _:IdItems) => #noDictVals
  rule kwExtrasEitherDictVals(kwArgValsCons(X:Id, _:Val, KWS:KwArgVals), IDS1:IdItems, IDS2:IdItems) =>
    kwExtrasEitherDictVals(KWS, IDS1, IDS2)
    requires idContains(X, IDS1) orBool idContains(X, IDS2)
  rule kwExtrasEitherDictVals(kwArgValsCons(X:Id, V:Val, KWS:KwArgVals), IDS1:IdItems, IDS2:IdItems) =>
    dictValsCons(Id2String(X), V, kwExtrasEitherDictVals(KWS, IDS1, IDS2))
    requires notBool (idContains(X, IDS1) orBool idContains(X, IDS2))
  rule kwExtrasEitherDictVals(kwArgStringValsCons(S:String, _:Val, KWS:KwArgVals), IDS1:IdItems, IDS2:IdItems) =>
    kwExtrasEitherDictVals(KWS, IDS1, IDS2)
    requires stringIdContains(S, IDS1) orBool stringIdContains(S, IDS2)
  rule kwExtrasEitherDictVals(kwArgStringValsCons(S:String, V:Val, KWS:KwArgVals), IDS1:IdItems, IDS2:IdItems) =>
    dictValsCons(S, V, kwExtrasEitherDictVals(KWS, IDS1, IDS2))
    requires notBool (stringIdContains(S, IDS1) orBool stringIdContains(S, IDS2))

  rule appendDictVal(#noDictVals, K:Val, V:Val) => dictValsCons(K, V, #noDictVals)
  rule appendDictVal(dictValsCons(K0:Val, _:Val, DVS:DictVals), K:Val, V:Val) =>
    dictValsCons(K0, V, DVS)
    requires valEq(K, K0)
  rule appendDictVal(dictValsCons(K0:Val, V0:Val, DVS:DictVals), K:Val, V:Val) =>
    dictValsCons(K0, V0, appendDictVal(DVS, K, V))
    requires notBool valEq(K, K0)

  rule appendDictUnpack(DVS:DictVals, ({}):Val) => DVS
  rule appendDictUnpack(DVS:DictVals, dictVal(DS:DictItems)) => appendDictItems(DVS, DS)

  rule appendDictItems(DVS:DictVals, dictItemsLast(K:Val, V:Val)) =>
    appendDictVal(DVS, K, V)
  rule appendDictItems(DVS:DictVals, dictItemsCons(K:Val, V:Val, DS:DictItems)) =>
    appendDictItems(appendDictVal(DVS, K, V), DS)

  rule appendDictPairVal(DVS:DictVals, listVal(valItemsCons(K:Val, valItemsLast(V:Val)))) =>
    appendDictVal(DVS, K, V)
  rule appendDictPairVal(DVS:DictVals, tupleVal(valItemsCons(K:Val, valItemsLast(V:Val)))) =>
    appendDictVal(DVS, K, V)

  rule dictCtorPairs(valItemsLast(Pair:Val), DVS:DictVals) =>
    appendDictPairVal(DVS, Pair)
  rule dictCtorPairs(valItemsCons(Pair:Val, Rest:ValItems), DVS:DictVals) =>
    dictCtorPairs(Rest, appendDictPairVal(DVS, Pair))

  rule bindArgs(Rho:Map, #noIds, #noArgVals) => Rho
  rule bindArgs(Rho:Map, idItemsLast(X:Id), argValsCons(V:Val, #noArgVals)) => Rho [ X <- V ]
  rule bindArgs(Rho:Map, idItemsCons(X:Id, IDS:IdItems), argValsCons(V:Val, VS:ArgVals)) =>
    bindArgs(Rho [ X <- V ], IDS, VS)

  rule bindVarArgs(Rho:Map, #noIds, Var:Id, VS:ArgVals) =>
    Rho [ Var <- argValsToTupleVal(VS) ]
  rule bindVarArgs(Rho:Map, idItemsLast(X:Id), Var:Id, argValsCons(V:Val, VS:ArgVals)) =>
    (Rho [ X <- V ]) [ Var <- argValsToTupleVal(VS) ]
  rule bindVarArgs(Rho:Map, idItemsCons(X:Id, IDS:IdItems), Var:Id, argValsCons(V:Val, VS:ArgVals)) =>
    bindVarArgs(Rho [ X <- V ], IDS, Var, VS)

  rule bindVarKwArgs(Rho:Map, IDS:IdItems, Var:Id, Kw:Id, VS:ArgVals, KWS:KwArgVals) =>
    (bindVarArgs(Rho, IDS, Var, VS)) [ Kw <- kwExtrasDict(KWS, IDS) ]

  rule bindKwArgs(Rho:Map, IDS:IdItems, Kw:Id, VS:ArgVals, KWS:KwArgVals) =>
    (bindArgs(Rho, IDS, VS)) [ Kw <- kwExtrasDict(KWS, IDS) ]

  rule bindPosOnlyArgs(Rho:Map, Pos:IdItems, Rest:IdItems, VS:ArgVals) =>
    bindArgs(bindArgs(Rho, Pos, takeArgVals(VS, idItemsLen(Pos))), Rest, dropArgVals(VS, idItemsLen(Pos)))

  rule bindPosOnlyVarArgs(Rho:Map, Pos:IdItems, Rest:IdItems, Var:Id, VS:ArgVals) =>
    bindVarArgs(
      bindArgs(Rho, Pos, takeArgVals(VS, idItemsLen(Pos))),
      Rest,
      Var,
      dropArgVals(VS, idItemsLen(Pos)))

  rule bindPosOnlyKwArgs(Rho:Map, Pos:IdItems, Rest:IdItems, Kw:Id, VS:ArgVals, KWS:KwArgVals) =>
    (bindPosOnlyArgs(Rho, Pos, Rest, VS)) [ Kw <- kwExtrasDict(KWS, Rest) ]

  rule bindPosOnlyVarKwArgs(Rho:Map, Pos:IdItems, Rest:IdItems, Var:Id, Kw:Id, VS:ArgVals, KWS:KwArgVals) =>
    (bindPosOnlyVarArgs(Rho, Pos, Rest, Var, VS)) [ Kw <- kwExtrasDict(KWS, Rest) ]

  rule bindPosOnlyVarArgsKwOnly(Rho:Map, Pos:IdItems, Rest:IdItems, Var:Id, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, KwDefaults:ArgVals) =>
    bindArgs(bindPosOnlyVarArgs(Rho, Pos, Rest, Var, VS), KwOnly, buildKwDefaultArgs(KwOnly, KWS, KwDefaults))

  rule bindPosOnlyVarArgsKwOnlyKwArgs(Rho:Map, Pos:IdItems, Rest:IdItems, Var:Id, KwOnly:IdItems, Kw:Id, VS:ArgVals, KWS:KwArgVals, KwDefaults:ArgVals) =>
    (bindPosOnlyVarArgsKwOnly(Rho, Pos, Rest, Var, KwOnly, VS, KWS, KwDefaults)) [ Kw <- kwExtrasEitherDict(KWS, Rest, KwOnly) ]

  rule bindPosOnlyKwOnly(Rho:Map, Pos:IdItems, Rest:IdItems, KwOnly:IdItems, VS:ArgVals, KWS:KwArgVals, KwDefaults:ArgVals) =>
    bindArgs(bindPosOnlyArgs(Rho, Pos, Rest, VS), KwOnly, buildKwDefaultArgs(KwOnly, KWS, KwDefaults))

  rule bindPosOnlyKwOnlyKwArgs(Rho:Map, Pos:IdItems, Rest:IdItems, KwOnly:IdItems, Kw:Id, VS:ArgVals, KWS:KwArgVals, KwDefaults:ArgVals) =>
    (bindPosOnlyKwOnly(Rho, Pos, Rest, KwOnly, VS, KWS, KwDefaults)) [ Kw <- kwExtrasEitherDict(KWS, Rest, KwOnly) ]

  rule bindPosOnlyMixedArgs(Rho:Map, Pos:IdItems, Rest:IdItems, VS:ArgVals, KWS:KwArgVals) =>
    bindArgs(
      bindArgs(Rho, Pos, takeArgVals(VS, idItemsLen(Pos))),
      Rest,
      buildMixedDefaultArgs(Rest, dropArgVals(VS, idItemsLen(Pos)), KWS, #noArgVals))

  rule bindVals(Rho:Map, idItemsLast(X:Id), valItemsLast(V:Val)) => Rho [ X <- V ]
  rule bindVals(Rho:Map, idItemsCons(X:Id, IDS:IdItems), valItemsCons(V:Val, VS:ValItems)) =>
    bindVals(Rho [ X <- V ], IDS, VS)

  rule bindTarget(Rho:Map, targetName(X:Id), V:Val) => Rho [ X <- V ]
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), listVal(VS:ValItems)) =>
    bindTargets(Rho, TS, VS)
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), tupleVal(VS:ValItems)) =>
    bindTargets(Rho, TS, VS)
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), bytesVal(VS:ValItems)) =>
    bindTargets(Rho, TS, VS)
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), S:String) =>
    bindTargets(Rho, TS, stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), dictVal(DS:DictItems)) =>
    bindTargets(Rho, TS, dictKeysToValItems(DS))
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), setVal(VS:ValItems)) =>
    bindTargets(Rho, TS, VS)
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), rangeVal(Start:Int, Stop:Int)) =>
    bindTargets(Rho, TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule bindTarget(Rho:Map, targetSeq(TS:Targets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    bindTargets(Rho, TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), listVal(VS:ValItems)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, VS)
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), []) =>
    Rho [ Star <- [] ]
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), tupleVal(VS:ValItems)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, VS)
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), ()) =>
    Rho [ Star <- [] ]
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), bytesVal(VS:ValItems)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, VS)
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), #bytes()) =>
    Rho [ Star <- [] ]
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), S:String) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), S:String) =>
    Rho [ Star <- [] ]
    requires lengthString(S) ==Int 0
      andBool maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), ({}):Val) =>
    Rho [ Star <- [] ]
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), dictVal(DS:DictItems)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, dictKeysToValItems(DS))
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), setVal(VS:ValItems)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, VS)
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), set()) =>
    Rho [ Star <- [] ]
    requires maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int)) =>
    Rho [ Star <- [] ]
    requires pyRangeLen(Start, Stop, 1) ==Int 0
      andBool maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    bindTargetStarSeq(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule bindTarget(Rho:Map, targetStarSeq(Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets), rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    Rho [ Star <- [] ]
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 0
      andBool maybeTargetsLen(Prefix) +Int maybeTargetsLen(Suffix) ==Int 0

  rule bindTargets(Rho:Map, targetsLast(T:Target), valItemsLast(V:Val)) =>
    bindTarget(Rho, T, V)
  rule bindTargets(Rho:Map, targetsCons(T:Target, TS:Targets), valItemsCons(V:Val, VS:ValItems)) =>
    bindTargets(bindTarget(Rho, T, V), TS, VS)

  rule bindTargetStarSeq(Rho:Map, Prefix:MaybeTargets, Star:Id, Suffix:MaybeTargets, VS:ValItems) =>
    bindMaybeSuffixTargets(
      bindOneVal(
        bindMaybePrefixTargets(Rho, Prefix, VS),
        Star,
        listSlice(VS, maybeTargetsLen(Prefix), valItemsLen(VS) -Int maybeTargetsLen(Suffix))),
      Suffix,
      VS)

  rule bindMaybePrefixTargets(Rho:Map, #noTargets, _:ValItems) => Rho
  rule bindMaybePrefixTargets(Rho:Map, #targets(TS:Targets), VS:ValItems) =>
    bindTargets(Rho, TS, sliceValItems(VS, 0, targetsLen(TS)))

  rule bindMaybeSuffixTargets(Rho:Map, #noTargets, _:ValItems) => Rho
  rule bindMaybeSuffixTargets(Rho:Map, #targets(TS:Targets), VS:ValItems) =>
    bindTargets(Rho, TS, dropValItems(VS, valItemsLen(VS) -Int targetsLen(TS)))

  rule delIds(Rho:Map, #noIds) => Rho
  rule delIds(Rho:Map, idItemsLast(X:Id)) => Rho [ X <- undef ]
  rule delIds(Rho:Map, idItemsCons(X:Id, IDS:IdItems)) => delIds(Rho [ X <- undef ], IDS)

  rule bindPrefixVals(Rho:Map, #noIds, _:ValItems) => Rho
  rule bindPrefixVals(Rho:Map, idItemsLast(X:Id), valItemsLast(V:Val)) => Rho [ X <- V ]
  rule bindPrefixVals(Rho:Map, idItemsLast(X:Id), valItemsCons(V:Val, _:ValItems)) => Rho [ X <- V ]
  rule bindPrefixVals(Rho:Map, idItemsCons(X:Id, IDS:IdItems), valItemsCons(V:Val, VS:ValItems)) =>
    bindPrefixVals(Rho [ X <- V ], IDS, VS)

  rule bindSuffixVals(Rho:Map, #noIds, _:ValItems, _:Int) => Rho
  rule bindSuffixVals(Rho:Map, IDS:IdItems, VS:ValItems, Len:Int) =>
    bindVals(Rho, IDS, dropValItems(VS, Len -Int idItemsLen(IDS)))
    requires idItemsLen(IDS) >Int 0

  rule bindOneVal(Rho:Map, X:Id, V:Val) => Rho [ X <- V ]

  rule bindStarUnpack(Rho:Map, Prefix:IdItems, Star:Id, Suffix:IdItems, VS:ValItems) =>
    bindSuffixVals(
      bindOneVal(
        bindPrefixVals(Rho, Prefix, VS),
        Star,
        listSlice(VS, idItemsLen(Prefix), valItemsLen(VS) -Int idItemsLen(Suffix))),
      Suffix,
      VS,
      valItemsLen(VS))

  rule argValsToValItems(argValsCons(V:Val, #noArgVals)) => valItemsLast(V)
  rule argValsToValItems(argValsCons(V:Val, VS:ArgVals)) =>
    valItemsCons(V, argValsToValItems(VS))
    requires notBool emptyArgVals(VS)

  rule argValsToTupleVal(#noArgVals) => ()
  rule argValsToTupleVal(VS:ArgVals) => tupleVal(argValsToValItems(VS))
    requires notBool emptyArgVals(VS)

  rule setFromArgVals(#noArgVals) => set()
  rule setFromArgVals(VS:ArgVals) => setVal(argValsToSetItems(VS))
    requires notBool emptyArgVals(VS)

  rule argValsToSetItems(argValsCons(V:Val, #noArgVals)) => valItemsLast(V)
  rule argValsToSetItems(argValsCons(V:Val, VS:ArgVals)) => argValsToSetItems(VS)
    requires notBool emptyArgVals(VS)
      andBool containsVal(V, argValsToSetItems(VS))
  rule argValsToSetItems(argValsCons(V:Val, VS:ArgVals)) =>
    valItemsCons(V, argValsToSetItems(VS))
    requires notBool emptyArgVals(VS)
      andBool notBool containsVal(V, argValsToSetItems(VS))

  rule stringToValItems(S:String, I:Int, Len:Int) =>
    valItemsLast(substrString(S, I, I +Int 1))
    requires I +Int 1 >=Int Len
  rule stringToValItems(S:String, I:Int, Len:Int) =>
    valItemsCons(substrString(S, I, I +Int 1), stringToValItems(S, I +Int 1, Len))
    requires I +Int 1 <Int Len

  rule dictKeysToValItems(dictItemsLast(K:Val, _:Val)) => valItemsLast(K)
  rule dictKeysToValItems(dictItemsCons(K:Val, _:Val, DS:DictItems)) =>
    valItemsCons(K, dictKeysToValItems(DS))

  rule rangeToValItems(Start:Int, Stop:Int, Step:Int, I:Int, Len:Int) =>
    valItemsLast(rangeGet(Start, Stop, Step, I))
    requires Step =/=Int 0 andBool I +Int 1 >=Int Len
  rule rangeToValItems(Start:Int, Stop:Int, Step:Int, I:Int, Len:Int) =>
    valItemsCons(rangeGet(Start, Stop, Step, I), rangeToValItems(Start, Stop, Step, I +Int 1, Len))
    requires Step =/=Int 0 andBool I +Int 1 <Int Len

  rule allValItems(valItemsLast(V:Val)) => truthy(V)
  rule allValItems(valItemsCons(V:Val, VS:ValItems)) => truthy(V) andBool allValItems(VS)
  rule anyValItems(valItemsLast(V:Val)) => truthy(V)
  rule anyValItems(valItemsCons(V:Val, VS:ValItems)) => truthy(V) orBool anyValItems(VS)
  rule valItemsAllIntLike(valItemsLast(V:Val)) => isIntLike(V)
  rule valItemsAllIntLike(valItemsCons(V:Val, VS:ValItems)) =>
    isIntLike(V) andBool valItemsAllIntLike(VS)
  rule valItemsAllByteInts(valItemsLast(V:Val)) =>
    isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule valItemsAllByteInts(valItemsCons(V:Val, VS:ValItems)) =>
    isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool valItemsAllByteInts(VS)

  rule rangeAllTruthy(Start:Int, Stop:Int, Step:Int) => notBool rangeContains(0, Start, Stop, Step)
    requires Step =/=Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => false
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => false
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 1
      andBool rangeGet(Start, Stop, Step, 0) ==Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => true
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 1
      andBool rangeGet(Start, Stop, Step, 0) =/=Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => true
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 1
  rule sumValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule sumValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V) +Int sumValItems(VS)
    requires isIntLike(V) andBool valItemsAllIntLike(VS)
  rule rangeSum(Start:Int, Stop:Int, Step:Int) =>
    (pyRangeLen(Start, Stop, Step) *Int ((2 *Int Start) +Int ((pyRangeLen(Start, Stop, Step) -Int 1) *Int Step))) /Int 2
    requires Step =/=Int 0
  rule minValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule minValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) <=Int minValItems(VS)
  rule minValItems(valItemsCons(V:Val, VS:ValItems)) => minValItems(VS)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) >Int minValItems(VS)
  rule maxValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule maxValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) >=Int maxValItems(VS)
  rule maxValItems(valItemsCons(V:Val, VS:ValItems)) => maxValItems(VS)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) <Int maxValItems(VS)
  rule minArgVals(argValsCons(V:Val, #noArgVals)) => intValue(V)
    requires isIntLike(V)
  rule minArgVals(argValsCons(V:Val, VS:ArgVals)) => intValue(V)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) <=Int minArgVals(VS)
  rule minArgVals(argValsCons(V:Val, VS:ArgVals)) => minArgVals(VS)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) >Int minArgVals(VS)
  rule maxArgVals(argValsCons(V:Val, #noArgVals)) => intValue(V)
    requires isIntLike(V)
  rule maxArgVals(argValsCons(V:Val, VS:ArgVals)) => intValue(V)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) >=Int maxArgVals(VS)
  rule maxArgVals(argValsCons(V:Val, VS:ArgVals)) => maxArgVals(VS)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) <Int maxArgVals(VS)
  rule rangeMin(Start:Int, Stop:Int, Step:Int) => Start
    requires Step >Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMin(Start:Int, Stop:Int, Step:Int) =>
    rangeGet(Start, Stop, Step, pyRangeLen(Start, Stop, Step) -Int 1)
    requires Step <Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMax(Start:Int, Stop:Int, Step:Int) =>
    rangeGet(Start, Stop, Step, pyRangeLen(Start, Stop, Step) -Int 1)
    requires Step >Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMax(Start:Int, Stop:Int, Step:Int) => Start
    requires Step <Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule concatValItems(valItemsLast(V:Val), VS:ValItems) => valItemsCons(V, VS)
  rule concatValItems(valItemsCons(V:Val, VS1:ValItems), VS2:ValItems) =>
    valItemsCons(V, concatValItems(VS1, VS2))

  rule repeatString(_:String, N:Int) => "" requires N <=Int 0
  rule repeatString(S:String, 1) => S
  rule repeatString(S:String, N:Int) => S +String repeatString(S, N -Int 1)
    requires N >Int 1

  rule bytesAsciiString(valItemsLast(V:Val)) => chrChar(intValue(V))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule bytesAsciiString(valItemsCons(V:Val, VS:ValItems)) =>
    chrChar(intValue(V)) +String bytesAsciiString(VS)
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool valItemsAllByteInts(VS)

  rule repeatValItems(VS:ValItems, 1) => VS
  rule repeatValItems(VS:ValItems, N:Int) => concatValItems(VS, repeatValItems(VS, N -Int 1))
    requires N >Int 1

  rule bytesRepeat(_:ValItems, N:Int) => #bytes() requires N <=Int 0
  rule bytesRepeat(VS:ValItems, 1) => bytesVal(VS)
  rule bytesRepeat(VS:ValItems, N:Int) => bytesVal(repeatValItems(VS, N))
    requires N >Int 1

  rule dropValItems(VS:ValItems, 0) => VS
  rule dropValItems(valItemsCons(_:Val, VS:ValItems), N:Int) => dropValItems(VS, N -Int 1)
    requires N >Int 0

  rule sliceString(_:String, Start:Int, Stop:Int) => "" requires Start >=Int Stop
  rule sliceString(S:String, Start:Int, Stop:Int) => substrString(S, Start, Stop)
    requires Start <Int Stop

  rule sliceStepString(_:String, Start:Int, Stop:Int, Step:Int) => ""
    requires Start >=Int Stop andBool Step >Int 0
  rule sliceStepString(S:String, Start:Int, Stop:Int, Step:Int) =>
    substrString(S, Start, Start +Int 1) +String sliceStepString(S, Start +Int Step, Stop, Step)
    requires Start <Int Stop andBool Step >Int 0
  rule sliceStepString(_:String, Start:Int, Stop:Int, Step:Int) => ""
    requires Start <=Int Stop andBool Step <Int 0
  rule sliceStepString(S:String, Start:Int, Stop:Int, Step:Int) =>
    substrString(S, Start, Start +Int 1) +String sliceStepString(S, Start +Int Step, Stop, Step)
    requires Start >Int Stop andBool Step <Int 0

  rule listSlice(_:ValItems, Start:Int, Stop:Int) => [] requires Start >=Int Stop
  rule listSlice(VS:ValItems, Start:Int, Stop:Int) => listVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule tupleSlice(_:ValItems, Start:Int, Stop:Int) => () requires Start >=Int Stop
  rule tupleSlice(VS:ValItems, Start:Int, Stop:Int) => tupleVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule bytesSlice(_:ValItems, Start:Int, Stop:Int) => #bytes() requires Start >=Int Stop
  rule bytesSlice(VS:ValItems, Start:Int, Stop:Int) => bytesVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule listSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => []
    requires Start >=Int Stop andBool Step >Int 0
  rule listSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule listSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => []
    requires Start <=Int Stop andBool Step <Int 0
  rule listSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule tupleSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => ()
    requires Start >=Int Stop andBool Step >Int 0
  rule tupleSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    tupleVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule tupleSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => ()
    requires Start <=Int Stop andBool Step <Int 0
  rule tupleSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    tupleVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule bytesSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => #bytes()
    requires Start >=Int Stop andBool Step >Int 0
  rule bytesSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    bytesVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule bytesSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => #bytes()
    requires Start <=Int Stop andBool Step <Int 0
  rule bytesSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    bytesVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule sliceValItems(valItemsLast(V:Val), 0, Stop:Int) => valItemsLast(V)
    requires Stop >Int 0
  rule sliceValItems(valItemsCons(V:Val, _:ValItems), 0, 1) => valItemsLast(V)
  rule sliceValItems(valItemsCons(V:Val, VS:ValItems), 0, Stop:Int) =>
    valItemsCons(V, sliceValItems(VS, 0, Stop -Int 1))
    requires Stop >Int 1
  rule sliceValItems(valItemsCons(_:Val, VS:ValItems), Start:Int, Stop:Int) =>
    sliceValItems(VS, Start -Int 1, Stop -Int 1)
    requires Start >Int 0

  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsLast(listGet(VS, Start))
    requires Start <Int Stop andBool Start +Int Step >=Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsCons(listGet(VS, Start), sliceStepValItems(VS, Start +Int Step, Stop, Step))
    requires Start <Int Stop andBool Start +Int Step <Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsLast(listGet(VS, Start))
    requires Start >Int Stop andBool Start +Int Step <=Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsCons(listGet(VS, Start), sliceStepValItems(VS, Start +Int Step, Stop, Step))
    requires Start >Int Stop andBool Start +Int Step >Int Stop

  rule dictValsToDictItems(dictValsCons(K:Val, V:Val, #noDictVals)) => dictItemsLast(K, V)
  rule dictValsToDictItems(dictValsCons(K:Val, V:Val, DVS:DictVals)) =>
    dictItemsCons(K, V, dictValsToDictItems(DVS))
    requires notBool emptyDictVals(DVS)

  rule valsEq(valItemsLast(V1:Val), valItemsLast(V2:Val)) => valEq(V1, V2)
  rule valsEq(valItemsCons(V1:Val, VS1:ValItems), valItemsCons(V2:Val, VS2:ValItems)) =>
    valEq(V1, V2) andBool valsEq(VS1, VS2)
  rule valsEq(valItemsLast(_:Val), valItemsCons(_:Val, _:ValItems)) => false
  rule valsEq(valItemsCons(_:Val, _:ValItems), valItemsLast(_:Val)) => false

  rule valItemsLt(valItemsLast(V1:Val), valItemsLast(V2:Val)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsLast(V2:Val)) => false
    requires valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsCons(V2:Val, _:ValItems)) => true
    requires valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsCons(V2:Val, _:ValItems)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsLast(V2:Val)) => false
    requires valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsLast(V2:Val)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, VS1:ValItems), valItemsCons(V2:Val, VS2:ValItems)) =>
    valItemsLt(VS1, VS2)
    requires valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsCons(V2:Val, _:ValItems)) =>
    cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)

