       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(S:String, Rest:ValItems), {}, Else:Block) =>
           forStarUnpackElseItems(Prefix, Star, Suffix, Rest, {}, Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires lengthString(S) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), {}, Else:Block) =>
           forStarUnpackElseItems(Prefix, Star, Suffix, Rest, {}, Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), {}, Else:Block) =>
           forStarUnpackElseItems(Prefix, Star, Suffix, Rest, {}, Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(listVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(tupleVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(bytesVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(S:String), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, lengthString(S))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(dictVal(DS:DictItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, dictKeysToValItems(DS)) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(dictKeysToValItems(DS)))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(setVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, 1))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, Step))
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast([]), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(()), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(({}):Val), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(#bytes()), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(set()), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(S:String), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires lengthString(S) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0

  rule <k> forElseRange(X:Id, I:Int, Stop:Int, block(SS:Stmts), Else:Block) =>
           SS ~> forElseRangeAgain(X, I +Int 1, Stop, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires I <Int Stop
  rule <k> forElseRange(X:Id, I:Int, Stop:Int, {}, Else:Block) =>
           forElseRange(X, I +Int 1, Stop, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires I <Int Stop
  rule <k> forElseRange(_:Id, I:Int, Stop:Int, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires I >=Int Stop
  rule <k> forElseRangeAgain(X:Id, I:Int, Stop:Int, Body:Block, Else:Block) =>
           forElseRange(X, I, Stop, Body, Else)
       ... </k>

  rule <k> forElseRangeStep(X:Id, I:Int, Stop:Int, Step:Int, block(SS:Stmts), Else:Block) =>
           SS ~> forElseRangeStepAgain(X, I +Int Step, Stop, Step, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires (Step >Int 0 andBool I <Int Stop)
      orBool (Step <Int 0 andBool I >Int Stop)
  rule <k> forElseRangeStep(X:Id, I:Int, Stop:Int, Step:Int, {}, Else:Block) =>
           forElseRangeStep(X, I +Int Step, Stop, Step, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires (Step >Int 0 andBool I <Int Stop)
      orBool (Step <Int 0 andBool I >Int Stop)
  rule <k> forElseRangeStep(_:Id, I:Int, Stop:Int, Step:Int, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires (Step >Int 0 andBool I >=Int Stop)
      orBool (Step <Int 0 andBool I <=Int Stop)
  rule <k> forElseRangeStepAgain(X:Id, I:Int, Stop:Int, Step:Int, Body:Block, Else:Block) =>
           forElseRangeStep(X, I, Stop, Step, Body, Else)
       ... </k>

  rule <k> runLoopElse(block(SS:Stmts)) => SS ~> ifStmtDone ... </k>
  rule <k> runLoopElse({}) => stmtNoResult ... </k>

  rule <k> break => breakSignal ... </k>
  rule <k> continue => continueSignal ... </k>
  rule <k> return => returnSignal(None) ... </k>
  rule <k> returnStmt(E:Exp) => E ~> returnValue() ... </k>
  rule <k> V:Val ~> returnValue() => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> returnValue() => exceptionSignal(V) ... </k>
  rule <k> raise => exceptionSignal(V) ... </k>
       <activeException> currentException(V) </activeException>
  rule <k> raise => exceptionSignal(#exception(#token("RuntimeError", "Id"))) ... </k>
       <activeException> noException </activeException>
  rule <k> raiseStmt(V:Val) => exceptionSignal(V) ... </k>
  rule <k> raiseFromNoneStmt(V:Val) => exceptionSignal(V) ... </k>
  rule <k> raiseFromStmt(V:Val, _Cause:Val) => exceptionSignal(V) ... </k>

  rule <k> breakSignal ~> stmtNext(_:Stmts) => breakSignal ... </k>
  rule <k> continueSignal ~> stmtNext(_:Stmts) => continueSignal ... </k>
  rule <k> returnSignal(V:Val) ~> stmtNext(_:Stmts) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> stmtNext(_:Stmts) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> stmtEnd => breakSignal ... </k>
  rule <k> continueSignal ~> stmtEnd => continueSignal ... </k>
  rule <k> returnSignal(V:Val) ~> stmtEnd => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> stmtEnd => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> ifStmtDone => breakSignal ... </k>
  rule <k> continueSignal ~> ifStmtDone => continueSignal ... </k>
  rule <k> returnSignal(V:Val) ~> ifStmtDone => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> ifStmtDone => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> matchDone => breakSignal ... </k>
  rule <k> continueSignal ~> matchDone => continueSignal ... </k>
  rule <k> returnSignal(V:Val) ~> matchDone => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> matchDone => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> compareChain(_:CmpChain) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> compareChainLast(_:CmpOp, _:Val) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> compareChainNext(_:CmpOp, _:Val, _:CmpChain) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> compareFrom(_:Val, _:CmpChain) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDefaultObject(_:Id, _:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDefaultApply(_:Val, _:Id) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> hasattrObject(_:Id) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDynName(_:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDynApply(_:Val) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDefaultDynName(_:Exp, _:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDefaultDynDefault(_:Val, _:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> getattrDefaultDynApply(_:Val, _:String) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> hasattrDynName(_:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> hasattrDynApply(_:Val) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> formatDefault() => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> formatSpec(_:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> formatApply(_:Val) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictFromKeysDefault => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictFromKeysIterDefault(_:Exp) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictFromKeysApply(_:Val) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> bytesIteratorApply => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> bytearrayIteratorApply => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompIteratorApply(_:Id, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetIteratorApply(_:Target, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetIfsIteratorApply(_:Target, _:CompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompIfIteratorApply(_:Id, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompIfsIteratorApply(_:Id, _:CompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompIteratorApply(_:Id, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompTargetIteratorApply(_:Target, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompTargetIfsIteratorApply(_:Target, _:CompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompIfIteratorApply(_:Id, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompIfsIteratorApply(_:Id, _:CompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictCompIteratorApply(_:Id, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictCompTargetIteratorApply(_:Target, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictCompTargetIfsIteratorApply(_:Target, _:CompFilters, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictCompIfIteratorApply(_:Id, _:Exp, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> dictCompIfsIteratorApply(_:Id, _:CompFilters, _:Exp, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompForIteratorApply(_:Id, _:Exp, _:Id, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetForIteratorApply(_:Target, _:Exp, _:Target, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetForIfsIteratorApply(_:Target, _:MaybeCompFilters, _:Exp, _:Target, _:MaybeCompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompForIfsIteratorApply(_:Id, _:MaybeCompFilters, _:Exp, _:Id, _:MaybeCompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompForInnerIteratorApply(_:Id, _:Exp, _:Id, _:Exp, _:ArgVals, _:ArgVals, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetForInnerIteratorApply(_:Target, _:Exp, _:Target, _:Exp, _:ArgVals, _:ArgVals, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompTargetForIfsInnerIteratorApply(_:Target, _:MaybeCompFilters, _:Exp, _:Target, _:MaybeCompFilters, _:Exp, _:ArgVals, _:ArgVals, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> listCompForIfsInnerIteratorApply(_:Id, _:MaybeCompFilters, _:Exp, _:Id, _:MaybeCompFilters, _:Exp, _:ArgVals, _:ArgVals, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompForIteratorApply(_:Id, _:Exp, _:Id, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompTargetForIteratorApply(_:Target, _:Exp, _:Target, _:Exp, _:Map) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> setCompTargetForIfsIteratorApply(_:Target, _:MaybeCompFilters, _:Exp, _:Target, _:MaybeCompFilters, _:Exp, _:Map) => exceptionSignal(V) ... </k>
