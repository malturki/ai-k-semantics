           listCompManyIter(NextT, NextFilters, NextRest, Elem, iterableArgVals(NextIter), Acc, compArgFrame(ParentT, ParentFilters, ParentRest, Elem, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
