  rule <k> exceptionSignal(V:Val) ~> mapForUnpackElseIter(_:IdItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> mapForTargetUnpackElseIter(_:Targets, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> mapForTargetElseIter(_:Target, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> filterForElseIter(_:Id, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> filterForUnpackElseIter(_:IdItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> filterForTargetUnpackElseIter(_:Targets, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> filterForTargetElseIter(_:Target, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forIteratorElse(_:Int, _:Id, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forTargetIteratorElse(_:Int, _:Target, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forElseItems(_:Id, _:ValItems, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> breakSignal ~> forElseDone(_:Block) => stmtNoResult ... </k>
  rule <k> breakSignal ~> forIteratorElse(_:Int, _:Id, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> breakSignal ~> forTargetIteratorElse(_:Int, _:Target, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forElseItems(X:Id, VS:ValItems, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> continueSignal ~> forElseDone(Else:Block) => runLoopElse(Else) ... </k>
  rule <k> continueSignal ~> forIteratorElse(I:Int, X:Id, Body:Block, Else:Block) =>
           forIteratorElse(I, X, Body, Else)
       ... </k>
  rule <k> continueSignal ~> forTargetIteratorElse(I:Int, T:Target, Body:Block, Else:Block) =>
           forTargetIteratorElse(I, T, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forElseItems(_:Id, _:ValItems, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> forElseDone(_:Block) => returnSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> forIteratorElse(_:Int, _:Id, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> forTargetIteratorElse(_:Int, _:Target, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forElseItems(_:Id, _:ValItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forElseDone(_:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forUnpackElseItems(_:IdItems, _:ValItems, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> breakSignal ~> forUnpackElseDone(_:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forUnpackElseItems(IDS:IdItems, VS:ValItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> continueSignal ~> forUnpackElseDone(Else:Block) => runLoopElse(Else) ... </k>
  rule <k> returnSignal(V:Val) ~> forUnpackElseItems(_:IdItems, _:ValItems, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> forUnpackElseDone(_:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forUnpackElseItems(_:IdItems, _:ValItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forUnpackElseDone(_:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forTargetUnpackElseItems(_:Targets, _:ValItems, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forTargetUnpackElseItems(TS:Targets, VS:ValItems, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forTargetUnpackElseItems(_:Targets, _:ValItems, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forTargetUnpackElseItems(_:Targets, _:ValItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forTargetElseItems(_:Target, _:ValItems, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forTargetElseItems(T:Target, VS:ValItems, Body:Block, Else:Block) =>
           forTargetElseItems(T, VS, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forTargetElseItems(_:Target, _:ValItems, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forTargetElseItems(_:Target, _:ValItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forStarUnpackElseItems(_:IdItems, _:Id, _:IdItems, _:ValItems, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forStarUnpackElseItems(Prefix:IdItems, Star:Id, Suffix:IdItems, VS:ValItems, Body:Block, Else:Block) =>
           forStarUnpackElseItems(Prefix, Star, Suffix, VS, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forStarUnpackElseItems(_:IdItems, _:Id, _:IdItems, _:ValItems, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forStarUnpackElseItems(_:IdItems, _:Id, _:IdItems, _:ValItems, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forElseRangeAgain(_:Id, _:Int, _:Int, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forElseRangeAgain(X:Id, I:Int, Stop:Int, Body:Block, Else:Block) =>
           forElseRange(X, I, Stop, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forElseRangeAgain(_:Id, _:Int, _:Int, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forElseRangeAgain(_:Id, _:Int, _:Int, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> forElseRangeStepAgain(_:Id, _:Int, _:Int, _:Int, _:Block, _:Block) => stmtNoResult ... </k>
  rule <k> continueSignal ~> forElseRangeStepAgain(X:Id, I:Int, Stop:Int, Step:Int, Body:Block, Else:Block) =>
           forElseRangeStep(X, I, Stop, Step, Body, Else)
       ... </k>
  rule <k> returnSignal(V:Val) ~> forElseRangeStepAgain(_:Id, _:Int, _:Int, _:Int, _:Block, _:Block) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> forElseRangeStepAgain(_:Id, _:Int, _:Int, _:Int, _:Block, _:Block) => exceptionSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> functionDone(Rho:Map) => V ~> restoreEnv(Rho) ... </k>
  rule <k> exceptionSignal(V:Val) ~> functionDone(Rho:Map) => exceptionSignal(V) ~> restoreEnv(Rho) ... </k>
  rule <k> functionDone(Rho:Map) => None ~> restoreEnv(Rho) ... </k>

  rule <k> delNameStmt(X:Id) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- undef ] </env>
       <result> _ => .K </result>
  rule <k> delManyStmt(IDS:IdItems) => stmtNoResult ... </k>
       <env> Rho => delIds(Rho, IDS) </env>
       <result> _ => .K </result>
  rule <k> delSubscriptStmt(X:Id, I:Exp) => I ~> delSubscriptApply(X) ... </k>
  rule <k> I:Val ~> delSubscriptApply(X:Id) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listDel(VS, intValue(I))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule <k> I:Val ~> delSubscriptApply(X:Id) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listDel(VS, valItemsLen(VS) +Int intValue(I))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule <k> K:Val ~> delSubscriptApply(X:Id) => stmtNoResult ... </k>
       <env> ... X |-> (dictVal(DS:DictItems) => dictDel(DS, K)) ... </env>
       <result> _ => .K </result>
    requires dictLookupKeySupported(K)
      andBool containsKey(K, DS)
  rule <k> I:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I)
      andBool notBool subscriptIndexInBounds(I, valItemsLen(VS))
  rule <k> I:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires isIntLike(I)
  rule <k> I:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> listVal(_:ValItems) ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> I:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> K:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("KeyError", "Id")))
       ... </k>
       <env> ... X |-> ({}):Val ... </env>
    requires dictLookupKeySupported(K)
  rule <k> K:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("KeyError", "Id")))
       ... </k>
       <env> ... X |-> dictVal(DS:DictItems) ... </env>
    requires dictLookupKeySupported(K)
      andBool notBool containsKey(K, DS)
  rule <k> K:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> ({}):Val ... </env>
    requires notBool dictLookupKeySupported(K)
  rule <k> K:Val ~> delSubscriptApply(X:Id) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> dictVal(_:DictItems) ... </env>
    requires notBool dictLookupKeySupported(K)
  rule <k> delSubscriptNestedStmt(X:Id, Outer:Exp, Inner:Exp) =>
           Outer ~> delSubscriptNestedInner(X, Inner)
       ... </k>
  rule <k> Outer:Val ~> delSubscriptNestedInner(X:Id, Inner:Exp) =>
           Inner ~> delSubscriptNestedApply(X, Outer)
       ... </k>
  rule <k> Inner:Val ~> delSubscriptNestedApply(X:Id, Outer:Val) => stmtNoResult ... </k>
       <env> ... X |-> (Base:Val => subscriptSet(Base, Outer, subscriptDel(subscriptGet(Base, Outer), Inner))) ... </env>
       <result> _ => .K </result>
    requires subscriptLookupable(Base, Outer)
      andBool subscriptDeletable(subscriptGet(Base, Outer), Inner)
  rule <k> delSliceStmt(X:Id, Lower:Exp, Upper:Exp) =>
           Lower ~> delSliceUpper(X, Upper)
       ... </k>
  rule <k> Lower:Val ~> delSliceUpper(X:Id, Upper:Exp) =>
           Upper ~> delSliceApply(X, Lower)
       ... </k>
  rule <k> Upper:Val ~> delSliceApply(X:Id, Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> delSliceApply(X:Id, _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
  rule <k> delSliceStepStmt(X:Id, Lower:Exp, Upper:Exp, Step:Exp) =>
           Lower ~> delSliceStepUpper(X, Upper, Step)
       ... </k>
  rule <k> Lower:Val ~> delSliceStepUpper(X:Id, Upper:Exp, Step:Exp) =>
           Upper ~> delSliceStepStep(X, Lower, Step)
       ... </k>
  rule <k> Upper:Val ~> delSliceStepStep(X:Id, Lower:Val, Step:Exp) =>
           Step ~> delSliceStepApply(X, Lower, Upper)
       ... </k>
  rule <k> Step:Val ~> delSliceStepApply(_X:Id, _Lower:Val, _Upper:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isIntLike(Step) andBool intValue(Step) ==Int 0
  rule <k> Step:Val ~> delSliceStepApply(X:Id, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> delSliceStepApply(X:Id, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceStepDelete(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) >Int 1
  rule <k> Step:Val ~> delSliceStepApply(X:Id, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceStepDelete(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule <k> Step:Val ~> delSliceStepApply(X:Id, _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0

  rule <k> pass => stmtNoResult ... </k>
  rule <k> assertStmt(V:Val) => stmtNoResult ... </k>
    requires truthy(V)
  rule <k> assertStmt(V:Val) => exceptionSignal(#exception(#token("AssertionError", "Id"))) ... </k>
    requires notBool truthy(V)
  rule <k> assertMsgStmt(V:Val, _Msg:Exp) => stmtNoResult ... </k>
    requires truthy(V)
  rule <k> assertMsgStmt(V:Val, Msg:Exp) => Msg ~> assertMsgRaise ... </k>
    requires notBool truthy(V)
  rule <k> _Msg:Val ~> assertMsgRaise => exceptionSignal(#exception(#token("AssertionError", "Id"))) ... </k>
  rule <k> exceptionSignal(E:Val) ~> assertMsgRaise => exceptionSignal(E) ... </k>
  rule <k> globalStmt(_:Id) => stmtNoResult ... </k>
  rule <k> globalManyStmt(_:IdItems) => stmtNoResult ... </k>

  rule <k> stmtNoResult ~> stmtNext(SS:Stmts) => SS ... </k>
  rule <k> stmtNoResult ~> stmtEnd => .K ... </k>
endmodule
