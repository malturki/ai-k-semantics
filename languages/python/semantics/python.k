requires "domains.md"

module PYTHON-SYNTAX
  imports INT-SYNTAX
  imports ID-SYNTAX
  imports STRING-SYNTAX
  imports FLOAT-SYNTAX

  syntax Val ::= Int
               | Float
               | "#complex" "(" Float "," Float ")" [symbol(complexVal)]
               | String
               | "True" [symbol(pyTrue)]
               | "False" [symbol(pyFalse)]
               | "None" [symbol(pyNone)]
               | "Ellipsis" [symbol(pyEllipsis)]
               | "#bytes" "(" ")" [symbol(emptyBytesVal)]
               | "#bytes" "(" ValItems ")" [symbol(bytesVal)]
               | "#bytearray" "(" ")" [symbol(emptyBytearrayVal)]
               | "#bytearray" "(" ValItems ")" [symbol(bytearrayVal)]
               | "#memoryviewVal" "(" Val ")" [symbol(memoryviewVal)]
               | "[" "]" [symbol(emptyListVal)]
               | "[" ValItems "]" [symbol(listVal)]
               | "(" ")" [symbol(emptyTupleVal)]
               | "(" ValItems ")" [symbol(tupleVal)]
               | "{" "}" [symbol(emptyDictVal)]
               | "{" DictItems "}" [symbol(dictVal)]
               | "set" "(" ")" [symbol(emptySetVal)]
               | "{" ValItems "}" [symbol(setVal)]
               | "frozenset" "(" ")" [symbol(emptyFrozenSetVal)]
               | "frozenset" "(" ValItems ")" [symbol(frozensetVal)]
               | "#kwDefaultMissing" [symbol(kwDefaultMissing)]
               | "#exception" "(" Id ")" [symbol(exceptionVal)]

  syntax ValItems ::= Val "," [symbol(valItemsLast)]
                    | Val "," ValItems [symbol(valItemsCons)]

  syntax DictItems ::= Val ":" Val "," [symbol(dictItemsLast)]
                     | Val ":" Val "," DictItems [symbol(dictItemsCons)]

  syntax IdItems ::= "#id" "(" Id ")" [symbol(idItemsLast)]
                   | "#noIds" [symbol(noIdItems)]
                   | "#ids" "(" Id "," IdItems ")" [symbol(idItemsCons)]

  syntax Target ::= "#targetName" "(" Id ")" [symbol(targetName)]
                  | "#targetSeq" "(" Targets ")" [symbol(targetSeq)]
                  | "#targetStarSeq" "(" MaybeTargets ";" Id ";" MaybeTargets ")" [symbol(targetStarSeq)]

  syntax Targets ::= "#targetLast" "(" Target ")" [symbol(targetsLast)]
                   | "#targetCons" "(" Target "," Targets ")" [symbol(targetsCons)]

  syntax MaybeTargets ::= "#noTargets" [symbol(noTargets)]
                        | "#targets" "(" Targets ")" [symbol(someTargets)]

  syntax ArgExps ::= "#noArgs" [symbol(noArgExps)]
                   | "#arg" "(" Exp ")" [symbol(argExp)]
                   | "#args" "(" Exp "," ArgExps ")" [symbol(argExpsCons)]
                   | "#starArg" "(" Exp ")" [symbol(starArgExp)]
                   | "#starArgs" "(" Exp "," ArgExps ")" [symbol(starArgExpsCons)]

  syntax KwArgExps ::= "#noKwArgs" [symbol(noKwArgExps)]
                     | "#kwArg" "(" Id "," Exp ")" [symbol(kwArgExp)]
                     | "#kwArgs" "(" Id "," Exp "," KwArgExps ")" [symbol(kwArgExpsCons)]
                     | "#kwStarArg" "(" Exp ")" [symbol(kwStarArgExp)]
                     | "#kwStarArgs" "(" Exp "," KwArgExps ")" [symbol(kwStarArgExpsCons)]

  syntax DictExps ::= "#noDictItems" [symbol(noDictExps)]
                    | "#dictItem" "(" Exp "," Exp ")" [symbol(dictExpItem)]
                    | "#dictItems" "(" Exp "," Exp "," DictExps ")" [symbol(dictExpsCons)]
                    | "#dictStarItem" "(" Exp ")" [symbol(dictStarExpItem)]
                    | "#dictStarItems" "(" Exp "," DictExps ")" [symbol(dictStarExpsCons)]

  syntax FStringConversion ::= "#fstrConvStr" [symbol(fstrConvStr)]
                             | "#fstrConvRepr" [symbol(fstrConvRepr)]
                             | "#fstrConvAscii" [symbol(fstrConvAscii)]

  syntax FStringParts ::= "#fstrEnd" [symbol(fstrEnd)]
                         | "#fstrText" "(" String "," FStringParts ")" [symbol(fstrText)]
                         | "#fstrExp" "(" Exp "," FStringParts ")" [symbol(fstrExp)]
                         | "#fstrExpConv" "(" Exp "," FStringConversion "," FStringParts ")" [symbol(fstrExpConv)]
                         | "#fstrExpFormatEmpty" "(" Exp "," FStringParts ")" [symbol(fstrExpFormatEmpty)]
                         | "#fstrExpConvFormatEmpty" "(" Exp "," FStringConversion "," FStringParts ")" [symbol(fstrExpConvFormatEmpty)]
                         | "#fstrExpFormat" "(" Exp "," String "," FStringParts ")" [symbol(fstrExpFormat)]
                         | "#fstrExpConvFormat" "(" Exp "," FStringConversion "," String "," FStringParts ")" [symbol(fstrExpConvFormat)]
                         | "#fstrExpFormatParts" "(" Exp "," FStringParts "," FStringParts ")" [symbol(fstrExpFormatParts)]
                         | "#fstrExpConvFormatParts" "(" Exp "," FStringConversion "," FStringParts "," FStringParts ")" [symbol(fstrExpConvFormatParts)]

  syntax CompFilters ::= "#filter" "(" Exp ")" [symbol(compFilterLast)]
                       | "#filters" "(" Exp "," CompFilters ")" [symbol(compFiltersCons)]

  syntax MaybeCompFilters ::= "#noFilters" [symbol(noCompFilters)]
                            | CompFilters

  syntax CompClauses ::= "#compClause" "(" Exp "," Target "," MaybeCompFilters ")" [symbol(compClause)]
                       | "#compClauses" "(" Exp "," Target "," MaybeCompFilters "," CompClauses ")" [symbol(compClausesCons)]

  syntax MaybeCompClauses ::= "#noCompClauses" [symbol(noCompClauses)]
                            | "#compRest" "(" CompClauses ")" [symbol(compRest)]

  syntax MatchPattern ::= "#matchValue" "(" Exp ")" [symbol(matchValuePattern)]
                        | "#matchSingleton" "(" Val ")" [symbol(matchSingletonPattern)]
                        | "#matchCapture" "(" Id ")" [symbol(matchCapturePattern)]
                        | "#matchOr" "(" MatchPattern "," MatchPattern ")" [symbol(matchOrPattern)]
                        | "#matchAs" "(" MatchPattern "," Id ")" [symbol(matchAsPattern)]
                        | "#matchClass" "(" Id ")" [symbol(matchClassPattern)]
                        | "#matchClassArg" "(" Id "," MatchPattern ")" [symbol(matchClassArgPattern)]
                        | "#matchClassKw" "(" Id "," MatchAttrPatterns ")" [symbol(matchClassKwPattern)]
                        | "#matchClassArgKw" "(" Id "," MatchPattern "," MatchAttrPatterns ")" [symbol(matchClassArgKwPattern)]
                        | "#matchSequence" "(" MatchPatterns ")" [symbol(matchSequencePattern)]
                        | "#matchSequenceStar" "(" MatchPatterns "," MatchPatterns ")" [symbol(matchSequenceStarPattern)]
                        | "#matchSequenceStarCapture" "(" MatchPatterns "," Id "," MatchPatterns ")" [symbol(matchSequenceStarCapturePattern)]
                        | "#matchMapping" "(" MatchMapPatterns ")" [symbol(matchMappingPattern)]
                        | "#matchMappingRest" "(" MatchMapPatterns "," Id ")" [symbol(matchMappingRestPattern)]
                        | "#matchWildcard" [symbol(matchWildcardPattern)]

  syntax MatchPatterns ::= "#matchNoPatterns" [symbol(matchNoPatterns)]
                         | "#matchPattern" "(" MatchPattern "," MatchPatterns ")" [symbol(matchPatternCons)]

  syntax MatchMapPatterns ::= "#matchNoMapPatterns" [symbol(matchNoMapPatterns)]
                            | "#matchMapPattern" "(" Val "," MatchPattern "," MatchMapPatterns ")" [symbol(matchMapPatternCons)]

  syntax MatchAttrPatterns ::= "#matchNoAttrPatterns" [symbol(matchNoAttrPatterns)]
                             | "#matchAttrPattern" "(" Id "," MatchPattern "," MatchAttrPatterns ")" [symbol(matchAttrPatternCons)]

  syntax MatchCases ::= "#matchCase" "(" MatchPattern "," Block ")" [symbol(matchCaseLast)]
                      | "#matchCases" "(" MatchPattern "," Block "," MatchCases ")" [symbol(matchCasesCons)]
                      | "#matchCaseGuard" "(" MatchPattern "," Exp "," Block ")" [symbol(matchCaseGuardLast)]
                      | "#matchCasesGuard" "(" MatchPattern "," Exp "," Block "," MatchCases ")" [symbol(matchCasesGuardCons)]

  syntax MaybeMatchCases ::= "#noMatchCases" [symbol(noMatchCases)]
                           | "#someMatchCases" "(" MatchCases ")" [symbol(someMatchCases)]

  syntax ExceptHandlers ::= "#except" "(" Id "," Block ")" [symbol(exceptHandlersLast)]
                          | "#exceptAs" "(" Id "," Id "," Block ")" [symbol(exceptHandlersAsLast)]
                          | "#exceptTuple" "(" IdItems "," Block ")" [symbol(exceptHandlersTupleLast)]
                          | "#exceptTupleAs" "(" IdItems "," Id "," Block ")" [symbol(exceptHandlersTupleAsLast)]
                          | "#exceptAny" "(" Block ")" [symbol(exceptHandlersAnyLast)]
                          | "#excepts" "(" Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersCons)]
                          | "#exceptsAs" "(" Id "," Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersAsCons)]
                          | "#exceptsTuple" "(" IdItems "," Block "," ExceptHandlers ")" [symbol(exceptHandlersTupleCons)]
                          | "#exceptsTupleAs" "(" IdItems "," Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersTupleAsCons)]

  syntax CmpOp ::= "#lt" [symbol(cmpLt)]
                 | "#le" [symbol(cmpLe)]
                 | "#gt" [symbol(cmpGt)]
                 | "#ge" [symbol(cmpGe)]
                 | "#eq" [symbol(cmpEq)]
                 | "#ne" [symbol(cmpNe)]
                 | "#is" [symbol(cmpIs)]
                 | "#isNot" [symbol(cmpIsNot)]
                 | "#in" [symbol(cmpIn)]
                 | "#notIn" [symbol(cmpNotIn)]

  syntax AugOp ::= "#augAdd" [symbol(augAddOp)]
                 | "#augSub" [symbol(augSubOp)]
                 | "#augMul" [symbol(augMulOp)]
                 | "#augMatMul" [symbol(augMatMulOp)]
                 | "#augTrueDiv" [symbol(augTrueDivOp)]
                 | "#augFloorDiv" [symbol(augFloorDivOp)]
                 | "#augMod" [symbol(augModOp)]
                 | "#augPow" [symbol(augPowOp)]
                 | "#augLShift" [symbol(augLShiftOp)]
                 | "#augRShift" [symbol(augRShiftOp)]
                 | "#augBitAnd" [symbol(augBitAndOp)]
                 | "#augBitXor" [symbol(augBitXorOp)]
                 | "#augBitOr" [symbol(augBitOrOp)]

  syntax CmpChain ::= "#cmpLast" "(" CmpOp "," Exp ")" [symbol(cmpChainLast)]
                    | "#cmpCons" "(" CmpOp "," Exp "," CmpChain ")" [symbol(cmpChainCons)]

  syntax WithItem ::= "#withItem" "(" Exp ")" [symbol(withItem)]
                    | "#withItemAs" "(" Exp "," Id ")" [symbol(withItemAs)]
                    | "#withItemAsTarget" "(" Exp "," Target ")" [symbol(withItemAsTarget)]

  syntax WithItems ::= "#withOne" "(" WithItem ")" [symbol(withItemsLast)]
                     | "#withItems" "(" WithItem "," WithItems ")" [symbol(withItemsCons)]

  syntax Stmts ::= Stmt ";" Stmts [symbol(stmtsCons)]
                 | Stmt ";" [symbol(stmtsLast)]

  syntax Block ::= "{" "}" [symbol(emptyBlock)]
                 | "{" Stmts "}" [symbol(block)]

  syntax FunctionSpec ::= "#function" "(" Id "," Block ")" [symbol(functionSpecOne)]
                        | "#functionArgs" "(" IdItems "," Block ")" [symbol(functionSpecArgs)]
                        | "#functionDefaults" "(" IdItems "," ArgExps "," Block ")" [symbol(functionSpecDefaults)]
                        | "#functionVarArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecVarArgs)]
                        | "#functionVarArgsKwOnly" "(" IdItems "," Id "," IdItems "," Block ")" [symbol(functionSpecVarArgsKwOnly)]
                        | "#functionVarArgsKwOnlyKwArgs" "(" IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionSpecVarArgsKwOnlyKwArgs)]
                        | "#functionVarKwArgs" "(" IdItems "," Id "," Id "," Block ")" [symbol(functionSpecVarKwArgs)]
                        | "#functionKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecKwArgs)]
                        | "#functionPosOnly" "(" IdItems "," IdItems "," Block ")" [symbol(functionSpecPosOnly)]
                        | "#functionPosOnlyVarArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyVarArgs)]
                        | "#functionPosOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyKwArgs)]
                        | "#functionPosOnlyVarKwArgs" "(" IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionSpecPosOnlyVarKwArgs)]
                        | "#functionPosOnlyVarArgsKwOnly" "(" IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionSpecPosOnlyVarArgsKwOnly)]
                        | "#functionPosOnlyVarArgsKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyVarArgsKwOnlyKwArgs)]
                        | "#functionPosOnlyKwOnly" "(" IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionSpecPosOnlyKwOnly)]
                        | "#functionPosOnlyKwOnlyKwArgs" "(" IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyKwOnlyKwArgs)]
                        | "#functionKwOnly" "(" IdItems "," Block ")" [symbol(functionSpecKwOnly)]
                        | "#functionKwOnlyKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecKwOnlyKwArgs)]
                        | "#functionPosKwOnly" "(" IdItems "," IdItems "," Block ")" [symbol(functionSpecPosKwOnly)]
                        | "#functionPosKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosKwOnlyKwArgs)]
                        | "#functionDefaultSpec" "(" ArgExps "," FunctionDefaultBuilder ")" [symbol(functionSpecDefaultBuilder)]
                        | "#functionTwoDefaultSpec" "(" ArgExps "," ArgExps "," FunctionTwoDefaultBuilder ")" [symbol(functionSpecTwoDefaultBuilder)]

  syntax FunctionDefaultBuilder ::= "#buildFunctionDefaults" "(" IdItems "," Block ")" [symbol(functionDefaultBuilderDefaults)]
                                  | "#buildFunctionVarArgsDefaults" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderVarArgsDefaults)]
                                  | "#buildFunctionVarKwArgsDefaults" "(" IdItems "," Id "," Id "," Block ")" [symbol(functionDefaultBuilderVarKwArgsDefaults)]
                                  | "#buildFunctionKwArgsDefaults" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderKwArgsDefaults)]
                                  | "#buildFunctionPosOnlyDefaults" "(" IdItems "," IdItems "," Block ")" [symbol(functionDefaultBuilderPosOnlyDefaults)]
                                  | "#buildFunctionPosOnlyVarArgsDefaults" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyVarArgsDefaults)]
                                  | "#buildFunctionPosOnlyKwArgsDefaults" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyKwArgsDefaults)]
                                  | "#buildFunctionPosOnlyVarKwArgsDefaults" "(" IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyVarKwArgsDefaults)]
                                  | "#buildFunctionKwDefaults" "(" IdItems "," Block ")" [symbol(functionDefaultBuilderKwDefaults)]
                                  | "#buildFunctionKwDefaultsKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderKwDefaultsKwArgs)]

  syntax FunctionTwoDefaultBuilder ::= "#buildFunctionVarArgsKwDefaults" "(" IdItems "," Id "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderVarArgsKwDefaults)]
                                     | "#buildFunctionVarArgsKwDefaultsKwArgs" "(" IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderVarArgsKwDefaultsKwArgs)]
                                     | "#buildFunctionPosOnlyVarArgsKwDefaults" "(" IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyVarArgsKwDefaults)]
                                     | "#buildFunctionPosOnlyVarArgsKwDefaultsKwArgs" "(" IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyVarArgsKwDefaultsKwArgs)]
                                     | "#buildFunctionPosOnlyKwOnlyDefaults" "(" IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyKwOnlyDefaults)]
                                     | "#buildFunctionPosOnlyKwDefaultsKwArgs" "(" IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyKwDefaultsKwArgs)]
                                     | "#buildFunctionPosKwDefaults" "(" IdItems "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosKwDefaults)]
                                     | "#buildFunctionPosKwDefaultsKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosKwDefaultsKwArgs)]

  syntax Stmt ::= Exp
                | "pass" [symbol(passStmt)]
                | "break" [symbol(breakStmt)]
                | "continue" [symbol(continueStmt)]
                | "assert" Exp [symbol(assertStmt), strict]
                | "#assertMsg" "(" Exp "," Exp ")" [symbol(assertMsgStmt), strict(1)]
                | "global" Id [symbol(globalStmt)]
                | "#globalMany" "(" IdItems ")" [symbol(globalManyStmt)]
                | "del" Id [symbol(delNameStmt)]
                | "#delMany" "(" IdItems ")" [symbol(delManyStmt)]
                | "#delSubscript" "(" Id "," Exp ")" [symbol(delSubscriptStmt)]
                | "#delSubscript2" "(" Id "," Exp "," Exp ")" [symbol(delSubscriptNestedStmt)]
                | "#delSlice" "(" Id "," Exp "," Exp ")" [symbol(delSliceStmt)]
                | "#delSliceStep" "(" Id "," Exp "," Exp "," Exp ")" [symbol(delSliceStepStmt)]
                | Id "=" Exp [symbol(assignStmt), strict(2)]
                | "#assignName" "(" Id "," Exp ")" [symbol(assignNameStmt), strict(2)]
                | Id "+=" Exp [symbol(augAddStmt)]
                | Id "-=" Exp [symbol(augSubStmt)]
                | Id "*=" Exp [symbol(augMulStmt)]
                | Id "@=" Exp [symbol(augMatMulStmt)]
                | Id "/=" Exp [symbol(augTrueDivStmt)]
                | Id "%=" Exp [symbol(augModStmt)]
                | Id "**=" Exp [symbol(augPowStmt)]
                | Id "<<=" Exp [symbol(augLShiftStmt)]
                | Id ">>=" Exp [symbol(augRShiftStmt)]
                | Id "&=" Exp [symbol(augBitAndStmt)]
                | Id "^=" Exp [symbol(augBitXorStmt)]
                | Id "|=" Exp [symbol(augBitOrStmt)]
                | "#floorDivAssign" "(" Id "," Exp ")" [symbol(augFloorDivStmt)]
                | "#assignMany" "(" IdItems ";" Exp ")" [symbol(assignManyStmt), strict(2)]
                | "#subscriptAssign" "(" Id "," Exp "," Exp ")" [symbol(subscriptAssignStmt)]
                | "#subscriptAssign2" "(" Id "," Exp "," Exp "," Exp ")" [symbol(subscriptAssignNestedStmt)]
                | "#subscriptAug" "(" Id "," Exp "," AugOp "," Exp ")" [symbol(subscriptAugStmt)]
                | "#sliceAssign" "(" Id "," Exp "," Exp "," Exp ")" [symbol(sliceAssignStmt)]
                | "#sliceStepAssign" "(" Id "," Exp "," Exp "," Exp "," Exp ")" [symbol(sliceStepAssignStmt)]
                | "#unpackAssign" "(" IdItems ";" Exp ")" [symbol(unpackAssignStmt), strict(2)]
                | "#unpackStarAssign" "(" IdItems ";" Id ";" IdItems ";" Exp ")" [symbol(unpackStarAssignStmt), strict(4)]
                | "#unpackTargetAssign" "(" Targets ";" Exp ")" [symbol(unpackTargetAssignStmt), strict(2)]
                | "#targetAssign" "(" Target ";" Exp ")" [symbol(targetAssignStmt), strict(2)]
                | "#annAssign" "(" Id "," Exp ")" [symbol(annAssignStmt), strict(2)]
                | "#annOnly" "(" Id ")" [symbol(annOnlyStmt)]
                | "return" [symbol(returnNoneStmt)]
                | "return" Exp [symbol(returnStmt)]
                | "#def" "(" Id "," Id "," Block ")" [symbol(functionDefStmt)]
                | "#defArgs" "(" Id "," IdItems "," Block ")" [symbol(functionDefArgsStmt)]
                | "#defDefaults" "(" Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefDefaultsStmt)]
                | "#defVarArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefVarArgsStmt)]
                | "#defVarArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefVarArgsDefaultsStmt)]
                | "#defVarArgsKwOnly" "(" Id "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionDefVarArgsKwOnlyStmt)]
                | "#defVarArgsKwDefaults" "(" Id "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefVarArgsKwDefaultsStmt)]
                | "#defVarArgsKwOnlyKwArgs" "(" Id "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionDefVarArgsKwOnlyKwArgsStmt)]
                | "#defVarArgsKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefVarArgsKwDefaultsKwArgsStmt)]
                | "#defVarKwArgs" "(" Id "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefVarKwArgsStmt)]
                | "#defVarKwArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Id "," Block ")" [symbol(functionDefVarKwArgsDefaultsStmt)]
                | "#defKwArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefKwArgsStmt)]
                | "#defKwArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefKwArgsDefaultsStmt)]
                | "#defPosOnly" "(" Id "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosOnlyStmt)]
                | "#defPosOnlyDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyDefaultsStmt)]
                | "#defPosOnlyVarArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsStmt)]
                | "#defPosOnlyVarArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsDefaultsStmt)]
                | "#defPosOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyKwArgsStmt)]
                | "#defPosOnlyKwArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyKwArgsDefaultsStmt)]
                | "#defPosOnlyVarKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefPosOnlyVarKwArgsStmt)]
                | "#defPosOnlyVarKwArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Id "," Block ")" [symbol(functionDefPosOnlyVarKwArgsDefaultsStmt)]
                | "#defPosOnlyVarArgsKwOnly" "(" Id "," IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionDefPosOnlyVarArgsKwOnlyStmt)]
                | "#defPosOnlyVarArgsKwDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyVarArgsKwDefaultsStmt)]
                | "#defPosOnlyVarArgsKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsKwOnlyKwArgsStmt)]
                | "#defPosOnlyVarArgsKwDefaultsKwArgs" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsKwDefaultsKwArgsStmt)]
                | "#defPosOnlyKwOnly" "(" Id "," IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosOnlyKwOnlyStmt)]
                | "#defPosOnlyKwOnlyDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyKwOnlyDefaultsStmt)]
                | "#defPosOnlyKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyKwOnlyKwArgsStmt)]
                | "#defPosOnlyKwDefaultsKwArgs" "(" Id "," IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyKwDefaultsKwArgsStmt)]
                | "#defKwOnly" "(" Id "," IdItems "," Block ")" [symbol(functionDefKwOnlyStmt)]
                | "#defKwDefaults" "(" Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefKwDefaultsStmt)]
                | "#defKwOnlyKwArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefKwOnlyKwArgsStmt)]
                | "#defKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefKwDefaultsKwArgsStmt)]
                | "#defPosKwOnly" "(" Id "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosKwOnlyStmt)]
                | "#defPosKwDefaults" "(" Id "," IdItems "," ArgExps "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosKwDefaultsStmt)]
                | "#defPosKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosKwOnlyKwArgsStmt)]
                | "#defPosKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosKwDefaultsKwArgsStmt)]
                | "#defDecorated" "(" Id "," ArgExps "," FunctionSpec ")" [symbol(functionDefDecoratedStmt)]
                | "#if" "(" Exp "," Block "," Block ")" [symbol(ifStmt)]
                | "#while" "(" Exp "," Block ")" [symbol(whileStmt)]
                | "#whileElse" "(" Exp "," Block "," Block ")" [symbol(whileElseStmt)]
                | "#for" "(" Id "," Exp "," Block ")" [symbol(forStmt)]
                | "#forElse" "(" Id "," Exp "," Block "," Block ")" [symbol(forElseStmt)]
                | "#forUnpack" "(" IdItems "," Exp "," Block ")" [symbol(forUnpackStmt)]
                | "#forUnpackElse" "(" IdItems "," Exp "," Block "," Block ")" [symbol(forUnpackElseStmt)]
                | "#forTargetUnpack" "(" Targets "," Exp "," Block ")" [symbol(forTargetUnpackStmt)]
                | "#forTargetUnpackElse" "(" Targets "," Exp "," Block "," Block ")" [symbol(forTargetUnpackElseStmt)]
                | "#forTarget" "(" Target "," Exp "," Block ")" [symbol(forTargetStmt)]
                | "#forTargetElse" "(" Target "," Exp "," Block "," Block ")" [symbol(forTargetElseStmt)]
                | "#forStarUnpack" "(" IdItems "," Id "," IdItems "," Exp "," Block ")" [symbol(forStarUnpackStmt)]
                | "#forStarUnpackElse" "(" IdItems "," Id "," IdItems "," Exp "," Block "," Block ")" [symbol(forStarUnpackElseStmt)]
                | "#with" "(" Exp "," Block ")" [symbol(withStmt)]
                | "#withAs" "(" Exp "," Id "," Block ")" [symbol(withAsStmt)]
                | "#withAsTarget" "(" Exp "," Target "," Block ")" [symbol(withAsTargetStmt)]
                | "#withMany" "(" WithItems "," Block ")" [symbol(withManyStmt)]
                | "raise" [symbol(reraiseStmt)]
                | "raise" Exp [symbol(raiseStmt), strict]
                | "#raiseFromNone" "(" Exp ")" [symbol(raiseFromNoneStmt), strict]
                | "#raiseFrom" "(" Exp "," Exp ")" [symbol(raiseFromStmt), strict]
                | "#match" "(" Exp "," MatchCases ")" [symbol(matchStmt)]
                | "#tryExcept" "(" Block "," Id "," Block ")" [symbol(tryExceptStmt)]
                | "#tryExceptElse" "(" Block "," Id "," Block "," Block ")" [symbol(tryExceptElseStmt)]
                | "#tryExceptCases" "(" Block "," ExceptHandlers ")" [symbol(tryExceptCasesStmt)]
                | "#tryExceptCasesElse" "(" Block "," ExceptHandlers "," Block ")" [symbol(tryExceptCasesElseStmt)]
                | "#tryFinally" "(" Block "," Block ")" [symbol(tryFinallyStmt)]

  syntax Exp ::= Val
               | Id
               | "#name" "(" Id ")" [symbol(nameExp)]
               | "#debug" [symbol(debugExp)]
               | "#namedExpr" "(" Id "," Exp ")" [symbol(namedExprExp), strict(2)]
               | "(" Exp ")" [bracket]
               | Exp "(" Exp ")" [symbol(callExp)]
               | "#call" "(" Exp "," ArgExps ")" [symbol(callArgsExp)]
               | "#callKw" "(" Exp "," KwArgExps ")" [symbol(callKwArgsExp)]
               | "#callMixed" "(" Exp "," ArgExps "," KwArgExps ")" [symbol(callMixedArgsExp)]
