  rule <k> matchDispatch(V:Val, #matchCases(#matchSequenceStarCapture(Prefix:MatchPatterns, _Name:Id, Suffix:MatchPatterns), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchStarSequence(V, Prefix, Suffix)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMapping(MPS:MatchMapPatterns), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMapping(MPS:MatchMapPatterns), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMapping(MPS:MatchMapPatterns), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMapping(MPS:MatchMapPatterns), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMapping(MPS:MatchMapPatterns), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMapping(MPS:MatchMapPatterns), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMappingRest(MPS:MatchMapPatterns, Name:Id), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ] </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMappingRest(MPS:MatchMapPatterns, Name:Id), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ] </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchMappingRest(MPS:MatchMapPatterns, _Name:Id), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMappingRest(MPS:MatchMapPatterns, Name:Id), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ] </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMappingRest(MPS:MatchMapPatterns, Name:Id), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ] </env>
    requires matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchMappingRest(MPS:MatchMapPatterns, _Name:Id), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClass(C:Id), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
    requires matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClass(C:Id), {})) =>
           stmtNoResult
      ... </k>
    requires matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClass(C:Id), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClass(C:Id), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
    requires matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClass(C:Id), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
    requires matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClass(C:Id), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClass(V, C)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArg(C:Id, P:MatchPattern), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArg(C, P)) </env>
    requires matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArg(C:Id, P:MatchPattern), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArg(C, P)) </env>
    requires matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArg(C:Id, P:MatchPattern), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArg(C:Id, P:MatchPattern), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArg(C, P)) </env>
    requires matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArg(C:Id, P:MatchPattern), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArg(C, P)) </env>
    requires matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArg(C:Id, P:MatchPattern), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassArg(V, C, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassKw(C:Id, APS:MatchAttrPatterns), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassKw(C, APS)) </env>
    requires matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassKw(C:Id, APS:MatchAttrPatterns), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassKw(C, APS)) </env>
    requires matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassKw(C:Id, APS:MatchAttrPatterns), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassKw(C:Id, APS:MatchAttrPatterns), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassKw(C, APS)) </env>
    requires matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassKw(C:Id, APS:MatchAttrPatterns), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassKw(C, APS)) </env>
    requires matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassKw(C:Id, APS:MatchAttrPatterns), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassKw(V, C, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArgKw(C, P, APS)) </env>
    requires matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArgKw(C, P, APS)) </env>
    requires matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArgKw(C, P, APS)) </env>
    requires matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArgKw(C, P, APS)) </env>
    requires matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCases(#matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchDispatch(V:Val, #matchCase(#matchSingleton(P:Val), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
    requires singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchSingleton(P:Val), {})) =>
           stmtNoResult
      ... </k>
    requires singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchSingleton(P:Val), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchSingleton(P:Val), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
    requires singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchSingleton(P:Val), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
    requires singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchSingleton(P:Val), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool singletonPatternEq(V, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchValue(P:Exp), Body:Block)) =>
           P ~> matchValueDispatch(V, Body, #matchCase(#matchWildcard, {}))
      ... </k>
  rule <k> matchDispatch(V:Val, #matchCases(#matchValue(P:Exp), Body:Block, Rest:MatchCases)) =>
           P ~> matchValueDispatch(V, Body, Rest)
      ... </k>
  rule <k> P:Val ~> matchValueDispatch(V:Val, block(SS:Stmts), _Rest:MatchCases) =>
           SS ~> matchDone
      ... </k>
    requires valEq(V, P)
  rule <k> P:Val ~> matchValueDispatch(V:Val, {}, _Rest:MatchCases) =>
           stmtNoResult
      ... </k>
    requires valEq(V, P)
  rule <k> P:Val ~> matchValueDispatch(V:Val, _Body:Block, Rest:MatchCases) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool valEq(V, P)
  rule <k> matchDone => stmtNoResult ... </k>

  rule <k> whileStmt(C:Exp, Body:Block) =>
           C ~> whileStmtBranch(C, Body)
       ... </k>
  rule <k> V:Val ~> whileStmtBranch(C:Exp, block(SS:Stmts)) =>
           SS ~> whileStmtAgain(C, block(SS))
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> whileStmtBranch(C:Exp, {}) =>
           whileStmt(C, {})
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> whileStmtBranch(_:Exp, _:Block) =>
           stmtNoResult
       ... </k>
    requires notBool truthy(V)
  rule <k> whileStmtAgain(C:Exp, Body:Block) =>
           whileStmt(C, Body)
       ... </k>

  rule <k> whileElseStmt(C:Exp, Body:Block, Else:Block) =>
           C ~> whileElseStmtBranch(C, Body, Else)
       ... </k>
  rule <k> V:Val ~> whileElseStmtBranch(C:Exp, block(SS:Stmts), Else:Block) =>
           SS ~> whileElseStmtAgain(C, block(SS), Else)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> whileElseStmtBranch(C:Exp, {}, Else:Block) =>
           whileElseStmt(C, {}, Else)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> whileElseStmtBranch(_:Exp, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
    requires notBool truthy(V)
  rule <k> whileElseStmtAgain(C:Exp, Body:Block, Else:Block) =>
           whileElseStmt(C, Body, Else)
       ... </k>

  rule <k> forStmt(X:Id, E:Exp, Body:Block) =>
           E ~> forIter(X, Body)
       ... </k>
  rule <k> [] ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> () ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> bytesVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> #bytearray() ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> bytearrayVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> #memoryviewVal(#bytes()) ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> #memoryviewVal(bytesVal(VS:ValItems)) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> #memoryviewVal(#bytearray()) ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> #memoryviewVal(bytearrayVal(VS:ValItems)) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> S:String ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forIter(X:Id, Body:Block) =>
           forItems(X, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forIter(X:Id, Body:Block) =>
           forRange(X, Start, Stop, Body)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forIter(X:Id, Body:Block) =>
           forRangeStep(X, Start, Stop, Step, Body)
       ... </k>
    requires Step =/=Int 0
  rule <k> ({}):Val ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> frozenset() ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forIter(X:Id, Body:Block) =>
           forItems(X, VS, Body)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forIter(X:Id, Body:Block) =>
           forItems(X, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forIter(X:Id, Body:Block) =>
           forItems(X, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forIter(_:Id, _:Block) => stmtNoResult ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forIter(X:Id, Body:Block) =>
           forItems(X, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forIter(X:Id, Body:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForIter(X, Body)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forIter(X:Id, Body:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForIter(X, Body)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> iteratorRef(I:Int) ~> forIter(X:Id, Body:Block) =>
           forIterator(I, X, Body)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forTargetIterator(I, targetSeq(idItemsToTargets(IDS)), Body)
       ... </k>
    requires idItemsLen(IDS) >Int 0
  rule <k> iteratorRef(I:Int) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetIterator(I, targetSeq(TS), Body)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetIterator(I, T, Body)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forTargetIterator(I, targetStarSeq(idItemsToMaybeTargets(Prefix), Star, idItemsToMaybeTargets(Suffix)), Body)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forTargetIteratorElse(I, targetSeq(idItemsToTargets(IDS)), Body, Else)
       ... </k>
    requires idItemsLen(IDS) >Int 0
  rule <k> iteratorRef(I:Int) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetIteratorElse(I, targetSeq(TS), Body, Else)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forTargetElseIter(T:Target, Body:Block, Else:Block) =>
           forTargetIteratorElse(I, T, Body, Else)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> forStarUnpackElseIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block, Else:Block) =>
           forTargetIteratorElse(I, targetStarSeq(idItemsToMaybeTargets(Prefix), Star, idItemsToMaybeTargets(Suffix)), Body, Else)
       ... </k>
  rule <k> forIterator(I:Int, _:Id, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> forIterator(I:Int, X:Id, Body:Block) =>
           argsVal(#noArgVals) ~> callApplyArgs(F) ~> callableForIteratorNext(I, X, Body)
       ... </k>
       <iterators> ... I |-> callableIterator(F:Val, _Sentinel:Val) ... </iterators>
  rule <k> _V:Val ~> callableForIteratorNext(I:Int, _:Id, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> V:Val ~> callableForIteratorNext(I:Int, _:Id, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, Sentinel:Val) => #noArgVals) ... </iterators>
    requires valEq(V, Sentinel)
  rule <k> V:Val ~> callableForIteratorNext(I:Int, X:Id, block(SS:Stmts)) =>
           SS ~> forIterator(I, X, block(SS))
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
  rule <k> V:Val ~> callableForIteratorNext(I:Int, X:Id, {}) =>
           forIterator(I, X, {})
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorNext(I:Int, _:Id, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, _Sentinel:Val) => #noArgVals) ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorNext(I:Int, _:Id, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorNext(_I:Int, _:Id, _:Block) =>
           exceptionSignal(E)
       ... </k>
    requires notBool exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> forIterator(I:Int, X:Id, block(SS:Stmts)) =>
           SS ~> forIterator(I, X, block(SS))
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
  rule <k> forIterator(I:Int, X:Id, {}) =>
           forIterator(I, X, {})
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>

  rule <k> forTargetIterator(I:Int, _:Target, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> forTargetIterator(I:Int, T:Target, Body:Block) =>
           argsVal(#noArgVals) ~> callApplyArgs(F) ~> callableForTargetIteratorNext(I, T, Body)
       ... </k>
       <iterators> ... I |-> callableIterator(F:Val, _Sentinel:Val) ... </iterators>
  rule <k> _V:Val ~> callableForTargetIteratorNext(I:Int, _:Target, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> V:Val ~> callableForTargetIteratorNext(I:Int, _:Target, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, Sentinel:Val) => #noArgVals) ... </iterators>
    requires valEq(V, Sentinel)
  rule <k> V:Val ~> callableForTargetIteratorNext(I:Int, T:Target, block(SS:Stmts)) =>
           SS ~> forTargetIterator(I, T, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
      andBool targetValueArityOk(T, V)
  rule <k> V:Val ~> callableForTargetIteratorNext(I:Int, T:Target, {}) =>
           forTargetIterator(I, T, {})
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
      andBool targetValueArityOk(T, V)
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorNext(I:Int, _:Target, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, _Sentinel:Val) => #noArgVals) ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorNext(I:Int, _:Target, _:Block) =>
           stmtNoResult
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorNext(_I:Int, _:Target, _:Block) =>
           exceptionSignal(E)
       ... </k>
    requires notBool exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> forTargetIterator(I:Int, T:Target, block(SS:Stmts)) =>
           SS ~> forTargetIterator(I, T, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
    requires targetValueArityOk(T, V)
  rule <k> forTargetIterator(I:Int, T:Target, {}) =>
           forTargetIterator(I, T, {})
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
    requires targetValueArityOk(T, V)

  rule <k> forTargetIteratorElse(I:Int, _:Target, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> forTargetIteratorElse(I:Int, T:Target, Body:Block, Else:Block) =>
           argsVal(#noArgVals) ~> callApplyArgs(F) ~> callableForTargetIteratorElseNext(I, T, Body, Else)
       ... </k>
       <iterators> ... I |-> callableIterator(F:Val, _Sentinel:Val) ... </iterators>
  rule <k> _V:Val ~> callableForTargetIteratorElseNext(I:Int, _:Target, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> V:Val ~> callableForTargetIteratorElseNext(I:Int, _:Target, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, Sentinel:Val) => #noArgVals) ... </iterators>
    requires valEq(V, Sentinel)
  rule <k> V:Val ~> callableForTargetIteratorElseNext(I:Int, T:Target, block(SS:Stmts), Else:Block) =>
           SS ~> forTargetIteratorElse(I, T, block(SS), Else)
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
      andBool targetValueArityOk(T, V)
  rule <k> V:Val ~> callableForTargetIteratorElseNext(I:Int, T:Target, {}, Else:Block) =>
           forTargetIteratorElse(I, T, {}, Else)
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
      andBool targetValueArityOk(T, V)
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorElseNext(I:Int, _:Target, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, _Sentinel:Val) => #noArgVals) ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorElseNext(I:Int, _:Target, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForTargetIteratorElseNext(_I:Int, _:Target, _:Block, _Else:Block) =>
           exceptionSignal(E)
       ... </k>
    requires notBool exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> forTargetIteratorElse(I:Int, T:Target, block(SS:Stmts), Else:Block) =>
           SS ~> forTargetIteratorElse(I, T, block(SS), Else)
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
    requires targetValueArityOk(T, V)
  rule <k> forTargetIteratorElse(I:Int, T:Target, {}, Else:Block) =>
           forTargetIteratorElse(I, T, {}, Else)
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
    requires targetValueArityOk(T, V)

  rule <k> forItems(X:Id, valItemsCons(V:Val, VS:ValItems), block(SS:Stmts)) =>
           SS ~> forItems(X, VS, block(SS))
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forItems(X:Id, valItemsLast(V:Val), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forItems(X:Id, valItemsCons(V:Val, VS:ValItems), {}) =>
           forItems(X, VS, {})
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forItems(X:Id, valItemsLast(V:Val), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forDone => stmtNoResult ... </k>

  rule <k> forUnpackStmt(IDS:IdItems, E:Exp, Body:Block) =>
           E ~> forUnpackIter(IDS, Body)
       ... </k>
  rule <k> [] ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, VS, Body)
       ... </k>
  rule <k> () ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, VS, Body)
       ... </k>
  rule <k> frozenset() ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, VS, Body)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForUnpackIter(IDS, Body)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForUnpackIter(IDS, Body)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forUnpackIter(_:IdItems, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forUnpackIter(IDS:IdItems, Body:Block) =>
           forUnpackItems(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(listVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(tupleVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(bytesVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(bytearrayVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(S:String, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(dictVal(DS:DictItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forUnpackItems(IDS, Rest, block(SS))
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(listVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(tupleVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(bytesVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(bytearrayVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(S:String), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(dictVal(DS:DictItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(setVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(listVal(VS:ValItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(tupleVal(VS:ValItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(bytesVal(VS:ValItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(bytearrayVal(VS:ValItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(S:String, Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(dictVal(DS:DictItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), {}) =>
           forUnpackItems(IDS, Rest, {})
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(listVal(VS:ValItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(tupleVal(VS:ValItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(bytesVal(VS:ValItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(bytearrayVal(VS:ValItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(S:String), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(dictVal(DS:DictItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(setVal(VS:ValItems)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))

  rule <k> forTargetUnpackStmt(TS:Targets, E:Exp, Body:Block) =>
           E ~> forTargetUnpackIter(TS, Body)
       ... </k>
  rule <k> [] ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> () ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> frozenset() ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForTargetUnpackIter(TS, Body)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForTargetUnpackIter(TS, Body)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forTargetUnpackItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forTargetUnpackItems(TS, Rest, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsLast(V:Val), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), {}) =>
           forTargetUnpackItems(TS, Rest, {})
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsLast(V:Val), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)

  rule <k> forTargetStmt(T:Target, E:Exp, Body:Block) =>
           E ~> forTargetIter(T, Body)
       ... </k>
  rule <k> [] ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> () ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> frozenset() ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, argValsToValItems(VS), Body)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forTargetIter(T:Target, Body:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForTargetIter(T, Body)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forTargetIter(T:Target, Body:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForTargetIter(T, Body)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forTargetItems(T:Target, valItemsCons(V:Val, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forTargetItems(T, Rest, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> forTargetItems(T:Target, valItemsLast(V:Val), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> forTargetItems(T:Target, valItemsCons(V:Val, Rest:ValItems), {}) =>
           forTargetItems(T, Rest, {})
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> forTargetItems(T:Target, valItemsLast(V:Val), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)

  rule <k> forStarUnpackStmt(Prefix:IdItems, Star:Id, Suffix:IdItems, E:Exp, Body:Block) =>
           E ~> forStarUnpackIter(Prefix, Star, Suffix, Body)
       ... </k>
  rule <k> [] ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, VS, Body)
       ... </k>
  rule <k> () ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, VS, Body)
       ... </k>
  rule <k> frozenset() ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, VS, Body)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forStarUnpackIter(_:IdItems, _:Id, _:IdItems, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forStarUnpackIter(Prefix:IdItems, Star:Id, Suffix:IdItems, Body:Block) =>
           forStarUnpackItems(Prefix, Star, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(listVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(tupleVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(bytesVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(bytearrayVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(S:String, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, lengthString(S))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(dictVal(DS:DictItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, dictKeysToValItems(DS)) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(dictKeysToValItems(DS)))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, 1))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, Step))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons([], Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons((), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(({}):Val, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(#bytes(), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(#bytearray(), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(set(), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(S:String, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires lengthString(S) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forStarUnpackItems(Prefix, Star, Suffix, Rest, block(SS))
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(listVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(tupleVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(bytesVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(bytearrayVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(S:String), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, lengthString(S))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(dictVal(DS:DictItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, dictKeysToValItems(DS)) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(dictKeysToValItems(DS)))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(setVal(VS:ValItems)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, VS) </env>
    requires starUnpackArityOk(Prefix, Suffix, valItemsLen(VS))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, 1))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, pyRangeLen(Start, Stop, Step))
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast([]), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
