  rule <k> unpackTargetAssignStmt(TS:Targets, rangeVal(Start:Int, Stop:Int, Step:Int)) => stmtNoResult ... </k>
       <env> Rho => bindTargets(Rho, TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
       <result> _ => .K </result>
    requires Step =/=Int 0
