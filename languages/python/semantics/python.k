  rule sliceStepExp(S:String, Lower:Val, Upper:Val, Step:Val) =>
    sliceStepString(S, pySliceLowerNeg(Lower, stringCodePointLen(S, 0)), pySliceUpperNeg(Upper, stringCodePointLen(S, 0)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp(#bytes(), _Lower:Val, _Upper:Val, Step:Val) => #bytes()
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule sliceStepExp(bytesVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    bytesSliceStep(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(bytesVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    bytesSliceStep(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp(#bytearray(), _Lower:Val, _Upper:Val, Step:Val) => #bytearray()
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule sliceStepExp(bytearrayVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    bytesToBytearray(bytesSliceStep(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)))
    requires isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(bytearrayVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    bytesToBytearray(bytesSliceStep(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp([], _Lower:Val, _Upper:Val, Step:Val) => []
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule sliceStepExp(listVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    listSliceStep(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(listVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    listSliceStep(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp((), _Lower:Val, _Upper:Val, Step:Val) => ()
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule sliceStepExp(tupleVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    tupleSliceStep(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(tupleVal(VS:ValItems), Lower:Val, Upper:Val, Step:Val) =>
    tupleSliceStep(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp(rangeVal(Start:Int, Stop:Int), Lower:Val, Upper:Val, Step:Val) =>
    rangeSliceStep(Start, Stop, 1, pySliceLower(Lower, pyRangeLen(Start, Stop, 1)), pySliceUpper(Upper, pyRangeLen(Start, Stop, 1)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(rangeVal(Start:Int, Stop:Int), Lower:Val, Upper:Val, Step:Val) =>
    rangeSliceStep(Start, Stop, 1, pySliceLowerNeg(Lower, pyRangeLen(Start, Stop, 1)), pySliceUpperNeg(Upper, pyRangeLen(Start, Stop, 1)), intValue(Step))
    requires isIntLike(Step) andBool intValue(Step) <Int 0
  rule sliceStepExp(rangeVal(Start:Int, Stop:Int, RangeStep:Int), Lower:Val, Upper:Val, Step:Val) =>
    rangeSliceStep(Start, Stop, RangeStep, pySliceLower(Lower, pyRangeLen(Start, Stop, RangeStep)), pySliceUpper(Upper, pyRangeLen(Start, Stop, RangeStep)), intValue(Step))
    requires RangeStep =/=Int 0 andBool isIntLike(Step) andBool intValue(Step) >Int 0
  rule sliceStepExp(rangeVal(Start:Int, Stop:Int, RangeStep:Int), Lower:Val, Upper:Val, Step:Val) =>
    rangeSliceStep(Start, Stop, RangeStep, pySliceLowerNeg(Lower, pyRangeLen(Start, Stop, RangeStep)), pySliceUpperNeg(Upper, pyRangeLen(Start, Stop, RangeStep)), intValue(Step))
    requires RangeStep =/=Int 0 andBool isIntLike(Step) andBool intValue(Step) <Int 0

  rule attrExp(rangeVal(Start:Int, _:Int), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule attrExp(rangeVal(_:Int, Stop:Int), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule attrExp(rangeVal(_:Int, _:Int), Attr:Id) => 1
    requires Id2String(Attr) ==String "step"
  rule attrExp(rangeVal(Start:Int, _:Int, _:Int), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule attrExp(rangeVal(_:Int, Stop:Int, _:Int), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule attrExp(rangeVal(_:Int, _:Int, Step:Int), Attr:Id) => Step
    requires Id2String(Attr) ==String "step"
  rule attrExp(sliceVal(Start:Val, _:Val, _:Val), Attr:Id) => Start
    requires Id2String(Attr) ==String "start"
  rule attrExp(sliceVal(_:Val, Stop:Val, _:Val), Attr:Id) => Stop
    requires Id2String(Attr) ==String "stop"
  rule attrExp(sliceVal(_:Val, _:Val, Step:Val), Attr:Id) => Step
    requires Id2String(Attr) ==String "step"
  rule attrExp(#complex(R:Float, _:Float), Attr:Id) => R
    requires Id2String(Attr) ==String "real"
  rule attrExp(#complex(_:Float, I:Float), Attr:Id) => I
    requires Id2String(Attr) ==String "imag"
  rule attrExp(F:Float, Attr:Id) => F
    requires Id2String(Attr) ==String "real"
  rule attrExp(_:Float, Attr:Id) => 0.0
    requires Id2String(Attr) ==String "imag"
  rule attrExp(V:Val, Attr:Id) => intValue(V)
    requires isIntLike(V) andBool Id2String(Attr) ==String "real"
  rule attrExp(V:Val, Attr:Id) => 0
    requires isIntLike(V) andBool Id2String(Attr) ==String "imag"
  rule attrExp(V:Val, Attr:Id) => intValue(V)
    requires isIntLike(V) andBool Id2String(Attr) ==String "numerator"
  rule attrExp(V:Val, Attr:Id) => 1
    requires isIntLike(V) andBool Id2String(Attr) ==String "denominator"

  rule #getattr(V:Val, Attr:Id) => matchClassAttrVal(V, Attr)
    requires classHasMatchAttr(V, Attr)
  rule <k> #getattrDefault(Obj:Exp, Attr:Id, Default:Exp)
        => Obj ~> getattrDefaultObject(Attr, Default) ... </k>
  rule <k> V:Val ~> getattrDefaultObject(Attr:Id, Default:Exp)
        => Default ~> getattrDefaultApply(V, Attr) ... </k>
  rule <k> _Default:Val ~> getattrDefaultApply(V:Val, Attr:Id)
        => matchClassAttrVal(V, Attr) ... </k>
    requires classHasMatchAttr(V, Attr)
  rule <k> Default:Val ~> getattrDefaultApply(V:Val, Attr:Id)
        => Default ... </k>
    requires notBool classHasMatchAttr(V, Attr)
  rule <k> #getattr(V:Val, Attr:Id) => exceptionSignal(#exception(#token("AttributeError", "Id"))) ... </k>
    requires notBool classHasMatchAttr(V, Attr)
  rule <k> #hasattr(Obj:Exp, Attr:Id) => Obj ~> hasattrObject(Attr) ... </k>
  rule <k> V:Val ~> hasattrObject(Attr:Id)
        => boolValue(classHasMatchAttr(V, Attr)) ... </k>
  rule <k> #getattrDyn(Obj:Exp, Attr:Exp)
        => Obj ~> getattrDynName(Attr) ... </k>
  rule <k> V:Val ~> getattrDynName(Attr:Exp)
        => Attr ~> getattrDynApply(V) ... </k>
  rule <k> Attr:String ~> getattrDynApply(V:Val)
        => matchClassAttrStringVal(V, Attr) ... </k>
    requires classHasAttrString(V, Attr)
  rule <k> Attr:String ~> getattrDynApply(V:Val)
        => exceptionSignal(#exception(#token("AttributeError", "Id"))) ... </k>
    requires getattrStringSupported(Attr) andBool notBool classHasAttrString(V, Attr)
  rule <k> Attr:String ~> getattrDynApply(_V:Val)
        => exceptionSignal(#exception(#token("NotImplementedError", "Id"))) ... </k>
    requires notBool getattrStringSupported(Attr)
  rule <k> Attr:Val ~> getattrDynApply(_V:Val)
        => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires notBool isStringVal(Attr)
  rule <k> #getattrDefaultDyn(Obj:Exp, Attr:Exp, Default:Exp)
        => Obj ~> getattrDefaultDynName(Attr, Default) ... </k>
  rule <k> V:Val ~> getattrDefaultDynName(Attr:Exp, Default:Exp)
        => Attr ~> getattrDefaultDynDefault(V, Default) ... </k>
  rule <k> Attr:String ~> getattrDefaultDynDefault(V:Val, Default:Exp)
        => Default ~> getattrDefaultDynApply(V, Attr) ... </k>
  rule <k> Attr:Val ~> getattrDefaultDynDefault(_V:Val, _Default:Exp)
        => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires notBool isStringVal(Attr)
  rule <k> _Default:Val ~> getattrDefaultDynApply(V:Val, Attr:String)
        => matchClassAttrStringVal(V, Attr) ... </k>
    requires classHasAttrString(V, Attr)
  rule <k> Default:Val ~> getattrDefaultDynApply(V:Val, Attr:String)
        => Default ... </k>
    requires getattrStringSupported(Attr) andBool notBool classHasAttrString(V, Attr)
  rule <k> _Default:Val ~> getattrDefaultDynApply(_V:Val, Attr:String)
        => exceptionSignal(#exception(#token("NotImplementedError", "Id"))) ... </k>
    requires notBool getattrStringSupported(Attr)
  rule <k> #hasattrDyn(Obj:Exp, Attr:Exp)
        => Obj ~> hasattrDynName(Attr) ... </k>
  rule <k> V:Val ~> hasattrDynName(Attr:Exp)
        => Attr ~> hasattrDynApply(V) ... </k>
  rule <k> Attr:String ~> hasattrDynApply(V:Val)
        => boolValue(classHasAttrString(V, Attr)) ... </k>
    requires getattrStringSupported(Attr)
  rule <k> Attr:String ~> hasattrDynApply(_V:Val)
        => exceptionSignal(#exception(#token("NotImplementedError", "Id"))) ... </k>
    requires notBool getattrStringSupported(Attr)
  rule <k> Attr:Val ~> hasattrDynApply(_V:Val)
        => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires notBool isStringVal(Attr)

  rule V1:Val < V2:Val => boolValue(intValue(V1) <Int intValue(V2))
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float < F2:Float => boolValue(F1 <Float F2)
  rule F:Float < V:Val => boolValue(F <Float floatValue(V))
    requires isIntLike(V)
  rule V:Val < F:Float => boolValue(floatValue(V) <Float F)
    requires isIntLike(V)
  rule S1:String < S2:String => boolValue(S1 <String S2)
  rule V1:Val < V2:Val => boolValue(cmpHolds(#lt, V1, V2))
    requires seqOrderComparable(V1, V2)
  rule setVal(VS1:ValItems) < setVal(VS2:ValItems) =>
    boolValue(cmpHolds(#lt, setVal(VS1), setVal(VS2)))
  rule set() < set() => False
  rule set() < setVal(_:ValItems) => True
  rule setVal(_:ValItems) < set() => False
  rule V1:Val < V2:Val => boolValue(cmpHolds(#lt, V1, V2))
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
      andBool (isFrozenSetVal(V1) orBool isFrozenSetVal(V2))
  rule <k> V1:Val < V2:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(V1, V2)
  rule V1:Val <= V2:Val => boolValue(intValue(V1) <=Int intValue(V2))
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float <= F2:Float => boolValue(F1 <=Float F2)
  rule F:Float <= V:Val => boolValue(F <=Float floatValue(V))
    requires isIntLike(V)
  rule V:Val <= F:Float => boolValue(floatValue(V) <=Float F)
    requires isIntLike(V)
  rule S1:String <= S2:String => boolValue(S1 <=String S2)
  rule V1:Val <= V2:Val => boolValue(cmpHolds(#le, V1, V2))
    requires seqOrderComparable(V1, V2)
  rule setVal(VS1:ValItems) <= setVal(VS2:ValItems) =>
    boolValue(cmpHolds(#le, setVal(VS1), setVal(VS2)))
  rule set() <= set() => True
  rule set() <= setVal(_:ValItems) => True
  rule setVal(_:ValItems) <= set() => False
  rule V1:Val <= V2:Val => boolValue(cmpHolds(#le, V1, V2))
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
      andBool (isFrozenSetVal(V1) orBool isFrozenSetVal(V2))
  rule <k> V1:Val <= V2:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(V1, V2)
  rule V1:Val > V2:Val => boolValue(intValue(V1) >Int intValue(V2))
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float > F2:Float => boolValue(F1 >Float F2)
  rule F:Float > V:Val => boolValue(F >Float floatValue(V))
    requires isIntLike(V)
  rule V:Val > F:Float => boolValue(floatValue(V) >Float F)
    requires isIntLike(V)
  rule S1:String > S2:String => boolValue(S1 >String S2)
  rule V1:Val > V2:Val => boolValue(cmpHolds(#gt, V1, V2))
    requires seqOrderComparable(V1, V2)
  rule setVal(VS1:ValItems) > setVal(VS2:ValItems) =>
    boolValue(cmpHolds(#gt, setVal(VS1), setVal(VS2)))
  rule set() > set() => False
  rule set() > setVal(_:ValItems) => False
  rule setVal(_:ValItems) > set() => True
  rule V1:Val > V2:Val => boolValue(cmpHolds(#gt, V1, V2))
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
      andBool (isFrozenSetVal(V1) orBool isFrozenSetVal(V2))
  rule <k> V1:Val > V2:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(V1, V2)
  rule V1:Val >= V2:Val => boolValue(intValue(V1) >=Int intValue(V2))
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float >= F2:Float => boolValue(F1 >=Float F2)
  rule F:Float >= V:Val => boolValue(F >=Float floatValue(V))
    requires isIntLike(V)
  rule V:Val >= F:Float => boolValue(floatValue(V) >=Float F)
    requires isIntLike(V)
  rule S1:String >= S2:String => boolValue(S1 >=String S2)
  rule V1:Val >= V2:Val => boolValue(cmpHolds(#ge, V1, V2))
    requires seqOrderComparable(V1, V2)
  rule setVal(VS1:ValItems) >= setVal(VS2:ValItems) =>
    boolValue(cmpHolds(#ge, setVal(VS1), setVal(VS2)))
  rule set() >= set() => True
  rule set() >= setVal(_:ValItems) => False
  rule setVal(_:ValItems) >= set() => True
  rule V1:Val >= V2:Val => boolValue(cmpHolds(#ge, V1, V2))
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
      andBool (isFrozenSetVal(V1) orBool isFrozenSetVal(V2))
  rule <k> V1:Val >= V2:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(V1, V2)
  rule V1:Val == V2:Val => boolValue(valEq(V1, V2))
  rule V1:Val != V2:Val => boolValue(notBool valEq(V1, V2))
  rule V1:Val is V2:Val => boolValue(valIs(V1, V2))
  rule V1:Val is not V2:Val => boolValue(notBool valIs(V1, V2))
  rule <k> compareChainExp(Left:Exp, Chain:CmpChain) =>
           Left ~> compareChain(Chain)
       ... </k>
  rule <k> L:Val ~> compareChain(cmpChainLast(Op:CmpOp, Right:Exp)) =>
           Right ~> compareChainLast(Op, L)
       ... </k>
  rule <k> R:Val ~> compareChainLast(#lt, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainLast(#le, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainLast(#gt, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainLast(#ge, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainLast(Op:CmpOp, L:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires bytesMembershipBadInt(Op, L, R)
  rule <k> R:Val ~> compareChainLast(Op:CmpOp, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires bytesMembershipBadNeedle(Op, L, R)
  rule <k> R:Val ~> compareChainLast(Op:CmpOp, L:Val) =>
           boolValue(cmpHolds(Op, L, R))
       ... </k>
    requires ((notBool orderingComparisonOp(Op)) orBool orderComparable(L, R))
      andBool notBool bytesMembershipInvalid(Op, L, R)
  rule <k> L:Val ~> compareChain(cmpChainCons(Op:CmpOp, Right:Exp, Rest:CmpChain)) =>
           Right ~> compareChainNext(Op, L, Rest)
       ... </k>
  rule <k> R:Val ~> compareChainNext(#lt, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainNext(#le, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainNext(#gt, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainNext(#ge, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool orderComparable(L, R)
  rule <k> R:Val ~> compareChainNext(Op:CmpOp, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires bytesMembershipBadInt(Op, L, R)
  rule <k> R:Val ~> compareChainNext(Op:CmpOp, L:Val, _Rest:CmpChain) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires bytesMembershipBadNeedle(Op, L, R)
  rule <k> R:Val ~> compareChainNext(Op:CmpOp, L:Val, Rest:CmpChain) =>
           compareFrom(R, Rest)
       ... </k>
    requires ((notBool orderingComparisonOp(Op)) orBool orderComparable(L, R))
      andBool notBool bytesMembershipInvalid(Op, L, R)
      andBool cmpHolds(Op, L, R)
  rule <k> R:Val ~> compareChainNext(Op:CmpOp, L:Val, _:CmpChain) =>
           False
       ... </k>
    requires ((notBool orderingComparisonOp(Op)) orBool orderComparable(L, R))
      andBool notBool bytesMembershipInvalid(Op, L, R)
      andBool notBool cmpHolds(Op, L, R)
  rule <k> compareFrom(L:Val, Chain:CmpChain) =>
           L ~> compareChain(Chain)
       ... </k>
  rule Needle:String in Haystack:String => boolValue(findString(Haystack, Needle, 0) >=Int 0)
  rule #bytes() in #bytes() => True
  rule #bytearray() in #bytes() => True
  rule bytesVal(_:ValItems) in #bytes() => False
  rule bytearrayVal(_:ValItems) in #bytes() => False
  rule #bytes() in bytesVal(_:ValItems) => True
  rule #bytearray() in bytesVal(_:ValItems) => True
  rule bytesVal(Needle:ValItems) in bytesVal(Haystack:ValItems) =>
    boolValue(bytesContains(Needle, Haystack))
  rule bytearrayVal(Needle:ValItems) in bytesVal(Haystack:ValItems) =>
    boolValue(bytesContains(Needle, Haystack))
  rule V:Val in #bytes() => False
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule V:Val in bytesVal(VS:ValItems) => boolValue(containsVal(intValue(V), VS))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule #bytes() in #bytearray() => True
  rule #bytearray() in #bytearray() => True
  rule bytesVal(_:ValItems) in #bytearray() => False
  rule bytearrayVal(_:ValItems) in #bytearray() => False
  rule #bytes() in bytearrayVal(_:ValItems) => True
  rule #bytearray() in bytearrayVal(_:ValItems) => True
  rule bytesVal(Needle:ValItems) in bytearrayVal(Haystack:ValItems) =>
    boolValue(bytesContains(Needle, Haystack))
  rule bytearrayVal(Needle:ValItems) in bytearrayVal(Haystack:ValItems) =>
    boolValue(bytesContains(Needle, Haystack))
  rule V:Val in #bytearray() => False
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule V:Val in bytearrayVal(VS:ValItems) => boolValue(containsVal(intValue(V), VS))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule <k> V:Val in Haystack:Val =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires bytesMembershipBadInt(#in, V, Haystack)
  rule <k> V:Val in Haystack:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires bytesMembershipBadNeedle(#in, V, Haystack)
  rule _V:Val in [] => False
  rule V:Val in listVal(VS:ValItems) => boolValue(containsVal(V, VS))
  rule _V:Val in () => False
  rule V:Val in tupleVal(VS:ValItems) => boolValue(containsVal(V, VS))
  rule _V:Val in {} => False
  rule V:Val in dictVal(DS:DictItems) => boolValue(containsKey(V, DS))
  rule _V:Val in set() => False
  rule V:Val in setVal(VS:ValItems) => boolValue(containsVal(V, VS))
  rule _V:Val in frozenset() => False
  rule V:Val in frozensetVal(VS:ValItems) => boolValue(containsVal(V, VS))
  rule V:Val in rangeVal(Start:Int, Stop:Int) => boolValue(rangeContains(V, Start, Stop))
  rule V:Val in rangeVal(Start:Int, Stop:Int, Step:Int) => boolValue(rangeContains(V, Start, Stop, Step))
  rule Needle:String not in Haystack:String => boolValue(findString(Haystack, Needle, 0) <Int 0)
  rule #bytes() not in #bytes() => False
  rule #bytearray() not in #bytes() => False
  rule bytesVal(_:ValItems) not in #bytes() => True
  rule bytearrayVal(_:ValItems) not in #bytes() => True
  rule #bytes() not in bytesVal(_:ValItems) => False
  rule #bytearray() not in bytesVal(_:ValItems) => False
  rule bytesVal(Needle:ValItems) not in bytesVal(Haystack:ValItems) =>
    boolValue(notBool bytesContains(Needle, Haystack))
  rule bytearrayVal(Needle:ValItems) not in bytesVal(Haystack:ValItems) =>
    boolValue(notBool bytesContains(Needle, Haystack))
  rule V:Val not in #bytes() => True
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule V:Val not in bytesVal(VS:ValItems) => boolValue(notBool containsVal(intValue(V), VS))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule #bytes() not in #bytearray() => False
  rule #bytearray() not in #bytearray() => False
  rule bytesVal(_:ValItems) not in #bytearray() => True
  rule bytearrayVal(_:ValItems) not in #bytearray() => True
  rule #bytes() not in bytearrayVal(_:ValItems) => False
  rule #bytearray() not in bytearrayVal(_:ValItems) => False
  rule bytesVal(Needle:ValItems) not in bytearrayVal(Haystack:ValItems) =>
    boolValue(notBool bytesContains(Needle, Haystack))
  rule bytearrayVal(Needle:ValItems) not in bytearrayVal(Haystack:ValItems) =>
    boolValue(notBool bytesContains(Needle, Haystack))
  rule V:Val not in #bytearray() => True
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule V:Val not in bytearrayVal(VS:ValItems) => boolValue(notBool containsVal(intValue(V), VS))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule <k> V:Val not in Haystack:Val =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires bytesMembershipBadInt(#notIn, V, Haystack)
  rule <k> V:Val not in Haystack:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires bytesMembershipBadNeedle(#notIn, V, Haystack)
  rule _V:Val not in [] => True
  rule V:Val not in listVal(VS:ValItems) => boolValue(notBool containsVal(V, VS))
  rule _V:Val not in () => True
  rule V:Val not in tupleVal(VS:ValItems) => boolValue(notBool containsVal(V, VS))
  rule _V:Val not in {} => True
  rule V:Val not in dictVal(DS:DictItems) => boolValue(notBool containsKey(V, DS))
  rule _V:Val not in set() => True
  rule V:Val not in setVal(VS:ValItems) => boolValue(notBool containsVal(V, VS))
  rule _V:Val not in frozenset() => True
  rule V:Val not in frozensetVal(VS:ValItems) => boolValue(notBool containsVal(V, VS))
  rule V:Val not in rangeVal(Start:Int, Stop:Int) => boolValue(notBool rangeContains(V, Start, Stop))
  rule V:Val not in rangeVal(Start:Int, Stop:Int, Step:Int) => boolValue(notBool rangeContains(V, Start, Stop, Step))
  rule subscriptExp(V:Val, sliceVal(Lower:Val, Upper:Val, None)) => sliceExp(V, Lower, Upper)
  rule subscriptExp(V:Val, sliceVal(Lower:Val, Upper:Val, Step:Val)) => sliceStepExp(V, Lower, Upper, Step)
    requires isIntLike(Step)
  rule subscriptExp(S:String, I:Val) =>
    substrString(
      S,
      stringCodePointPrefixByteLen(S, intValue(I), 0),
      stringCodePointPrefixByteLen(S, intValue(I) +Int 1, 0))
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int stringCodePointLen(S, 0)
  rule subscriptExp(S:String, I:Val) =>
    substrString(
      S,
      stringCodePointPrefixByteLen(S, stringCodePointLen(S, 0) +Int intValue(I), 0),
      stringCodePointPrefixByteLen(S, stringCodePointLen(S, 0) +Int intValue(I) +Int 1, 0))
    requires isIntLike(I)
     andBool intValue(I) <Int 0
     andBool stringCodePointLen(S, 0) +Int intValue(I) >=Int 0
  rule <k> subscriptExp(S:String, I:Val) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
    requires isIntLike(I)
      andBool notBool subscriptIndexInBounds(I, stringCodePointLen(S, 0))
  rule <k> subscriptExp(_S:String, I:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
