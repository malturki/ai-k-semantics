           forRangeStep(X, I +Int Step, Stop, Step, {})
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires (Step >Int 0 andBool I <Int Stop)
      orBool (Step <Int 0 andBool I >Int Stop)
  rule <k> forRangeStep(_:Id, I:Int, Stop:Int, Step:Int, _:Block) => stmtNoResult ... </k>
    requires (Step >Int 0 andBool I >=Int Stop)
      orBool (Step <Int 0 andBool I <=Int Stop)
  rule <k> forRangeStepAgain(X:Id, I:Int, Stop:Int, Step:Int, Body:Block) =>
           forRangeStep(X, I, Stop, Step, Body)
       ... </k>

  rule <k> forElseStmt(X:Id, E:Exp, Body:Block, Else:Block) =>
           E ~> forElseIter(X, Body, Else)
       ... </k>
  rule <k> [] ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> () ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> bytesVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> S:String ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseRange(X, Start, Stop, Body, Else)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseRangeStep(X, Start, Stop, Step, Body, Else)
       ... </k>
    requires Step =/=Int 0
  rule <k> ({}):Val ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, dictKeysToValItems(DS), Body, Else)
       ... </k>
  rule <k> set() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> setVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>

  rule <k> forElseItems(X:Id, valItemsCons(V:Val, VS:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forElseItems(X, VS, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsLast(V:Val), block(SS:Stmts), Else:Block) =>
           SS ~> forElseDone(Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsCons(V:Val, VS:ValItems), {}, Else:Block) =>
           forElseItems(X, VS, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsLast(V:Val), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseDone(Else:Block) => runLoopElse(Else) ... </k>

  rule <k> forUnpackElseStmt(IDS:IdItems, E:Exp, Body:Block, Else:Block) =>
           E ~> forUnpackElseIter(IDS, Body, Else)
       ... </k>
  rule <k> [] ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> () ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> S:String ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, dictKeysToValItems(DS), Body, Else)
       ... </k>
  rule <k> set() ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> setVal(VS:ValItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body, Else)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body, Else)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(listVal(VS:ValItems), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(tupleVal(VS:ValItems), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(bytesVal(VS:ValItems), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(S:String, Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(dictVal(DS:DictItems), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseItems(IDS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(listVal(VS:ValItems)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(tupleVal(VS:ValItems)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(bytesVal(VS:ValItems)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(S:String), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(dictVal(DS:DictItems)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(setVal(VS:ValItems)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(listVal(VS:ValItems), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(tupleVal(VS:ValItems), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(bytesVal(VS:ValItems), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(S:String, Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(dictVal(DS:DictItems), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(setVal(VS:ValItems), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsCons(rangeVal(Start:Int, Stop:Int, Step:Int), Rest:ValItems), {}, Else:Block) =>
           forUnpackElseItems(IDS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(listVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(tupleVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(bytesVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(S:String), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool sameIdValArity(IDS, stringToValItems(S, 0, lengthString(S)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(dictVal(DS:DictItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, dictKeysToValItems(DS)) </env>
    requires sameIdValArity(IDS, dictKeysToValItems(DS))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(setVal(VS:ValItems)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
    requires sameIdValArity(IDS, VS)
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))) </env>
    requires pyRangeLen(Start, Stop, 1) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
  rule <k> forUnpackElseItems(IDS:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindVals(Rho, IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))) </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) >Int 0
      andBool sameIdValArity(IDS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
  rule <k> forUnpackElseDone(Else:Block) => runLoopElse(Else) ... </k>

  rule <k> forTargetUnpackElseStmt(TS:Targets, E:Exp, Body:Block, Else:Block) =>
           E ~> forTargetUnpackElseIter(TS, Body, Else)
       ... </k>
  rule <k> [] ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> () ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> S:String ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, dictKeysToValItems(DS), Body, Else)
       ... </k>
  rule <k> set() ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, VS, Body, Else)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body, Else)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackElseIter(_:Targets, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackElseIter(TS:Targets, Body:Block, Else:Block) =>
           forTargetUnpackElseItems(TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body, Else)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forTargetUnpackElseItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forTargetUnpackElseItems(TS, Rest, block(SS), Else)
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackElseItems(TS:Targets, valItemsLast(V:Val), block(SS:Stmts), Else:Block) =>
           SS ~> forUnpackElseDone(Else)
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackElseItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), {}, Else:Block) =>
           forTargetUnpackElseItems(TS, Rest, {}, Else)
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackElseItems(TS:Targets, valItemsLast(V:Val), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)

  rule <k> forTargetElseStmt(T:Target, E:Exp, Body:Block, Else:Block) =>
           E ~> forTargetElseIter(T, Body, Else)
       ... </k>
  rule <k> [] ~> forTargetElseIter(_:Target, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetElseIter(T:Target, Body:Block, Else:Block) =>
           forTargetElseItems(T, VS, Body, Else)
       ... </k>
  rule <k> () ~> forTargetElseIter(_:Target, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetElseIter(T:Target, Body:Block, Else:Block) =>
           forTargetElseItems(T, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forTargetElseIter(_:Target, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> S:String ~> forTargetElseIter(_:Target, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetElseIter(T:Target, Body:Block, Else:Block) =>
           forTargetElseItems(T, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
