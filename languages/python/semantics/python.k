           evalArgs(Args, #noArgVals) ~> mapStrictEval(Strict)
       ... </k>
  rule <k> argsVal(VS:ArgVals) ~> mapStrictEval(Strict:Exp) =>
           Strict ~> mapStrictResult(VS)
       ... </k>
