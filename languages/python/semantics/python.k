  rule <k> #tupleCtor(iteratorRef(I:Int)) =>
           argValsToTupleVal(VS)
       ... </k>
       <iterators> ... I |-> (VS:ArgVals => #noArgVals) ... </iterators>
  rule <k> #tupleCtor(iteratorRef(I:Int)) =>
           argsVal(#noArgVals) ~> callApplyArgs(F) ~> callableIteratorCollectTuple(I, Sentinel, #noArgVals)
       ... </k>
