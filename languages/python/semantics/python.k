           NextIter ~> listCompManyDescend(NextT, NextFilters, #noCompClauses, T, Filters, #compRest(#compClause(NextIter, NextT, NextFilters)), Elem, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
