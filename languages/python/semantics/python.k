  rule isIntLike(functionValArgs(_:IdItems, _:Block)) => false
  rule isIntLike(functionValDefaults(_:IdItems, _:ArgVals, _:Block)) => false
  rule isIntLike(functionValVarArgs(_:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValVarArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValVarArgsKwOnly(_:IdItems, _:Id, _:IdItems, _:Block)) => false
  rule isIntLike(functionValVarArgsKwDefaults(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Block)) => false
  rule isIntLike(functionValVarArgsKwOnlyKwArgs(_:IdItems, _:Id, _:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValVarArgsKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValVarKwArgs(_:IdItems, _:Id, _:Id, _:Block)) => false
  rule isIntLike(functionValVarKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Id, _:Block)) => false
  rule isIntLike(functionValKwArgs(_:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnly(_:IdItems, _:IdItems, _:Block)) => false
  rule isIntLike(functionValPosOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarKwArgs(_:IdItems, _:IdItems, _:Id, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgsKwOnly(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgsKwDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgsKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyVarArgsKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isIntLike(functionValPosOnlyKwOnly(_:IdItems, _:IdItems, _:IdItems, _:Block)) => false
  rule isIntLike(functionValPosOnlyKwOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Block)) => false
  rule isIntLike(functionValPosOnlyKwOnlyKwArgs(_:IdItems, _:IdItems, _:IdItems, _:Id, _:Block)) => false
