           exceptionSignal(E)
       ... </k>
    requires notBool exceptionMatches(E, #token("StopIteration", "Id"))
  rule #boolCtor() => False
  rule #boolCtor(V:Val) => boolValue(truthy(V))
  rule #strCtor() => ""
  rule #strCtor(V:Val) => pyFormatStr(V)
