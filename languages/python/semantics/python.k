  rule <k> forTargetItems(T:Target, valItemsCons(V:Val, Rest:ValItems), {}) =>
           forTargetItems(T, Rest, {})
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
