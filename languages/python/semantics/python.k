           argsVal(VS) ~> mapArgsResult(Strict)
       ... </k>
  rule <k> mapCollect(_F:Val, #noArgVals, Strict:Val, Iters:ArgVals, Acc:ArgVals) =>
           argsVal(Acc)
       ... </k>
    requires (notBool truthy(Strict)) orBool zipStrictEqualLengths(Iters)
