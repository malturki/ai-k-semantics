  rule <k> functionDefDecoratedStmt(F:Id, Decorators:ArgExps, functionSpecPosKwOnlyKwArgs(Pos:IdItems, KwOnly:IdItems, Kw:Id, Body:Block)) =>
           evalArgs(Decorators, #noArgVals) ~> bindDecoratedFunction(F, functionValPosKwOnlyKwArgs(Pos, KwOnly, Kw, Body))
       ... </k>
  rule <k> functionDefDecoratedStmt(F:Id, Decorators:ArgExps, functionSpecDefaultBuilder(Defaults:ArgExps, Builder:FunctionDefaultBuilder)) =>
           evalArgs(Decorators, #noArgVals) ~> bindDecoratedFunctionDefaultBuilder(F, Builder, Defaults)
       ... </k>
  rule <k> functionDefDecoratedStmt(F:Id, Decorators:ArgExps, functionSpecTwoDefaultBuilder(Defaults:ArgExps, KwDefaults:ArgExps, Builder:FunctionTwoDefaultBuilder)) =>
           evalArgs(Decorators, #noArgVals) ~> bindDecoratedFunctionTwoDefaultBuilder(F, Builder, Defaults, KwDefaults)
       ... </k>
  rule <k> argsVal(Decorators:ArgVals) ~> bindDecoratedFunction(F:Id, Fun:Val) =>
           Fun ~> applyDecorators(F, reverseArgVals(Decorators))
       ... </k>
  rule <k> argsVal(Decorators:ArgVals) ~> bindDecoratedFunctionDefaults(F:Id, IDS:IdItems, Defaults:ArgExps, Body:Block) =>
           evalArgs(Defaults, #noArgVals) ~> bindDecoratedFunctionDefaultVals(F, Decorators, IDS, Body)
       ... </k>
  rule <k> argsVal(Defaults:ArgVals) ~> bindDecoratedFunctionDefaultVals(F:Id, Decorators:ArgVals, IDS:IdItems, Body:Block) =>
           functionValDefaults(IDS, Defaults, Body) ~> applyDecorators(F, reverseArgVals(Decorators))
       ... </k>
  rule <k> argsVal(Decorators:ArgVals) ~> bindDecoratedFunctionDefaultBuilder(F:Id, Builder:FunctionDefaultBuilder, Defaults:ArgExps) =>
           evalArgs(Defaults, #noArgVals) ~> bindDecoratedFunctionDefaultBuilderVals(F, Decorators, Builder)
       ... </k>
  rule <k> argsVal(Defaults:ArgVals) ~> bindDecoratedFunctionDefaultBuilderVals(F:Id, Decorators:ArgVals, Builder:FunctionDefaultBuilder) =>
           buildFunctionDefault(Builder, Defaults) ~> applyDecorators(F, reverseArgVals(Decorators))
       ... </k>
  rule <k> argsVal(Decorators:ArgVals) ~> bindDecoratedFunctionTwoDefaultBuilder(F:Id, Builder:FunctionTwoDefaultBuilder, Defaults:ArgExps, KwDefaults:ArgExps) =>
           evalArgs(Defaults, #noArgVals) ~> bindDecoratedFunctionTwoDefaultBuilderKw(F, Decorators, Builder, KwDefaults)
       ... </k>
  rule <k> argsVal(Defaults:ArgVals) ~> bindDecoratedFunctionTwoDefaultBuilderKw(F:Id, Decorators:ArgVals, Builder:FunctionTwoDefaultBuilder, KwDefaults:ArgExps) =>
           evalArgs(KwDefaults, #noArgVals) ~> bindDecoratedFunctionTwoDefaultBuilderVals(F, Decorators, Defaults, Builder)
       ... </k>
  rule <k> argsVal(KwDefaults:ArgVals) ~> bindDecoratedFunctionTwoDefaultBuilderVals(F:Id, Decorators:ArgVals, Defaults:ArgVals, Builder:FunctionTwoDefaultBuilder) =>
           buildFunctionTwoDefaults(Builder, Defaults, KwDefaults) ~> applyDecorators(F, reverseArgVals(Decorators))
       ... </k>
  rule <k> Fun:Val ~> applyDecorators(F:Id, #noArgVals) => stmtNoResult ... </k>
       <env> Rho => Rho [ F <- Fun ] </env>
       <result> _ => .K </result>
  rule <k> Fun:Val ~> applyDecorators(F:Id, argValsCons(Decorator:Val, Rest:ArgVals)) =>
           Decorator ~> callArg(Fun) ~> applyDecorators(F, Rest)
       ... </k>

  rule <k> tryFinallyStmt(block(SS:Stmts), Finally:Block) =>
           SS ~> tryFinallyDone(Finally)
       ... </k>
  rule <k> tryFinallyStmt({}, Finally:Block) =>
           tryFinallyDone(Finally)
       ... </k>
  rule <k> tryFinallyDone(block(SS:Stmts)) =>
           SS ~> ifStmtDone
       ... </k>
  rule <k> tryFinallyDone({}) => stmtNoResult ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyDone(block(SS:Stmts)) =>
           SS ~> tryFinallyReturn(V)
       ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyDone({}) => returnSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyReturn(_:Val) => returnSignal(V) ... </k>
  rule <k> breakSignal ~> tryFinallyReturn(_:Val) => breakSignal ... </k>
  rule <k> continueSignal ~> tryFinallyReturn(_:Val) => continueSignal ... </k>
  rule <k> tryFinallyReturn(V:Val) => returnSignal(V) ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryFinallyDone(block(SS:Stmts)) =>
           SS ~> tryFinallyException(V)
      ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryFinallyDone({}) => exceptionSignal(V) ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyException(_:Val) => returnSignal(V) ... </k>
  rule <k> breakSignal ~> tryFinallyException(_:Val) => breakSignal ... </k>
  rule <k> continueSignal ~> tryFinallyException(_:Val) => continueSignal ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryFinallyException(_:Val) => exceptionSignal(V) ... </k>
  rule <k> tryFinallyException(V:Val) => exceptionSignal(V) ... </k>
  rule <k> breakSignal ~> tryFinallyDone(block(SS:Stmts)) =>
           SS ~> tryFinallyBreak
      ... </k>
  rule <k> breakSignal ~> tryFinallyDone({}) => breakSignal ... </k>
  rule <k> continueSignal ~> tryFinallyDone(block(SS:Stmts)) =>
           SS ~> tryFinallyContinue
       ... </k>
  rule <k> continueSignal ~> tryFinallyDone({}) => continueSignal ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyBreak => returnSignal(V) ... </k>
  rule <k> breakSignal ~> tryFinallyBreak => breakSignal ... </k>
  rule <k> continueSignal ~> tryFinallyBreak => continueSignal ... </k>
  rule <k> tryFinallyBreak => breakSignal ... </k>
  rule <k> returnSignal(V:Val) ~> tryFinallyContinue => returnSignal(V) ... </k>
  rule <k> breakSignal ~> tryFinallyContinue => breakSignal ... </k>
  rule <k> continueSignal ~> tryFinallyContinue => continueSignal ... </k>
  rule <k> tryFinallyContinue => continueSignal ... </k>

  rule <k> tryExceptStmt(block(SS:Stmts), E:Id, Handler:Block) =>
           SS ~> tryExceptDone(E, Handler)
      ... </k>
  rule <k> tryExceptStmt({}, _E:Id, _Handler:Block) => stmtNoResult ... </k>
  rule <k> tryExceptDone(_E:Id, _Handler:Block) => stmtNoResult ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryExceptDone(E:Id, block(SS:Stmts)) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionMatches(V, E)
  rule <k> exceptionSignal(V:Val) ~> tryExceptDone(E:Id, {}) => stmtNoResult ... </k>
    requires exceptionMatches(V, E)
  rule <k> exceptionSignal(V:Val) ~> tryExceptDone(E:Id, _Handler:Block) => exceptionSignal(V) ... </k>
    requires notBool exceptionMatches(V, E)

  rule <k> tryExceptElseStmt(block(SS:Stmts), E:Id, Handler:Block, Else:Block) =>
           SS ~> tryExceptElseDone(E, Handler, Else)
      ... </k>
  rule <k> tryExceptElseStmt({}, _E:Id, _Handler:Block, block(SS:Stmts)) =>
           SS ~> ifStmtDone
      ... </k>
  rule <k> tryExceptElseStmt({}, _E:Id, _Handler:Block, {}) => stmtNoResult ... </k>
  rule <k> tryExceptElseDone(_E:Id, _Handler:Block, block(SS:Stmts)) =>
           SS ~> ifStmtDone
      ... </k>
  rule <k> tryExceptElseDone(_E:Id, _Handler:Block, {}) => stmtNoResult ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryExceptElseDone(E:Id, block(SS:Stmts), _Else:Block) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionMatches(V, E)
  rule <k> exceptionSignal(V:Val) ~> tryExceptElseDone(E:Id, {}, _Else:Block) => stmtNoResult ... </k>
    requires exceptionMatches(V, E)
  rule <k> exceptionSignal(V:Val) ~> tryExceptElseDone(E:Id, _Handler:Block, _Else:Block) => exceptionSignal(V) ... </k>
    requires notBool exceptionMatches(V, E)

  rule <k> tryExceptCasesStmt(block(SS:Stmts), Cases:ExceptHandlers) =>
           SS ~> tryExceptCasesDone(Cases)
      ... </k>
  rule <k> tryExceptCasesStmt({}, _Cases:ExceptHandlers) => stmtNoResult ... </k>
  rule <k> tryExceptCasesDone(_Cases:ExceptHandlers) => stmtNoResult ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryExceptCasesDone(Cases:ExceptHandlers) =>
           handleException(V, Cases)
      ... </k>

  rule <k> tryExceptCasesElseStmt(block(SS:Stmts), Cases:ExceptHandlers, Else:Block) =>
           SS ~> tryExceptCasesElseDone(Cases, Else)
      ... </k>
  rule <k> tryExceptCasesElseStmt({}, _Cases:ExceptHandlers, block(SS:Stmts)) =>
           SS ~> ifStmtDone
      ... </k>
  rule <k> tryExceptCasesElseStmt({}, _Cases:ExceptHandlers, {}) => stmtNoResult ... </k>
  rule <k> tryExceptCasesElseDone(_Cases:ExceptHandlers, block(SS:Stmts)) =>
           SS ~> ifStmtDone
      ... </k>
  rule <k> tryExceptCasesElseDone(_Cases:ExceptHandlers, {}) => stmtNoResult ... </k>
  rule <k> exceptionSignal(V:Val) ~> tryExceptCasesElseDone(Cases:ExceptHandlers, _Else:Block) =>
           handleException(V, Cases)
      ... </k>

  rule <k> handleException(V:Val, #except(E:Id, block(SS:Stmts))) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #except(E:Id, {})) => stmtNoResult ... </k>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #except(E:Id, _Handler:Block)) =>
           exceptionSignal(V)
      ... </k>
    requires notBool exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptAs(E:Id, Alias:Id, block(SS:Stmts))) =>
           SS ~> exceptAsCleanup(Alias) ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptAs(E:Id, Alias:Id, {})) =>
           exceptAsCleanup(Alias)
      ... </k>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptAs(E:Id, _Alias:Id, _Handler:Block)) =>
           exceptionSignal(V)
      ... </k>
    requires notBool exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptTuple(IDS:IdItems, block(SS:Stmts))) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptTuple(IDS:IdItems, {})) => stmtNoResult ... </k>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptTuple(IDS:IdItems, _Handler:Block)) =>
           exceptionSignal(V)
      ... </k>
    requires notBool exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptTupleAs(IDS:IdItems, Alias:Id, block(SS:Stmts))) =>
           SS ~> exceptAsCleanup(Alias) ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptTupleAs(IDS:IdItems, Alias:Id, {})) =>
           exceptAsCleanup(Alias)
      ... </k>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptTupleAs(IDS:IdItems, _Alias:Id, _Handler:Block)) =>
           exceptionSignal(V)
      ... </k>
    requires notBool exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptAny(block(SS:Stmts))) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
  rule <k> handleException(_V:Val, #exceptAny({})) => stmtNoResult ... </k>
  rule <k> handleException(V:Val, #excepts(E:Id, block(SS:Stmts), _Rest:ExceptHandlers)) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #excepts(E:Id, {}, _Rest:ExceptHandlers)) => stmtNoResult ... </k>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #excepts(E:Id, _Handler:Block, Rest:ExceptHandlers)) =>
           handleException(V, Rest)
      ... </k>
    requires notBool exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptsAs(E:Id, Alias:Id, block(SS:Stmts), _Rest:ExceptHandlers)) =>
           SS ~> exceptAsCleanup(Alias) ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptsAs(E:Id, Alias:Id, {}, _Rest:ExceptHandlers)) =>
           exceptAsCleanup(Alias)
      ... </k>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptsAs(E:Id, _Alias:Id, _Handler:Block, Rest:ExceptHandlers)) =>
           handleException(V, Rest)
      ... </k>
    requires notBool exceptionMatches(V, E)
  rule <k> handleException(V:Val, #exceptsTuple(IDS:IdItems, block(SS:Stmts), _Rest:ExceptHandlers)) =>
           SS ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptsTuple(IDS:IdItems, {}, _Rest:ExceptHandlers)) => stmtNoResult ... </k>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptsTuple(IDS:IdItems, _Handler:Block, Rest:ExceptHandlers)) =>
           handleException(V, Rest)
      ... </k>
    requires notBool exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptsTupleAs(IDS:IdItems, Alias:Id, block(SS:Stmts), _Rest:ExceptHandlers)) =>
           SS ~> exceptAsCleanup(Alias) ~> restoreActiveException(Prev)
      ... </k>
       <activeException> Prev => currentException(V) </activeException>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptsTupleAs(IDS:IdItems, Alias:Id, {}, _Rest:ExceptHandlers)) =>
           exceptAsCleanup(Alias)
      ... </k>
       <env> Rho => Rho [ Alias <- V ] </env>
    requires exceptionIn(V, IDS)
  rule <k> handleException(V:Val, #exceptsTupleAs(IDS:IdItems, _Alias:Id, _Handler:Block, Rest:ExceptHandlers)) =>
           handleException(V, Rest)
      ... </k>
    requires notBool exceptionIn(V, IDS)
  rule <k> handleException(V:Val, _Cases:ExceptHandlers) => exceptionSignal(V) ... </k> [owise]

  rule <k> exceptAsCleanup(Alias:Id) => stmtNoResult ... </k>
       <env> Rho => Rho [ Alias <- undef ] </env>
  rule <k> breakSignal ~> exceptAsCleanup(Alias:Id) => breakSignal ... </k>
       <env> Rho => Rho [ Alias <- undef ] </env>
  rule <k> continueSignal ~> exceptAsCleanup(Alias:Id) => continueSignal ... </k>
       <env> Rho => Rho [ Alias <- undef ] </env>
  rule <k> returnSignal(V:Val) ~> exceptAsCleanup(Alias:Id) => returnSignal(V) ... </k>
       <env> Rho => Rho [ Alias <- undef ] </env>
  rule <k> exceptionSignal(V:Val) ~> exceptAsCleanup(Alias:Id) => exceptionSignal(V) ... </k>
       <env> Rho => Rho [ Alias <- undef ] </env>

  rule <k> restoreActiveException(Prev:ActiveException) => ifStmtDone ... </k>
       <activeException> _ => Prev </activeException>
  rule <k> stmtNoResult ~> restoreActiveException(Prev:ActiveException) => ifStmtDone ... </k>
       <activeException> _ => Prev </activeException>
  rule <k> breakSignal ~> restoreActiveException(Prev:ActiveException) => breakSignal ... </k>
       <activeException> _ => Prev </activeException>
  rule <k> continueSignal ~> restoreActiveException(Prev:ActiveException) => continueSignal ... </k>
       <activeException> _ => Prev </activeException>
  rule <k> returnSignal(V:Val) ~> restoreActiveException(Prev:ActiveException) => returnSignal(V) ... </k>
       <activeException> _ => Prev </activeException>
  rule <k> exceptionSignal(V:Val) ~> restoreActiveException(Prev:ActiveException) => exceptionSignal(V) ... </k>
       <activeException> _ => Prev </activeException>

  rule <k> ifStmt(C:Exp, Then:Block, Else:Block) =>
           C ~> ifStmtBranch(Then, Else)
       ... </k>
  rule <k> V:Val ~> ifStmtBranch(block(SS:Stmts), _:Block) =>
           SS ~> ifStmtDone
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> ifStmtBranch({}, _:Block) =>
           stmtNoResult
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> ifStmtBranch(_:Block, block(SS:Stmts)) =>
           SS ~> ifStmtDone
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> ifStmtBranch(_:Block, {}) =>
           stmtNoResult
       ... </k>
    requires notBool truthy(V)
  rule <k> ifStmtDone => stmtNoResult ... </k>

  rule <k> matchStmt(Subject:Exp, Cases:MatchCases) =>
           Subject ~> matchSubject(Cases)
      ... </k>
  rule <k> V:Val ~> matchSubject(Cases:MatchCases) =>
           matchDispatch(V, Cases)
      ... </k>
  rule <k> matchDispatch(V:Val, #matchCaseGuard(P:MatchPattern, Guard:Exp, Body:Block)) =>
           matchGuardPattern(V, P, Guard, Body, #noMatchCases)
      ... </k>
  rule <k> matchDispatch(V:Val, #matchCasesGuard(P:MatchPattern, Guard:Exp, Body:Block, Rest:MatchCases)) =>
           matchGuardPattern(V, P, Guard, Body, #someMatchCases(Rest))
      ... </k>
  rule <k> matchGuardNoMatch(_V:Val, #noMatchCases) => stmtNoResult ... </k>
  rule <k> matchGuardNoMatch(V:Val, #someMatchCases(Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>

  rule <k> matchGuardPattern(V:Val, #matchWildcard, Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
  rule <k> matchGuardPattern(V:Val, #matchCapture(Name:Id), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => Rho [ Name <- V ] </env>
  rule <k> matchGuardPattern(V:Val, #matchOr(P1:MatchPattern, P2:MatchPattern), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchGuardPattern(V:Val, #matchOr(P1:MatchPattern, P2:MatchPattern), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchGuardPattern(V:Val, #matchAs(P:MatchPattern, Name:Id), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchAs(P, Name)) </env>
    requires matchSimplePattern(V, P)
  rule <k> matchGuardPattern(V:Val, #matchAs(P:MatchPattern, _Name:Id), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchSimplePattern(V, P)
  rule <k> matchGuardPattern(V:Val, #matchSequence(PS:MatchPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchSequence(Rho, V, PS) </env>
    requires matchFixedSequence(V, PS)
  rule <k> matchGuardPattern(V:Val, #matchSequence(PS:MatchPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchFixedSequence(V, PS)
  rule <k> matchGuardPattern(V:Val, #matchSequenceStar(Prefix:MatchPatterns, Suffix:MatchPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchStarSequence(Rho, V, Prefix, Suffix) </env>
    requires matchStarSequence(V, Prefix, Suffix)
  rule <k> matchGuardPattern(V:Val, #matchSequenceStar(Prefix:MatchPatterns, Suffix:MatchPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchStarSequence(V, Prefix, Suffix)
  rule <k> matchGuardPattern(V:Val, #matchSequenceStarCapture(Prefix:MatchPatterns, Name:Id, Suffix:MatchPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchStarSequence(Rho, V, Prefix, Suffix) [ Name <- matchStarMiddle(V, Prefix, Suffix) ] </env>
    requires matchStarSequence(V, Prefix, Suffix)
  rule <k> matchGuardPattern(V:Val, #matchSequenceStarCapture(Prefix:MatchPatterns, _Name:Id, Suffix:MatchPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchStarSequence(V, Prefix, Suffix)
  rule <k> matchGuardPattern(V:Val, #matchMapping(MPS:MatchMapPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) </env>
    requires matchMapping(V, MPS)
  rule <k> matchGuardPattern(V:Val, #matchMapping(MPS:MatchMapPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchGuardPattern(V:Val, #matchMappingRest(MPS:MatchMapPatterns, Name:Id), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchMapping(Rho, V, MPS) [ Name <- matchMappingRestVal(V, MPS) ] </env>
    requires matchMapping(V, MPS)
  rule <k> matchGuardPattern(V:Val, #matchMappingRest(MPS:MatchMapPatterns, _Name:Id), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchMapping(V, MPS)
  rule <k> matchGuardPattern(V:Val, #matchSingleton(P:Val), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
    requires singletonPatternEq(V, P)
  rule <k> matchGuardPattern(V:Val, #matchSingleton(P:Val), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool singletonPatternEq(V, P)
  rule <k> matchGuardPattern(V:Val, #matchClass(C:Id), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
    requires matchBuiltinClass(V, C)
  rule <k> matchGuardPattern(V:Val, #matchClass(C:Id), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClass(V, C)
  rule <k> matchGuardPattern(V:Val, #matchClassArg(C:Id, P:MatchPattern), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArg(C, P)) </env>
    requires matchBuiltinClassArg(V, C, P)
  rule <k> matchGuardPattern(V:Val, #matchClassArg(C:Id, P:MatchPattern), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassArg(V, C, P)
  rule <k> matchGuardPattern(V:Val, #matchClassKw(C:Id, APS:MatchAttrPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassKw(C, APS)) </env>
    requires matchBuiltinClassKw(V, C, APS)
  rule <k> matchGuardPattern(V:Val, #matchClassKw(C:Id, APS:MatchAttrPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassKw(V, C, APS)
  rule <k> matchGuardPattern(V:Val, #matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchClassArgKw(C, P, APS)) </env>
    requires matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchGuardPattern(V:Val, #matchClassArgKw(C:Id, P:MatchPattern, APS:MatchAttrPatterns), _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool matchBuiltinClassArgKw(V, C, P, APS)
  rule <k> matchGuardPattern(V:Val, #matchValue(P:Exp), Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           P ~> matchValueGuardDispatch(V, Guard, Body, Rest)
      ... </k>

  rule <k> GuardValue:Val ~> matchGuardSelect(_V:Val, block(SS:Stmts), _Rest:MaybeMatchCases) =>
           SS ~> matchDone
      ... </k>
    requires truthy(GuardValue)
  rule <k> GuardValue:Val ~> matchGuardSelect(_V:Val, {}, _Rest:MaybeMatchCases) =>
           stmtNoResult
      ... </k>
    requires truthy(GuardValue)
  rule <k> GuardValue:Val ~> matchGuardSelect(V:Val, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool truthy(GuardValue)
  rule <k> exceptionSignal(E:Val) ~> matchGuardSelect(_V:Val, _Body:Block, _Rest:MaybeMatchCases) =>
           exceptionSignal(E)
      ... </k>

  rule <k> PatternValue:Val ~> matchValueGuardDispatch(V:Val, Guard:Exp, Body:Block, Rest:MaybeMatchCases) =>
           Guard ~> matchGuardSelect(V, Body, Rest)
      ... </k>
    requires valEq(V, PatternValue)
  rule <k> PatternValue:Val ~> matchValueGuardDispatch(V:Val, _Guard:Exp, _Body:Block, Rest:MaybeMatchCases) =>
           matchGuardNoMatch(V, Rest)
      ... </k>
    requires notBool valEq(V, PatternValue)
  rule <k> exceptionSignal(E:Val) ~> matchValueGuardDispatch(_V:Val, _Guard:Exp, _Body:Block, _Rest:MaybeMatchCases) =>
           exceptionSignal(E)
      ... </k>

  rule <k> matchDispatch(_V:Val, #matchCase(#matchWildcard, block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
  rule <k> matchDispatch(_:Val, #matchCase(#matchWildcard, {})) =>
           stmtNoResult
      ... </k>
  rule <k> matchDispatch(_V:Val, #matchCases(#matchWildcard, block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
  rule <k> matchDispatch(_:Val, #matchCases(#matchWildcard, {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
  rule <k> matchDispatch(V:Val, #matchCase(#matchCapture(Name:Id), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => Rho [ Name <- V ] </env>
  rule <k> matchDispatch(V:Val, #matchCase(#matchCapture(Name:Id), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => Rho [ Name <- V ] </env>
  rule <k> matchDispatch(V:Val, #matchCases(#matchCapture(Name:Id), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => Rho [ Name <- V ] </env>
  rule <k> matchDispatch(V:Val, #matchCases(#matchCapture(Name:Id), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => Rho [ Name <- V ] </env>
  rule <k> matchDispatch(V:Val, #matchCase(#matchOr(P1:MatchPattern, P2:MatchPattern), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCase(#matchOr(P1:MatchPattern, P2:MatchPattern), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCase(#matchOr(P1:MatchPattern, P2:MatchPattern), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCases(#matchOr(P1:MatchPattern, P2:MatchPattern), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCases(#matchOr(P1:MatchPattern, P2:MatchPattern), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
