  rule bytesBytesLikeValue(#bytes()) => #bytes()
  rule bytesBytesLikeValue(bytesVal(VS:ValItems)) => bytesVal(VS)
  rule bytesBytesLikeValue(#bytearray()) => #bytes()
  rule bytesBytesLikeValue(bytearrayVal(VS:ValItems)) => bytesVal(VS)
