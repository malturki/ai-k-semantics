           Inner ~> dictCompForIfsInner(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsOuterFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> InnerIter:Val ~> dictCompForIfsInner(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, iterableArgVals(InnerIter), Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, #noFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:DictVals, Rho:Map) =>
           Key ~> dictCompForIfsKey(X, OuterFilters, Inner, Y, #noFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> dictCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsInnerFilterNext(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filter(Filter:Exp), Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsInnerFilterLast(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> V:Val ~> dictCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, RestFilters:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, _:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Key ~> dictCompForIfsKey(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> K:Val ~> dictCompForIfsKey(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompForIfsValue(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompForIfsValue(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, appendDictVal(Acc, K, V), Rho)
       ... </k>
  rule <k> dictCompManyExp(Iter:Val, T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, iterableArgVals(Iter), #noDictVals, #noCompDictStack, Rho, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, #noDictVals, #noCompDictStack, _:Map, OuterRho:Map) =>
           ({}):Val ~> restoreEnv(OuterRho)
       ... </k>
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, Acc:DictVals, #noCompDictStack, _:Map, OuterRho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(OuterRho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, Acc:DictVals, compDictFrame(ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, ParentKey:Exp, ParentValue:Exp, ParentRestItems:ArgVals, ParentBaseRho:Map, ParentStack:CompDictStack), _:Map, OuterRho:Map) =>
           dictCompManyIter(ParentT, ParentFilters, ParentRest, ParentKey, ParentValue, ParentRestItems, Acc, ParentStack, ParentBaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyIter(T:Target, #noFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyAfter(T, #noFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> dictCompManyIter(T:Target, Filters:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyFilter(T, Filters, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> dictCompManyFilter(T:Target, Filters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> dictCompManyFilterNext(T, Filters, RestFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyFilter(T:Target, Filters:MaybeCompFilters, #filter(Filter:Exp), RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> dictCompManyFilterLast(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> V:Val ~> dictCompManyFilterNext(T:Target, Filters:MaybeCompFilters, RestFilters:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyFilter(T, Filters, RestFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompManyFilterNext(T:Target, Filters:MaybeCompFilters, _:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyAfter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #noCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Key ~> dictCompManyKey(T, Filters, #noCompClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClause(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters)), Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> dictCompManyDescend(NextT, NextFilters, #noCompClauses, T, Filters, #compRest(#compClause(NextIter, NextT, NextFilters)), Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClauses(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters, More:CompClauses)), Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> dictCompManyDescend(NextT, NextFilters, #compRest(More), T, Filters, #compRest(#compClauses(NextIter, NextT, NextFilters, More)), Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> NextIter:Val ~> dictCompManyDescend(NextT:Target, NextFilters:MaybeCompFilters, NextRest:MaybeCompClauses, ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, Key:Exp, Value:Exp, ParentRestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, ParentBaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(NextT, NextFilters, NextRest, Key, Value, iterableArgVals(NextIter), Acc, compDictFrame(ParentT, ParentFilters, ParentRest, Key, Value, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
       ... </k>
       <env> CurrentBaseRho </env>
  rule <k> K:Val ~> dictCompManyKey(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Value ~> dictCompManyValue(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho, K)
       ... </k>
  rule <k> V:Val ~> dictCompManyValue(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map, K:Val) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, appendDictVal(Acc, K, V), Stack, BaseRho, OuterRho)
       ... </k>

  rule <k> dictCtorKwExp(KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildDictCtorKw
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorKw =>
           dictCtorFromKwArgs(KWS)
       ... </k>
  rule <k> dictCtorMixedExp(Base:Val, KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildDictCtorMixed(Base)
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorMixed(Base:Val) =>
           dictCtorMergeKw(Base, KWS)
       ... </k>
  rule <k> complexCtorKwExp(KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildComplexCtorKw
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildComplexCtorKw =>
           complexCtorFromKwArgs(KWS)
       ... </k>
  rule <k> complexCtorMixedExp(Base:Val, KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildComplexCtorMixed(Base)
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildComplexCtorMixed(Base:Val) =>
           complexCtorMergeKw(Base, KWS)
       ... </k>

  rule #listCtor() => []
  rule #tupleCtor() => ()
  rule #dictCtor() => ({}):Val
  rule #setCtor() => set()
  rule #setCtor(V:Val) => setFromArgVals(iterableArgVals(V))
  rule #dictCtor(({}):Val) => ({}):Val
  rule #dictCtor(dictVal(DS:DictItems)) => dictVal(DS)
  rule #dictCtor([]) => ({}):Val
  rule #dictCtor(listVal(VS:ValItems)) => dictCtorFromPairs(VS)
  rule #dictCtor(()) => ({}):Val
  rule #dictCtor(tupleVal(VS:ValItems)) => dictCtorFromPairs(VS)
  rule dictCtorFromPairs(VS:ValItems) => ({}):Val
    requires emptyDictVals(dictCtorPairs(VS, #noDictVals))
  rule dictCtorFromPairs(VS:ValItems) => dictVal(dictValsToDictItems(dictCtorPairs(VS, #noDictVals)))
    requires notBool emptyDictVals(dictCtorPairs(VS, #noDictVals))
  rule #listCtor([]) => []
  rule #listCtor(listVal(VS:ValItems)) => listVal(VS)
  rule #listCtor(()) => []
  rule #listCtor(tupleVal(VS:ValItems)) => listVal(VS)
  rule #listCtor(S:String) => []
    requires lengthString(S) ==Int 0
  rule #listCtor(S:String) => listVal(stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule #listCtor(#bytes()) => []
  rule #listCtor(bytesVal(VS:ValItems)) => listVal(VS)
  rule #listCtor(({}):Val) => []
  rule #listCtor(dictVal(DS:DictItems)) => listVal(dictKeysToValItems(DS))
  rule #listCtor(set()) => []
  rule #listCtor(setVal(VS:ValItems)) => listVal(VS)
  rule #listCtor(rangeVal(Start:Int, Stop:Int)) => []
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule #listCtor(rangeVal(Start:Int, Stop:Int)) =>
    listVal(rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule #listCtor(rangeVal(Start:Int, Stop:Int, Step:Int)) => []
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule #listCtor(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    listVal(rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule #tupleCtor([]) => ()
  rule #tupleCtor(listVal(VS:ValItems)) => tupleVal(VS)
  rule #tupleCtor(()) => ()
  rule #tupleCtor(tupleVal(VS:ValItems)) => tupleVal(VS)
  rule #tupleCtor(S:String) => ()
    requires lengthString(S) ==Int 0
  rule #tupleCtor(S:String) => tupleVal(stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule #tupleCtor(#bytes()) => ()
  rule #tupleCtor(bytesVal(VS:ValItems)) => tupleVal(VS)
  rule #tupleCtor(({}):Val) => ()
  rule #tupleCtor(dictVal(DS:DictItems)) => tupleVal(dictKeysToValItems(DS))
  rule #tupleCtor(set()) => ()
  rule #tupleCtor(setVal(VS:ValItems)) => tupleVal(VS)
  rule #tupleCtor(rangeVal(Start:Int, Stop:Int)) => ()
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule #tupleCtor(rangeVal(Start:Int, Stop:Int)) =>
    tupleVal(rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule #tupleCtor(rangeVal(Start:Int, Stop:Int, Step:Int)) => ()
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule #tupleCtor(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    tupleVal(rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule #boolCtor() => False
  rule #boolCtor(V:Val) => boolValue(truthy(V))
  rule #all([]) => True
  rule #all(listVal(VS:ValItems)) => boolValue(allValItems(VS))
  rule #all(()) => True
  rule #all(tupleVal(VS:ValItems)) => boolValue(allValItems(VS))
  rule #all(_:String) => True
  rule #all(#bytes()) => True
  rule #all(bytesVal(VS:ValItems)) => boolValue(allValItems(VS))
  rule #all(({}):Val) => True
  rule #all(dictVal(DS:DictItems)) => boolValue(allValItems(dictKeysToValItems(DS)))
  rule #all(set()) => True
  rule #all(setVal(VS:ValItems)) => boolValue(allValItems(VS))
  rule #all(rangeVal(Start:Int, Stop:Int)) => boolValue(rangeAllTruthy(Start, Stop, 1))
  rule #all(rangeVal(Start:Int, Stop:Int, Step:Int)) => boolValue(rangeAllTruthy(Start, Stop, Step))
    requires Step =/=Int 0
  rule #any([]) => False
  rule #any(listVal(VS:ValItems)) => boolValue(anyValItems(VS))
  rule #any(()) => False
  rule #any(tupleVal(VS:ValItems)) => boolValue(anyValItems(VS))
  rule #any(S:String) => boolValue(lengthString(S) >Int 0)
  rule #any(#bytes()) => False
  rule #any(bytesVal(VS:ValItems)) => boolValue(anyValItems(VS))
  rule #any(({}):Val) => False
  rule #any(dictVal(DS:DictItems)) => boolValue(anyValItems(dictKeysToValItems(DS)))
  rule #any(set()) => False
  rule #any(setVal(VS:ValItems)) => boolValue(anyValItems(VS))
  rule #any(rangeVal(Start:Int, Stop:Int)) => boolValue(rangeAnyTruthy(Start, Stop, 1))
  rule #any(rangeVal(Start:Int, Stop:Int, Step:Int)) => boolValue(rangeAnyTruthy(Start, Stop, Step))
    requires Step =/=Int 0
  rule #sum([]) => 0
  rule #sum(listVal(VS:ValItems)) => sumValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #sum(()) => 0
  rule #sum(tupleVal(VS:ValItems)) => sumValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #sum(#bytes()) => 0
  rule #sum(bytesVal(VS:ValItems)) => sumValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #sum(({}):Val) => 0
  rule #sum(dictVal(DS:DictItems)) => sumValItems(dictKeysToValItems(DS))
    requires valItemsAllIntLike(dictKeysToValItems(DS))
  rule #sum(set()) => 0
  rule #sum(setVal(VS:ValItems)) => sumValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #sum(rangeVal(Start:Int, Stop:Int)) => rangeSum(Start, Stop, 1)
  rule #sum(rangeVal(Start:Int, Stop:Int, Step:Int)) => rangeSum(Start, Stop, Step)
    requires Step =/=Int 0
  rule #sum([], Seed:Val) => Seed
    requires isIntLike(Seed)
  rule #sum(listVal(VS:ValItems), Seed:Val) => intValue(Seed) +Int sumValItems(VS)
    requires isIntLike(Seed) andBool valItemsAllIntLike(VS)
  rule #sum((), Seed:Val) => Seed
    requires isIntLike(Seed)
  rule #sum(tupleVal(VS:ValItems), Seed:Val) => intValue(Seed) +Int sumValItems(VS)
    requires isIntLike(Seed) andBool valItemsAllIntLike(VS)
  rule #sum(#bytes(), Seed:Val) => Seed
    requires isIntLike(Seed)
  rule #sum(bytesVal(VS:ValItems), Seed:Val) => intValue(Seed) +Int sumValItems(VS)
    requires isIntLike(Seed) andBool valItemsAllIntLike(VS)
  rule #sum(({}):Val, Seed:Val) => Seed
    requires isIntLike(Seed)
  rule #sum(dictVal(DS:DictItems), Seed:Val) => intValue(Seed) +Int sumValItems(dictKeysToValItems(DS))
    requires isIntLike(Seed) andBool valItemsAllIntLike(dictKeysToValItems(DS))
  rule #sum(set(), Seed:Val) => Seed
    requires isIntLike(Seed)
  rule #sum(setVal(VS:ValItems), Seed:Val) => intValue(Seed) +Int sumValItems(VS)
    requires isIntLike(Seed) andBool valItemsAllIntLike(VS)
  rule #sum(rangeVal(Start:Int, Stop:Int), Seed:Val) => Seed
    requires isIntLike(Seed) andBool pyRangeLen(Start, Stop, 1) ==Int 0
  rule #sum(rangeVal(Start:Int, Stop:Int), Seed:Val) => intValue(Seed) +Int rangeSum(Start, Stop, 1)
    requires isIntLike(Seed) andBool pyRangeLen(Start, Stop, 1) >Int 0
  rule #sum(rangeVal(Start:Int, Stop:Int, Step:Int), Seed:Val) => Seed
    requires isIntLike(Seed) andBool Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule #sum(rangeVal(Start:Int, Stop:Int, Step:Int), Seed:Val) => intValue(Seed) +Int rangeSum(Start, Stop, Step)
    requires isIntLike(Seed) andBool Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule #min(listVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(tupleVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(bytesVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(dictVal(DS:DictItems)) => minValItems(dictKeysToValItems(DS))
    requires valItemsAllIntLike(dictKeysToValItems(DS))
  rule #min(setVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(rangeVal(Start:Int, Stop:Int)) => rangeMin(Start, Stop, 1)
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule #min(rangeVal(Start:Int, Stop:Int, Step:Int)) => rangeMin(Start, Stop, Step)
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule #max(listVal(VS:ValItems)) => maxValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #max(tupleVal(VS:ValItems)) => maxValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #max(bytesVal(VS:ValItems)) => maxValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #max(dictVal(DS:DictItems)) => maxValItems(dictKeysToValItems(DS))
    requires valItemsAllIntLike(dictKeysToValItems(DS))
  rule #max(setVal(VS:ValItems)) => maxValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #max(rangeVal(Start:Int, Stop:Int)) => rangeMax(Start, Stop, 1)
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule #max(rangeVal(Start:Int, Stop:Int, Step:Int)) => rangeMax(Start, Stop, Step)
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule <k> minArgsExp(Args:ArgExps) => evalArgs(Args, #noArgVals) ~> minArgsResult ... </k>
  rule <k> argsVal(VS:ArgVals) ~> minArgsResult => minArgVals(VS) ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> maxArgsExp(Args:ArgExps) => evalArgs(Args, #noArgVals) ~> maxArgsResult ... </k>
  rule <k> argsVal(VS:ArgVals) ~> maxArgsResult => maxArgVals(VS) ... </k>
    requires notBool emptyArgVals(VS)
  rule #sliceCtor(Stop:Val) => sliceVal(None, Stop, None)
  rule #sliceCtor(Start:Val, Stop:Val) => sliceVal(Start, Stop, None)
  rule #sliceCtor(Start:Val, Stop:Val, Step:Val) => sliceVal(Start, Stop, Step)
  rule #intCtor() => 0
  rule #intCtor(V:Val) => intValue(V)
    requires isIntLike(V)
  rule #intCtor(bytesVal(VS:ValItems)) => #intCtor(bytesAsciiString(VS))
    requires valItemsAllByteInts(VS)
  rule #intCtor(S:String) => intStringValue(stripAsciiSpace(S), 10)
    requires stripAsciiSpace(S) =/=String S
      andBool intStringOk(stripAsciiSpace(S), 10)
  rule #intCtor(S:String) => intStringValue(S, 10)
    requires intStringOk(S, 10)
  rule #intCtor(S:String, B:Val) => intBase0StringValue(stripAsciiSpace(S))
    requires stripAsciiSpace(S) =/=String S
      andBool isIntLike(B)
      andBool intValue(B) ==Int 0
      andBool intBase0StringOk(stripAsciiSpace(S))
  rule #intCtor(S:String, B:Val) => intBase0StringValue(S)
    requires isIntLike(B)
      andBool intValue(B) ==Int 0
      andBool intBase0StringOk(S)
  rule #intCtor(S:String, B:Val) => intPrefixedStringValue(stripAsciiSpace(S), intValue(B))
    requires stripAsciiSpace(S) =/=String S
      andBool isIntLike(B)
      andBool intPrefixedStringOk(stripAsciiSpace(S), intValue(B))
  rule #intCtor(S:String, B:Val) => intPrefixedStringValue(S, intValue(B))
    requires isIntLike(B)
      andBool intPrefixedStringOk(S, intValue(B))
  rule #intCtor(S:String, B:Val) => intStringValue(stripAsciiSpace(S), intValue(B))
    requires stripAsciiSpace(S) =/=String S
      andBool isIntLike(B)
      andBool intStringOk(stripAsciiSpace(S), intValue(B))
  rule #intCtor(S:String, B:Val) => intStringValue(S, intValue(B))
    requires isIntLike(B) andBool intStringOk(S, intValue(B))
  rule #intCtor(bytesVal(VS:ValItems), B:Val) => #intCtor(bytesAsciiString(VS), B)
    requires valItemsAllByteInts(VS)
  rule #floatCtor() => 0.0
  rule #floatCtor(F:Float) => F
  rule #floatCtor(V:Val) => floatValue(V)
    requires isIntLike(V)
  rule #floatCtor(bytesVal(VS:ValItems)) => #floatCtor(bytesAsciiString(VS))
    requires valItemsAllByteInts(VS)
  rule #floatCtor(S:String) => #floatCtor(stripAsciiSpace(S))
    requires stripAsciiSpace(S) =/=String S
      andBool (intStringOk(stripAsciiSpace(S), 10)
        orBool floatDecimalStringOk(stripAsciiSpace(S))
        orBool floatExponentStringOk(stripAsciiSpace(S))
        orBool floatSpecialStringOk(stripAsciiSpace(S)))
  rule #floatCtor(S:String) => Int2Float(intStringValue(S, 10), 53, 11)
    requires intStringOk(S, 10)
  rule #floatCtor(S:String) => floatDecimalStringValue(S)
    requires floatDecimalStringOk(S)
  rule #floatCtor(S:String) => floatExponentStringValue(S)
    requires floatExponentStringOk(S)
  rule #floatCtor(S:String) => floatSpecialStringValue(S)
    requires floatSpecialStringOk(S)
  rule #complexCtor() => #complex(0.0, 0.0)
  rule #complexCtor(S:String) => #complexCtor(stripPythonStringSpace(S))
    requires stripPythonStringSpace(S) =/=String S
      andBool complexStringOk(stripPythonStringSpace(S))
  rule #complexCtor(S:String) => #complexCtor(stripPythonStringSpace(substrString(S, 1, lengthString(S) -Int 1)))
    requires complexParenStringOk(S)
  rule #complexCtor(S:String) => #complex(floatStringValue(S), 0.0)
    requires floatStringOk(S)
  rule #complexCtor(S:String) => #complex(0.0, complexImagStringValue(S))
    requires complexImagStringOk(S)
  rule #complexCtor(S:String) =>
    #complex(
      floatStringValue(substrString(S, 0, complexSplitIndex(S))),
      complexImagStringValue(substrString(S, complexSplitIndex(S), lengthString(S))))
    requires complexPairStringOk(S)
  rule #complexCtor(V:Val) => #complex(complexReal(V), complexImag(V))
    requires isComplexLike(V)
  rule #complexCtor(V1:Val, V2:Val) =>
    #complex(complexReal(V1) -Float complexImag(V2), complexImag(V1) +Float complexReal(V2))
    requires isComplexLike(V1) andBool isComplexLike(V2)
  rule #conjugate(#complex(R:Float, I:Float)) => #complex(R, 0.0 -Float I)
  rule #conjugate(F:Float) => F
  rule #conjugate(V:Val) => intValue(V)
    requires isIntLike(V)
  rule #abs(V:Val) => 0 -Int intValue(V)
    requires isIntLike(V) andBool intValue(V) <Int 0
  rule #abs(V:Val) => intValue(V)
    requires isIntLike(V) andBool intValue(V) >=Int 0
  rule #abs(F:Float) => --Float F
    requires F <Float 0.0
  rule #abs(F:Float) => F
    requires F >=Float 0.0
  rule #divmod(V1:Val, V2:Val) =>
    tupleVal(valItemsCons(pyFloorDiv(intValue(V1), intValue(V2)), valItemsLast(pyModulo(intValue(V1), intValue(V2)))))
    requires isIntLike(V1) andBool isIntLike(V2) andBool intValue(V2) =/=Int 0
  rule #divmod(F1:Float, F2:Float) =>
    tupleVal(valItemsCons(pyFloatFloorDiv(F1, F2), valItemsLast(pyFloatModulo(F1, F2))))
    requires F2 =/=Float 0.0
  rule #divmod(F:Float, V:Val) =>
    tupleVal(valItemsCons(pyFloatFloorDiv(F, floatValue(V)), valItemsLast(pyFloatModulo(F, floatValue(V)))))
    requires isIntLike(V) andBool intValue(V) =/=Int 0
  rule #divmod(V:Val, F:Float) =>
    tupleVal(valItemsCons(pyFloatFloorDiv(floatValue(V), F), valItemsLast(pyFloatModulo(floatValue(V), F))))
    requires isIntLike(V) andBool F =/=Float 0.0
  rule #pow(V1:Val, V2:Val) => intValue(V1) ^Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2) andBool intValue(V2) >=Int 0
  rule #pow(V1:Val, V2:Val) => Int2Float(intValue(V1), 53, 11) ^Float Int2Float(intValue(V2), 53, 11)
    requires isIntLike(V1) andBool isIntLike(V2) andBool intValue(V1) =/=Int 0 andBool intValue(V2) <Int 0
  rule #pow(F1:Float, F2:Float) => F1 ^Float F2
    requires F1 >=Float 0.0 andBool (F1 =/=Float 0.0 orBool F2 >=Float 0.0)
  rule #pow(F:Float, V:Val) => F ^Float floatValue(V)
    requires isIntLike(V) andBool F >=Float 0.0 andBool (F =/=Float 0.0 orBool intValue(V) >=Int 0)
  rule #pow(V:Val, F:Float) => floatValue(V) ^Float F
    requires isIntLike(V) andBool floatValue(V) >=Float 0.0 andBool (intValue(V) =/=Int 0 orBool F >=Float 0.0)
  rule #pow(#complex(R:Float, I:Float), V:Val) => complexPowInt(R, I, intValue(V))
    requires isIntLike(V)
      andBool (intValue(V) >=Int 0 orBool (R *Float R) +Float (I *Float I) =/=Float 0.0)
  rule #pow(V1:Val, V2:Val, V3:Val) => pyModulo(intValue(V1) ^Int intValue(V2), intValue(V3))
    requires isIntLike(V1)
      andBool isIntLike(V2)
      andBool isIntLike(V3)
      andBool intValue(V2) >=Int 0
      andBool intValue(V3) =/=Int 0
  rule #pow(V1:Val, V2:Val, V3:Val) =>
    pyModulo(pyModInverse(intValue(V1), intValue(V3)) ^Int (0 -Int intValue(V2)), intValue(V3))
    requires isIntLike(V1)
      andBool isIntLike(V2)
      andBool isIntLike(V3)
      andBool intValue(V2) <Int 0
      andBool intValue(V3) =/=Int 0
      andBool pyGcd(pyModulo(intValue(V1), intAbs(intValue(V3))), intAbs(intValue(V3))) ==Int 1

  rule range1Exp(N:Val) => rangeVal(0, intValue(N))
    requires isIntLike(N)
  rule range2Exp(Start:Val, Stop:Val) => rangeVal(intValue(Start), intValue(Stop))
    requires isIntLike(Start) andBool isIntLike(Stop)
  rule range3Exp(Start:Val, Stop:Val, Step:Val) => rangeVal(intValue(Start), intValue(Stop), intValue(Step))
    requires isIntLike(Start) andBool isIntLike(Stop) andBool isIntLike(Step) andBool intValue(Step) =/=Int 0

  rule <k> assignStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> assignNameStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> subscriptAssignStmt(X:Id, I:Exp, E:Exp) =>
           E ~> subscriptAssignIndex(X, I)
       ... </k>
  rule <k> V:Val ~> subscriptAssignIndex(X:Id, I:Exp) =>
           I ~> subscriptAssignApply(X, V)
       ... </k>
  rule <k> I:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSet(VS, intValue(I), V))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule <k> I:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSet(VS, valItemsLen(VS) +Int intValue(I), V))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule <k> K:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (({}):Val => dictVal(dictItemsLast(K, V))) ... </env>
       <result> _ => .K </result>
  rule <k> K:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (dictVal(DS:DictItems) => dictVal(dictSet(DS, K, V))) ... </env>
       <result> _ => .K </result>

  rule <k> subscriptAugStmt(X:Id, I:Exp, Op:AugOp, E:Exp) =>
           I ~> subscriptAugOld(X, Op, E)
       ... </k>
  rule <k> I:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, I, listGet(VS, intValue(I)), Op)
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule <k> I:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, I, listGet(VS, valItemsLen(VS) +Int intValue(I)), Op)
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule <k> K:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, K, dictGet(DS, K), Op)
       ... </k>
       <env> ... X |-> dictVal(DS:DictItems) ... </env>
    requires containsKey(K, DS)
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augAdd) =>
           L + R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augSub) =>
           L - R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augMul) =>
           L * R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augTrueDiv) =>
           #trueDiv(L, R) ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augFloorDiv) =>
           #floorDiv(L, R) ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augMod) =>
           L % R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augPow) =>
           L ** R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augLShift) =>
           L << R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augRShift) =>
           L >> R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitAnd) =>
           L & R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitXor) =>
           L ^ R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitOr) =>
           L | R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> V:Val ~> subscriptAugStore(X:Id, I:Val) =>
           I ~> subscriptAssignApply(X, V)
       ... </k>

  rule <k> sliceAssignStmt(X:Id, Lower:Exp, Upper:Exp, E:Exp) =>
           E ~> sliceAssignLower(X, Lower, Upper)
       ... </k>
  rule <k> V:Val ~> sliceAssignLower(X:Id, Lower:Exp, Upper:Exp) =>
           Lower ~> sliceAssignUpper(X, V, Upper)
       ... </k>
  rule <k> Lower:Val ~> sliceAssignUpper(X:Id, V:Val, Upper:Exp) =>
           Upper ~> sliceAssignApply(X, V, Lower)
       ... </k>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, listVal(RS:ValItems), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, [], Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, (), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, listVal(RS:ValItems), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, tupleVal(RS:ValItems), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, [], _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, (), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>

  rule <k> sliceStepAssignStmt(X:Id, Lower:Exp, Upper:Exp, Step:Exp, E:Exp) =>
           E ~> sliceStepAssignLower(X, Lower, Upper, Step)
       ... </k>
  rule <k> V:Val ~> sliceStepAssignLower(X:Id, Lower:Exp, Upper:Exp, Step:Exp) =>
           Lower ~> sliceStepAssignUpper(X, V, Upper, Step)
       ... </k>
  rule <k> Lower:Val ~> sliceStepAssignUpper(X:Id, V:Val, Upper:Exp, Step:Exp) =>
           Upper ~> sliceStepAssignStep(X, V, Lower, Step)
       ... </k>
  rule <k> Upper:Val ~> sliceStepAssignStep(X:Id, V:Val, Lower:Val, Step:Exp) =>
           Step ~> sliceStepAssignApply(X, V, Lower, Upper)
       ... </k>
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0

  rule <k> augAddStmt(X:Id, E:Exp) => assignStmt(X, X + E) ... </k>
  rule <k> augSubStmt(X:Id, E:Exp) => assignStmt(X, X - E) ... </k>
  rule <k> augMulStmt(X:Id, E:Exp) => assignStmt(X, X * E) ... </k>
  rule <k> augTrueDivStmt(X:Id, E:Exp) => assignStmt(X, #trueDiv(X, E)) ... </k>
  rule <k> augModStmt(X:Id, E:Exp) => assignStmt(X, X % E) ... </k>
  rule <k> augPowStmt(X:Id, E:Exp) => assignStmt(X, X ** E) ... </k>
  rule <k> augLShiftStmt(X:Id, E:Exp) => assignStmt(X, X << E) ... </k>
  rule <k> augRShiftStmt(X:Id, E:Exp) => assignStmt(X, X >> E) ... </k>
  rule <k> augBitAndStmt(X:Id, E:Exp) => assignStmt(X, X & E) ... </k>
  rule <k> augBitXorStmt(X:Id, E:Exp) => assignStmt(X, X ^ E) ... </k>
  rule <k> augBitOrStmt(X:Id, E:Exp) => assignStmt(X, X | E) ... </k>
  rule <k> augFloorDivStmt(X:Id, E:Exp) => assignStmt(X, #floorDiv(X, E)) ... </k>

  rule <k> assignManyStmt(IDS:IdItems, V:Val) => assignMany(IDS, V) ... </k>
  rule <k> assignMany(idItemsLast(X:Id), V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> assignMany(idItemsCons(X:Id, IDS:IdItems), V:Val) => assignMany(IDS, V) ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> annAssignStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> annOnlyStmt(_:Id) => stmtNoResult ... </k>
       <result> _ => .K </result>

  rule <k> unpackAssignStmt(IDS:IdItems, listVal(VS:ValItems)) => stmtNoResult ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
       <result> _ => .K </result>
    requires sameIdValArity(IDS, VS)
