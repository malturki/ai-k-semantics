module PYTHON
  imports PYTHON-SYNTAX
  imports INT
  imports BOOL
  imports STRING
  imports ID
  imports FLOAT
  imports MAP

  syntax Val ::= closure(Id, Exp) [symbol(closure)]
               | closureArgs(IdItems, Exp) [symbol(closureArgs)]
               | closureDefaults(IdItems, ArgVals, Exp) [symbol(closureDefaults)]
               | closureVarArgs(IdItems, Id, Exp) [symbol(closureVarArgs)]
               | closureVarArgsDefaults(IdItems, ArgVals, Id, Exp) [symbol(closureVarArgsDefaults)]
               | closureVarArgsKwOnly(IdItems, Id, IdItems, Exp) [symbol(closureVarArgsKwOnly)]
               | closureVarArgsKwDefaults(IdItems, ArgVals, Id, IdItems, ArgVals, Exp) [symbol(closureVarArgsKwDefaults)]
               | closureVarArgsKwOnlyKwArgs(IdItems, Id, IdItems, Id, Exp) [symbol(closureVarArgsKwOnlyKwArgs)]
               | closureVarArgsKwDefaultsKwArgs(IdItems, ArgVals, Id, IdItems, ArgVals, Id, Exp) [symbol(closureVarArgsKwDefaultsKwArgs)]
               | closureVarKwArgs(IdItems, Id, Id, Exp) [symbol(closureVarKwArgs)]
               | closureVarKwArgsDefaults(IdItems, ArgVals, Id, Id, Exp) [symbol(closureVarKwArgsDefaults)]
               | closureKwArgs(IdItems, Id, Exp) [symbol(closureKwArgs)]
               | closureKwArgsDefaults(IdItems, ArgVals, Id, Exp) [symbol(closureKwArgsDefaults)]
               | closurePosOnly(IdItems, IdItems, Exp) [symbol(closurePosOnly)]
               | closurePosOnlyDefaults(IdItems, IdItems, ArgVals, Exp) [symbol(closurePosOnlyDefaults)]
               | closurePosOnlyVarArgs(IdItems, IdItems, Id, Exp) [symbol(closurePosOnlyVarArgs)]
               | closurePosOnlyVarArgsDefaults(IdItems, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyVarArgsDefaults)]
               | closurePosOnlyKwArgs(IdItems, IdItems, Id, Exp) [symbol(closurePosOnlyKwArgs)]
               | closurePosOnlyKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyKwArgsDefaults)]
               | closurePosOnlyVarKwArgs(IdItems, IdItems, Id, Id, Exp) [symbol(closurePosOnlyVarKwArgs)]
               | closurePosOnlyVarKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Id, Exp) [symbol(closurePosOnlyVarKwArgsDefaults)]
               | closurePosOnlyVarArgsKwOnly(IdItems, IdItems, Id, IdItems, Exp) [symbol(closurePosOnlyVarArgsKwOnly)]
               | closurePosOnlyVarArgsKwDefaults(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Exp) [symbol(closurePosOnlyVarArgsKwDefaults)]
               | closurePosOnlyVarArgsKwOnlyKwArgs(IdItems, IdItems, Id, IdItems, Id, Exp) [symbol(closurePosOnlyVarArgsKwOnlyKwArgs)]
               | closurePosOnlyVarArgsKwDefaultsKwArgs(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyVarArgsKwDefaultsKwArgs)]
               | closurePosOnlyKwOnly(IdItems, IdItems, IdItems, Exp) [symbol(closurePosOnlyKwOnly)]
