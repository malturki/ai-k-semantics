  rule <k> dictCompForIfsIter(X:Id, OuterFilters:CompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, argValsCons(V:Val, RestOuter:ArgVals), Acc:DictVals, Rho:Map) =>
           dictCompForIfsOuterFilter(X, OuterFilters, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
       <env> _ => Rho [ X <- V ] </env>
  rule <k> dictCompForIfsOuterFilter(X:Id, OuterFilters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsOuterFilterNext(X, OuterFilters, RestFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsOuterFilter(X:Id, OuterFilters:MaybeCompFilters, #filter(Filter:Exp), Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsOuterFilterLast(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
  rule <k> V:Val ~> dictCompForIfsOuterFilterNext(X:Id, OuterFilters:MaybeCompFilters, RestFilters:CompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsOuterFilter(X, OuterFilters, RestFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsOuterFilterNext(X:Id, OuterFilters:MaybeCompFilters, _:CompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompForIfsOuterFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           Inner ~> dictCompForIfsInner(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsOuterFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> iteratorRef(I:Int) ~> dictCompForIfsInner(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           #listCtor(iteratorRef(I)) ~> dictCompForIfsInnerIteratorApply(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
  rule <k> InnerIter:Val ~> dictCompForIfsInner(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, iterableArgVals(InnerIter), Acc, Rho)
       ... </k>
    requires notBool isIteratorRef(InnerIter)
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, #noArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, #noFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:DictVals, Rho:Map) =>
           Key ~> dictCompForIfsKey(X, OuterFilters, Inner, Y, #noFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> dictCompForIfsInnerIter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, argValsCons(V:Val, RestInner:ArgVals), Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
       <env> RhoCurrent:Map => RhoCurrent [ Y <- V ] </env>
  rule <k> dictCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsInnerFilterNext(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> dictCompForIfsInnerFilter(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, #filter(Filter:Exp), Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Filter ~> dictCompForIfsInnerFilterLast(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
  rule <k> V:Val ~> dictCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, RestFilters:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerFilter(X, OuterFilters, Inner, Y, InnerFilters, RestFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterNext(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, _:CompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Key ~> dictCompForIfsKey(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompForIfsInnerFilterLast(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho)
       ... </k>
    requires notBool truthy(V)
  rule <k> K:Val ~> dictCompForIfsKey(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map) =>
           Value ~> dictCompForIfsValue(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, Acc, Rho, K)
       ... </k>
  rule <k> V:Val ~> dictCompForIfsValue(X:Id, OuterFilters:MaybeCompFilters, Inner:Exp, Y:Id, InnerFilters:MaybeCompFilters, Key:Exp, Value:Exp, RestOuter:ArgVals, RestInner:ArgVals, Acc:DictVals, Rho:Map, K:Val) =>
           dictCompForIfsInnerIter(X, OuterFilters, Inner, Y, InnerFilters, Key, Value, RestOuter, RestInner, appendDictVal(Acc, K, V), Rho)
       ... </k>
  rule <k> dictCompManyExp(iteratorRef(I:Int), T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp) =>
           #listCtor(iteratorRef(I)) ~> dictCompManyIteratorApply(T, Filters, RestClauses, Key, Value, #noDictVals, #noCompDictStack, Rho, Rho)
       ... </k>
       <env> Rho </env>
  rule <k> dictCompManyExp(Iter:Val, T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, iterableArgVals(Iter), #noDictVals, #noCompDictStack, Rho, Rho)
       ... </k>
       <env> Rho </env>
    requires notBool isIteratorRef(Iter)
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, #noDictVals, #noCompDictStack, _:Map, OuterRho:Map) =>
           ({}):Val ~> restoreEnv(OuterRho)
       ... </k>
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, Acc:DictVals, #noCompDictStack, _:Map, OuterRho:Map) =>
           dictVal(dictValsToDictItems(Acc)) ~> restoreEnv(OuterRho)
       ... </k>
    requires notBool emptyDictVals(Acc)
  rule <k> dictCompManyIter(_:Target, _:MaybeCompFilters, _:MaybeCompClauses, _:Exp, _:Exp, #noArgVals, Acc:DictVals, compDictFrame(ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, ParentKey:Exp, ParentValue:Exp, ParentRestItems:ArgVals, ParentBaseRho:Map, ParentStack:CompDictStack), _:Map, OuterRho:Map) =>
           dictCompManyIter(ParentT, ParentFilters, ParentRest, ParentKey, ParentValue, ParentRestItems, Acc, ParentStack, ParentBaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyIter(T:Target, #noFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyAfter(T, #noFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> dictCompManyIter(T:Target, Filters:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, argValsCons(V:Val, RestItems:ArgVals), Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyFilter(T, Filters, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
       <env> _ => bindTarget(BaseRho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> dictCompManyFilter(T:Target, Filters:MaybeCompFilters, #filters(Filter:Exp, RestFilters:CompFilters), RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> dictCompManyFilterNext(T, Filters, RestFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyFilter(T:Target, Filters:MaybeCompFilters, #filter(Filter:Exp), RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Filter ~> dictCompManyFilterLast(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> V:Val ~> dictCompManyFilterNext(T:Target, Filters:MaybeCompFilters, RestFilters:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyFilter(T, Filters, RestFilters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompManyFilterNext(T:Target, Filters:MaybeCompFilters, _:CompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> V:Val ~> dictCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyAfter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires truthy(V)
  rule <k> V:Val ~> dictCompManyFilterLast(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
    requires notBool truthy(V)
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #noCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Key ~> dictCompManyKey(T, Filters, #noCompClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClause(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters)), Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> dictCompManyDescend(NextT, NextFilters, #noCompClauses, T, Filters, #compRest(#compClause(NextIter, NextT, NextFilters)), Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> dictCompManyAfter(T:Target, Filters:MaybeCompFilters, #compRest(#compClauses(NextIter:Exp, NextT:Target, NextFilters:MaybeCompFilters, More:CompClauses)), Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           NextIter ~> dictCompManyDescend(NextT, NextFilters, #compRest(More), T, Filters, #compRest(#compClauses(NextIter, NextT, NextFilters, More)), Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho)
       ... </k>
  rule <k> iteratorRef(I:Int) ~> dictCompManyDescend(NextT:Target, NextFilters:MaybeCompFilters, NextRest:MaybeCompClauses, ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, Key:Exp, Value:Exp, ParentRestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, ParentBaseRho:Map, OuterRho:Map) =>
           #listCtor(iteratorRef(I)) ~> dictCompManyIteratorApply(NextT, NextFilters, NextRest, Key, Value, Acc, compDictFrame(ParentT, ParentFilters, ParentRest, Key, Value, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
       ... </k>
       <env> CurrentBaseRho </env>
  rule <k> NextIter:Val ~> dictCompManyDescend(NextT:Target, NextFilters:MaybeCompFilters, NextRest:MaybeCompClauses, ParentT:Target, ParentFilters:MaybeCompFilters, ParentRest:MaybeCompClauses, Key:Exp, Value:Exp, ParentRestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, ParentBaseRho:Map, OuterRho:Map) =>
           dictCompManyIter(NextT, NextFilters, NextRest, Key, Value, iterableArgVals(NextIter), Acc, compDictFrame(ParentT, ParentFilters, ParentRest, Key, Value, ParentRestItems, ParentBaseRho, Stack), CurrentBaseRho, OuterRho)
       ... </k>
       <env> CurrentBaseRho </env>
    requires notBool isIteratorRef(NextIter)
  rule <k> K:Val ~> dictCompManyKey(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map) =>
           Value ~> dictCompManyValue(T, Filters, RestClauses, Key, Value, RestItems, Acc, Stack, BaseRho, OuterRho, K)
       ... </k>
  rule <k> V:Val ~> dictCompManyValue(T:Target, Filters:MaybeCompFilters, RestClauses:MaybeCompClauses, Key:Exp, Value:Exp, RestItems:ArgVals, Acc:DictVals, Stack:CompDictStack, BaseRho:Map, OuterRho:Map, K:Val) =>
           dictCompManyIter(T, Filters, RestClauses, Key, Value, RestItems, appendDictVal(Acc, K, V), Stack, BaseRho, OuterRho)
       ... </k>

  rule <k> dictCtorKwExp(KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildDictCtorKw
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorKw =>
           dictCtorFromKwArgs(KWS)
       ... </k>
    requires kwNoDuplicates(KWS)
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorKw =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool kwNoDuplicates(KWS)
  rule <k> dictCtorMixedExp(Base:Val, KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildDictCtorMixed(Base)
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorMixed(Base:Val) =>
           dictCtorMergeKw(Base, KWS)
       ... </k>
    requires kwNoDuplicates(KWS)
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildDictCtorMixed(_Base:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool kwNoDuplicates(KWS)
  rule <k> complexCtorKwExp(KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildComplexCtorKw
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildComplexCtorKw =>
           complexCtorFromKwArgs(KWS)
       ... </k>
  rule <k> complexCtorMixedExp(Base:Val, KWS:KwArgExps) =>
           evalKwArgs(KWS, #noKwArgVals) ~> buildComplexCtorMixed(Base)
       ... </k>
  rule <k> kwArgsVal(KWS:KwArgVals) ~> buildComplexCtorMixed(Base:Val) =>
           complexCtorMergeKw(Base, KWS)
       ... </k>

  rule #listCtor() => []
  rule #tupleCtor() => ()
  rule #dictCtor() => ({}):Val
  rule <k> #dictFromKeys(Iter:Exp) =>
           Iter ~> dictFromKeysDefault
       ... </k>
    requires notBool isKResult(Iter)
  rule <k> Iter:Val ~> dictFromKeysDefault =>
           #dictFromKeys(Iter, None)
       ... </k>
  rule #dictFromKeys(Iter:Val) => #dictFromKeys(Iter, None)
  rule <k> #dictFromKeys(Iter:Exp, Default:Exp) =>
           Iter ~> dictFromKeysIterDefault(Default)
       ... </k>
    requires notBool isKResult(Iter)
  rule <k> Iter:Val ~> dictFromKeysIterDefault(Default:Exp) =>
           #dictFromKeys(Iter, Default)
       ... </k>
  rule <k> #dictFromKeys(Iter:Val, Default:Exp) =>
           Default ~> dictFromKeysApply(Iter)
       ... </k>
    requires notBool isKResult(Default)
  rule <k> Default:Val ~> dictFromKeysApply(Iter:Val) =>
           dictFromKeysValue(Iter, Default)
       ... </k>
    requires unpackValueSupported(Iter)
      andBool dictFromKeysArgValsSupported(iterableArgVals(Iter))
  rule <k> _Default:Val ~> dictFromKeysApply(Iter:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool unpackValueSupported(Iter)
  rule <k> _Default:Val ~> dictFromKeysApply(Iter:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires unpackValueSupported(Iter)
      andBool notBool dictFromKeysArgValsSupported(iterableArgVals(Iter))
  rule #dictFromKeys(Iter:Val, Default:Val) => dictFromKeysValue(Iter, Default)
    requires unpackValueSupported(Iter)
      andBool dictFromKeysArgValsSupported(iterableArgVals(Iter))
  rule <k> #dictFromKeys(Iter:Val, _Default:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool unpackValueSupported(Iter)
  rule <k> #dictFromKeys(Iter:Val, _Default:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires unpackValueSupported(Iter)
      andBool notBool dictFromKeysArgValsSupported(iterableArgVals(Iter))
  rule #setCtor() => set()
  rule #setCtor(V:Val) => setFromArgVals(iterableArgVals(V))
    requires unpackValueSupported(V)
      andBool dictFromKeysArgValsSupported(iterableArgVals(V))
      andBool notBool isIteratorRef(V)
  rule <k> #setCtor(V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool unpackValueSupported(V)
      andBool notBool isIteratorRef(V)
  rule <k> #setCtor(V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires unpackValueSupported(V)
      andBool notBool dictFromKeysArgValsSupported(iterableArgVals(V))
      andBool notBool isIteratorRef(V)
  rule <k> #setCtor(iteratorRef(I:Int)) =>
           #listCtor(iteratorRef(I)) ~> setIteratorApply
       ... </k>
  rule <k> V:Val ~> setIteratorApply => #setCtor(V) ... </k>
  rule #frozensetCtor() => frozenset()
  rule #frozensetCtor(V:Val) => frozenSetFromArgVals(iterableArgVals(V))
    requires unpackValueSupported(V)
      andBool dictFromKeysArgValsSupported(iterableArgVals(V))
      andBool notBool isIteratorRef(V)
  rule <k> #frozensetCtor(V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool unpackValueSupported(V)
      andBool notBool isIteratorRef(V)
  rule <k> #frozensetCtor(V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires unpackValueSupported(V)
      andBool notBool dictFromKeysArgValsSupported(iterableArgVals(V))
      andBool notBool isIteratorRef(V)
  rule <k> #frozensetCtor(iteratorRef(I:Int)) =>
           #listCtor(iteratorRef(I)) ~> frozensetIteratorApply
       ... </k>
  rule <k> V:Val ~> frozensetIteratorApply => #frozensetCtor(V) ... </k>
  rule #sorted(V:Val) => sortedListVal(iterableArgVals(V))
    requires sortedIterableSupported(V)
      andBool argValsAllOrderComparable(iterableArgVals(V))
  rule <k> #sorted(V:Val) => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires sortedIterableSupported(V)
      andBool notBool argValsAllOrderComparable(iterableArgVals(V))
  rule <k> #sorted(V:Val) => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires notBool sortedIterableSupported(V)
      andBool notBool isIteratorRef(V)
  rule <k> #sorted(iteratorRef(I:Int)) =>
           #listCtor(iteratorRef(I)) ~> sortedIteratorApply
       ... </k>
  rule <k> V:Val ~> sortedIteratorApply => #sorted(V) ... </k>
  rule <k> #sortedReverse(Iter:Exp, Reverse:Exp) =>
           Iter ~> sortedReverseFlag(Reverse)
       ... </k>
  rule <k> Iter:Val ~> sortedReverseFlag(Reverse:Exp) =>
           Reverse ~> sortedReverseApply(Iter)
       ... </k>
  rule <k> Reverse:Val ~> sortedReverseApply(Iter:Val) =>
           argValsToListVal(reverseArgVals(sortedArgVals(iterableArgVals(Iter))))
       ... </k>
    requires sortedIterableSupported(Iter)
