    bytesPercentMappingScanKey(Rest, DS, Acc, Depth, bytesAppendByte(Key, intValue(C)))
    requires isIntLike(C)
      andBool intValue(C) =/=Int 40
      andBool intValue(C) =/=Int 41

  rule bytesPercentMappingScanBody(valItemsLast(C:Val), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentConcat(Acc, bytesPercentConvert(intValue(C), dictGet(DS, Key)))
    requires containsKey(Key, DS)
      andBool bytesPercentConversionCode(intValue(C))
  rule bytesPercentMappingScanBody(valItemsCons(C:Val, Rest:ValItems), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentMappingScan(
      Rest,
      DS,
      bytesPercentConcat(Acc, bytesPercentConvert(intValue(C), dictGet(DS, Key))))
    requires containsKey(Key, DS)
      andBool bytesPercentConversionCode(intValue(C))
  rule bytesPercentMappingScanBody(valItemsCons(L:Val, Tail:ValItems), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentConcat(
      Acc,
      bytesPercentConvert(bytesPercentLengthSpecCode(valItemsCons(L, Tail)), dictGet(DS, Key)))
    requires containsKey(Key, DS)
      andBool bytesPercentLengthSpec(valItemsCons(L, Tail))
      andBool bytesPercentLengthAtEnd(valItemsCons(L, Tail))
  rule bytesPercentMappingScanBody(valItemsCons(L:Val, Tail:ValItems), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentMappingScan(
      bytesPercentLengthRest(valItemsCons(L, Tail)),
      DS,
      bytesPercentConcat(
        Acc,
        bytesPercentConvert(bytesPercentLengthSpecCode(valItemsCons(L, Tail)), dictGet(DS, Key))))
    requires containsKey(Key, DS)
      andBool bytesPercentLengthSpec(valItemsCons(L, Tail))
      andBool notBool bytesPercentLengthAtEnd(valItemsCons(L, Tail))
  rule bytesPercentMappingScanBody(Body:ValItems, DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentConcat(Acc, bytesPercentConvertNumeric(Body, dictGet(DS, Key)))
    requires containsKey(Key, DS)
      andBool bytesPercentNumericSpec(Body)
      andBool bytesPercentNumericAtEnd(Body)
  rule bytesPercentMappingScanBody(Body:ValItems, DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentMappingScan(
      bytesPercentNumericRest(Body),
      DS,
      bytesPercentConcat(Acc, bytesPercentConvertNumeric(Body, dictGet(DS, Key))))
    requires containsKey(Key, DS)
      andBool bytesPercentNumericSpec(Body)
      andBool notBool bytesPercentNumericAtEnd(Body)
  rule bytesPercentMappingScanBody(valItemsCons(C:Val, Tail:ValItems), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentConcat(
      Acc,
      bytesPercentConvertField(
        bytesPercentFieldSpecCode(valItemsCons(C, Tail)),
        bytesPercentFieldWidth(valItemsCons(C, Tail)),
        bytesPercentFieldPrecision(valItemsCons(C, Tail)),
        bytesPercentFieldLeft(valItemsCons(C, Tail)),
        dictGet(DS, Key)))
    requires containsKey(Key, DS)
      andBool (bytesPercentDigitByte(C) orBool bytesPercentFieldFlagByte(C))
      andBool bytesPercentFieldSpec(valItemsCons(C, Tail))
      andBool bytesPercentFieldAtEnd(valItemsCons(C, Tail))
  rule bytesPercentMappingScanBody(valItemsCons(C:Val, Tail:ValItems), DS:DictItems, Acc:Val, Key:Val) =>
    bytesPercentMappingScan(
      bytesPercentFieldRest(valItemsCons(C, Tail)),
      DS,
      bytesPercentConcat(
        Acc,
        bytesPercentConvertField(
          bytesPercentFieldSpecCode(valItemsCons(C, Tail)),
          bytesPercentFieldWidth(valItemsCons(C, Tail)),
          bytesPercentFieldPrecision(valItemsCons(C, Tail)),
          bytesPercentFieldLeft(valItemsCons(C, Tail)),
          dictGet(DS, Key))))
    requires containsKey(Key, DS)
      andBool (bytesPercentDigitByte(C) orBool bytesPercentFieldFlagByte(C))
      andBool bytesPercentFieldSpec(valItemsCons(C, Tail))
      andBool notBool bytesPercentFieldAtEnd(valItemsCons(C, Tail))

  rule bytesPercentMappingRender(Body:ValItems, V:Val) =>
    bytesPercentConvert(bytesPercentLengthSpecCode(Body), V)
    requires bytesPercentLengthSpec(Body)
  rule bytesPercentMappingRender(Body:ValItems, V:Val) =>
    bytesPercentConvertPrecision(bytesPercentPrecisionSpecCode(Body), bytesPercentPrecisionValue(Body), V)
    requires bytesPercentPrecisionSpec(Body)
  rule bytesPercentMappingRender(Body:ValItems, V:Val) =>
    bytesPercentConvertNumeric(Body, V)
    requires bytesPercentNumericSpec(Body)
  rule bytesPercentMappingRender(Body:ValItems, V:Val) =>
    bytesPercentConvertField(
      bytesPercentFieldSpecCode(Body),
      bytesPercentFieldWidth(Body),
      bytesPercentFieldPrecision(Body),
      bytesPercentFieldLeft(Body),
      V)
    requires bytesPercentFieldSpec(Body)

  rule bytesPercentConvert(98, V:Val) => bytesBytesLikeValue(V)
    requires bytearrayAffixNeedleSupported(V)
  rule bytesPercentConvert(115, V:Val) => bytesBytesLikeValue(V)
    requires bytearrayAffixNeedleSupported(V)
  rule bytesPercentConvert(97, V:Val) => bytesStringAscii(pyAsciiStr(V))
    requires pyStringConversionSupported(V)
  rule bytesPercentConvert(114, V:Val) => bytesStringAscii(pyAsciiStr(V))
    requires pyStringConversionSupported(V)
  rule bytesPercentConvert(C:Int, V:Val) => bytesStringAscii(bytesPercentIntString(C, V))
    requires (bytesPercentDecimalCode(C) orBool bytesPercentIntegralCode(C))
      andBool bytesPercentConversionOk(C, V)
  rule bytesPercentConvert(99, V:Val) => bytesVal(valItemsLast(intValue(V)))
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
  rule bytesPercentConvert(99, bytesVal(VS:ValItems)) => bytesVal(VS)
    requires valItemsLen(VS) ==Int 1
  rule bytesPercentConvert(99, bytearrayVal(VS:ValItems)) => bytesVal(VS)
    requires valItemsLen(VS) ==Int 1

  rule bytesPercentConvertPrecision(98, P:Int, V:Val) => bytesPercentClip(bytesBytesLikeValue(V), P)
    requires bytearrayAffixNeedleSupported(V)
  rule bytesPercentConvertPrecision(115, P:Int, V:Val) => bytesPercentClip(bytesBytesLikeValue(V), P)
    requires bytearrayAffixNeedleSupported(V)
  rule bytesPercentConvertPrecision(97, P:Int, V:Val) => bytesPercentClip(bytesStringAscii(pyAsciiStr(V)), P)
    requires pyStringConversionSupported(V)
  rule bytesPercentConvertPrecision(114, P:Int, V:Val) => bytesPercentClip(bytesStringAscii(pyAsciiStr(V)), P)
    requires pyStringConversionSupported(V)
  rule bytesPercentConvertPrecision(99, _P:Int, V:Val) => bytesPercentConvert(99, V)
    requires bytesPercentConversionOk(99, V)

  rule bytesPercentConvertField(C:Int, W:Int, -1, Left:Bool, V:Val) =>
    bytesPercentPad(bytesPercentConvert(C, V), W, Left)
    requires bytesPercentPrecisionCode(C)
      andBool bytesPercentConversionOk(C, V)
  rule bytesPercentConvertField(C:Int, W:Int, P:Int, Left:Bool, V:Val) =>
    bytesPercentPad(bytesPercentConvertPrecision(C, P, V), W, Left)
    requires bytesPercentPrecisionCode(C)
      andBool P >=Int 0
      andBool bytesPercentConversionOk(C, V)
  rule bytesPercentConvertDynamicPrecisionField(C:Int, W:Int, P:Int, Left:Bool, V:Val) =>
    bytesPercentPad(bytesPercentConvertPrecision(C, P, V), W, Left)
    requires bytesPercentPrecisionCode(C)
      andBool bytesPercentConversionOk(C, V)

  rule bytesPercentConvertNumeric(Tail:ValItems, V:Val) =>
    bytesStringAscii(bytesPercentNumericRender(Tail, V))
    requires bytesPercentNumericSpec(Tail)
      andBool bytesPercentConversionOk(bytesPercentNumericSpecCode(Tail), V)

  rule bytesPercentClip(B:Val, N:Int) => #bytes()
    requires isBytesVal(B)
      andBool N <=Int 0
  rule bytesPercentClip(#bytes(), N:Int) => #bytes()
    requires N >Int 0
  rule bytesPercentClip(bytesVal(VS:ValItems), N:Int) => bytesVal(VS)
    requires N >=Int valItemsLen(VS)
  rule bytesPercentClip(bytesVal(VS:ValItems), N:Int) => bytesSegment(VS, 0, N)
    requires N >Int 0
      andBool N <Int valItemsLen(VS)

  rule bytesPercentPad(B:Val, W:Int, _Left:Bool) => B
    requires isBytesVal(B)
      andBool pyLen(B) >=Int W
  rule bytesPercentPad(B:Val, W:Int, false) => bytesConcat(bytesRepeat(valItemsLast(32), W -Int pyLen(B)), B)
    requires isBytesVal(B)
      andBool pyLen(B) <Int W
  rule bytesPercentPad(B:Val, W:Int, true) => bytesConcat(B, bytesRepeat(valItemsLast(32), W -Int pyLen(B)))
    requires isBytesVal(B)
      andBool pyLen(B) <Int W

  rule bytesPercentConcat(Acc:Val, Part:Val) => bytesConcat(Acc, Part)
    requires isBytesVal(Acc)
      andBool isBytesVal(Part)
  rule bytesPercentConcat(Acc:Val, Part:Val) => bytearrayConcat(Acc, bytesToBytearray(Part))
    requires isBytearrayVal(Acc)
      andBool isBytesVal(Part)

  rule bytesPercentAppendByte(Acc:Val, B:Int) => bytesAppendByte(Acc, B)
    requires isBytesVal(Acc)
  rule bytesPercentAppendByte(Acc:Val, B:Int) => bytearrayAppendByte(Acc, B)
    requires isBytearrayVal(Acc)

  rule bytesPercentTrunc(F:Float) => Float2Int(floorFloat(F))
    requires F >=Float 0.0
      andBool notBool isInfinite(F)
      andBool notBool isNaN(F)
  rule bytesPercentTrunc(F:Float) => 0 -Int Float2Int(floorFloat(0.0 -Float F))
    requires F <Float 0.0
      andBool notBool isInfinite(F)
      andBool notBool isNaN(F)

  rule bytesPercentIntString(C:Int, V:Val) => pyIntBaseString(intValue(V), 10, "")
    requires bytesPercentDecimalCode(C)
      andBool isIntLike(V)
      andBool notBool isFloatVal(V)
  rule bytesPercentIntString(C:Int, F:Float) => pyIntBaseString(bytesPercentTrunc(F), 10, "")
    requires bytesPercentDecimalCode(C)
      andBool notBool isInfinite(F)
      andBool notBool isNaN(F)
  rule bytesPercentIntString(111, V:Val) => pyIntBaseString(intValue(V), 8, "")
    requires isIntLike(V)
  rule bytesPercentIntString(120, V:Val) => pyIntBaseString(intValue(V), 16, "")
    requires isIntLike(V)
  rule bytesPercentIntString(88, V:Val) => pyIntBaseStringUpper(intValue(V), 16, "")
    requires isIntLike(V)

  rule bytesPercentNumericInt(C:Int, V:Val) => intValue(V)
    requires (bytesPercentDecimalCode(C) orBool bytesPercentIntegralCode(C))
      andBool isIntLike(V)
      andBool notBool isFloatVal(V)
  rule bytesPercentNumericInt(C:Int, F:Float) => bytesPercentTrunc(F)
    requires bytesPercentDecimalCode(C)
      andBool notBool isInfinite(F)
      andBool notBool isNaN(F)

  rule bytesPercentNumericRender(Tail:ValItems, V:Val) =>
    bytesPercentNumericRender(bytesPercentLengthless(Tail), V)
    requires bytesPercentLengthlessChanged(Tail)

  rule bytesPercentNumericRender(Tail:ValItems, V:Val) =>
    bytesPercentNumericPad(
      bytesPercentNumericSign(Tail, bytesPercentNumericInt(bytesPercentNumericSpecCode(Tail), V))
        +String bytesPercentNumericAltPrefix(Tail, bytesPercentNumericSpecCode(Tail)),
      bytesPercentNumericPrecisionDigits(
        bytesPercentNumericDigits(
          bytesPercentNumericSpecCode(Tail),
          bytesPercentNumericInt(bytesPercentNumericSpecCode(Tail), V)),
        bytesPercentNumericPrecision(Tail)),
      bytesPercentNumericWidth(Tail),
      bytesPercentNumericHasFlag(Tail, 45),
      bytesPercentNumericHasFlag(Tail, 48))
    requires bytesPercentNumericSpec(Tail)
      andBool bytesPercentConversionOk(bytesPercentNumericSpecCode(Tail), V)

  rule bytesPercentNumericRenderDynamicWidth(Tail:ValItems, W:Int, P:Int, Left:Bool, V:Val) =>
    bytesPercentNumericPad(
      bytesPercentNumericSign(Tail, bytesPercentNumericInt(bytesPercentNumericFieldStarSpecCode(Tail), V))
        +String bytesPercentNumericAltPrefix(Tail, bytesPercentNumericFieldStarSpecCode(Tail)),
      bytesPercentNumericPrecisionDigits(
        bytesPercentNumericDigits(
          bytesPercentNumericFieldStarSpecCode(Tail),
          bytesPercentNumericInt(bytesPercentNumericFieldStarSpecCode(Tail), V)),
        P),
      W,
      Left,
      bytesPercentNumericHasFlag(Tail, 48))
    requires bytesPercentNumericFieldStarSpec(Tail)
      andBool bytesPercentConversionOk(bytesPercentNumericFieldStarSpecCode(Tail), V)

  rule bytesPercentNumericRenderDynamic(C:Int, Tail:ValItems, W:Int, P:Int, Left:Bool, Zero:Bool, V:Val) =>
    bytesPercentNumericPad(
      bytesPercentNumericSign(Tail, bytesPercentNumericInt(C, V))
        +String bytesPercentNumericAltPrefix(Tail, C),
      bytesPercentNumericPrecisionDigits(
        bytesPercentNumericDigits(C, bytesPercentNumericInt(C, V)),
        P),
      W,
      Left,
      Zero)
    requires (bytesPercentDecimalCode(C) orBool bytesPercentIntegralCode(C))
      andBool bytesPercentConversionOk(C, V)

  rule bytesPercentNumericSign(_Tail:ValItems, I:Int) => "-"
    requires I <Int 0
  rule bytesPercentNumericSign(Tail:ValItems, I:Int) => "+"
    requires I >=Int 0
      andBool bytesPercentNumericHasFlag(Tail, 43)
  rule bytesPercentNumericSign(Tail:ValItems, I:Int) => " "
    requires I >=Int 0
      andBool notBool bytesPercentNumericHasFlag(Tail, 43)
      andBool bytesPercentNumericHasFlag(Tail, 32)
  rule bytesPercentNumericSign(Tail:ValItems, I:Int) => ""
    requires I >=Int 0
      andBool notBool bytesPercentNumericHasFlag(Tail, 43)
      andBool notBool bytesPercentNumericHasFlag(Tail, 32)

  rule bytesPercentNumericAltPrefix(Tail:ValItems, 111) => "0o"
    requires bytesPercentNumericHasFlag(Tail, 35)
  rule bytesPercentNumericAltPrefix(Tail:ValItems, 120) => "0x"
    requires bytesPercentNumericHasFlag(Tail, 35)
  rule bytesPercentNumericAltPrefix(Tail:ValItems, 88) => "0X"
    requires bytesPercentNumericHasFlag(Tail, 35)
  rule bytesPercentNumericAltPrefix(_Tail:ValItems, _C:Int) => "" [owise]

  rule bytesPercentNumericDigits(C:Int, I:Int) => Int2String(intAbs(I))
    requires bytesPercentDecimalCode(C)
  rule bytesPercentNumericDigits(111, I:Int) => intBaseDigits(intAbs(I), 8)
  rule bytesPercentNumericDigits(120, I:Int) => intBaseDigits(intAbs(I), 16)
  rule bytesPercentNumericDigits(88, I:Int) => intBaseDigitsUpper(intAbs(I), 16)

  rule bytesPercentNumericPrecisionDigits(Digits:String, P:Int) => Digits
    requires P <=Int lengthString(Digits)
  rule bytesPercentNumericPrecisionDigits(Digits:String, P:Int) =>
    repeatString("0", P -Int lengthString(Digits)) +String Digits
    requires P >Int lengthString(Digits)

  rule bytesPercentNumericPad(Prefix:String, Digits:String, W:Int, _Left:Bool, _Zero:Bool) =>
    Prefix +String Digits
    requires lengthString(Prefix) +Int lengthString(Digits) >=Int W
  rule bytesPercentNumericPad(Prefix:String, Digits:String, W:Int, true, _Zero:Bool) =>
    Prefix +String Digits +String repeatString(" ", W -Int lengthString(Prefix) -Int lengthString(Digits))
    requires lengthString(Prefix) +Int lengthString(Digits) <Int W
  rule bytesPercentNumericPad(Prefix:String, Digits:String, W:Int, false, true) =>
    Prefix +String repeatString("0", W -Int lengthString(Prefix) -Int lengthString(Digits)) +String Digits
    requires lengthString(Prefix) +Int lengthString(Digits) <Int W
  rule bytesPercentNumericPad(Prefix:String, Digits:String, W:Int, false, false) =>
    repeatString(" ", W -Int lengthString(Prefix) -Int lengthString(Digits)) +String Prefix +String Digits
    requires lengthString(Prefix) +Int lengthString(Digits) <Int W

  rule bytearrayConcat(#bytearray(), B:Val) => B
    requires isBytearrayVal(B)
  rule bytearrayConcat(bytearrayVal(VS:ValItems), #bytearray()) => bytearrayVal(VS)
  rule bytearrayConcat(bytearrayVal(VS1:ValItems), bytearrayVal(VS2:ValItems)) =>
    bytearrayVal(concatValItems(VS1, VS2))
  rule bytearrayRepeat(_:ValItems, N:Int) => #bytearray()
    requires N <=Int 0
  rule bytearrayRepeat(VS:ValItems, N:Int) => bytearrayVal(repeatValItems(VS, N))
    requires N >Int 0
  rule bytearrayAppendByte(#bytearray(), V:Val) => bytearrayVal(valItemsLast(intValue(V)))
    requires isIntLike(V)
  rule bytearrayAppendByte(bytearrayVal(VS:ValItems), V:Val) =>
    bytearrayVal(concatValItems(VS, valItemsLast(intValue(V))))
    requires isIntLike(V)
  rule bytearrayExtendBytes(#bytearray(), VS:ValItems) => bytearrayVal(VS)
  rule bytearrayExtendBytes(bytearrayVal(VS1:ValItems), VS2:ValItems) =>
    bytearrayVal(concatValItems(VS1, VS2))
  rule bytearrayReplace(B:Val, Old:Val, New:Val, 0) => B
    requires isBytearrayVal(B)
      andBool bytearrayAffixNeedleSupported(Old)
      andBool bytearrayAffixNeedleSupported(New)
  rule bytearrayReplace(B:Val, Old:Val, New:Val, Count:Int) =>
    bytearrayReplaceEmpty(B, New, Count)
    requires isBytearrayVal(B)
      andBool bytearrayAffixNeedleSupported(Old)
      andBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count =/=Int 0
  rule bytearrayReplace(#bytearray(), Old:Val, New:Val, Count:Int) => #bytearray()
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count =/=Int 0
  rule bytearrayReplace(bytearrayVal(VS:ValItems), Old:Val, New:Val, Count:Int) =>
    bytearrayReplaceAllItems(VS, Old, New)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count <Int 0
  rule bytearrayReplace(bytearrayVal(VS:ValItems), Old:Val, New:Val, Count:Int) =>
    bytearrayReplaceNItems(VS, Old, New, Count)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 0

  rule bytearrayReplaceEmpty(#bytearray(), New:Val, Count:Int) => bytearrayBytesLikeValue(New)
    requires bytearrayAffixNeedleSupported(New)
      andBool Count =/=Int 0
  rule bytearrayReplaceEmpty(bytearrayVal(VS:ValItems), New:Val, Count:Int) =>
    bytearrayReplaceEmptyItems(VS, New, Count)
    requires bytearrayAffixNeedleSupported(New)
      andBool Count =/=Int 0

  rule bytearrayReplaceEmptyItems(VS:ValItems, New:Val, Count:Int) =>
    bytearrayReplaceEmptyItems(VS, New, valItemsLen(VS) +Int 1)
    requires bytearrayAffixNeedleSupported(New)
      andBool Count <Int 0
  rule bytearrayReplaceEmptyItems(VS:ValItems, New:Val, 0) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(New)
  rule bytearrayReplaceEmptyItems(valItemsLast(V:Val), New:Val, 1) =>
    bytearrayConcat(bytearrayBytesLikeValue(New), bytearrayVal(valItemsLast(V)))
    requires bytearrayAffixNeedleSupported(New)
  rule bytearrayReplaceEmptyItems(valItemsLast(V:Val), New:Val, Count:Int) =>
    bytearrayConcat(bytearrayBytesLikeValue(New),
      bytearrayConcat(bytearrayVal(valItemsLast(V)), bytearrayBytesLikeValue(New)))
    requires bytearrayAffixNeedleSupported(New)
      andBool Count >Int 1
  rule bytearrayReplaceEmptyItems(valItemsCons(V:Val, VS:ValItems), New:Val, 1) =>
    bytearrayConcat(bytearrayBytesLikeValue(New), bytearrayVal(valItemsCons(V, VS)))
    requires bytearrayAffixNeedleSupported(New)
  rule bytearrayReplaceEmptyItems(valItemsCons(V:Val, VS:ValItems), New:Val, Count:Int) =>
    bytearrayConcat(bytearrayBytesLikeValue(New),
      bytearrayPrepend(V, bytearrayReplaceEmptyItems(VS, New, Count -Int 1)))
    requires bytearrayAffixNeedleSupported(New)
      andBool Count >Int 1

  rule bytearrayReplaceAllItems(VS:ValItems, Old:Val, New:Val) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) >Int valItemsLen(VS)
  rule bytearrayReplaceAllItems(VS:ValItems, Old:Val, New:Val) => bytearrayBytesLikeValue(New)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) ==Int valItemsLen(VS)
      andBool bytesPrefix(bytearrayAffixNeedleItems(Old), VS)
  rule bytearrayReplaceAllItems(VS:ValItems, Old:Val, New:Val) =>
    bytearrayConcat(bytearrayBytesLikeValue(New),
      bytearrayReplaceAllItems(dropValItems(VS, valItemsLen(bytearrayAffixNeedleItems(Old))), Old, New))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <Int valItemsLen(VS)
      andBool bytesPrefix(bytearrayAffixNeedleItems(Old), VS)
  rule bytearrayReplaceAllItems(valItemsLast(V:Val), Old:Val, New:Val) => bytearrayVal(valItemsLast(V))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <=Int 1
      andBool notBool bytesPrefix(bytearrayAffixNeedleItems(Old), valItemsLast(V))
  rule bytearrayReplaceAllItems(valItemsCons(V:Val, VS:ValItems), Old:Val, New:Val) =>
    bytearrayPrepend(V, bytearrayReplaceAllItems(VS, Old, New))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <=Int valItemsLen(valItemsCons(V, VS))
      andBool notBool bytesPrefix(bytearrayAffixNeedleItems(Old), valItemsCons(V, VS))

  rule bytearrayReplaceNItems(VS:ValItems, Old:Val, New:Val, Count:Int) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count <=Int 0
  rule bytearrayReplaceNItems(VS:ValItems, Old:Val, New:Val, Count:Int) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 0
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) >Int valItemsLen(VS)
  rule bytearrayReplaceNItems(VS:ValItems, Old:Val, New:Val, Count:Int) => bytearrayBytesLikeValue(New)
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 0
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) ==Int valItemsLen(VS)
      andBool bytesPrefix(bytearrayAffixNeedleItems(Old), VS)
  rule bytearrayReplaceNItems(VS:ValItems, Old:Val, New:Val, 1) =>
    bytearrayConcat(bytearrayBytesLikeValue(New),
      bytearrayVal(dropValItems(VS, valItemsLen(bytearrayAffixNeedleItems(Old)))))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <Int valItemsLen(VS)
      andBool bytesPrefix(bytearrayAffixNeedleItems(Old), VS)
  rule bytearrayReplaceNItems(VS:ValItems, Old:Val, New:Val, Count:Int) =>
    bytearrayConcat(bytearrayBytesLikeValue(New),
      bytearrayReplaceNItems(dropValItems(VS, valItemsLen(bytearrayAffixNeedleItems(Old))), Old, New, Count -Int 1))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 1
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <Int valItemsLen(VS)
      andBool bytesPrefix(bytearrayAffixNeedleItems(Old), VS)
  rule bytearrayReplaceNItems(valItemsLast(V:Val), Old:Val, New:Val, Count:Int) => bytearrayVal(valItemsLast(V))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 0
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <=Int 1
      andBool notBool bytesPrefix(bytearrayAffixNeedleItems(Old), valItemsLast(V))
  rule bytearrayReplaceNItems(valItemsCons(V:Val, VS:ValItems), Old:Val, New:Val, Count:Int) =>
    bytearrayPrepend(V, bytearrayReplaceNItems(VS, Old, New, Count))
    requires bytearrayAffixNeedleSupported(Old)
      andBool notBool bytearrayAffixNeedleEmpty(Old)
      andBool bytearrayAffixNeedleSupported(New)
      andBool Count >Int 0
      andBool valItemsLen(bytearrayAffixNeedleItems(Old)) <=Int valItemsLen(valItemsCons(V, VS))
      andBool notBool bytesPrefix(bytearrayAffixNeedleItems(Old), valItemsCons(V, VS))

  rule bytesPrepend(V:Val, #bytes()) => bytesVal(valItemsLast(intValue(V)))
    requires isIntLike(V)
