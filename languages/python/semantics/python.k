           stmtNoResult
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires lengthString(S) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0
  rule <k> forStarUnpackItems(Prefix:IdItems, Star:Id, Suffix:IdItems, valItemsLast(rangeVal(Start:Int, Stop:Int, Step:Int)), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => Rho [ Star <- [] ] </env>
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 0
      andBool idItemsLen(Prefix) +Int idItemsLen(Suffix) ==Int 0

  rule <k> forRange(X:Id, I:Int, Stop:Int, block(SS:Stmts)) =>
           SS ~> forRangeAgain(X, I +Int 1, Stop, block(SS))
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires I <Int Stop
  rule <k> forRange(X:Id, I:Int, Stop:Int, {}) =>
           forRange(X, I +Int 1, Stop, {})
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires I <Int Stop
  rule <k> forRange(_:Id, I:Int, Stop:Int, _:Block) => stmtNoResult ... </k>
    requires I >=Int Stop
  rule <k> forRangeAgain(X:Id, I:Int, Stop:Int, Body:Block) =>
           forRange(X, I, Stop, Body)
       ... </k>

  rule <k> forRangeStep(X:Id, I:Int, Stop:Int, Step:Int, block(SS:Stmts)) =>
           SS ~> forRangeStepAgain(X, I +Int Step, Stop, Step, block(SS))
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires (Step >Int 0 andBool I <Int Stop)
      orBool (Step <Int 0 andBool I >Int Stop)
  rule <k> forRangeStep(X:Id, I:Int, Stop:Int, Step:Int, {}) =>
           forRangeStep(X, I +Int Step, Stop, Step, {})
       ... </k>
       <env> Rho => Rho [ X <- I ] </env>
    requires (Step >Int 0 andBool I <Int Stop)
      orBool (Step <Int 0 andBool I >Int Stop)
  rule <k> forRangeStep(_:Id, I:Int, Stop:Int, Step:Int, _:Block) => stmtNoResult ... </k>
    requires (Step >Int 0 andBool I >=Int Stop)
      orBool (Step <Int 0 andBool I <=Int Stop)
  rule <k> forRangeStepAgain(X:Id, I:Int, Stop:Int, Step:Int, Body:Block) =>
           forRangeStep(X, I, Stop, Step, Body)
       ... </k>

  rule <k> forElseStmt(X:Id, E:Exp, Body:Block, Else:Block) =>
           E ~> forElseIter(X, Body, Else)
       ... </k>
  rule <k> [] ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> () ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> bytesVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #bytearray() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> bytearrayVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #memoryviewVal(#bytes()) ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #memoryviewVal(bytesVal(VS:ValItems)) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #memoryviewVal(#bytearray()) ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #memoryviewVal(bytearrayVal(VS:ValItems)) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> S:String ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseRange(X, Start, Stop, Body, Else)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseRangeStep(X, Start, Stop, Step, Body, Else)
       ... </k>
    requires Step =/=Int 0
  rule <k> ({}):Val ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, dictKeysToValItems(DS), Body, Else)
       ... </k>
  rule <k> set() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> setVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> frozenset() ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> frozensetVal(VS:ValItems) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, VS, Body, Else)
       ... </k>
  rule <k> #enumerateVal(#noArgVals) ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #enumerateVal(VS:ArgVals) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #zipVal(#noArgVals) ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #zipVal(VS:ArgVals) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #reversedVal(#noArgVals) ~> forElseIter(_:Id, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> #reversedVal(VS:ArgVals) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forElseItems(X, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
  rule <k> #mapVal(F:Val, Iters:ArgVals, Strict:Val) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           mapCollect(F, zipArgVals(Iters), Strict, Iters, #noArgVals) ~> mapForElseIter(X, Body, Else)
       ... </k>
    requires mapItersSupported(Iters)
  rule <k> #filterVal(F:Val, Iter:Val) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           filterCollect(F, iterableArgVals(Iter), #noArgVals) ~> filterForElseIter(X, Body, Else)
       ... </k>
    requires enumerateIterableSupported(Iter)
  rule <k> iteratorRef(I:Int) ~> forElseIter(X:Id, Body:Block, Else:Block) =>
           forIteratorElse(I, X, Body, Else)
       ... </k>
  rule <k> forIteratorElse(I:Int, _:Id, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> forIteratorElse(I:Int, X:Id, Body:Block, Else:Block) =>
           argsVal(#noArgVals) ~> callApplyArgs(F) ~> callableForIteratorElseNext(I, X, Body, Else)
       ... </k>
       <iterators> ... I |-> callableIterator(F:Val, _Sentinel:Val) ... </iterators>
  rule <k> _V:Val ~> callableForIteratorElseNext(I:Int, _:Id, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> V:Val ~> callableForIteratorElseNext(I:Int, _:Id, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, Sentinel:Val) => #noArgVals) ... </iterators>
    requires valEq(V, Sentinel)
  rule <k> V:Val ~> callableForIteratorElseNext(I:Int, X:Id, block(SS:Stmts), Else:Block) =>
           SS ~> forIteratorElse(I, X, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
  rule <k> V:Val ~> callableForIteratorElseNext(I:Int, X:Id, {}, Else:Block) =>
           forIteratorElse(I, X, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> callableIterator(_:Val, Sentinel:Val) ... </iterators>
    requires notBool valEq(V, Sentinel)
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorElseNext(I:Int, _:Id, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, _Sentinel:Val) => #noArgVals) ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorElseNext(I:Int, _:Id, _:Block, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <iterators> ... I |-> #noArgVals ... </iterators>
    requires exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> exceptionSignal(E:Val) ~> callableForIteratorElseNext(_I:Int, _:Id, _:Block, _:Block) =>
           exceptionSignal(E)
       ... </k>
    requires notBool exceptionMatches(E, #token("StopIteration", "Id"))
  rule <k> forIteratorElse(I:Int, X:Id, block(SS:Stmts), Else:Block) =>
           SS ~> forIteratorElse(I, X, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>
  rule <k> forIteratorElse(I:Int, X:Id, {}, Else:Block) =>
           forIteratorElse(I, X, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <iterators> ... I |-> (argValsCons(V:Val, Rest:ArgVals) => Rest) ... </iterators>

  rule <k> forElseItems(X:Id, valItemsCons(V:Val, VS:ValItems), block(SS:Stmts), Else:Block) =>
           SS ~> forElseItems(X, VS, block(SS), Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsLast(V:Val), block(SS:Stmts), Else:Block) =>
           SS ~> forElseDone(Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsCons(V:Val, VS:ValItems), {}, Else:Block) =>
           forElseItems(X, VS, {}, Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseItems(X:Id, valItemsLast(V:Val), {}, Else:Block) =>
           runLoopElse(Else)
       ... </k>
       <env> Rho => Rho [ X <- V ] </env>
  rule <k> forElseDone(Else:Block) => runLoopElse(Else) ... </k>

  rule <k> forUnpackElseStmt(IDS:IdItems, E:Exp, Body:Block, Else:Block) =>
           E ~> forUnpackElseIter(IDS, Body, Else)
       ... </k>
  rule <k> [] ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> listVal(VS:ValItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> () ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, VS, Body, Else)
       ... </k>
  rule <k> #bytes() ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> S:String ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, stringToValItems(S, 0, lengthString(S)), Body, Else)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forUnpackElseIter(_:IdItems, _:Block, Else:Block) => runLoopElse(Else) ... </k>
  rule <k> dictVal(DS:DictItems) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
