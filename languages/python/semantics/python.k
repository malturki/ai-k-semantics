    requires isInfinite(F)
  rule <k> None ~> roundApply(F:Float)
        => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
    requires isNaN(F)
  rule <k> D:Val ~> roundApply(F:Float) => F ... </k>
    requires isIntLike(D) andBool (isInfinite(F) orBool isNaN(F))
  rule <k> D:Val ~> roundApply(F:Float) => roundFloat(F, intValue(D)) ... </k>
    requires isIntLike(D)
      andBool notBool isInfinite(F)
      andBool notBool isNaN(F)
  rule <k> D:Val ~> roundApply(V:Val) => roundInt(intValue(V), intValue(D)) ... </k>
    requires isIntLike(V) andBool isIntLike(D)
  rule <k> D:Val ~> roundApply(V:Val)
        => exceptionSignal(#exception(#token("TypeError", "Id"))) ... </k>
    requires (notBool isIntLike(V)
              andBool notBool roundNdigitsFiniteFloat(V, D)
              andBool notBool roundNdigitsSpecialFloat(V, D))
      orBool (notBool isIntLike(D) andBool notBool valEq(D, None))
  rule <k> #pow(V1:Val, V2:Val) =>
           exceptionSignal(#exception(#token("ZeroDivisionError", "Id")))
       ... </k>
    requires isIntLike(V1)
      andBool isIntLike(V2)
      andBool intValue(V1) ==Int 0
      andBool intValue(V2) <Int 0
  rule <k> #pow(F1:Float, F2:Float) =>
           exceptionSignal(#exception(#token("ZeroDivisionError", "Id")))
       ... </k>
    requires F1 ==Float 0.0
      andBool F2 <Float 0.0
  rule <k> #pow(F:Float, V:Val) =>
           exceptionSignal(#exception(#token("ZeroDivisionError", "Id")))
       ... </k>
    requires isIntLike(V)
      andBool F ==Float 0.0
      andBool intValue(V) <Int 0
  rule <k> #pow(V:Val, F:Float) =>
           exceptionSignal(#exception(#token("ZeroDivisionError", "Id")))
       ... </k>
    requires isIntLike(V)
      andBool intValue(V) ==Int 0
      andBool F <Float 0.0
  rule <k> #pow(#complex(R:Float, I:Float), V:Val) =>
           exceptionSignal(#exception(#token("ZeroDivisionError", "Id")))
       ... </k>
    requires isIntLike(V)
      andBool intValue(V) <Int 0
      andBool (R *Float R) +Float (I *Float I) ==Float 0.0
  rule <k> #pow(V1:Val, V2:Val, V3:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isIntLike(V1)
      andBool isIntLike(V2)
      andBool isIntLike(V3)
      andBool intValue(V3) ==Int 0
  rule <k> #pow(V1:Val, V2:Val, V3:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isIntLike(V1)
      andBool isIntLike(V2)
      andBool isIntLike(V3)
      andBool intValue(V2) <Int 0
      andBool intValue(V3) =/=Int 0
      andBool pyGcd(pyModulo(intValue(V1), intAbs(intValue(V3))), intAbs(intValue(V3))) =/=Int 1
  rule <k> #pow(V1:Val, V2:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires powTypeErrorProfile(V1, V2)
  rule <k> #pow(V1:Val, V2:Val, V3:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires powModTypeErrorProfile(V1, V2, V3)

  rule range1Exp(N:Val) => rangeVal(0, intValue(N))
    requires isIntLike(N)
  rule range2Exp(Start:Val, Stop:Val) => rangeVal(intValue(Start), intValue(Stop))
    requires isIntLike(Start) andBool isIntLike(Stop)
  rule range3Exp(Start:Val, Stop:Val, Step:Val) => rangeVal(intValue(Start), intValue(Stop), intValue(Step))
    requires isIntLike(Start) andBool isIntLike(Stop) andBool isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule <k> range3Exp(Start:Val, Stop:Val, Step:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isIntLike(Start)
      andBool isIntLike(Stop)
      andBool isIntLike(Step)
      andBool intValue(Step) ==Int 0

  rule <k> assignStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> assignNameStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> subscriptAssignStmt(X:Id, I:Exp, E:Exp) =>
           E ~> subscriptAssignIndex(X, I)
       ... </k>
  rule <k> V:Val ~> subscriptAssignIndex(X:Id, I:Exp) =>
           I ~> subscriptAssignApply(X, V)
       ... </k>
  rule <k> I:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSet(VS, intValue(I), V))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule <k> I:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSet(VS, valItemsLen(VS) +Int intValue(I), V))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule <k> I:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I)
      andBool notBool subscriptIndexInBounds(I, valItemsLen(VS))
  rule <k> I:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires isIntLike(I)
  rule <k> I:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> listVal(_:ValItems) ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> I:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> K:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (({}):Val => dictVal(dictItemsLast(K, V))) ... </env>
       <result> _ => .K </result>
    requires dictLookupKeySupported(K)
  rule <k> K:Val ~> subscriptAssignApply(X:Id, V:Val) => stmtNoResult ... </k>
       <env> ... X |-> (dictVal(DS:DictItems) => dictVal(dictSet(DS, K, V))) ... </env>
       <result> _ => .K </result>
    requires dictLookupKeySupported(K)
  rule <k> K:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> ({}):Val ... </env>
    requires notBool dictLookupKeySupported(K)
  rule <k> K:Val ~> subscriptAssignApply(X:Id, _V:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> dictVal(_:DictItems) ... </env>
    requires notBool dictLookupKeySupported(K)

  rule <k> subscriptAssignNestedStmt(X:Id, Outer:Exp, Inner:Exp, E:Exp) =>
           E ~> subscriptAssignNestedOuter(X, Outer, Inner)
       ... </k>
  rule <k> V:Val ~> subscriptAssignNestedOuter(X:Id, Outer:Exp, Inner:Exp) =>
           Outer ~> subscriptAssignNestedInner(X, V, Inner)
       ... </k>
  rule <k> Outer:Val ~> subscriptAssignNestedInner(X:Id, V:Val, Inner:Exp) =>
           Inner ~> subscriptAssignNestedApply(X, V, Outer)
       ... </k>
  rule <k> Inner:Val ~> subscriptAssignNestedApply(X:Id, V:Val, Outer:Val) => stmtNoResult ... </k>
       <env> ... X |-> (Base:Val => subscriptSet(Base, Outer, subscriptSet(subscriptGet(Base, Outer), Inner, V))) ... </env>
       <result> _ => .K </result>
    requires subscriptLookupable(Base, Outer)
      andBool subscriptSettable(subscriptGet(Base, Outer), Inner)

  rule <k> subscriptAugStmt(X:Id, I:Exp, Op:AugOp, E:Exp) =>
           I ~> subscriptAugOld(X, Op, E)
       ... </k>
  rule <k> I:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, I, listGet(VS, intValue(I)), Op)
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule <k> I:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, I, listGet(VS, valItemsLen(VS) +Int intValue(I)), Op)
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule <k> K:Val ~> subscriptAugOld(X:Id, Op:AugOp, E:Exp) =>
           E ~> subscriptAugApply(X, K, dictGet(DS, K), Op)
       ... </k>
       <env> ... X |-> dictVal(DS:DictItems) ... </env>
    requires containsKey(K, DS)
  rule <k> I:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(I)
      andBool notBool subscriptIndexInBounds(I, valItemsLen(VS))
  rule <k> I:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("IndexError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires isIntLike(I)
  rule <k> I:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> listVal(_:ValItems) ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> I:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires notBool isIntLike(I)
      andBool notBool isSliceVal(I)
  rule <k> K:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("KeyError", "Id")))
       ... </k>
       <env> ... X |-> ({}):Val ... </env>
    requires dictLookupKeySupported(K)
  rule <k> K:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("KeyError", "Id")))
       ... </k>
       <env> ... X |-> dictVal(DS:DictItems) ... </env>
    requires dictLookupKeySupported(K)
      andBool notBool containsKey(K, DS)
  rule <k> K:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> ({}):Val ... </env>
    requires notBool dictLookupKeySupported(K)
  rule <k> K:Val ~> subscriptAugOld(X:Id, _Op:AugOp, _E:Exp) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
       <env> ... X |-> dictVal(_:DictItems) ... </env>
    requires notBool dictLookupKeySupported(K)
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augAdd) =>
           L + R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augSub) =>
           L - R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augMul) =>
           L * R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augMatMul) =>
           L @ R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augTrueDiv) =>
           #trueDiv(L, R) ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augFloorDiv) =>
           #floorDiv(L, R) ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augMod) =>
           L % R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augPow) =>
           L ** R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augLShift) =>
           L << R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augRShift) =>
           L >> R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitAnd) =>
           L & R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitXor) =>
           L ^ R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> R:Val ~> subscriptAugApply(X:Id, I:Val, L:Val, #augBitOr) =>
           L | R ~> subscriptAugStore(X, I)
       ... </k>
  rule <k> V:Val ~> subscriptAugStore(X:Id, I:Val) =>
           I ~> subscriptAssignApply(X, V)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> subscriptAugStore(_:Id, _:Val) => exceptionSignal(E) ... </k>

  rule <k> sliceAssignStmt(X:Id, Lower:Exp, Upper:Exp, E:Exp) =>
           E ~> sliceAssignLower(X, Lower, Upper)
       ... </k>
  rule <k> V:Val ~> sliceAssignLower(X:Id, Lower:Exp, Upper:Exp) =>
           Lower ~> sliceAssignUpper(X, V, Upper)
       ... </k>
  rule <k> Lower:Val ~> sliceAssignUpper(X:Id, V:Val, Upper:Exp) =>
           Upper ~> sliceAssignApply(X, V, Lower)
       ... </k>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, listVal(RS:ValItems), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, [], Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, (), Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, listVal(RS:ValItems), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, tupleVal(RS:ValItems), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, [], _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, (), _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, RHS:Val, Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), concreteIterableExtraItems(RHS))) ... </env>
       <result> _ => .K </result>
    requires concreteIterableExtraNonEmpty(RHS)
  rule <k> Upper:Val ~> sliceAssignApply(X:Id, RHS:Val, Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires concreteIterableExtraEmpty(RHS)
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, RHS:Val, _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(concreteIterableExtraItems(RHS))) ... </env>
       <result> _ => .K </result>
    requires concreteIterableExtraNonEmpty(RHS)
  rule <k> _Upper:Val ~> sliceAssignApply(X:Id, RHS:Val, _Lower:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires concreteIterableExtraEmpty(RHS)

  rule <k> sliceStepAssignStmt(X:Id, Lower:Exp, Upper:Exp, Step:Exp, E:Exp) =>
           E ~> sliceStepAssignLower(X, Lower, Upper, Step)
       ... </k>
  rule <k> V:Val ~> sliceStepAssignLower(X:Id, Lower:Exp, Upper:Exp, Step:Exp) =>
           Lower ~> sliceStepAssignUpper(X, V, Upper, Step)
       ... </k>
  rule <k> Lower:Val ~> sliceStepAssignUpper(X:Id, V:Val, Upper:Exp, Step:Exp) =>
           Upper ~> sliceStepAssignStep(X, V, Lower, Step)
       ... </k>
  rule <k> Upper:Val ~> sliceStepAssignStep(X:Id, V:Val, Lower:Val, Step:Exp) =>
           Step ~> sliceStepAssignApply(X, V, Lower, Upper)
       ... </k>
  rule <k> Step:Val ~> sliceStepAssignApply(_X:Id, _RHS:Val, _Lower:Val, _Upper:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isIntLike(Step) andBool intValue(Step) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, listVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, tupleVal(RS:ValItems), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step), RS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool valItemsLen(RS) ==Int sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssign(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), concreteIterableExtraItems(RHS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) ==Int 1
      andBool concreteIterableExtraNonEmpty(RHS)
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listSliceAssignEmpty(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) ==Int 1
      andBool concreteIterableExtraEmpty(RHS)
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step), concreteIterableExtraItems(RHS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool concreteIterableExtraNonEmpty(RHS)
      andBool valItemsLen(concreteIterableExtraItems(RHS)) ==Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> (listVal(VS:ValItems) => listVal(listSliceStepSet(VS, pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step), concreteIterableExtraItems(RHS)))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool concreteIterableExtraNonEmpty(RHS)
      andBool valItemsLen(concreteIterableExtraItems(RHS)) ==Int sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool concreteIterableExtraEmpty(RHS)
      andBool sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) <Int 0
      andBool concreteIterableExtraEmpty(RHS)
      andBool sliceStepLen(pySliceLowerNeg(Lower, valItemsLen(VS)), pySliceUpperNeg(Upper, valItemsLen(VS)), intValue(Step)) ==Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(Step)
      andBool intValue(Step) >Int 1
      andBool sliceStepAssignRhsSupported(RHS)
      andBool sliceStepAssignRhsLen(RHS) =/=Int sliceStepLen(pySliceLower(Lower, valItemsLen(VS)), pySliceUpper(Upper, valItemsLen(VS)), intValue(Step))
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, Lower:Val, Upper:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
       <env> ... X |-> listVal(VS:ValItems) ... </env>
    requires isIntLike(Step)
