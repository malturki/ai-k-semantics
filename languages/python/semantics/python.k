  rule isTupleSequence(functionValPosOnlyVarKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyVarArgsKwOnly(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyVarArgsKwDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyVarArgsKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyVarArgsKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyKwOnly(_:IdItems, _:IdItems, _:IdItems, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyKwOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyKwOnlyKwArgs(_:IdItems, _:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosOnlyKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isTupleSequence(functionValKwOnly(_:IdItems, _:Block)) => false
  rule isTupleSequence(functionValKwDefaults(_:IdItems, _:ArgVals, _:Block)) => false
  rule isTupleSequence(functionValKwOnlyKwArgs(_:IdItems, _:Id, _:Block)) => false
  rule isTupleSequence(functionValKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosKwOnly(_:IdItems, _:IdItems, _:Block)) => false
  rule isTupleSequence(functionValPosKwDefaults(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Block)) => false
  rule isTupleSequence(functionValPosKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Block)) => false
  rule isTupleSequence(functionValPosKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Block)) => false
  rule isTupleSequence(rangeVal(_:Int, _:Int)) => false
  rule isTupleSequence(rangeVal(_:Int, _:Int, _:Int)) => false
  rule isTupleSequence(argsVal(_:ArgVals)) => false
  rule isTupleSequence(dictArgsVal(_:DictVals)) => false
  rule isTupleSequence(_:Float) => false
  rule isTupleSequence(_:Val) => false [owise]

  rule isBytesSequence(#bytes()) => true
  rule isBytesSequence(bytesVal(_:ValItems)) => true
  rule isBytesSequence(#bytearray()) => true
  rule isBytesSequence(bytearrayVal(_:ValItems)) => true
  rule isBytesSequence(_:Val) => false [owise]

  rule bytesMembershipBadInt(#in, Needle:Val, Haystack:Val) => true
    requires isBytesSequence(Haystack)
      andBool isIntLike(Needle)
      andBool (intValue(Needle) <Int 0 orBool intValue(Needle) >Int 255)
  rule bytesMembershipBadInt(#notIn, Needle:Val, Haystack:Val) => true
    requires isBytesSequence(Haystack)
      andBool isIntLike(Needle)
      andBool (intValue(Needle) <Int 0 orBool intValue(Needle) >Int 255)
  rule bytesMembershipBadInt(_:CmpOp, _:Val, _:Val) => false [owise]

  rule bytesMembershipBadNeedle(#in, Needle:Val, Haystack:Val) => true
    requires isBytesSequence(Haystack)
      andBool notBool isIntLike(Needle)
      andBool notBool isBytesSequence(Needle)
  rule bytesMembershipBadNeedle(#notIn, Needle:Val, Haystack:Val) => true
    requires isBytesSequence(Haystack)
      andBool notBool isIntLike(Needle)
      andBool notBool isBytesSequence(Needle)
  rule bytesMembershipBadNeedle(_:CmpOp, _:Val, _:Val) => false [owise]

  rule bytesMembershipInvalid(Op:CmpOp, Needle:Val, Haystack:Val) =>
    bytesMembershipBadInt(Op, Needle, Haystack)
      orBool bytesMembershipBadNeedle(Op, Needle, Haystack)

  rule isStringVal(_:String) => true
  rule isStringVal(_:Val) => false [owise]

  rule isConcreteSequenceVal(_:String) => true
  rule isConcreteSequenceVal(#bytes()) => true
  rule isConcreteSequenceVal(bytesVal(_:ValItems)) => true
  rule isConcreteSequenceVal(#bytearray()) => true
  rule isConcreteSequenceVal(bytearrayVal(_:ValItems)) => true
  rule isConcreteSequenceVal([]) => true
  rule isConcreteSequenceVal(listVal(_:ValItems)) => true
  rule isConcreteSequenceVal(()) => true
  rule isConcreteSequenceVal(tupleVal(_:ValItems)) => true
  rule isConcreteSequenceVal(_:Val) => false [owise]

  rule sumStartForbidden(V:Val) => isStringVal(V) orBool isBytesSequence(V)

  rule sumAddSupported(V1:Val, V2:Val) => true
    requires isComplexLike(V1) andBool isComplexLike(V2)
  rule sumAddSupported(V1:Val, V2:Val) => true
    requires isListSequence(V1) andBool isListSequence(V2)
  rule sumAddSupported(V1:Val, V2:Val) => true
    requires isTupleSequence(V1) andBool isTupleSequence(V2)
  rule sumAddSupported(_:Val, _:Val) => false [owise]

  rule enumerateIterableSupported([]) => true
  rule enumerateIterableSupported(listVal(_:ValItems)) => true
  rule enumerateIterableSupported(()) => true
  rule enumerateIterableSupported(tupleVal(_:ValItems)) => true
  rule enumerateIterableSupported(_:String) => true
  rule enumerateIterableSupported(#bytes()) => true
  rule enumerateIterableSupported(bytesVal(_:ValItems)) => true
  rule enumerateIterableSupported(#bytearray()) => true
  rule enumerateIterableSupported(bytearrayVal(_:ValItems)) => true
  rule enumerateIterableSupported(#memoryviewVal(V:Val)) => enumerateIterableSupported(V)
  rule enumerateIterableSupported({}) => true
  rule enumerateIterableSupported(dictVal(_:DictItems)) => true
  rule enumerateIterableSupported(set()) => true
  rule enumerateIterableSupported(setVal(_:ValItems)) => true
  rule enumerateIterableSupported(frozenset()) => true
  rule enumerateIterableSupported(frozensetVal(_:ValItems)) => true
  rule enumerateIterableSupported(#enumerateVal(_:ArgVals)) => true
  rule enumerateIterableSupported(#zipVal(_:ArgVals)) => true
  rule enumerateIterableSupported(#reversedVal(_:ArgVals)) => true
  rule enumerateIterableSupported(rangeVal(_:Int, _:Int)) => true
  rule enumerateIterableSupported(rangeVal(_:Int, _:Int, Step:Int)) => Step =/=Int 0
  rule enumerateIterableSupported(_:Val) => false [owise]

  rule reversedSupported([]) => true
  rule reversedSupported(listVal(_:ValItems)) => true
  rule reversedSupported(()) => true
  rule reversedSupported(tupleVal(_:ValItems)) => true
  rule reversedSupported(_:String) => true
  rule reversedSupported(#bytes()) => true
  rule reversedSupported(bytesVal(_:ValItems)) => true
  rule reversedSupported(#bytearray()) => true
  rule reversedSupported(bytearrayVal(_:ValItems)) => true
  rule reversedSupported(#memoryviewVal(V:Val)) => reversedSupported(V)
  rule reversedSupported({}) => true
  rule reversedSupported(dictVal(_:DictItems)) => true
  rule reversedSupported(rangeVal(_:Int, _:Int)) => true
  rule reversedSupported(rangeVal(_:Int, _:Int, Step:Int)) => Step =/=Int 0
  rule reversedSupported(_:Val) => false [owise]

  rule matMulSupported(_:Val, _:Val) => false [owise]

  rule seqOrderComparable(V1:Val, V2:Val) =>
    (isListSequence(V1) andBool isListSequence(V2))
      orBool (isTupleSequence(V1) andBool isTupleSequence(V2))
      orBool (isBytesSequence(V1) andBool isBytesSequence(V2))

  rule orderComparable(V1:Val, V2:Val) => true
    requires isIntLike(V1) andBool isIntLike(V2)
  rule orderComparable(_:Float, _:Float) => true
  rule orderComparable(_:Float, V:Val) => true
    requires isIntLike(V)
  rule orderComparable(V:Val, _:Float) => true
    requires isIntLike(V)
  rule orderComparable(_:String, _:String) => true
  rule orderComparable(V1:Val, V2:Val) => true
    requires seqOrderComparable(V1, V2)
  rule orderComparable(set(), set()) => true
  rule orderComparable(set(), setVal(_:ValItems)) => true
  rule orderComparable(setVal(_:ValItems), set()) => true
  rule orderComparable(setVal(_:ValItems), setVal(_:ValItems)) => true
  rule orderComparable(V1:Val, V2:Val) => true
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
      andBool (isFrozenSetVal(V1) orBool isFrozenSetVal(V2))
  rule orderComparable(_:Val, _:Val) => false [owise]

  rule orderingComparisonOp(#lt) => true
  rule orderingComparisonOp(#le) => true
  rule orderingComparisonOp(#gt) => true
  rule orderingComparisonOp(#ge) => true
  rule orderingComparisonOp(#eq) => false
  rule orderingComparisonOp(#ne) => false
  rule orderingComparisonOp(#is) => false
  rule orderingComparisonOp(#isNot) => false
  rule orderingComparisonOp(#in) => false
  rule orderingComparisonOp(#notIn) => false

  rule seqLt([], []) => false
  rule seqLt([], listVal(_:ValItems)) => true
  rule seqLt(listVal(_:ValItems), []) => false
  rule seqLt(listVal(VS1:ValItems), listVal(VS2:ValItems)) => valItemsLt(VS1, VS2)
  rule seqLt((), ()) => false
  rule seqLt((), tupleVal(_:ValItems)) => true
  rule seqLt(tupleVal(_:ValItems), ()) => false
  rule seqLt(tupleVal(VS1:ValItems), tupleVal(VS2:ValItems)) => valItemsLt(VS1, VS2)
  rule seqLt(#bytes(), #bytes()) => false
  rule seqLt(#bytes(), bytesVal(_:ValItems)) => true
  rule seqLt(#bytes(), #bytearray()) => false
  rule seqLt(#bytes(), bytearrayVal(_:ValItems)) => true
  rule seqLt(bytesVal(_:ValItems), #bytes()) => false
  rule seqLt(bytesVal(_:ValItems), #bytearray()) => false
  rule seqLt(bytesVal(VS1:ValItems), bytesVal(VS2:ValItems)) => valItemsLt(VS1, VS2)
  rule seqLt(bytesVal(VS1:ValItems), bytearrayVal(VS2:ValItems)) => valItemsLt(VS1, VS2)
  rule seqLt(#bytearray(), #bytes()) => false
  rule seqLt(#bytearray(), bytesVal(_:ValItems)) => true
  rule seqLt(#bytearray(), #bytearray()) => false
  rule seqLt(#bytearray(), bytearrayVal(_:ValItems)) => true
  rule seqLt(bytearrayVal(_:ValItems), #bytes()) => false
  rule seqLt(bytearrayVal(_:ValItems), #bytearray()) => false
  rule seqLt(bytearrayVal(VS1:ValItems), bytesVal(VS2:ValItems)) => valItemsLt(VS1, VS2)
  rule seqLt(bytearrayVal(VS1:ValItems), bytearrayVal(VS2:ValItems)) => valItemsLt(VS1, VS2)

  rule dictsEq(DS1:DictItems, DS2:DictItems) =>
    dictItemsLen(DS1) ==Int dictItemsLen(DS2)
      andBool dictItemsContained(DS1, DS2)
      andBool dictItemsContained(DS2, DS1)

  rule dictItemsContained(dictItemsLast(K:Val, V:Val), DS:DictItems) => containsDictPair(K, V, DS)
  rule dictItemsContained(dictItemsCons(K:Val, V:Val, DS1:DictItems), DS2:DictItems) =>
    containsDictPair(K, V, DS2) andBool dictItemsContained(DS1, DS2)

  rule containsDictPair(K:Val, V:Val, dictItemsLast(K1:Val, V1:Val)) =>
    valEq(K, K1) andBool valEq(V, V1)
  rule containsDictPair(K:Val, V:Val, dictItemsCons(K1:Val, V1:Val, DS:DictItems)) =>
    (valEq(K, K1) andBool valEq(V, V1)) orBool containsDictPair(K, V, DS)

  rule setsEq(VS1:ValItems, VS2:ValItems) =>
    setItemsSubset(VS1, VS2) andBool setItemsSubset(VS2, VS1)

  rule setItemsSubset(valItemsLast(V:Val), VS:ValItems) => containsVal(V, VS)
  rule setItemsSubset(valItemsCons(V:Val, VS1:ValItems), VS2:ValItems) =>
    containsVal(V, VS2) andBool setItemsSubset(VS1, VS2)

  rule containsVal(V:Val, valItemsLast(V1:Val)) => valEq(V, V1)
  rule containsVal(V:Val, valItemsCons(V1:Val, VS:ValItems)) =>
    valEq(V, V1) orBool containsVal(V, VS)

  rule bytesContains(Needle:ValItems, Haystack:ValItems) => false
    requires valItemsLen(Needle) >Int valItemsLen(Haystack)
  rule bytesContains(Needle:ValItems, Haystack:ValItems) => bytesPrefix(Needle, Haystack)
    requires valItemsLen(Needle) ==Int valItemsLen(Haystack)
  rule bytesContains(Needle:ValItems, valItemsCons(V:Val, Haystack:ValItems)) =>
    bytesPrefix(Needle, valItemsCons(V, Haystack)) orBool bytesContains(Needle, Haystack)
    requires valItemsLen(Needle) <Int valItemsLen(valItemsCons(V, Haystack))

  rule bytesPrefix(valItemsLast(Needle:Val), valItemsLast(Haystack:Val)) =>
    valEq(Needle, Haystack)
  rule bytesPrefix(valItemsLast(Needle:Val), valItemsCons(Haystack:Val, _:ValItems)) =>
    valEq(Needle, Haystack)
  rule bytesPrefix(valItemsCons(_:Val, _:ValItems), valItemsLast(_:Val)) => false
  rule bytesPrefix(valItemsCons(Needle:Val, Needles:ValItems), valItemsCons(Haystack:Val, Haystacks:ValItems)) =>
    valEq(Needle, Haystack) andBool bytesPrefix(Needles, Haystacks)

  rule bytesSuffix(Needle:ValItems, Haystack:ValItems) =>
    bytesPrefix(reverseValItems(Needle), reverseValItems(Haystack))
    requires valItemsLen(Needle) <=Int valItemsLen(Haystack)
  rule bytesSuffix(Needle:ValItems, Haystack:ValItems) => false
    requires valItemsLen(Needle) >Int valItemsLen(Haystack)

  rule bytearrayPrefixMatch(Needle:Val, B:Val) => true
    requires isBytesSequence(B)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearrayPrefixMatch(Needle:Val, #bytes()) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearrayPrefixMatch(Needle:Val, #bytearray()) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearrayPrefixMatch(Needle:Val, bytesVal(VS:ValItems)) =>
    bytesPrefix(bytearrayAffixNeedleItems(Needle), VS)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
      andBool valItemsLen(bytearrayAffixNeedleItems(Needle)) <=Int valItemsLen(VS)
  rule bytearrayPrefixMatch(Needle:Val, bytesVal(VS:ValItems)) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
      andBool valItemsLen(bytearrayAffixNeedleItems(Needle)) >Int valItemsLen(VS)
  rule bytearrayPrefixMatch(Needle:Val, bytearrayVal(VS:ValItems)) =>
    bytesPrefix(bytearrayAffixNeedleItems(Needle), VS)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
      andBool valItemsLen(bytearrayAffixNeedleItems(Needle)) <=Int valItemsLen(VS)
  rule bytearrayPrefixMatch(Needle:Val, bytearrayVal(VS:ValItems)) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
      andBool valItemsLen(bytearrayAffixNeedleItems(Needle)) >Int valItemsLen(VS)

  rule bytearraySuffixMatch(Needle:Val, B:Val) => true
    requires isBytesSequence(B)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearraySuffixMatch(Needle:Val, #bytes()) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearraySuffixMatch(Needle:Val, #bytearray()) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearraySuffixMatch(Needle:Val, bytesVal(VS:ValItems)) =>
    bytesSuffix(bytearrayAffixNeedleItems(Needle), VS)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)
  rule bytearraySuffixMatch(Needle:Val, bytearrayVal(VS:ValItems)) =>
    bytesSuffix(bytearrayAffixNeedleItems(Needle), VS)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)

  rule bytearrayPrefixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) => true
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
      andBool bytearraySearchEmptyStartOk(B, Start)
      andBool bytearraySearchWindowLen(B, Start, End) >=Int 0
  rule bytearrayPrefixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) => false
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
      andBool (bytearraySearchWindowLen(B, Start, End) <Int 0
        orBool notBool bytearraySearchEmptyStartOk(B, Start))
  rule bytearrayPrefixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) =>
    bytearrayPrefixMatch(Needle, bytearraySearchWindow(B, Start, End))
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)

  rule bytearraySuffixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) => true
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
      andBool bytearraySearchEmptyStartOk(B, Start)
      andBool bytearraySearchWindowLen(B, Start, End) >=Int 0
  rule bytearraySuffixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) => false
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayAffixNeedleEmpty(Needle)
      andBool (bytearraySearchWindowLen(B, Start, End) <Int 0
        orBool notBool bytearraySearchEmptyStartOk(B, Start))
  rule bytearraySuffixMatchWindow(Needle:Val, B:Val, Start:Val, End:Val) =>
    bytearraySuffixMatch(Needle, bytearraySearchWindow(B, Start, End))
    requires isBytesSequence(B)
      andBool bytearraySearchBoundOk(Start)
      andBool bytearraySearchBoundOk(End)
      andBool bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayAffixNeedleEmpty(Needle)

  rule bytearrayRemovePrefix(Prefix:Val, B:Val) => B
    requires isBytearrayVal(B)
      andBool bytearrayAffixNeedleSupported(Prefix)
      andBool bytearrayAffixNeedleEmpty(Prefix)
  rule bytearrayRemovePrefix(Prefix:Val, #bytearray()) => #bytearray()
    requires bytearrayAffixNeedleSupported(Prefix)
      andBool notBool bytearrayAffixNeedleEmpty(Prefix)
  rule bytearrayRemovePrefix(Prefix:Val, bytearrayVal(VS:ValItems)) =>
    bytesToBytearray(bytesSlice(VS, valItemsLen(bytearrayAffixNeedleItems(Prefix)), valItemsLen(VS)))
    requires bytearrayAffixNeedleSupported(Prefix)
      andBool notBool bytearrayAffixNeedleEmpty(Prefix)
      andBool bytearrayPrefixMatch(Prefix, bytearrayVal(VS))
  rule bytearrayRemovePrefix(Prefix:Val, bytearrayVal(VS:ValItems)) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(Prefix)
      andBool notBool bytearrayAffixNeedleEmpty(Prefix)
      andBool notBool bytearrayPrefixMatch(Prefix, bytearrayVal(VS))

  rule bytearrayRemoveSuffix(Suffix:Val, B:Val) => B
    requires isBytearrayVal(B)
      andBool bytearrayAffixNeedleSupported(Suffix)
      andBool bytearrayAffixNeedleEmpty(Suffix)
  rule bytearrayRemoveSuffix(Suffix:Val, #bytearray()) => #bytearray()
    requires bytearrayAffixNeedleSupported(Suffix)
      andBool notBool bytearrayAffixNeedleEmpty(Suffix)
  rule bytearrayRemoveSuffix(Suffix:Val, bytearrayVal(VS:ValItems)) =>
    bytesToBytearray(bytesSlice(VS, 0, valItemsLen(VS) -Int valItemsLen(bytearrayAffixNeedleItems(Suffix))))
    requires bytearrayAffixNeedleSupported(Suffix)
      andBool notBool bytearrayAffixNeedleEmpty(Suffix)
      andBool bytearraySuffixMatch(Suffix, bytearrayVal(VS))
  rule bytearrayRemoveSuffix(Suffix:Val, bytearrayVal(VS:ValItems)) => bytearrayVal(VS)
    requires bytearrayAffixNeedleSupported(Suffix)
      andBool notBool bytearrayAffixNeedleEmpty(Suffix)
      andBool notBool bytearraySuffixMatch(Suffix, bytearrayVal(VS))

  rule bytearrayStartsWithTuple(valItemsLast(Needle:Val), B:Val) =>
    bytearrayPrefixMatch(Needle, B)
    requires bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTuple(valItemsLast(Needle:Val), _B:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTuple(valItemsCons(Needle:Val, _Rest:ValItems), B:Val) => true
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayPrefixMatch(Needle, B)
  rule bytearrayStartsWithTuple(valItemsCons(Needle:Val, Rest:ValItems), B:Val) =>
    bytearrayStartsWithTuple(Rest, B)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayPrefixMatch(Needle, B)
  rule bytearrayStartsWithTuple(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayStartsWithTupleTypeError(valItemsLast(Needle:Val), _B:Val) =>
    notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTupleTypeError(valItemsCons(Needle:Val, _Rest:ValItems), B:Val) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayPrefixMatch(Needle, B)
  rule bytearrayStartsWithTupleTypeError(valItemsCons(Needle:Val, Rest:ValItems), B:Val) =>
    bytearrayStartsWithTupleTypeError(Rest, B)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayPrefixMatch(Needle, B)
  rule bytearrayStartsWithTupleTypeError(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val) => true
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayEndsWithTuple(valItemsLast(Needle:Val), B:Val) =>
    bytearraySuffixMatch(Needle, B)
    requires bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTuple(valItemsLast(Needle:Val), _B:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTuple(valItemsCons(Needle:Val, _Rest:ValItems), B:Val) => true
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearraySuffixMatch(Needle, B)
  rule bytearrayEndsWithTuple(valItemsCons(Needle:Val, Rest:ValItems), B:Val) =>
    bytearrayEndsWithTuple(Rest, B)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearraySuffixMatch(Needle, B)
  rule bytearrayEndsWithTuple(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayEndsWithTupleTypeError(valItemsLast(Needle:Val), _B:Val) =>
    notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTupleTypeError(valItemsCons(Needle:Val, _Rest:ValItems), B:Val) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearraySuffixMatch(Needle, B)
  rule bytearrayEndsWithTupleTypeError(valItemsCons(Needle:Val, Rest:ValItems), B:Val) =>
    bytearrayEndsWithTupleTypeError(Rest, B)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearraySuffixMatch(Needle, B)
  rule bytearrayEndsWithTupleTypeError(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val) => true
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayStartsWithTupleWindow(valItemsLast(Needle:Val), B:Val, Start:Val, End:Val) =>
    bytearrayPrefixMatchWindow(Needle, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTupleWindow(valItemsLast(Needle:Val), _B:Val, _Start:Val, _End:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTupleWindow(valItemsCons(Needle:Val, _Rest:ValItems), B:Val, Start:Val, End:Val) => true
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayPrefixMatchWindow(Needle, B, Start, End)
  rule bytearrayStartsWithTupleWindow(valItemsCons(Needle:Val, Rest:ValItems), B:Val, Start:Val, End:Val) =>
    bytearrayStartsWithTupleWindow(Rest, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayPrefixMatchWindow(Needle, B, Start, End)
  rule bytearrayStartsWithTupleWindow(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val, _Start:Val, _End:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayStartsWithTupleWindowTypeError(valItemsLast(Needle:Val), _B:Val, _Start:Val, _End:Val) =>
    notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayStartsWithTupleWindowTypeError(valItemsCons(Needle:Val, _Rest:ValItems), B:Val, Start:Val, End:Val) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearrayPrefixMatchWindow(Needle, B, Start, End)
  rule bytearrayStartsWithTupleWindowTypeError(valItemsCons(Needle:Val, Rest:ValItems), B:Val, Start:Val, End:Val) =>
    bytearrayStartsWithTupleWindowTypeError(Rest, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearrayPrefixMatchWindow(Needle, B, Start, End)
  rule bytearrayStartsWithTupleWindowTypeError(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val, _Start:Val, _End:Val) => true
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayEndsWithTupleWindow(valItemsLast(Needle:Val), B:Val, Start:Val, End:Val) =>
    bytearraySuffixMatchWindow(Needle, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTupleWindow(valItemsLast(Needle:Val), _B:Val, _Start:Val, _End:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTupleWindow(valItemsCons(Needle:Val, _Rest:ValItems), B:Val, Start:Val, End:Val) => true
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearraySuffixMatchWindow(Needle, B, Start, End)
  rule bytearrayEndsWithTupleWindow(valItemsCons(Needle:Val, Rest:ValItems), B:Val, Start:Val, End:Val) =>
    bytearrayEndsWithTupleWindow(Rest, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearraySuffixMatchWindow(Needle, B, Start, End)
  rule bytearrayEndsWithTupleWindow(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val, _Start:Val, _End:Val) => false
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytearrayEndsWithTupleWindowTypeError(valItemsLast(Needle:Val), _B:Val, _Start:Val, _End:Val) =>
    notBool bytearrayAffixNeedleSupported(Needle)
  rule bytearrayEndsWithTupleWindowTypeError(valItemsCons(Needle:Val, _Rest:ValItems), B:Val, Start:Val, End:Val) => false
    requires bytearrayAffixNeedleSupported(Needle)
      andBool bytearraySuffixMatchWindow(Needle, B, Start, End)
  rule bytearrayEndsWithTupleWindowTypeError(valItemsCons(Needle:Val, Rest:ValItems), B:Val, Start:Val, End:Val) =>
    bytearrayEndsWithTupleWindowTypeError(Rest, B, Start, End)
    requires bytearrayAffixNeedleSupported(Needle)
      andBool notBool bytearraySuffixMatchWindow(Needle, B, Start, End)
  rule bytearrayEndsWithTupleWindowTypeError(valItemsCons(Needle:Val, _Rest:ValItems), _B:Val, _Start:Val, _End:Val) => true
    requires notBool bytearrayAffixNeedleSupported(Needle)

  rule bytesFind(Needle:ValItems, Haystack:ValItems, _I:Int) => -1
    requires valItemsLen(Needle) >Int valItemsLen(Haystack)
  rule bytesFind(Needle:ValItems, Haystack:ValItems, I:Int) => I
    requires valItemsLen(Needle) <=Int valItemsLen(Haystack)
      andBool bytesPrefix(Needle, Haystack)
  rule bytesFind(Needle:ValItems, valItemsCons(H:Val, Haystack:ValItems), I:Int) =>
    bytesFind(Needle, Haystack, I +Int 1)
    requires valItemsLen(Needle) <Int valItemsLen(valItemsCons(H, Haystack))
      andBool notBool bytesPrefix(Needle, valItemsCons(H, Haystack))
  rule bytesFind(Needle:ValItems, Haystack:ValItems, _I:Int) => -1
    requires valItemsLen(Needle) ==Int valItemsLen(Haystack)
      andBool notBool bytesPrefix(Needle, Haystack)

  rule bytesRFind(Needle:ValItems, Haystack:ValItems, _I:Int, Best:Int) => Best
    requires valItemsLen(Needle) >Int valItemsLen(Haystack)
  rule bytesRFind(Needle:ValItems, valItemsLast(H:Val), I:Int, _Best:Int) => I
    requires valItemsLen(Needle) <=Int 1
      andBool bytesPrefix(Needle, valItemsLast(H))
  rule bytesRFind(Needle:ValItems, valItemsLast(H:Val), _I:Int, Best:Int) => Best
    requires valItemsLen(Needle) <=Int 1
      andBool notBool bytesPrefix(Needle, valItemsLast(H))
  rule bytesRFind(Needle:ValItems, valItemsCons(H:Val, Haystack:ValItems), I:Int, _Best:Int) =>
    bytesRFind(Needle, Haystack, I +Int 1, I)
    requires valItemsLen(Needle) <=Int valItemsLen(valItemsCons(H, Haystack))
      andBool bytesPrefix(Needle, valItemsCons(H, Haystack))
  rule bytesRFind(Needle:ValItems, valItemsCons(H:Val, Haystack:ValItems), I:Int, Best:Int) =>
    bytesRFind(Needle, Haystack, I +Int 1, Best)
    requires valItemsLen(Needle) <=Int valItemsLen(valItemsCons(H, Haystack))
      andBool notBool bytesPrefix(Needle, valItemsCons(H, Haystack))

  rule bytesCountNeedle(Needle:ValItems, Haystack:ValItems) => 0
    requires valItemsLen(Needle) >Int valItemsLen(Haystack)
  rule bytesCountNeedle(Needle:ValItems, Haystack:ValItems) => 1
    requires valItemsLen(Needle) ==Int valItemsLen(Haystack)
      andBool bytesPrefix(Needle, Haystack)
  rule bytesCountNeedle(Needle:ValItems, Haystack:ValItems) =>
    1 +Int bytesCountNeedle(Needle, dropValItems(Haystack, valItemsLen(Needle)))
    requires valItemsLen(Needle) <Int valItemsLen(Haystack)
      andBool bytesPrefix(Needle, Haystack)
  rule bytesCountNeedle(Needle:ValItems, valItemsLast(V:Val)) => 0
    requires valItemsLen(Needle) <=Int 1
      andBool notBool bytesPrefix(Needle, valItemsLast(V))
  rule bytesCountNeedle(Needle:ValItems, valItemsCons(V:Val, Haystack:ValItems)) =>
    bytesCountNeedle(Needle, Haystack)
    requires valItemsLen(Needle) <=Int valItemsLen(valItemsCons(V, Haystack))
      andBool notBool bytesPrefix(Needle, valItemsCons(V, Haystack))

  rule bytearraySearchStart(B:Val, Start:Val) => pySliceLower(Start, pyLen(B))
  rule bytearraySearchEnd(B:Val, End:Val) => pySliceUpper(End, pyLen(B))
  rule bytearraySearchWindowLen(B:Val, Start:Val, End:Val) =>
    bytearraySearchEnd(B, End) -Int bytearraySearchStart(B, Start)
  rule bytearraySearchWindow(B:Val, Start:Val, End:Val) => #bytearray()
    requires isBytearrayVal(B)
      andBool bytearraySearchWindowLen(B, Start, End) <=Int 0
  rule bytearraySearchWindow(B:Val, Start:Val, End:Val) => #bytearray()
    requires isBytesVal(B)
      andBool bytearraySearchWindowLen(B, Start, End) <=Int 0
  rule bytearraySearchWindow(bytesVal(VS:ValItems), Start:Val, End:Val) =>
    bytesToBytearray(bytesSlice(VS, bytearraySearchStart(bytesVal(VS), Start), bytearraySearchEnd(bytesVal(VS), End)))
    requires bytearraySearchWindowLen(bytesVal(VS), Start, End) >Int 0
  rule bytearraySearchWindow(bytearrayVal(VS:ValItems), Start:Val, End:Val) =>
    bytesToBytearray(bytesSlice(VS, bytearraySearchStart(bytearrayVal(VS), Start), bytearraySearchEnd(bytearrayVal(VS), End)))
    requires bytearraySearchWindowLen(bytearrayVal(VS), Start, End) >Int 0

  rule bytearrayCountByte(valItemsLast(V0:Val), V:Val) => 1
    requires valEq(V0, V)
  rule bytearrayCountByte(valItemsLast(V0:Val), V:Val) => 0
    requires notBool valEq(V0, V)
  rule bytearrayCountByte(valItemsCons(V0:Val, VS:ValItems), V:Val) =>
    1 +Int bytearrayCountByte(VS, V)
    requires valEq(V0, V)
  rule bytearrayCountByte(valItemsCons(V0:Val, VS:ValItems), V:Val) =>
    bytearrayCountByte(VS, V)
    requires notBool valEq(V0, V)

  rule bytearrayIndexByte(valItemsLast(V0:Val), V:Val, I:Int) => I
    requires valEq(V0, V)
  rule bytearrayIndexByte(valItemsCons(V0:Val, _VS:ValItems), V:Val, I:Int) => I
    requires valEq(V0, V)
  rule bytearrayIndexByte(valItemsCons(V0:Val, VS:ValItems), V:Val, I:Int) =>
    bytearrayIndexByte(VS, V, I +Int 1)
    requires notBool valEq(V0, V)

  rule containsKey(K:Val, dictItemsLast(K1:Val, _:Val)) => valEq(K, K1)
  rule containsKey(K:Val, dictItemsCons(K1:Val, _:Val, DS:DictItems)) =>
    valEq(K, K1) orBool containsKey(K, DS)

  rule listGet(valItemsLast(V:Val), 0) => V
  rule listGet(valItemsCons(V:Val, _:ValItems), 0) => V
  rule listGet(valItemsCons(_:Val, VS:ValItems), I:Int) => listGet(VS, I -Int 1)
    requires I >Int 0

  rule listSet(valItemsLast(_:Val), 0, V:Val) => valItemsLast(V)
  rule listSet(valItemsCons(_:Val, VS:ValItems), 0, V:Val) => valItemsCons(V, VS)
  rule listSet(valItemsCons(V0:Val, VS:ValItems), I:Int, V:Val) =>
    valItemsCons(V0, listSet(VS, I -Int 1, V))
    requires I >Int 0

  rule listSliceStepSet(VS:ValItems, Start:Int, Stop:Int, Step:Int, valItemsLast(R:Val)) =>
    listSet(VS, Start, R)
    requires sliceStepLen(Start, Stop, Step) ==Int 1
  rule listSliceStepSet(VS:ValItems, Start:Int, Stop:Int, Step:Int, valItemsCons(R:Val, RS:ValItems)) =>
    listSliceStepSet(listSet(VS, Start, R), Start +Int Step, Stop, Step, RS)
    requires sliceStepLen(Start, Stop, Step) >Int 1

  rule listDel(valItemsLast(_:Val), 0) => []
  rule listDel(valItemsCons(_:Val, VS:ValItems), 0) => listVal(VS)
  rule listDel(valItemsCons(V0:Val, VS:ValItems), I:Int) =>
    listPrepend(V0, listDel(VS, I -Int 1))
    requires I >Int 0

  rule listPrepend(V:Val, []) => listVal(valItemsLast(V))
  rule listPrepend(V:Val, listVal(VS:ValItems)) => listVal(valItemsCons(V, VS))

  rule listAppendItem([], V:Val) => listVal(valItemsLast(V))
  rule listAppendItem(listVal(VS:ValItems), V:Val) =>
    listVal(concatValItems(VS, valItemsLast(V)))

  rule listExtendItems([], VS:ValItems) => listVal(VS)
  rule listExtendItems(listVal(VS1:ValItems), VS2:ValItems) =>
    listVal(concatValItems(VS1, VS2))

  rule listCount(valItemsLast(V0:Val), V:Val) => 1
    requires valEq(V0, V)
  rule listCount(valItemsLast(V0:Val), V:Val) => 0
    requires notBool valEq(V0, V)
  rule listCount(valItemsCons(V0:Val, VS:ValItems), V:Val) =>
    1 +Int listCount(VS, V)
    requires valEq(V0, V)
  rule listCount(valItemsCons(V0:Val, VS:ValItems), V:Val) =>
    listCount(VS, V)
    requires notBool valEq(V0, V)

  rule listIndexStart(I:Int, Len:Int) => 0
    requires I <Int 0 andBool Len +Int I <Int 0
  rule listIndexStart(I:Int, Len:Int) => Len +Int I
    requires I <Int 0 andBool Len +Int I >=Int 0
  rule listIndexStart(I:Int, Len:Int) => Len
    requires I >Int Len
  rule listIndexStart(I:Int, Len:Int) => I
    requires I >=Int 0 andBool I <=Int Len

  rule listIndexStop(I:Int, Len:Int) => 0
    requires I <Int 0 andBool Len +Int I <Int 0
  rule listIndexStop(I:Int, Len:Int) => Len +Int I
    requires I <Int 0 andBool Len +Int I >=Int 0
  rule listIndexStop(I:Int, Len:Int) => Len
    requires I >Int Len
  rule listIndexStop(I:Int, Len:Int) => I
    requires I >=Int 0 andBool I <=Int Len

  rule listIndexFind(_VS:ValItems, _V:Val, Start:Int, Stop:Int) => -1
    requires Start >=Int Stop
  rule listIndexFind(VS:ValItems, V:Val, Start:Int, Stop:Int) => Start
    requires Start <Int Stop
      andBool valEq(listGet(VS, Start), V)
  rule listIndexFind(VS:ValItems, V:Val, Start:Int, Stop:Int) =>
    listIndexFind(VS, V, Start +Int 1, Stop)
    requires Start <Int Stop
      andBool notBool valEq(listGet(VS, Start), V)

  rule listRemoveFirst(valItemsLast(V0:Val), V:Val) => []
    requires valEq(V0, V)
  rule listRemoveFirst(valItemsCons(V0:Val, VS:ValItems), V:Val) => listVal(VS)
    requires valEq(V0, V)
  rule listRemoveFirst(valItemsCons(V0:Val, VS:ValItems), V:Val) =>
    listPrepend(V0, listRemoveFirst(VS, V))
    requires notBool valEq(V0, V)

  rule listInsertItem([], _I:Int, V:Val) => listVal(valItemsLast(V))
  rule listInsertItem(listVal(VS:ValItems), I:Int, V:Val) =>
    listVal(valItemsCons(V, VS))
    requires I <=Int 0
  rule listInsertItem(listVal(VS:ValItems), I:Int, V:Val) =>
    listVal(concatValItems(VS, valItemsLast(V)))
    requires I >=Int valItemsLen(VS)
  rule listInsertItem(listVal(valItemsCons(V0:Val, VS:ValItems)), I:Int, V:Val) =>
    listPrepend(V0, listInsertItem(listVal(VS), I -Int 1, V))
    requires I >Int 0
      andBool I <Int valItemsLen(valItemsCons(V0, VS))

  rule listReverse([]) => []
  rule listReverse(listVal(VS:ValItems)) => listVal(reverseValItems(VS))

  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(RS, VS))
    requires Start >=Int Stop andBool Start ==Int 0
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(VS, RS))
    requires Start >=Int Stop andBool Start >=Int valItemsLen(VS)
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(sliceValItems(VS, 0, Start), concatValItems(RS, dropValItems(VS, Start))))
    requires Start >=Int Stop andBool Start >Int 0 andBool Start <Int valItemsLen(VS)
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(RS)
    requires Start <Int Stop andBool Start ==Int 0 andBool Stop >=Int valItemsLen(VS)
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(RS, dropValItems(VS, Stop)))
    requires Start <Int Stop andBool Start ==Int 0 andBool Stop <Int valItemsLen(VS)
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(sliceValItems(VS, 0, Start), RS))
    requires Start <Int Stop andBool Start >Int 0 andBool Stop >=Int valItemsLen(VS)
  rule listSliceAssign(VS:ValItems, Start:Int, Stop:Int, RS:ValItems) =>
    listVal(concatValItems(sliceValItems(VS, 0, Start), concatValItems(RS, dropValItems(VS, Stop))))
    requires Start <Int Stop andBool Start >Int 0 andBool Stop <Int valItemsLen(VS)

  rule listSliceAssignEmpty(VS:ValItems, Start:Int, Stop:Int) => listVal(VS)
    requires Start >=Int Stop
  rule listSliceAssignEmpty(VS:ValItems, Start:Int, Stop:Int) => listSliceDelete(VS, Start, Stop)
    requires Start <Int Stop

  rule listSliceDelete(VS:ValItems, Start:Int, Stop:Int) => []
    requires Start ==Int 0 andBool Stop >=Int valItemsLen(VS)
  rule listSliceDelete(VS:ValItems, Start:Int, Stop:Int) => listVal(dropValItems(VS, Stop))
    requires Start ==Int 0 andBool Stop <Int valItemsLen(VS)
  rule listSliceDelete(VS:ValItems, Start:Int, Stop:Int) =>
    listVal(sliceValItems(VS, 0, Start))
    requires Start >Int 0 andBool Stop >=Int valItemsLen(VS)
  rule listSliceDelete(VS:ValItems, Start:Int, Stop:Int) =>
    listVal(concatValItems(sliceValItems(VS, 0, Start), dropValItems(VS, Stop)))
    requires Start >Int 0 andBool Stop <Int valItemsLen(VS)

  rule listSliceStepDelete(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listSliceStepDeleteN(listVal(VS), Start, Step -Int 1, sliceStepLen(Start, Stop, Step))
    requires Step >Int 0
  rule listSliceStepDelete(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listSliceStepDeleteN(listVal(VS), Start, Step, sliceStepLen(Start, Stop, Step))
    requires Step <Int 0

  rule listSliceStepDeleteN(V:Val, _I:Int, _Delta:Int, 0) => V
  rule listSliceStepDeleteN(listVal(VS:ValItems), I:Int, Delta:Int, N:Int) =>
    listSliceStepDeleteN(listDel(VS, I), I +Int Delta, Delta, N -Int 1)
    requires N >Int 0

  rule dictGet(dictItemsLast(K1:Val, V:Val), K:Val) => V
    requires valEq(K, K1)
  rule dictGet(dictItemsCons(K1:Val, V:Val, _:DictItems), K:Val) => V
    requires valEq(K, K1)
  rule dictGet(dictItemsCons(K1:Val, _:Val, DS:DictItems), K:Val) => dictGet(DS, K)
    requires notBool valEq(K, K1)

  rule dictSet(dictItemsLast(K1:Val, _:Val), K:Val, V:Val) => dictItemsLast(K1, V)
    requires valEq(K, K1)
  rule dictSet(dictItemsLast(K1:Val, V1:Val), K:Val, V:Val) =>
    dictItemsCons(K1, V1, dictItemsLast(K, V))
    requires notBool valEq(K, K1)
  rule dictSet(dictItemsCons(K1:Val, _:Val, DS:DictItems), K:Val, V:Val) =>
    dictItemsCons(K1, V, DS)
    requires valEq(K, K1)
  rule dictSet(dictItemsCons(K1:Val, V1:Val, DS:DictItems), K:Val, V:Val) =>
    dictItemsCons(K1, V1, dictSet(DS, K, V))
    requires notBool valEq(K, K1)

  rule dictDel(dictItemsLast(K1:Val, _:Val), K:Val) => ({}):Val
    requires valEq(K, K1)
  rule dictDel(dictItemsCons(K1:Val, _:Val, DS:DictItems), K:Val) => dictVal(DS)
    requires valEq(K, K1)
  rule dictDel(dictItemsCons(K1:Val, V1:Val, DS:DictItems), K:Val) =>
    dictPrepend(K1, V1, dictDel(DS, K))
    requires notBool valEq(K, K1)

  rule dictPopItemPair(dictItemsLast(K:Val, V:Val)) =>
    tupleVal(valItemsCons(K, valItemsLast(V)))
  rule dictPopItemPair(dictItemsCons(_:Val, _:Val, DS:DictItems)) =>
    dictPopItemPair(DS)

  rule dictPopItemRest(dictItemsLast(_:Val, _:Val)) => ({}):Val
  rule dictPopItemRest(dictItemsCons(K:Val, V:Val, DS:DictItems)) =>
    dictPrepend(K, V, dictPopItemRest(DS))

  rule subscriptIndexInBounds(I:Val, Len:Int) =>
    ((intValue(I) >=Int 0 andBool intValue(I) <Int Len)
      orBool (intValue(I) <Int 0 andBool Len +Int intValue(I) >=Int 0))
    requires isIntLike(I)
  rule subscriptIndexInBounds(I:Val, _Len:Int) => false
    requires notBool isIntLike(I)

  rule isSliceVal(sliceVal(_:Val, _:Val, _:Val)) => true
  rule isSliceVal(_:Val) => false [owise]

  rule isRangeVal(rangeVal(_:Int, _:Int)) => true
  rule isRangeVal(rangeVal(_:Int, _:Int, _:Int)) => true
  rule isRangeVal(_:Val) => false [owise]

  rule dictLookupKeySupported(_:Int) => true
  rule dictLookupKeySupported(_:Float) => true
  rule dictLookupKeySupported(True) => true
  rule dictLookupKeySupported(False) => true
  rule dictLookupKeySupported(_:String) => true
  rule dictLookupKeySupported(None) => true
  rule dictLookupKeySupported(Ellipsis) => true
  rule dictLookupKeySupported(#bytes()) => true
  rule dictLookupKeySupported(bytesVal(_:ValItems)) => true
  rule dictLookupKeySupported(#complex(_:Float, _:Float)) => true
  rule dictLookupKeySupported(()) => true
  rule dictLookupKeySupported(tupleVal(VS:ValItems)) => dictLookupKeyItemsSupported(VS)
  rule dictLookupKeySupported(frozenset()) => true
  rule dictLookupKeySupported(frozensetVal(VS:ValItems)) => dictLookupKeyItemsSupported(VS)
  rule dictLookupKeySupported(rangeVal(_:Int, _:Int)) => true
  rule dictLookupKeySupported(rangeVal(_:Int, _:Int, Step:Int)) => true
    requires Step =/=Int 0
  rule dictLookupKeySupported(sliceVal(Start:Val, Stop:Val, Step:Val)) =>
    dictLookupKeySupported(Start)
      andBool dictLookupKeySupported(Stop)
      andBool dictLookupKeySupported(Step)
  rule dictLookupKeySupported(_:Val) => false [owise]

  rule dictLookupKeyItemsSupported(valItemsLast(V:Val)) => dictLookupKeySupported(V)
  rule dictLookupKeyItemsSupported(valItemsCons(V:Val, VS:ValItems)) =>
    dictLookupKeySupported(V) andBool dictLookupKeyItemsSupported(VS)

  rule dictFromKeysArgValsSupported(#noArgVals) => true
  rule dictFromKeysArgValsSupported(argValsCons(K:Val, Rest:ArgVals)) =>
    dictLookupKeySupported(K) andBool dictFromKeysArgValsSupported(Rest)

  rule dictUpdateSourceSupported(V:Val) =>
    isDictVal(V) orBool unpackValueSupported(V)

  rule dictUpdateSourceValueError(V:Val) => false
    requires isDictVal(V)
  rule dictUpdateSourceValueError(V:Val) => dictUpdateArgValsValueError(iterableArgVals(V))
    requires notBool isDictVal(V) andBool unpackValueSupported(V)
  rule dictUpdateSourceValueError(V:Val) => false
    requires notBool unpackValueSupported(V)

  rule dictUpdateSourceTypeError(V:Val) => false
    requires isDictVal(V)
  rule dictUpdateSourceTypeError(V:Val) => true
    requires notBool unpackValueSupported(V)
  rule dictUpdateSourceTypeError(V:Val) => dictUpdateArgValsTypeError(iterableArgVals(V))
    requires notBool isDictVal(V) andBool unpackValueSupported(V)

  rule dictUpdateArgValsOk(#noArgVals) => true
  rule dictUpdateArgValsOk(argValsCons(Pair:Val, Rest:ArgVals)) =>
    dictUpdatePairOk(Pair) andBool dictUpdateArgValsOk(Rest)

  rule dictUpdateArgValsValueError(#noArgVals) => false
  rule dictUpdateArgValsValueError(argValsCons(Pair:Val, _Rest:ArgVals)) => true
    requires dictUpdatePairValueError(Pair)
  rule dictUpdateArgValsValueError(argValsCons(Pair:Val, Rest:ArgVals)) =>
    dictUpdateArgValsValueError(Rest)
    requires dictUpdatePairOk(Pair)
  rule dictUpdateArgValsValueError(argValsCons(Pair:Val, _Rest:ArgVals)) => false
    requires dictUpdatePairTypeError(Pair)

  rule dictUpdateArgValsTypeError(#noArgVals) => false
  rule dictUpdateArgValsTypeError(argValsCons(Pair:Val, _Rest:ArgVals)) => true
    requires dictUpdatePairTypeError(Pair)
  rule dictUpdateArgValsTypeError(argValsCons(Pair:Val, Rest:ArgVals)) =>
    dictUpdateArgValsTypeError(Rest)
    requires dictUpdatePairOk(Pair)
  rule dictUpdateArgValsTypeError(argValsCons(Pair:Val, _Rest:ArgVals)) => false
    requires dictUpdatePairValueError(Pair)

  rule dictUpdatePairOk(Pair:Val) => true
    requires unpackValueSupported(Pair)
      andBool unpackValueLen(Pair) ==Int 2
      andBool dictLookupKeySupported(dictPairKey(Pair))
  rule dictUpdatePairOk(Pair:Val) => false
    requires notBool unpackValueSupported(Pair)
  rule dictUpdatePairOk(Pair:Val) => false
    requires unpackValueSupported(Pair) andBool unpackValueLen(Pair) =/=Int 2
  rule dictUpdatePairOk(Pair:Val) => false
    requires unpackValueSupported(Pair)
      andBool unpackValueLen(Pair) ==Int 2
      andBool notBool dictLookupKeySupported(dictPairKey(Pair))

  rule dictUpdatePairValueError(Pair:Val) => true
    requires unpackValueSupported(Pair) andBool unpackValueLen(Pair) =/=Int 2
  rule dictUpdatePairValueError(Pair:Val) => false
    requires notBool unpackValueSupported(Pair)
  rule dictUpdatePairValueError(Pair:Val) => false
    requires unpackValueSupported(Pair) andBool unpackValueLen(Pair) ==Int 2

  rule dictUpdatePairTypeError(Pair:Val) => true
    requires notBool unpackValueSupported(Pair)
  rule dictUpdatePairTypeError(Pair:Val) => true
    requires unpackValueSupported(Pair)
      andBool unpackValueLen(Pair) ==Int 2
      andBool notBool dictLookupKeySupported(dictPairKey(Pair))
  rule dictUpdatePairTypeError(Pair:Val) => false
    requires unpackValueSupported(Pair) andBool unpackValueLen(Pair) =/=Int 2
  rule dictUpdatePairTypeError(Pair:Val) => false
    requires unpackValueSupported(Pair)
      andBool unpackValueLen(Pair) ==Int 2
      andBool dictLookupKeySupported(dictPairKey(Pair))

  rule subscriptLookupable(listVal(VS:ValItems), I:Val) =>
    intValue(I) <Int valItemsLen(VS)
    requires isIntLike(I) andBool intValue(I) >=Int 0
  rule subscriptLookupable(listVal(VS:ValItems), I:Val) =>
    valItemsLen(VS) +Int intValue(I) >=Int 0
    requires isIntLike(I) andBool intValue(I) <Int 0
  rule subscriptLookupable(dictVal(DS:DictItems), K:Val) => containsKey(K, DS)
  rule subscriptLookupable(_:Val, _:Val) => false [owise]

  rule subscriptSettable(listVal(VS:ValItems), I:Val) =>
    intValue(I) <Int valItemsLen(VS)
    requires isIntLike(I) andBool intValue(I) >=Int 0
  rule subscriptSettable(listVal(VS:ValItems), I:Val) =>
    valItemsLen(VS) +Int intValue(I) >=Int 0
    requires isIntLike(I) andBool intValue(I) <Int 0
  rule subscriptSettable(({}):Val, _:Val) => true
  rule subscriptSettable(dictVal(_:DictItems), _:Val) => true
  rule subscriptSettable(_:Val, _:Val) => false [owise]

  rule subscriptDeletable(listVal(VS:ValItems), I:Val) =>
    intValue(I) <Int valItemsLen(VS)
    requires isIntLike(I) andBool intValue(I) >=Int 0
  rule subscriptDeletable(listVal(VS:ValItems), I:Val) =>
    valItemsLen(VS) +Int intValue(I) >=Int 0
    requires isIntLike(I) andBool intValue(I) <Int 0
  rule subscriptDeletable(dictVal(DS:DictItems), K:Val) => containsKey(K, DS)
  rule subscriptDeletable(_:Val, _:Val) => false [owise]

  rule subscriptGet(listVal(VS:ValItems), I:Val) => listGet(VS, intValue(I))
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule subscriptGet(listVal(VS:ValItems), I:Val) => listGet(VS, valItemsLen(VS) +Int intValue(I))
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule subscriptGet(dictVal(DS:DictItems), K:Val) => dictGet(DS, K)
    requires containsKey(K, DS)

  rule subscriptSet(listVal(VS:ValItems), I:Val, V:Val) =>
    listVal(listSet(VS, intValue(I), V))
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule subscriptSet(listVal(VS:ValItems), I:Val, V:Val) =>
    listVal(listSet(VS, valItemsLen(VS) +Int intValue(I), V))
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule subscriptSet(({}):Val, K:Val, V:Val) => dictVal(dictItemsLast(K, V))
  rule subscriptSet(dictVal(DS:DictItems), K:Val, V:Val) => dictVal(dictSet(DS, K, V))

  rule subscriptDel(listVal(VS:ValItems), I:Val) => listDel(VS, intValue(I))
    requires isIntLike(I) andBool intValue(I) >=Int 0 andBool intValue(I) <Int valItemsLen(VS)
  rule subscriptDel(listVal(VS:ValItems), I:Val) => listDel(VS, valItemsLen(VS) +Int intValue(I))
    requires isIntLike(I)
      andBool intValue(I) <Int 0
      andBool valItemsLen(VS) +Int intValue(I) >=Int 0
  rule subscriptDel(dictVal(DS:DictItems), K:Val) => dictDel(DS, K)
    requires containsKey(K, DS)

  rule dictPrepend(K:Val, V:Val, ({}):Val) => dictVal(dictItemsLast(K, V))
  rule dictPrepend(K:Val, V:Val, dictVal(DS:DictItems)) => dictVal(dictItemsCons(K, V, DS))

  configuration
    <python>
      <k> $PGM:Stmts </k>
      <env> .Map </env>
      <iterators> .Map </iterators>
      <nextIterator> 0 </nextIterator>
      <activeException> noException </activeException>
      <result> .K </result>
    </python>

  rule <k> stmtsCons(S:Stmt, SS:Stmts) => S ~> stmtNext(SS) ... </k>
  rule <k> stmtsLast(S:Stmt) => S ~> stmtEnd ... </k>

  rule <k> V:Val ~> stmtNext(SS:Stmts) => SS ... </k>
       <result> _ => V </result>

  rule <k> V:Val ~> stmtEnd => .K ... </k>
       <result> _ => V </result>

  rule <k> X:Id => V ... </k>
       <env> ... X |-> V:Val ... </env>
  rule <k> X:Id => exceptionSignal(#exception(#token("NameError", "Id"))) ... </k>
       <env> Rho </env>
    requires notBool (X in_keys(Rho))

  rule <k> #name(X:Id) => V ... </k>
       <env> ... X |-> V:Val ... </env>
  rule <k> #name(#token("kEllipsisName", "Id")) => Ellipsis ... </k>
       <env> Rho </env>
    requires notBool (#token("kEllipsisName", "Id") in_keys(Rho))

  rule <k> namedExprExp(X:Id, V:Val) => V ... </k>
       <env> Rho => Rho [ X <- V ] </env>

  rule <k> fstringExp(Parts:FStringParts) => fStringEval(Parts, "") ... </k>
  rule <k> fStringEval(#fstrEnd, Acc:String) => Acc ... </k>
  rule <k> fStringEval(#fstrText(S:String, Rest:FStringParts), Acc:String) =>
           fStringEval(Rest, Acc +String S)
       ... </k>
  rule <k> fStringEval(#fstrExp(E:Exp, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppend(Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpConv(E:Exp, Conv:FStringConversion, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendConv(Conv, Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpFormatEmpty(E:Exp, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppend(Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpConvFormatEmpty(E:Exp, Conv:FStringConversion, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendConv(Conv, Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpFormat(E:Exp, Spec:String, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendFormat(Spec, Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpConvFormat(E:Exp, Conv:FStringConversion, Spec:String, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendConvFormat(Conv, Spec, Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpFormatParts(E:Exp, SpecParts:FStringParts, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendFormatParts(SpecParts, Rest, Acc)
       ... </k>
  rule <k> fStringEval(#fstrExpConvFormatParts(E:Exp, Conv:FStringConversion, SpecParts:FStringParts, Rest:FStringParts), Acc:String) =>
           E ~> fStringAppendConvFormatParts(Conv, SpecParts, Rest, Acc)
       ... </k>
  rule <k> V:Val ~> fStringAppend(Rest:FStringParts, Acc:String) =>
           fStringEval(Rest, Acc +String pyFormatStr(V))
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConv(#fstrConvStr, Rest:FStringParts, Acc:String) =>
           fStringEval(Rest, Acc +String pyFormatStr(V))
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConv(#fstrConvRepr, Rest:FStringParts, Acc:String) =>
           fStringEval(Rest, Acc +String pyReprStr(V))
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConv(#fstrConvAscii, Rest:FStringParts, Acc:String) =>
           fStringEval(Rest, Acc +String pyAsciiStr(V))
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendFormat(Spec:String, Rest:FStringParts, Acc:String) =>
           Spec ~> formatApply(V) ~> fStringAppendFormatted(Rest, Acc)
       ... </k>
  rule <k> V:Val ~> fStringAppendConvFormat(#fstrConvStr, Spec:String, Rest:FStringParts, Acc:String) =>
           Spec ~> formatApply(pyFormatStr(V)) ~> fStringAppendFormatted(Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConvFormat(#fstrConvRepr, Spec:String, Rest:FStringParts, Acc:String) =>
           Spec ~> formatApply(pyReprStr(V)) ~> fStringAppendFormatted(Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConvFormat(#fstrConvAscii, Spec:String, Rest:FStringParts, Acc:String) =>
           Spec ~> formatApply(pyAsciiStr(V)) ~> fStringAppendFormatted(Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendFormatParts(SpecParts:FStringParts, Rest:FStringParts, Acc:String) =>
           fStringEval(SpecParts, "") ~> fStringApplyDynamicFormat(V, Rest, Acc)
       ... </k>
  rule <k> V:Val ~> fStringAppendConvFormatParts(#fstrConvStr, SpecParts:FStringParts, Rest:FStringParts, Acc:String) =>
           fStringEval(SpecParts, "") ~> fStringApplyDynamicFormat(pyFormatStr(V), Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConvFormatParts(#fstrConvRepr, SpecParts:FStringParts, Rest:FStringParts, Acc:String) =>
           fStringEval(SpecParts, "") ~> fStringApplyDynamicFormat(pyReprStr(V), Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> V:Val ~> fStringAppendConvFormatParts(#fstrConvAscii, SpecParts:FStringParts, Rest:FStringParts, Acc:String) =>
           fStringEval(SpecParts, "") ~> fStringApplyDynamicFormat(pyAsciiStr(V), Rest, Acc)
       ... </k>
    requires fStringFormatSupported(V)
  rule <k> Spec:String ~> fStringApplyDynamicFormat(V:Val, Rest:FStringParts, Acc:String) =>
           Spec ~> formatApply(V) ~> fStringAppendFormatted(Rest, Acc)
       ... </k>
  rule <k> S:String ~> fStringAppendFormatted(Rest:FStringParts, Acc:String) =>
           fStringEval(Rest, Acc +String S)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppend(_:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendConv(_:FStringConversion, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendFormat(_:String, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendConvFormat(_:FStringConversion, _:String, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendFormatParts(_:FStringParts, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendConvFormatParts(_:FStringConversion, _:FStringParts, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringApplyDynamicFormat(_:Val, _:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>
  rule <k> exceptionSignal(E:Val) ~> fStringAppendFormatted(_:FStringParts, _:String) =>
           exceptionSignal(E)
       ... </k>

  rule + V:Val => intValue(V) requires isIntLike(V)
  rule + F:Float => F
  rule + #complex(R:Float, I:Float) => #complex(R, I)
  rule - V:Val => 0 -Int intValue(V) requires isIntLike(V)
  rule - F:Float => --Float F
  rule - #complex(R:Float, I:Float) => #complex(0.0 -Float R, 0.0 -Float I)
  rule ~ V:Val => ~Int intValue(V) requires isIntLike(V)

  rule V1:Val + V2:Val => intValue(V1) +Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float + F2:Float => F1 +Float F2
  rule #complex(R1:Float, I1:Float) + #complex(R2:Float, I2:Float) =>
    #complex(R1 +Float R2, I1 +Float I2)
  rule #complex(R:Float, I:Float) + V:Val => #complex(R +Float floatValue(V), I)
    requires isIntLike(V)
  rule V:Val + #complex(R:Float, I:Float) => #complex(floatValue(V) +Float R, I)
    requires isIntLike(V)
  rule #complex(R:Float, I:Float) + F:Float => #complex(R +Float F, I)
  rule F:Float + #complex(R:Float, I:Float) => #complex(F +Float R, I)
  rule F:Float + V:Val => F +Float floatValue(V)
    requires isIntLike(V)
  rule V:Val + F:Float => floatValue(V) +Float F
    requires isIntLike(V)
  rule V1:Val - V2:Val => intValue(V1) -Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float - F2:Float => F1 -Float F2
  rule #complex(R1:Float, I1:Float) - #complex(R2:Float, I2:Float) =>
    #complex(R1 -Float R2, I1 -Float I2)
  rule #complex(R:Float, I:Float) - V:Val => #complex(R -Float floatValue(V), I)
    requires isIntLike(V)
  rule V:Val - #complex(R:Float, I:Float) => #complex(floatValue(V) -Float R, 0.0 -Float I)
    requires isIntLike(V)
  rule #complex(R:Float, I:Float) - F:Float => #complex(R -Float F, I)
  rule F:Float - #complex(R:Float, I:Float) => #complex(F -Float R, 0.0 -Float I)
  rule F:Float - V:Val => F -Float floatValue(V)
    requires isIntLike(V)
  rule V:Val - F:Float => floatValue(V) -Float F
    requires isIntLike(V)
  rule V1:Val - V2:Val => setLikeDifferenceValue(V1, V2)
    requires isSetFamilyVal(V1) andBool isSetFamilyVal(V2)
  rule <k> V1:Val - V2:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires (isSetFamilyVal(V1) andBool notBool isSetFamilyVal(V2))
      orBool (notBool isSetFamilyVal(V1) andBool isSetFamilyVal(V2))
  rule V1:Val * V2:Val => intValue(V1) *Int intValue(V2)
    requires isIntLike(V1) andBool isIntLike(V2)
  rule F1:Float * F2:Float => F1 *Float F2
  rule #complex(R1:Float, I1:Float) * #complex(R2:Float, I2:Float) =>
    #complex((R1 *Float R2) -Float (I1 *Float I2), (R1 *Float I2) +Float (I1 *Float R2))
  rule #complex(R:Float, I:Float) * V:Val => #complex(R *Float floatValue(V), I *Float floatValue(V))
    requires isIntLike(V)
  rule V:Val * #complex(R:Float, I:Float) => #complex(floatValue(V) *Float R, floatValue(V) *Float I)
    requires isIntLike(V)
  rule #complex(R:Float, I:Float) * F:Float => #complex(R *Float F, I *Float F)
  rule F:Float * #complex(R:Float, I:Float) => #complex(F *Float R, F *Float I)
  rule F:Float * V:Val => F *Float floatValue(V)
    requires isIntLike(V)
  rule V:Val * F:Float => floatValue(V) *Float F
    requires isIntLike(V)
  rule S:String * V:Val => repeatString(S, intValue(V))
    requires isIntLike(V)
  rule V:Val * S:String => repeatString(S, intValue(V))
    requires isIntLike(V)
  rule [] * V:Val => []
    requires isIntLike(V)
  rule V:Val * [] => []
    requires isIntLike(V)
  rule listVal(_:ValItems) * V:Val => []
    requires isIntLike(V) andBool intValue(V) <=Int 0
  rule V:Val * listVal(_:ValItems) => []
    requires isIntLike(V) andBool intValue(V) <=Int 0
  rule listVal(VS:ValItems) * V:Val => listVal(repeatValItems(VS, intValue(V)))
    requires isIntLike(V) andBool intValue(V) >Int 0
  rule V:Val * listVal(VS:ValItems) => listVal(repeatValItems(VS, intValue(V)))
    requires isIntLike(V) andBool intValue(V) >Int 0
  rule () * V:Val => ()
    requires isIntLike(V)
  rule V:Val * () => ()
    requires isIntLike(V)
  rule tupleVal(_:ValItems) * V:Val => ()
    requires isIntLike(V) andBool intValue(V) <=Int 0
  rule V:Val * tupleVal(_:ValItems) => ()
    requires isIntLike(V) andBool intValue(V) <=Int 0
  rule tupleVal(VS:ValItems) * V:Val => tupleVal(repeatValItems(VS, intValue(V)))
    requires isIntLike(V) andBool intValue(V) >Int 0
  rule V:Val * tupleVal(VS:ValItems) => tupleVal(repeatValItems(VS, intValue(V)))
    requires isIntLike(V) andBool intValue(V) >Int 0
  rule <k> _S:String * V:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool isIntLike(V)
  rule <k> V:Val * _S:String =>
