  rule <k> [] * V:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool isIntLike(V)
  rule <k> listVal(_:ValItems) * V:Val =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool isIntLike(V)
  rule <k> V:Val * [] =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool isIntLike(V)
      andBool notBool isConcreteSequenceVal(V)
  rule <k> V:Val * listVal(_:ValItems) =>
