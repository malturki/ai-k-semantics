  rule byteUpper(V:Val) => intValue(V) >=Int 65 andBool intValue(V) <=Int 90
  rule byteAlpha(V:Val) => byteLower(V) orBool byteUpper(V)
  rule byteAlnum(V:Val) => byteAlpha(V) orBool byteDigit(V)
  rule byteSign(V:Val) => intValue(V) ==Int 43 orBool intValue(V) ==Int 45
  rule byteSpace(V:Val) =>
    intValue(V) ==Int 32
      orBool intValue(V) ==Int 9
      orBool intValue(V) ==Int 10
      orBool intValue(V) ==Int 11
      orBool intValue(V) ==Int 12
      orBool intValue(V) ==Int 13
  rule bytearrayFindSpace(valItemsLast(V:Val), I:Int) => I
    requires byteSpace(V)
  rule bytearrayFindSpace(valItemsLast(V:Val), _I:Int) => -1
    requires notBool byteSpace(V)
  rule bytearrayFindSpace(valItemsCons(V:Val, _VS:ValItems), I:Int) => I
    requires byteSpace(V)
  rule bytearrayFindSpace(valItemsCons(V:Val, VS:ValItems), I:Int) =>
    bytearrayFindSpace(VS, I +Int 1)
    requires notBool byteSpace(V)
  rule bytearrayRFindSpace(valItemsLast(V:Val), I:Int, _Best:Int) => I
    requires byteSpace(V)
  rule bytearrayRFindSpace(valItemsLast(V:Val), _I:Int, Best:Int) => Best
    requires notBool byteSpace(V)
  rule bytearrayRFindSpace(valItemsCons(V:Val, VS:ValItems), I:Int, _Best:Int) =>
    bytearrayRFindSpace(VS, I +Int 1, I)
    requires byteSpace(V)
  rule bytearrayRFindSpace(valItemsCons(V:Val, VS:ValItems), I:Int, Best:Int) =>
    bytearrayRFindSpace(VS, I +Int 1, Best)
    requires notBool byteSpace(V)

  rule bytesAllAscii(valItemsLast(V:Val)) => byteAscii(V)
  rule bytesAllAscii(valItemsCons(V:Val, VS:ValItems)) => byteAscii(V) andBool bytesAllAscii(VS)
  rule bytesAllDigit(valItemsLast(V:Val)) => byteDigit(V)
  rule bytesAllDigit(valItemsCons(V:Val, VS:ValItems)) => byteDigit(V) andBool bytesAllDigit(VS)
  rule bytesAllAlpha(valItemsLast(V:Val)) => byteAlpha(V)
  rule bytesAllAlpha(valItemsCons(V:Val, VS:ValItems)) => byteAlpha(V) andBool bytesAllAlpha(VS)
  rule bytesAllAlnum(valItemsLast(V:Val)) => byteAlnum(V)
  rule bytesAllAlnum(valItemsCons(V:Val, VS:ValItems)) => byteAlnum(V) andBool bytesAllAlnum(VS)
  rule bytesAllSpace(valItemsLast(V:Val)) => byteSpace(V)
  rule bytesAllSpace(valItemsCons(V:Val, VS:ValItems)) => byteSpace(V) andBool bytesAllSpace(VS)
  rule bytesHasLower(valItemsLast(V:Val)) => byteLower(V)
  rule bytesHasLower(valItemsCons(V:Val, VS:ValItems)) => byteLower(V) orBool bytesHasLower(VS)
  rule bytesHasUpper(valItemsLast(V:Val)) => byteUpper(V)
  rule bytesHasUpper(valItemsCons(V:Val, VS:ValItems)) => byteUpper(V) orBool bytesHasUpper(VS)

  rule bytesTitleOk(VS:ValItems) =>
    bytesTitlePatternOk(VS, false) andBool (bytesHasLower(VS) orBool bytesHasUpper(VS))
  rule bytesTitlePatternOk(valItemsLast(V:Val), PrevCased:Bool) => true
    requires byteUpper(V) andBool notBool PrevCased
  rule bytesTitlePatternOk(valItemsLast(V:Val), PrevCased:Bool) => true
    requires byteLower(V) andBool PrevCased
  rule bytesTitlePatternOk(valItemsLast(V:Val), _PrevCased:Bool) => true
    requires notBool byteAlpha(V)
  rule bytesTitlePatternOk(valItemsLast(V:Val), PrevCased:Bool) => false
    requires (byteUpper(V) andBool PrevCased) orBool (byteLower(V) andBool notBool PrevCased)
  rule bytesTitlePatternOk(valItemsCons(V:Val, VS:ValItems), PrevCased:Bool) =>
    bytesTitlePatternOk(VS, true)
    requires byteUpper(V) andBool notBool PrevCased
  rule bytesTitlePatternOk(valItemsCons(V:Val, VS:ValItems), PrevCased:Bool) =>
    bytesTitlePatternOk(VS, true)
    requires byteLower(V) andBool PrevCased
  rule bytesTitlePatternOk(valItemsCons(V:Val, VS:ValItems), _PrevCased:Bool) =>
    bytesTitlePatternOk(VS, false)
    requires notBool byteAlpha(V)
  rule bytesTitlePatternOk(valItemsCons(V:Val, _VS:ValItems), PrevCased:Bool) => false
    requires (byteUpper(V) andBool PrevCased) orBool (byteLower(V) andBool notBool PrevCased)

  rule byteToLower(V:Val) => intValue(V) +Int 32 requires byteUpper(V)
  rule byteToLower(V:Val) => intValue(V) requires notBool byteUpper(V)
  rule byteToUpper(V:Val) => intValue(V) -Int 32 requires byteLower(V)
  rule byteToUpper(V:Val) => intValue(V) requires notBool byteLower(V)
  rule byteSwapCase(V:Val) => byteToUpper(V) requires byteLower(V)
  rule byteSwapCase(V:Val) => byteToLower(V) requires byteUpper(V)
  rule byteSwapCase(V:Val) => intValue(V) requires notBool byteAlpha(V)

  rule bytesLowerItems(valItemsLast(V:Val)) => valItemsLast(byteToLower(V))
  rule bytesLowerItems(valItemsCons(V:Val, VS:ValItems)) =>
    valItemsCons(byteToLower(V), bytesLowerItems(VS))
  rule bytesUpperItems(valItemsLast(V:Val)) => valItemsLast(byteToUpper(V))
  rule bytesUpperItems(valItemsCons(V:Val, VS:ValItems)) =>
    valItemsCons(byteToUpper(V), bytesUpperItems(VS))
  rule bytesSwapcaseItems(valItemsLast(V:Val)) => valItemsLast(byteSwapCase(V))
  rule bytesSwapcaseItems(valItemsCons(V:Val, VS:ValItems)) =>
    valItemsCons(byteSwapCase(V), bytesSwapcaseItems(VS))
  rule bytesCapitalizeItems(valItemsLast(V:Val)) => valItemsLast(byteToUpper(V))
  rule bytesCapitalizeItems(valItemsCons(V:Val, VS:ValItems)) =>
    valItemsCons(byteToUpper(V), bytesLowerItems(VS))
  rule bytesTitleItems(valItemsLast(V:Val), PrevCased:Bool) => valItemsLast(byteToUpper(V))
    requires byteAlpha(V) andBool notBool PrevCased
  rule bytesTitleItems(valItemsLast(V:Val), PrevCased:Bool) => valItemsLast(byteToLower(V))
    requires byteAlpha(V) andBool PrevCased
  rule bytesTitleItems(valItemsLast(V:Val), _PrevCased:Bool) => valItemsLast(intValue(V))
    requires notBool byteAlpha(V)
  rule bytesTitleItems(valItemsCons(V:Val, VS:ValItems), PrevCased:Bool) =>
    valItemsCons(byteToUpper(V), bytesTitleItems(VS, true))
    requires byteAlpha(V) andBool notBool PrevCased
  rule bytesTitleItems(valItemsCons(V:Val, VS:ValItems), PrevCased:Bool) =>
    valItemsCons(byteToLower(V), bytesTitleItems(VS, true))
    requires byteAlpha(V) andBool PrevCased
  rule bytesTitleItems(valItemsCons(V:Val, VS:ValItems), _PrevCased:Bool) =>
    valItemsCons(intValue(V), bytesTitleItems(VS, false))
    requires notBool byteAlpha(V)

  rule sortedIterableSupported([]) => true
  rule sortedIterableSupported(listVal(_:ValItems)) => true
  rule sortedIterableSupported(()) => true
  rule sortedIterableSupported(tupleVal(_:ValItems)) => true
  rule sortedIterableSupported(_:String) => true
  rule sortedIterableSupported(#bytes()) => true
  rule sortedIterableSupported(bytesVal(_:ValItems)) => true
  rule sortedIterableSupported(#bytearray()) => true
  rule sortedIterableSupported(bytearrayVal(_:ValItems)) => true
  rule sortedIterableSupported(#memoryviewVal(V:Val)) => sortedIterableSupported(V)
  rule sortedIterableSupported({}) => true
  rule sortedIterableSupported(dictVal(_:DictItems)) => true
  rule sortedIterableSupported(set()) => true
  rule sortedIterableSupported(setVal(_:ValItems)) => true
  rule sortedIterableSupported(frozenset()) => true
  rule sortedIterableSupported(frozensetVal(_:ValItems)) => true
  rule sortedIterableSupported(rangeVal(_:Int, _:Int)) => true
  rule sortedIterableSupported(rangeVal(_:Int, _:Int, _:Int)) => true
  rule sortedIterableSupported(_:Val) => false [owise]

  rule bytesEncodingUtf8("utf-8") => true
  rule bytesEncodingUtf8("utf8") => true
  rule bytesEncodingUtf8("UTF-8") => true
  rule bytesEncodingUtf8("UTF8") => true
  rule bytesEncodingUtf8(_:String) => false [owise]

  rule bytesEncodingAscii("ascii") => true
  rule bytesEncodingAscii("ASCII") => true
  rule bytesEncodingAscii(_:String) => false [owise]

  rule bytesEncodingLatin1("latin-1") => true
  rule bytesEncodingLatin1("latin_1") => true
  rule bytesEncodingLatin1("iso-8859-1") => true
  rule bytesEncodingLatin1("LATIN-1") => true
  rule bytesEncodingLatin1("LATIN_1") => true
  rule bytesEncodingLatin1("ISO-8859-1") => true
  rule bytesEncodingLatin1(_:String) => false [owise]

  rule bytesEncodingSupported(Enc:String) =>
    bytesEncodingUtf8(Enc) orBool bytesEncodingAscii(Enc) orBool bytesEncodingLatin1(Enc)

  rule bytesErrorsStrict("strict") => true
  rule bytesErrorsStrict(_:String) => false [owise]

  rule bytesErrorsIgnore("ignore") => true
  rule bytesErrorsIgnore(_:String) => false [owise]

  rule bytesErrorsReplace("replace") => true
  rule bytesErrorsReplace(_:String) => false [owise]

  rule bytesErrorsBackslashReplace("backslashreplace") => true
  rule bytesErrorsBackslashReplace(_:String) => false [owise]

  rule bytesErrorsXmlCharRefReplace("xmlcharrefreplace") => true
  rule bytesErrorsXmlCharRefReplace(_:String) => false [owise]

  rule bytesErrorsUnicodeRaise("strict") => true
  rule bytesErrorsUnicodeRaise("surrogateescape") => true
  rule bytesErrorsUnicodeRaise("surrogatepass") => true
  rule bytesErrorsUnicodeRaise(_:String) => false [owise]

  rule bytesErrorsKnown("strict") => true
  rule bytesErrorsKnown("ignore") => true
  rule bytesErrorsKnown("replace") => true
  rule bytesErrorsKnown("backslashreplace") => true
  rule bytesErrorsKnown("surrogateescape") => true
  rule bytesErrorsKnown("xmlcharrefreplace") => true
  rule bytesErrorsKnown("namereplace") => true
  rule bytesErrorsKnown("surrogatepass") => true
  rule bytesErrorsKnown(_:String) => false [owise]

  rule stringAsciiEncodable(S:String, I:Int) => true
    requires I >=Int lengthString(S)
  rule stringAsciiEncodable(S:String, I:Int) => stringAsciiEncodable(S, I +Int stringCodePointByteLenAt(S, I))
    requires I <Int lengthString(S) andBool stringCodePointAt(S, I) <Int 128
  rule stringAsciiEncodable(S:String, I:Int) => false
    requires I <Int lengthString(S) andBool stringCodePointAt(S, I) >=Int 128

  rule stringLatin1Encodable(S:String, I:Int) => true
    requires I >=Int lengthString(S)
  rule stringLatin1Encodable(S:String, I:Int) => stringLatin1Encodable(S, I +Int stringCodePointByteLenAt(S, I))
    requires I <Int lengthString(S) andBool stringCodePointAt(S, I) <=Int 255
  rule stringLatin1Encodable(S:String, I:Int) => false
    requires I <Int lengthString(S) andBool stringCodePointAt(S, I) >Int 255

  rule concreteIterableExtraItems(S:String) => stringToValItems(S, 0, lengthString(S))
    requires lengthString(S) >Int 0
  rule concreteIterableExtraItems(bytesVal(VS:ValItems)) => VS
  rule concreteIterableExtraItems(bytearrayVal(VS:ValItems)) => VS
  rule concreteIterableExtraItems(#memoryviewVal(V:Val)) => concreteIterableExtraItems(V)
  rule concreteIterableExtraItems(dictVal(DS:DictItems)) => dictKeysToValItems(DS)
  rule concreteIterableExtraItems(setVal(VS:ValItems)) => VS
  rule concreteIterableExtraItems(frozensetVal(VS:ValItems)) => VS
  rule concreteIterableExtraItems(#enumerateVal(VS:ArgVals)) => argValsToValItems(VS)
    requires notBool emptyArgVals(VS)
  rule concreteIterableExtraItems(#zipVal(VS:ArgVals)) => argValsToValItems(VS)
    requires notBool emptyArgVals(VS)
  rule concreteIterableExtraItems(#reversedVal(VS:ArgVals)) => argValsToValItems(VS)
    requires notBool emptyArgVals(VS)
  rule concreteIterableExtraItems(rangeVal(Start:Int, Stop:Int)) =>
    rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1))
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule concreteIterableExtraItems(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step))
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule sliceStepAssignRhsSupported(listVal(_:ValItems)) => true
  rule sliceStepAssignRhsSupported(tupleVal(_:ValItems)) => true
  rule sliceStepAssignRhsSupported([]) => true
  rule sliceStepAssignRhsSupported(()) => true
  rule sliceStepAssignRhsSupported(RHS:Val) =>
    concreteIterableExtraNonEmpty(RHS) orBool concreteIterableExtraEmpty(RHS)
    [owise]

  rule sliceStepAssignRhsLen(listVal(VS:ValItems)) => valItemsLen(VS)
  rule sliceStepAssignRhsLen(tupleVal(VS:ValItems)) => valItemsLen(VS)
  rule sliceStepAssignRhsLen([]) => 0
  rule sliceStepAssignRhsLen(()) => 0
  rule sliceStepAssignRhsLen(RHS:Val) => valItemsLen(concreteIterableExtraItems(RHS))
    requires concreteIterableExtraNonEmpty(RHS)
  rule sliceStepAssignRhsLen(RHS:Val) => 0
    requires concreteIterableExtraEmpty(RHS)

  rule unpackValueSupported(listVal(_:ValItems)) => true
  rule unpackValueSupported([]) => true
  rule unpackValueSupported(tupleVal(_:ValItems)) => true
  rule unpackValueSupported(()) => true
  rule unpackValueSupported(bytesVal(_:ValItems)) => true
  rule unpackValueSupported(#bytes()) => true
  rule unpackValueSupported(bytearrayVal(_:ValItems)) => true
  rule unpackValueSupported(#bytearray()) => true
  rule unpackValueSupported(#memoryviewVal(V:Val)) => unpackValueSupported(V)
  rule unpackValueSupported(_:String) => true
  rule unpackValueSupported(dictVal(_:DictItems)) => true
  rule unpackValueSupported(({}):Val) => true
  rule unpackValueSupported(setVal(_:ValItems)) => true
  rule unpackValueSupported(set()) => true
  rule unpackValueSupported(frozensetVal(_:ValItems)) => true
  rule unpackValueSupported(frozenset()) => true
  rule unpackValueSupported(rangeVal(_:Int, _:Int)) => true
  rule unpackValueSupported(rangeVal(_:Int, _:Int, Step:Int)) => true
    requires Step =/=Int 0
  rule unpackValueSupported(_:Val) => false [owise]

  rule unpackValueLen(listVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen([]) => 0
  rule unpackValueLen(tupleVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen(()) => 0
  rule unpackValueLen(bytesVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen(#bytes()) => 0
  rule unpackValueLen(bytearrayVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen(#bytearray()) => 0
  rule unpackValueLen(#memoryviewVal(V:Val)) => unpackValueLen(V)
  rule unpackValueLen(S:String) => stringCodePointLen(S, 0)
  rule unpackValueLen(dictVal(DS:DictItems)) => valItemsLen(dictKeysToValItems(DS))
  rule unpackValueLen(({}):Val) => 0
  rule unpackValueLen(setVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen(set()) => 0
  rule unpackValueLen(frozensetVal(VS:ValItems)) => valItemsLen(VS)
  rule unpackValueLen(frozenset()) => 0
  rule unpackValueLen(rangeVal(Start:Int, Stop:Int)) => pyRangeLen(Start, Stop, 1)
  rule unpackValueLen(rangeVal(Start:Int, Stop:Int, Step:Int)) => pyRangeLen(Start, Stop, Step)
    requires Step =/=Int 0

  rule stringToValItems(S:String, I:Int, Len:Int) =>
    valItemsLast(substrString(S, I, I +Int stringCodePointByteLenAt(S, I)))
    requires I +Int stringCodePointByteLenAt(S, I) >=Int Len
  rule stringToValItems(S:String, I:Int, Len:Int) =>
    valItemsCons(
      substrString(S, I, I +Int stringCodePointByteLenAt(S, I)),
      stringToValItems(S, I +Int stringCodePointByteLenAt(S, I), Len))
    requires I +Int stringCodePointByteLenAt(S, I) <Int Len

  rule stringBytesToValItems(S:String, I:Int, Len:Int) =>
    valItemsLast(stringByte(S, I))
    requires I +Int 1 >=Int Len
  rule stringBytesToValItems(S:String, I:Int, Len:Int) =>
    valItemsCons(stringByte(S, I), stringBytesToValItems(S, I +Int 1, Len))
    requires I +Int 1 <Int Len

  rule stringLatin1BytesToValItems(S:String, I:Int, Len:Int) =>
    valItemsLast(stringCodePointAt(S, I))
    requires I +Int stringCodePointByteLenAt(S, I) >=Int Len
  rule stringLatin1BytesToValItems(S:String, I:Int, Len:Int) =>
    valItemsCons(
      stringCodePointAt(S, I),
      stringLatin1BytesToValItems(S, I +Int stringCodePointByteLenAt(S, I), Len))
    requires I +Int stringCodePointByteLenAt(S, I) <Int Len

  rule dictKeysToValItems(dictItemsLast(K:Val, _:Val)) => valItemsLast(K)
  rule dictKeysToValItems(dictItemsCons(K:Val, _:Val, DS:DictItems)) =>
    valItemsCons(K, dictKeysToValItems(DS))

  rule rangeToValItems(Start:Int, Stop:Int, Step:Int, I:Int, Len:Int) =>
    valItemsLast(rangeGet(Start, Stop, Step, I))
    requires Step =/=Int 0 andBool I +Int 1 >=Int Len
  rule rangeToValItems(Start:Int, Stop:Int, Step:Int, I:Int, Len:Int) =>
    valItemsCons(rangeGet(Start, Stop, Step, I), rangeToValItems(Start, Stop, Step, I +Int 1, Len))
    requires Step =/=Int 0 andBool I +Int 1 <Int Len

  rule allValItems(valItemsLast(V:Val)) => truthy(V)
  rule allValItems(valItemsCons(V:Val, VS:ValItems)) => truthy(V) andBool allValItems(VS)
  rule anyValItems(valItemsLast(V:Val)) => truthy(V)
  rule anyValItems(valItemsCons(V:Val, VS:ValItems)) => truthy(V) orBool anyValItems(VS)
  rule numericComparableVal(_:Float) => true
  rule numericComparableVal(V:Val) => isIntLike(V) [owise]
  rule valItemsAllIntLike(valItemsLast(V:Val)) => isIntLike(V)
  rule valItemsAllIntLike(valItemsCons(V:Val, VS:ValItems)) =>
    isIntLike(V) andBool valItemsAllIntLike(VS)
  rule valItemsAllNumericComparable(valItemsLast(V:Val)) => numericComparableVal(V)
  rule valItemsAllNumericComparable(valItemsCons(V:Val, VS:ValItems)) =>
    numericComparableVal(V) andBool valItemsAllNumericComparable(VS)
  rule valItemsAllByteInts(valItemsLast(V:Val)) =>
    isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule valItemsAllByteInts(valItemsCons(V:Val, VS:ValItems)) =>
    isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool valItemsAllByteInts(VS)

  rule byteItems(valItemsLast(V:Val)) => valItemsLast(intValue(V))
    requires isIntLike(V)
  rule byteItems(valItemsCons(V:Val, VS:ValItems)) =>
    valItemsCons(intValue(V), byteItems(VS))
    requires isIntLike(V)

  rule rangeAllTruthy(Start:Int, Stop:Int, Step:Int) => notBool rangeContains(0, Start, Stop, Step)
    requires Step =/=Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => false
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => false
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 1
      andBool rangeGet(Start, Stop, Step, 0) ==Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => true
    requires Step =/=Int 0
      andBool pyRangeLen(Start, Stop, Step) ==Int 1
      andBool rangeGet(Start, Stop, Step, 0) =/=Int 0
  rule rangeAnyTruthy(Start:Int, Stop:Int, Step:Int) => true
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 1
  rule sumValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule sumValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V) +Int sumValItems(VS)
    requires isIntLike(V) andBool valItemsAllIntLike(VS)
  rule rangeSum(Start:Int, Stop:Int, Step:Int) =>
    (pyRangeLen(Start, Stop, Step) *Int ((2 *Int Start) +Int ((pyRangeLen(Start, Stop, Step) -Int 1) *Int Step))) /Int 2
    requires Step =/=Int 0
  rule minValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule minValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) <=Int minValItems(VS)
  rule minValItems(valItemsCons(V:Val, VS:ValItems)) => minValItems(VS)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) >Int minValItems(VS)
  rule maxValItems(valItemsLast(V:Val)) => intValue(V)
    requires isIntLike(V)
  rule maxValItems(valItemsCons(V:Val, VS:ValItems)) => intValue(V)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) >=Int maxValItems(VS)
  rule maxValItems(valItemsCons(V:Val, VS:ValItems)) => maxValItems(VS)
    requires isIntLike(V)
      andBool valItemsAllIntLike(VS)
      andBool intValue(V) <Int maxValItems(VS)
  rule minNumericItems(valItemsLast(V:Val)) => V
    requires numericComparableVal(V)
  rule minNumericItems(valItemsCons(V:Val, VS:ValItems)) => V
    requires numericComparableVal(V)
      andBool valItemsAllNumericComparable(VS)
      andBool cmpHolds(#le, V, minNumericItems(VS))
  rule minNumericItems(valItemsCons(V:Val, VS:ValItems)) => minNumericItems(VS)
    requires numericComparableVal(V)
      andBool valItemsAllNumericComparable(VS)
      andBool cmpHolds(#gt, V, minNumericItems(VS))
  rule maxNumericItems(valItemsLast(V:Val)) => V
    requires numericComparableVal(V)
  rule maxNumericItems(valItemsCons(V:Val, VS:ValItems)) => V
    requires numericComparableVal(V)
      andBool valItemsAllNumericComparable(VS)
      andBool cmpHolds(#ge, V, maxNumericItems(VS))
  rule maxNumericItems(valItemsCons(V:Val, VS:ValItems)) => maxNumericItems(VS)
    requires numericComparableVal(V)
      andBool valItemsAllNumericComparable(VS)
      andBool cmpHolds(#lt, V, maxNumericItems(VS))
  rule minStringItems(valItemsLast(S:String)) => S
  rule minStringItems(valItemsCons(S:String, VS:ValItems)) => S
    requires S <=String minStringItems(VS)
  rule minStringItems(valItemsCons(S:String, VS:ValItems)) => minStringItems(VS)
    requires S >String minStringItems(VS)
  rule maxStringItems(valItemsLast(S:String)) => S
  rule maxStringItems(valItemsCons(S:String, VS:ValItems)) => S
    requires S >=String maxStringItems(VS)
  rule maxStringItems(valItemsCons(S:String, VS:ValItems)) => maxStringItems(VS)
    requires S <String maxStringItems(VS)
  rule minArgVals(argValsCons(V:Val, #noArgVals)) => intValue(V)
    requires isIntLike(V)
  rule minArgVals(argValsCons(V:Val, VS:ArgVals)) => intValue(V)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) <=Int minArgVals(VS)
  rule minArgVals(argValsCons(V:Val, VS:ArgVals)) => minArgVals(VS)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) >Int minArgVals(VS)
  rule maxArgVals(argValsCons(V:Val, #noArgVals)) => intValue(V)
    requires isIntLike(V)
  rule maxArgVals(argValsCons(V:Val, VS:ArgVals)) => intValue(V)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) >=Int maxArgVals(VS)
  rule maxArgVals(argValsCons(V:Val, VS:ArgVals)) => maxArgVals(VS)
    requires notBool emptyArgVals(VS)
      andBool isIntLike(V)
      andBool intValue(V) <Int maxArgVals(VS)
  rule rangeMin(Start:Int, Stop:Int, Step:Int) => Start
    requires Step >Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMin(Start:Int, Stop:Int, Step:Int) =>
    rangeGet(Start, Stop, Step, pyRangeLen(Start, Stop, Step) -Int 1)
    requires Step <Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMax(Start:Int, Stop:Int, Step:Int) =>
    rangeGet(Start, Stop, Step, pyRangeLen(Start, Stop, Step) -Int 1)
    requires Step >Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0
  rule rangeMax(Start:Int, Stop:Int, Step:Int) => Start
    requires Step <Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule concatValItems(valItemsLast(V:Val), VS:ValItems) => valItemsCons(V, VS)
  rule concatValItems(valItemsCons(V:Val, VS1:ValItems), VS2:ValItems) =>
    valItemsCons(V, concatValItems(VS1, VS2))

  rule repeatString(_:String, N:Int) => "" requires N <=Int 0
  rule repeatString(S:String, 1) => S
  rule repeatString(S:String, N:Int) => S +String repeatString(S, N -Int 1)
    requires N >Int 1

  rule bytesAsciiString(valItemsLast(V:Val)) => chrChar(intValue(V))
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule bytesAsciiString(valItemsCons(V:Val, VS:ValItems)) =>
    chrChar(intValue(V)) +String bytesAsciiString(VS)
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool valItemsAllByteInts(VS)

  rule repeatValItems(VS:ValItems, 1) => VS
  rule repeatValItems(VS:ValItems, N:Int) => concatValItems(VS, repeatValItems(VS, N -Int 1))
    requires N >Int 1
  rule reverseValItems(valItemsLast(V:Val)) => valItemsLast(V)
  rule reverseValItems(valItemsCons(V:Val, VS:ValItems)) =>
    concatValItems(reverseValItems(VS), valItemsLast(V))

  rule bytesRepeat(_:ValItems, N:Int) => #bytes() requires N <=Int 0
  rule bytesRepeat(VS:ValItems, 1) => bytesVal(VS)
  rule bytesRepeat(VS:ValItems, N:Int) => bytesVal(repeatValItems(VS, N))
    requires N >Int 1

  rule dropValItems(VS:ValItems, 0) => VS
  rule dropValItems(valItemsCons(_:Val, VS:ValItems), N:Int) => dropValItems(VS, N -Int 1)
    requires N >Int 0

  rule sliceString(_:String, Start:Int, Stop:Int) => "" requires Start >=Int Stop
  rule sliceString(S:String, Start:Int, Stop:Int) =>
    substrString(
      S,
      stringCodePointPrefixByteLen(S, Start, 0),
      stringCodePointPrefixByteLen(S, Stop, 0))
    requires Start <Int Stop

  rule sliceStepString(_:String, Start:Int, Stop:Int, Step:Int) => ""
    requires Start >=Int Stop andBool Step >Int 0
  rule sliceStepString(S:String, Start:Int, Stop:Int, Step:Int) =>
    substrString(
      S,
      stringCodePointPrefixByteLen(S, Start, 0),
      stringCodePointPrefixByteLen(S, Start +Int 1, 0))
      +String sliceStepString(S, Start +Int Step, Stop, Step)
    requires Start <Int Stop andBool Step >Int 0
  rule sliceStepString(_:String, Start:Int, Stop:Int, Step:Int) => ""
    requires Start <=Int Stop andBool Step <Int 0
  rule sliceStepString(S:String, Start:Int, Stop:Int, Step:Int) =>
    substrString(
      S,
      stringCodePointPrefixByteLen(S, Start, 0),
      stringCodePointPrefixByteLen(S, Start +Int 1, 0))
      +String sliceStepString(S, Start +Int Step, Stop, Step)
    requires Start >Int Stop andBool Step <Int 0

  rule listSlice(_:ValItems, Start:Int, Stop:Int) => [] requires Start >=Int Stop
  rule listSlice(VS:ValItems, Start:Int, Stop:Int) => listVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule tupleSlice(_:ValItems, Start:Int, Stop:Int) => () requires Start >=Int Stop
  rule tupleSlice(VS:ValItems, Start:Int, Stop:Int) => tupleVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule bytesSlice(_:ValItems, Start:Int, Stop:Int) => #bytes() requires Start >=Int Stop
  rule bytesSlice(VS:ValItems, Start:Int, Stop:Int) => bytesVal(sliceValItems(VS, Start, Stop))
    requires Start <Int Stop

  rule listSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => []
    requires Start >=Int Stop andBool Step >Int 0
  rule listSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule listSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => []
    requires Start <=Int Stop andBool Step <Int 0
  rule listSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    listVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule tupleSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => ()
    requires Start >=Int Stop andBool Step >Int 0
  rule tupleSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    tupleVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule tupleSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => ()
    requires Start <=Int Stop andBool Step <Int 0
  rule tupleSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    tupleVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule bytesSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => #bytes()
    requires Start >=Int Stop andBool Step >Int 0
  rule bytesSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    bytesVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start <Int Stop andBool Step >Int 0
  rule bytesSliceStep(_:ValItems, Start:Int, Stop:Int, Step:Int) => #bytes()
    requires Start <=Int Stop andBool Step <Int 0
  rule bytesSliceStep(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    bytesVal(sliceStepValItems(VS, Start, Stop, Step))
    requires Start >Int Stop andBool Step <Int 0

  rule sliceValItems(valItemsLast(V:Val), 0, Stop:Int) => valItemsLast(V)
    requires Stop >Int 0
  rule sliceValItems(valItemsCons(V:Val, _:ValItems), 0, 1) => valItemsLast(V)
  rule sliceValItems(valItemsCons(V:Val, VS:ValItems), 0, Stop:Int) =>
    valItemsCons(V, sliceValItems(VS, 0, Stop -Int 1))
    requires Stop >Int 1
  rule sliceValItems(valItemsCons(_:Val, VS:ValItems), Start:Int, Stop:Int) =>
    sliceValItems(VS, Start -Int 1, Stop -Int 1)
    requires Start >Int 0

  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsLast(listGet(VS, Start))
    requires Start <Int Stop andBool Start +Int Step >=Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsCons(listGet(VS, Start), sliceStepValItems(VS, Start +Int Step, Stop, Step))
    requires Start <Int Stop andBool Start +Int Step <Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsLast(listGet(VS, Start))
    requires Start >Int Stop andBool Start +Int Step <=Int Stop
  rule sliceStepValItems(VS:ValItems, Start:Int, Stop:Int, Step:Int) =>
    valItemsCons(listGet(VS, Start), sliceStepValItems(VS, Start +Int Step, Stop, Step))
    requires Start >Int Stop andBool Start +Int Step >Int Stop

  rule dictValsToDictItems(dictValsCons(K:Val, V:Val, #noDictVals)) => dictItemsLast(K, V)
  rule dictValsToDictItems(dictValsCons(K:Val, V:Val, DVS:DictVals)) =>
    dictItemsCons(K, V, dictValsToDictItems(DVS))
    requires notBool emptyDictVals(DVS)

  rule valsEq(valItemsLast(V1:Val), valItemsLast(V2:Val)) => valEq(V1, V2)
  rule valsEq(valItemsCons(V1:Val, VS1:ValItems), valItemsCons(V2:Val, VS2:ValItems)) =>
    valEq(V1, V2) andBool valsEq(VS1, VS2)
  rule valsEq(valItemsLast(_:Val), valItemsCons(_:Val, _:ValItems)) => false
  rule valsEq(valItemsCons(_:Val, _:ValItems), valItemsLast(_:Val)) => false

  rule valItemsLt(valItemsLast(V1:Val), valItemsLast(V2:Val)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsLast(V2:Val)) => false
    requires valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsCons(V2:Val, _:ValItems)) => true
    requires valEq(V1, V2)
  rule valItemsLt(valItemsLast(V1:Val), valItemsCons(V2:Val, _:ValItems)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsLast(V2:Val)) => false
    requires valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsLast(V2:Val)) => cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, VS1:ValItems), valItemsCons(V2:Val, VS2:ValItems)) =>
    valItemsLt(VS1, VS2)
    requires valEq(V1, V2)
  rule valItemsLt(valItemsCons(V1:Val, _:ValItems), valItemsCons(V2:Val, _:ValItems)) =>
    cmpHolds(#lt, V1, V2)
    requires notBool valEq(V1, V2)

  rule isListSequence([]) => true
  rule isListSequence(listVal(_:ValItems)) => true
  rule isListSequence(()) => false
  rule isListSequence(tupleVal(_:ValItems)) => false
