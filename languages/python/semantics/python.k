    requires bytesUtf8Start4(B1, B2, B3, B4)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsCons(B3:Val, valItemsCons(B4:Val, Rest:ValItems))))) =>
    unicodeChar(((intValue(B1) -Int 240) *Int 262144) +Int ((intValue(B2) -Int 128) *Int 4096)
      +Int ((intValue(B3) -Int 128) *Int 64) +Int (intValue(B4) -Int 128))
      +String bytesDecodeUtf8BackslashItems(Rest)
    requires bytesUtf8Start4(B1, B2, B3, B4)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsLast(B2:Val))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2)
    requires bytesUtf8Prefix3(B1, B2) orBool bytesUtf8Prefix4(B1, B2)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsLast(B3:Val)))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2) +String bytesDecodeBackslashByte(B3)
    requires bytesUtf8Prefix4(B1, B2, B3)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsLast(B3:Val)))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2) +String bytesDecodeUtf8BackslashItems(valItemsLast(B3))
    requires (bytesUtf8Prefix3(B1, B2) orBool bytesUtf8Prefix4(B1, B2)) andBool notBool byteUtf8Cont(B3)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsCons(B3:Val, Rest:ValItems)))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2) +String bytesDecodeUtf8BackslashItems(valItemsCons(B3, Rest))
    requires (bytesUtf8Prefix3(B1, B2) orBool bytesUtf8Prefix4(B1, B2)) andBool notBool byteUtf8Cont(B3)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsCons(B3:Val, valItemsLast(B4:Val))))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2) +String bytesDecodeBackslashByte(B3) +String bytesDecodeUtf8BackslashItems(valItemsLast(B4))
    requires bytesUtf8Prefix4(B1, B2, B3) andBool notBool byteUtf8Cont(B4)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B1:Val, valItemsCons(B2:Val, valItemsCons(B3:Val, valItemsCons(B4:Val, Rest:ValItems))))) =>
    bytesDecodeBackslashByte(B1) +String bytesDecodeBackslashByte(B2) +String bytesDecodeBackslashByte(B3) +String bytesDecodeUtf8BackslashItems(valItemsCons(B4, Rest))
    requires bytesUtf8Prefix4(B1, B2, B3) andBool notBool byteUtf8Cont(B4)
  rule bytesDecodeUtf8BackslashItems(valItemsCons(B:Val, Rest:ValItems)) =>
    bytesDecodeBackslashByte(B) +String bytesDecodeUtf8BackslashItems(Rest) [owise]

  rule pyIntBaseString(0, _Base:Int, Prefix:String) => Prefix +String "0"
  rule pyIntBaseString(I:Int, Base:Int, Prefix:String) => Prefix +String intBaseDigits(I, Base)
    requires I >Int 0
  rule pyIntBaseString(I:Int, Base:Int, Prefix:String) => "-" +String Prefix +String intBaseDigits(0 -Int I, Base)
    requires I <Int 0

  rule intBaseDigits(I:Int, Base:Int) => byteHexDigit(I)
    requires I >=Int 0 andBool I <Int Base andBool Base >=Int 2 andBool Base <=Int 16
  rule intBaseDigits(I:Int, Base:Int) =>
    intBaseDigits(I /Int Base, Base) +String byteHexDigit(I %Int Base)
    requires I >=Int Base andBool Base >=Int 2 andBool Base <=Int 16

  rule pyIntBaseStringUpper(0, _Base:Int, Prefix:String) => Prefix +String "0"
  rule pyIntBaseStringUpper(I:Int, Base:Int, Prefix:String) => Prefix +String intBaseDigitsUpper(I, Base)
    requires I >Int 0
  rule pyIntBaseStringUpper(I:Int, Base:Int, Prefix:String) => "-" +String Prefix +String intBaseDigitsUpper(0 -Int I, Base)
    requires I <Int 0

  rule intBaseDigitsUpper(I:Int, Base:Int) => byteHexDigitUpper(I)
    requires I >=Int 0 andBool I <Int Base andBool Base >=Int 2 andBool Base <=Int 16
  rule intBaseDigitsUpper(I:Int, Base:Int) =>
    intBaseDigitsUpper(I /Int Base, Base) +String byteHexDigitUpper(I %Int Base)
    requires I >=Int Base andBool Base >=Int 2 andBool Base <=Int 16

  rule byteHexDigitUpper(I:Int) => Int2String(I)
    requires I >=Int 0 andBool I <=Int 9
  rule byteHexDigitUpper(10) => "A"
  rule byteHexDigitUpper(11) => "B"
  rule byteHexDigitUpper(12) => "C"
  rule byteHexDigitUpper(13) => "D"
  rule byteHexDigitUpper(14) => "E"
  rule byteHexDigitUpper(15) => "F"

  rule unicodeChar(C:Int) => chrChar(C)
    requires C >=Int 0 andBool C <=Int 127
  rule unicodeChar(C:Int) => utf8ByteString(
      192 +Int (C /Int 64),
      128 +Int (C %Int 64))
    requires C >=Int 128 andBool C <=Int 2047
  rule unicodeChar(C:Int) => utf8ByteString(
      224 +Int (C /Int 4096),
      128 +Int ((C /Int 64) %Int 64),
      128 +Int (C %Int 64))
    requires C >=Int 2048
      andBool C <=Int 65535
      andBool unicodeScalarCodePoint(C)
  rule unicodeChar(C:Int) => utf8ByteString(
      240 +Int (C /Int 262144),
      128 +Int ((C /Int 4096) %Int 64),
      128 +Int ((C /Int 64) %Int 64),
      128 +Int (C %Int 64))
    requires C >=Int 65536 andBool C <=Int 1114111

  rule formatSignPrefix("+", I:Int) => "+"
    requires I >=Int 0
  rule formatSignPrefix("+", I:Int) => ""
    requires I <Int 0
  rule formatSignPrefix(" ", I:Int) => " "
    requires I >=Int 0
  rule formatSignPrefix(" ", I:Int) => ""
    requires I <Int 0
  rule formatSignPrefix("-", _I:Int) => ""

  rule formatAlignChar("<") => true
  rule formatAlignChar(">") => true
  rule formatAlignChar("=") => true
  rule formatAlignChar("^") => true
  rule formatAlignChar(_:String) => false [owise]

  rule formatSignChar("+") => true
  rule formatSignChar("-") => true
  rule formatSignChar(" ") => true
  rule formatSignChar(_:String) => false [owise]

  rule formatIntTypeChar("b") => true
  rule formatIntTypeChar("c") => true
  rule formatIntTypeChar("d") => true
  rule formatIntTypeChar("o") => true
  rule formatIntTypeChar("x") => true
  rule formatIntTypeChar("X") => true
  rule formatIntTypeChar(_:String) => false [owise]

  rule formatStringTypeChar("s") => true
  rule formatStringTypeChar(_:String) => false [owise]

  rule formatNumericTypeChar("b") => true
  rule formatNumericTypeChar("c") => true
  rule formatNumericTypeChar("d") => true
  rule formatNumericTypeChar("e") => true
  rule formatNumericTypeChar("E") => true
  rule formatNumericTypeChar("f") => true
  rule formatNumericTypeChar("F") => true
  rule formatNumericTypeChar("g") => true
  rule formatNumericTypeChar("G") => true
  rule formatNumericTypeChar("n") => true
  rule formatNumericTypeChar("o") => true
  rule formatNumericTypeChar("x") => true
  rule formatNumericTypeChar("X") => true
  rule formatNumericTypeChar("%") => true
  rule formatNumericTypeChar(_:String) => false [owise]

  rule formatFloatTypeChar("e") => true
  rule formatFloatTypeChar("E") => true
  rule formatFloatTypeChar("f") => true
  rule formatFloatTypeChar("F") => true
  rule formatFloatTypeChar("g") => true
  rule formatFloatTypeChar("G") => true
  rule formatFloatTypeChar("n") => true
  rule formatFloatTypeChar("%") => true
  rule formatFloatTypeChar(_:String) => false [owise]

  rule formatFloatSpecialUppercase(S:String) => true
    requires formatFloatType(S) ==String "E"
      orBool formatFloatType(S) ==String "F"
      orBool formatFloatType(S) ==String "G"
  rule formatFloatSpecialUppercase(S:String) => false
    requires formatFloatType(S) =/=String "E"
      andBool formatFloatType(S) =/=String "F"
      andBool formatFloatType(S) =/=String "G"

  rule formatGroupingChar(",") => true
  rule formatGroupingChar("_") => true
  rule formatGroupingChar(_:String) => false [owise]

  rule formatAlignIndex(S:String) => 1
    requires lengthString(S) >=Int 2
      andBool formatAlignChar(substrString(S, 1, 2))
  rule formatAlignIndex(S:String) => 0
    requires lengthString(S) ==Int 1
      andBool formatAlignChar(substrString(S, 0, 1))
  rule formatAlignIndex(S:String) => 0
    requires lengthString(S) >=Int 2
      andBool notBool formatAlignChar(substrString(S, 1, 2))
      andBool formatAlignChar(substrString(S, 0, 1))
  rule formatAlignIndex(S:String) => -1
    requires lengthString(S) ==Int 0
  rule formatAlignIndex(S:String) => -1
    requires lengthString(S) ==Int 1
      andBool notBool formatAlignChar(substrString(S, 0, 1))
  rule formatAlignIndex(S:String) => -1
    requires lengthString(S) >=Int 2
      andBool notBool formatAlignChar(substrString(S, 1, 2))
      andBool notBool formatAlignChar(substrString(S, 0, 1))

  rule formatOptionsStart(S:String) => 2
    requires formatAlignIndex(S) ==Int 1
  rule formatOptionsStart(S:String) => 1
    requires formatAlignIndex(S) ==Int 0
  rule formatOptionsStart(S:String) => 0
    requires formatAlignIndex(S) ==Int -1

  rule formatHasSign(S:String) => true
    requires formatOptionsStart(S) <Int lengthString(S)
      andBool formatSignChar(substrString(S, formatOptionsStart(S), formatOptionsStart(S) +Int 1))
  rule formatHasSign(S:String) => false
    requires formatOptionsStart(S) >=Int lengthString(S)
  rule formatHasSign(S:String) => false
    requires formatOptionsStart(S) <Int lengthString(S)
      andBool notBool formatSignChar(substrString(S, formatOptionsStart(S), formatOptionsStart(S) +Int 1))

  rule formatSign(S:String) => substrString(S, formatOptionsStart(S), formatOptionsStart(S) +Int 1)
    requires formatHasSign(S)
  rule formatSign(S:String) => "-"
    requires notBool formatHasSign(S)

  rule formatAfterSignIndex(S:String) => formatOptionsStart(S) +Int 1
    requires formatHasSign(S)
  rule formatAfterSignIndex(S:String) => formatOptionsStart(S)
    requires notBool formatHasSign(S)

  rule formatHasZ(S:String) => true
    requires formatAfterSignIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterSignIndex(S), formatAfterSignIndex(S) +Int 1) ==String "z"
  rule formatHasZ(S:String) => false
    requires formatAfterSignIndex(S) >=Int lengthString(S)
  rule formatHasZ(S:String) => false
    requires formatAfterSignIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterSignIndex(S), formatAfterSignIndex(S) +Int 1) =/=String "z"

  rule formatAfterZIndex(S:String) => formatAfterSignIndex(S) +Int 1
    requires formatHasZ(S)
  rule formatAfterZIndex(S:String) => formatAfterSignIndex(S)
    requires notBool formatHasZ(S)

  rule formatHasAlt(S:String) => true
    requires formatAfterZIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterZIndex(S), formatAfterZIndex(S) +Int 1) ==String "#"
  rule formatHasAlt(S:String) => false
    requires formatAfterZIndex(S) >=Int lengthString(S)
  rule formatHasAlt(S:String) => false
    requires formatAfterZIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterZIndex(S), formatAfterZIndex(S) +Int 1) =/=String "#"

  rule formatAfterAltIndex(S:String) => formatAfterZIndex(S) +Int 1
    requires formatHasAlt(S)
  rule formatAfterAltIndex(S:String) => formatAfterZIndex(S)
    requires notBool formatHasAlt(S)

  rule formatHasZero(S:String) => true
    requires formatAfterAltIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterAltIndex(S), formatAfterAltIndex(S) +Int 1) ==String "0"
  rule formatHasZero(S:String) => false
    requires formatAfterAltIndex(S) >=Int lengthString(S)
  rule formatHasZero(S:String) => false
    requires formatAfterAltIndex(S) <Int lengthString(S)
      andBool substrString(S, formatAfterAltIndex(S), formatAfterAltIndex(S) +Int 1) =/=String "0"

  rule formatWidthStart(S:String) => formatAfterAltIndex(S) +Int 1
    requires formatHasZero(S)
  rule formatWidthStart(S:String) => formatAfterAltIndex(S)
    requires notBool formatHasZero(S)

  rule formatIntWidthEnd(S:String) => lengthString(S) -Int 1
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatIntTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatIntWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatIntWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatIntTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatHasGrouping(S:String) => true
    requires formatIntWidthEnd(S) >Int formatWidthStart(S)
      andBool formatGroupingChar(substrString(S, formatIntWidthEnd(S) -Int 1, formatIntWidthEnd(S)))
  rule formatHasGrouping(S:String) => false
    requires formatIntWidthEnd(S) <=Int formatWidthStart(S)
  rule formatHasGrouping(S:String) => false
    requires formatIntWidthEnd(S) >Int formatWidthStart(S)
      andBool notBool formatGroupingChar(substrString(S, formatIntWidthEnd(S) -Int 1, formatIntWidthEnd(S)))

  rule formatGrouping(S:String) => substrString(S, formatIntWidthEnd(S) -Int 1, formatIntWidthEnd(S))
    requires formatHasGrouping(S)
  rule formatGrouping(_S:String) => ""
    [owise]

  rule formatIntWidthDigitsEnd(S:String) => formatIntWidthEnd(S) -Int 1
    requires formatHasGrouping(S)
  rule formatIntWidthDigitsEnd(S:String) => formatIntWidthEnd(S)
    requires notBool formatHasGrouping(S)

  rule formatGroupingAllowed(S:String) => true
    requires notBool formatHasGrouping(S)
  rule formatGroupingAllowed(S:String) => true
    requires formatHasGrouping(S)
      andBool formatGrouping(S) ==String ","
      andBool formatIntType(S) ==String "d"
  rule formatGroupingAllowed(S:String) => true
    requires formatHasGrouping(S)
      andBool formatGrouping(S) ==String "_"
      andBool formatIntType(S) =/=String "c"
  rule formatGroupingAllowed(S:String) => false
    requires formatHasGrouping(S)
      andBool notBool (formatGrouping(S) ==String "," andBool formatIntType(S) ==String "d")
      andBool notBool (formatGrouping(S) ==String "_" andBool formatIntType(S) =/=String "c")

  rule formatGroupingSize(S:String) => 4
    requires formatHasGrouping(S)
      andBool formatGrouping(S) ==String "_"
      andBool (formatIntType(S) ==String "b"
        orBool formatIntType(S) ==String "o"
        orBool formatIntType(S) ==String "x"
        orBool formatIntType(S) ==String "X")
  rule formatGroupingSize(S:String) => 3
    requires formatHasGrouping(S)
      andBool notBool (formatGrouping(S) ==String "_"
        andBool (formatIntType(S) ==String "b"
          orBool formatIntType(S) ==String "o"
          orBool formatIntType(S) ==String "x"
          orBool formatIntType(S) ==String "X"))
  rule formatGroupingSize(_S:String) => 3
    [owise]

  rule formatIntPrecisionDot(S:String) => findString(S, ".", formatWidthStart(S))
    requires findString(S, ".", formatWidthStart(S)) >=Int formatWidthStart(S)
      andBool findString(S, ".", formatWidthStart(S)) <Int formatIntWidthDigitsEnd(S)
  rule formatIntPrecisionDot(S:String) => -1
    requires findString(S, ".", formatWidthStart(S)) <Int 0
      orBool findString(S, ".", formatWidthStart(S)) >=Int formatIntWidthDigitsEnd(S)

  rule formatHasIntPrecision(S:String) => true
    requires formatIntPrecisionDot(S) >=Int 0
  rule formatHasIntPrecision(S:String) => false
    requires formatIntPrecisionDot(S) <Int 0

  rule formatIntPrecisionMissing(S:String) => true
    requires formatHasIntPrecision(S)
      andBool formatIntPrecisionDot(S) +Int 1 >=Int formatIntWidthDigitsEnd(S)
  rule formatIntPrecisionMissing(S:String) => false
    requires notBool formatHasIntPrecision(S)
  rule formatIntPrecisionMissing(S:String) => false
    requires formatHasIntPrecision(S)
      andBool formatIntPrecisionDot(S) +Int 1 <Int formatIntWidthDigitsEnd(S)

  rule formatNumericWidthEnd(S:String) => lengthString(S) -Int 1
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatNumericTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatNumericWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatNumericWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatNumericTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatNumericHasGrouping(S:String) => true
    requires formatNumericWidthEnd(S) >Int formatWidthStart(S)
      andBool formatGroupingChar(substrString(S, formatNumericWidthEnd(S) -Int 1, formatNumericWidthEnd(S)))
  rule formatNumericHasGrouping(S:String) => false
    requires formatNumericWidthEnd(S) <=Int formatWidthStart(S)
  rule formatNumericHasGrouping(S:String) => false
    requires formatNumericWidthEnd(S) >Int formatWidthStart(S)
      andBool notBool formatGroupingChar(substrString(S, formatNumericWidthEnd(S) -Int 1, formatNumericWidthEnd(S)))

  rule formatNumericWidthDigitsEnd(S:String) => formatNumericWidthEnd(S) -Int 1
    requires formatNumericHasGrouping(S)
  rule formatNumericWidthDigitsEnd(S:String) => formatNumericWidthEnd(S)
    requires notBool formatNumericHasGrouping(S)

  rule formatNumericPrecisionDot(S:String) => findString(S, ".", formatWidthStart(S))
    requires findString(S, ".", formatWidthStart(S)) >=Int formatWidthStart(S)
      andBool findString(S, ".", formatWidthStart(S)) <Int formatNumericWidthDigitsEnd(S)
  rule formatNumericPrecisionDot(S:String) => -1
    requires findString(S, ".", formatWidthStart(S)) <Int 0
      orBool findString(S, ".", formatWidthStart(S)) >=Int formatNumericWidthDigitsEnd(S)

  rule formatHasNumericPrecision(S:String) => true
    requires formatNumericPrecisionDot(S) >=Int 0
  rule formatHasNumericPrecision(S:String) => false
    requires formatNumericPrecisionDot(S) <Int 0

  rule formatNumericPrecisionMissing(S:String) => true
    requires formatHasNumericPrecision(S)
      andBool formatNumericPrecisionDot(S) +Int 1 >=Int formatNumericWidthDigitsEnd(S)
  rule formatNumericPrecisionMissing(S:String) => false
    requires notBool formatHasNumericPrecision(S)
  rule formatNumericPrecisionMissing(S:String) => false
    requires formatHasNumericPrecision(S)
      andBool formatNumericPrecisionDot(S) +Int 1 <Int formatNumericWidthDigitsEnd(S)

  rule formatNumericWidthDigitsPrefixEnd(S:String) => formatNumericPrecisionDot(S)
    requires formatHasNumericPrecision(S)
  rule formatNumericWidthDigitsPrefixEnd(S:String) => formatNumericWidthDigitsEnd(S)
    requires notBool formatHasNumericPrecision(S)

  rule formatStringWidthEnd(S:String) => lengthString(S) -Int 1
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatStringTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatStringWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatStringWidthEnd(S:String) => lengthString(S)
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatStringTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatStringPrecisionDot(S:String) => findString(S, ".", formatWidthStart(S))
    requires findString(S, ".", formatWidthStart(S)) >=Int formatWidthStart(S)
      andBool findString(S, ".", formatWidthStart(S)) <Int formatStringWidthEnd(S)
  rule formatStringPrecisionDot(S:String) => -1
    requires findString(S, ".", formatWidthStart(S)) <Int 0
      orBool findString(S, ".", formatWidthStart(S)) >=Int formatStringWidthEnd(S)

  rule formatHasStringPrecision(S:String) => true
    requires formatStringPrecisionDot(S) >=Int 0
  rule formatHasStringPrecision(S:String) => false
    requires formatStringPrecisionDot(S) <Int 0

  rule formatStringPrecisionMissing(S:String) => true
    requires formatHasStringPrecision(S)
      andBool formatStringPrecisionDot(S) +Int 1 >=Int formatStringWidthEnd(S)
  rule formatStringPrecisionMissing(S:String) => false
    requires notBool formatHasStringPrecision(S)
  rule formatStringPrecisionMissing(S:String) => false
    requires formatHasStringPrecision(S)
      andBool formatStringPrecisionDot(S) +Int 1 <Int formatStringWidthEnd(S)

  rule formatStringWidthDigitsEnd(S:String) => formatStringPrecisionDot(S)
    requires formatHasStringPrecision(S)
  rule formatStringWidthDigitsEnd(S:String) => formatStringWidthEnd(S)
    requires notBool formatHasStringPrecision(S)

  rule formatStringPrecision(S:String) =>
    formatWidth(S, formatStringPrecisionDot(S) +Int 1, formatStringWidthEnd(S))
    requires formatHasStringPrecision(S)
      andBool notBool formatStringPrecisionMissing(S)
  rule formatStringPrecision(_S:String) => 0
    [owise]

  rule formatDecimalDigits(_S:String, I:Int, End:Int) => true
    requires I >=Int End
  rule formatDecimalDigits(S:String, I:Int, End:Int) =>
    formatDecimalDigits(S, I +Int 1, End)
    requires I <Int End
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9
  rule formatDecimalDigits(S:String, I:Int, End:Int) => false
    requires I <Int End
      andBool (digitValue(substrString(S, I, I +Int 1)) <Int 0
        orBool digitValue(substrString(S, I, I +Int 1)) >Int 9)

  rule formatDecimalDigitsValue(_S:String, I:Int, End:Int, Acc:Int) => Acc
    requires I >=Int End
  rule formatDecimalDigitsValue(S:String, I:Int, End:Int, Acc:Int) =>
    formatDecimalDigitsValue(S, I +Int 1, End, (Acc *Int 10) +Int digitValue(substrString(S, I, I +Int 1)))
    requires I <Int End
      andBool digitValue(substrString(S, I, I +Int 1)) >=Int 0
      andBool digitValue(substrString(S, I, I +Int 1)) <=Int 9

  rule formatWidth(_S:String, Start:Int, End:Int) => 0
    requires Start >=Int End
  rule formatWidth(S:String, Start:Int, End:Int) => formatDecimalDigitsValue(S, Start, End, 0)
    requires Start <Int End

  rule formatAlign(S:String, _Default:String) => substrString(S, formatAlignIndex(S), formatAlignIndex(S) +Int 1)
    requires formatAlignIndex(S) >=Int 0
  rule formatAlign(S:String, Default:String) => Default
    requires formatAlignIndex(S) <Int 0

  rule formatIntAlign(S:String) => "="
    requires formatAlignIndex(S) <Int 0 andBool formatHasZero(S)
  rule formatIntAlign(S:String) => formatAlign(S, ">")
    requires formatAlignIndex(S) >=Int 0 orBool notBool formatHasZero(S)

  rule formatFill(S:String) => substrString(S, 0, 1)
    requires formatAlignIndex(S) ==Int 1
  rule formatFill(S:String) => "0"
    requires formatAlignIndex(S) =/=Int 1 andBool formatHasZero(S)
  rule formatFill(S:String) => " "
    requires formatAlignIndex(S) =/=Int 1 andBool notBool formatHasZero(S)

  rule formatIntType(S:String) => substrString(S, lengthString(S) -Int 1, lengthString(S))
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatIntTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatIntType(S:String) => "d"
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatIntType(S:String) => "d"
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatIntTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatStringType(S:String) => "s"
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatStringTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatStringType(S:String) => "s"
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatStringType(S:String) => "s"
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatStringTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatFloatType(S:String) => substrString(S, lengthString(S) -Int 1, lengthString(S))
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatFloatTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatFloatType(S:String) => ""
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatFloatType(S:String) => ""
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatFloatTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatFloatBodyEnd(S:String) => lengthString(S) -Int 1
    requires lengthString(S) >Int formatWidthStart(S)
      andBool formatFloatTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))
  rule formatFloatBodyEnd(S:String) => lengthString(S)
    requires lengthString(S) <=Int formatWidthStart(S)
  rule formatFloatBodyEnd(S:String) => lengthString(S)
    requires lengthString(S) >Int formatWidthStart(S)
      andBool notBool formatFloatTypeChar(substrString(S, lengthString(S) -Int 1, lengthString(S)))

  rule formatFloatPrecisionDot(S:String) => findString(S, ".", formatWidthStart(S))
    requires findString(S, ".", formatWidthStart(S)) >=Int formatWidthStart(S)
      andBool findString(S, ".", formatWidthStart(S)) <Int formatFloatBodyEnd(S)
  rule formatFloatPrecisionDot(S:String) => -1
    requires findString(S, ".", formatWidthStart(S)) <Int 0
      orBool findString(S, ".", formatWidthStart(S)) >=Int formatFloatBodyEnd(S)

  rule formatFloatHasPrecision(S:String) => true
    requires formatFloatPrecisionDot(S) >=Int 0
  rule formatFloatHasPrecision(S:String) => false
    requires formatFloatPrecisionDot(S) <Int 0

  rule formatFloatHasPrecisionGrouping(S:String) => true
    requires formatFloatHasPrecision(S)
      andBool formatFloatBodyEnd(S) >Int formatFloatPrecisionDot(S) +Int 1
      andBool formatGroupingChar(substrString(S, formatFloatBodyEnd(S) -Int 1, formatFloatBodyEnd(S)))
  rule formatFloatHasPrecisionGrouping(S:String) => false
    requires notBool formatFloatHasPrecision(S)
  rule formatFloatHasPrecisionGrouping(S:String) => false
    requires formatFloatHasPrecision(S)
      andBool (formatFloatBodyEnd(S) <=Int formatFloatPrecisionDot(S) +Int 1
        orBool notBool formatGroupingChar(substrString(S, formatFloatBodyEnd(S) -Int 1, formatFloatBodyEnd(S))))

  rule formatFloatPrecisionDigitsEnd(S:String) => formatFloatBodyEnd(S) -Int 1
    requires formatFloatHasPrecisionGrouping(S)
  rule formatFloatPrecisionDigitsEnd(S:String) => formatFloatBodyEnd(S)
    requires notBool formatFloatHasPrecisionGrouping(S)

  rule formatFloatPrecisionMissing(S:String) => true
    requires formatFloatHasPrecision(S)
      andBool notBool formatFloatHasPrecisionGrouping(S)
      andBool formatFloatPrecisionDot(S) +Int 1 >=Int formatFloatPrecisionDigitsEnd(S)
  rule formatFloatPrecisionMissing(S:String) => false
    requires notBool formatFloatHasPrecision(S)
  rule formatFloatPrecisionMissing(S:String) => false
    requires formatFloatHasPrecision(S)
      andBool (formatFloatHasPrecisionGrouping(S)
        orBool formatFloatPrecisionDot(S) +Int 1 <Int formatFloatPrecisionDigitsEnd(S))

  rule formatFloatWidthPartEnd(S:String) => formatFloatPrecisionDot(S)
    requires formatFloatHasPrecision(S)
  rule formatFloatWidthPartEnd(S:String) => formatFloatBodyEnd(S)
    requires notBool formatFloatHasPrecision(S)

  rule formatFloatHasWidthGrouping(S:String) => true
    requires formatFloatWidthPartEnd(S) >Int formatWidthStart(S)
      andBool formatGroupingChar(substrString(S, formatFloatWidthPartEnd(S) -Int 1, formatFloatWidthPartEnd(S)))
  rule formatFloatHasWidthGrouping(S:String) => false
    requires formatFloatWidthPartEnd(S) <=Int formatWidthStart(S)
  rule formatFloatHasWidthGrouping(S:String) => false
    requires formatFloatWidthPartEnd(S) >Int formatWidthStart(S)
      andBool notBool formatGroupingChar(substrString(S, formatFloatWidthPartEnd(S) -Int 1, formatFloatWidthPartEnd(S)))

  rule formatFloatHasAnyGrouping(S:String) => true
    requires formatFloatHasWidthGrouping(S) orBool formatFloatHasPrecisionGrouping(S)
  rule formatFloatHasAnyGrouping(S:String) => false
    requires notBool formatFloatHasWidthGrouping(S) andBool notBool formatFloatHasPrecisionGrouping(S)

  rule formatFloatWidthDigitsEnd(S:String) => formatFloatWidthPartEnd(S) -Int 1
    requires formatFloatHasWidthGrouping(S)
  rule formatFloatWidthDigitsEnd(S:String) => formatFloatWidthPartEnd(S)
    requires notBool formatFloatHasWidthGrouping(S)

  rule formatFloatSpecialAlign(S:String) => "="
    requires formatAlignIndex(S) <Int 0 andBool formatHasZero(S)
  rule formatFloatSpecialAlign(S:String) => formatAlign(S, ">")
    requires formatAlignIndex(S) >=Int 0 orBool notBool formatHasZero(S)

  rule formatStringPayload(Text:String, Spec:String) =>
    substrString(Text, 0, stringCodePointPrefixByteLen(Text, formatStringPrecision(Spec), 0))
    requires formatHasStringPrecision(Spec)
      andBool notBool formatStringPrecisionMissing(Spec)
      andBool formatStringPrecision(Spec) <Int stringCodePointLen(Text, 0)
  rule formatStringPayload(Text:String, Spec:String) => Text
    requires notBool formatHasStringPrecision(Spec)
      orBool formatStringPrecisionMissing(Spec)
      orBool formatStringPrecision(Spec) >=Int stringCodePointLen(Text, 0)

  rule formatPad(_Align:String, _Fill:String, Text:String, Width:Int) => Text
    requires Width <=Int stringCodePointLen(Text, 0)
  rule formatPad("<", Fill:String, Text:String, Width:Int) => Text +String repeatString(Fill, Width -Int stringCodePointLen(Text, 0))
    requires Width >Int stringCodePointLen(Text, 0)
  rule formatPad(">", Fill:String, Text:String, Width:Int) => repeatString(Fill, Width -Int stringCodePointLen(Text, 0)) +String Text
    requires Width >Int stringCodePointLen(Text, 0)
  rule formatPad("^", Fill:String, Text:String, Width:Int) =>
    repeatString(Fill, (Width -Int stringCodePointLen(Text, 0)) /Int 2)
      +String Text
      +String repeatString(Fill, (Width -Int stringCodePointLen(Text, 0)) -Int ((Width -Int stringCodePointLen(Text, 0)) /Int 2))
    requires Width >Int stringCodePointLen(Text, 0)

  rule formatPadEqual(_Fill:String, Prefix:String, Digits:String, Width:Int) => Prefix +String Digits
    requires Width <=Int stringCodePointLen(Prefix, 0) +Int stringCodePointLen(Digits, 0)
  rule formatPadEqual(Fill:String, Prefix:String, Digits:String, Width:Int) =>
    Prefix +String repeatString(Fill, Width -Int stringCodePointLen(Prefix, 0) -Int stringCodePointLen(Digits, 0)) +String Digits
    requires Width >Int stringCodePointLen(Prefix, 0) +Int stringCodePointLen(Digits, 0)

  rule formatIntSign(_Spec:String, I:Int) => "-"
    requires I <Int 0
  rule formatIntSign(Spec:String, I:Int) => "+"
    requires I >=Int 0 andBool formatSign(Spec) ==String "+"
  rule formatIntSign(Spec:String, I:Int) => " "
    requires I >=Int 0 andBool formatSign(Spec) ==String " "
  rule formatIntSign(Spec:String, I:Int) => ""
    requires I >=Int 0
      andBool formatSign(Spec) =/=String "+"
      andBool formatSign(Spec) =/=String " "

  rule formatFloatSpecialSign(_Spec:String, F:Float) => "-"
    requires isInfinite(F) andBool signFloat(F)
  rule formatFloatSpecialSign(Spec:String, F:Float) => "+"
    requires notBool (isInfinite(F) andBool signFloat(F))
      andBool formatSign(Spec) ==String "+"
  rule formatFloatSpecialSign(Spec:String, F:Float) => " "
    requires notBool (isInfinite(F) andBool signFloat(F))
      andBool formatSign(Spec) ==String " "
  rule formatFloatSpecialSign(Spec:String, F:Float) => ""
    requires notBool (isInfinite(F) andBool signFloat(F))
      andBool formatSign(Spec) =/=String "+"
      andBool formatSign(Spec) =/=String " "

  rule formatFloatSpecialSuffix(Spec:String) => "%"
    requires formatFloatType(Spec) ==String "%"
  rule formatFloatSpecialSuffix(Spec:String) => ""
    requires formatFloatType(Spec) =/=String "%"

  rule formatFloatSpecialBase(F:Float, Spec:String) => "NAN"
    requires isNaN(F) andBool formatFloatSpecialUppercase(Spec)
  rule formatFloatSpecialBase(F:Float, Spec:String) => "nan"
    requires isNaN(F) andBool notBool formatFloatSpecialUppercase(Spec)
  rule formatFloatSpecialBase(F:Float, Spec:String) => "INF"
    requires isInfinite(F) andBool formatFloatSpecialUppercase(Spec)
  rule formatFloatSpecialBase(F:Float, Spec:String) => "inf"
    requires isInfinite(F) andBool notBool formatFloatSpecialUppercase(Spec)

  rule formatFloatSpecialBody(F:Float, Spec:String) =>
    formatFloatSpecialBase(F, Spec) +String formatFloatSpecialSuffix(Spec)

  rule formatFloatSpecialText(F:Float, Spec:String) =>
    formatFloatSpecialSign(Spec, F) +String formatFloatSpecialBody(F, Spec)

  rule formatFloatSpecialRender(F:Float, Spec:String) =>
    formatPadEqual(
      formatFill(Spec),
      formatFloatSpecialSign(Spec, F),
      formatFloatSpecialBody(F, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatNumericWidthDigitsPrefixEnd(Spec)))
    requires formatFloatSpecialAlign(Spec) ==String "="
  rule formatFloatSpecialRender(F:Float, Spec:String) =>
    formatPad(
      formatFloatSpecialAlign(Spec),
      formatFill(Spec),
      formatFloatSpecialText(F, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatNumericWidthDigitsPrefixEnd(Spec)))
    requires formatFloatSpecialAlign(Spec) =/=String "="

  rule formatFloatSpecialExtendedRender(F:Float, Spec:String) =>
    formatPadEqual(
      formatFill(Spec),
      formatFloatSpecialSign(Spec, F),
      formatFloatSpecialBody(F, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatFloatWidthDigitsEnd(Spec)))
    requires formatFloatSpecialAlign(Spec) ==String "="
  rule formatFloatSpecialExtendedRender(F:Float, Spec:String) =>
    formatPad(
      formatFloatSpecialAlign(Spec),
      formatFill(Spec),
      formatFloatSpecialText(F, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatFloatWidthDigitsEnd(Spec)))
    requires formatFloatSpecialAlign(Spec) =/=String "="

  rule formatIntAltPrefix(Spec:String, "b") => "0b"
    requires formatHasAlt(Spec)
  rule formatIntAltPrefix(Spec:String, "o") => "0o"
    requires formatHasAlt(Spec)
  rule formatIntAltPrefix(Spec:String, "x") => "0x"
    requires formatHasAlt(Spec)
  rule formatIntAltPrefix(Spec:String, "X") => "0X"
    requires formatHasAlt(Spec)
  rule formatIntAltPrefix(_Spec:String, _Type:String) => ""
    [owise]

  rule formatIntDigits(I:Int, "b") => intBaseDigits(intAbs(I), 2)
  rule formatIntDigits(I:Int, "c") => unicodeChar(I)
    requires unicodeScalarCodePoint(I)
  rule formatIntDigits(I:Int, "d") => Int2String(intAbs(I))
  rule formatIntDigits(I:Int, "o") => intBaseDigits(intAbs(I), 8)
  rule formatIntDigits(I:Int, "x") => intBaseDigits(intAbs(I), 16)
  rule formatIntDigits(I:Int, "X") => intBaseDigitsUpper(intAbs(I), 16)

  rule formatGroupDigits(Digits:String, _Sep:String, Size:Int) => Digits
    requires lengthString(Digits) <=Int Size
  rule formatGroupDigits(Digits:String, Sep:String, Size:Int) =>
    formatGroupDigits(substrString(Digits, 0, lengthString(Digits) -Int Size), Sep, Size)
      +String Sep
      +String substrString(Digits, lengthString(Digits) -Int Size, lengthString(Digits))
    requires lengthString(Digits) >Int Size

  rule formatIntGroupedDigits(I:Int, Spec:String) =>
    formatGroupDigits(formatIntDigits(I, formatIntType(Spec)), formatGrouping(Spec), formatGroupingSize(Spec))
    requires formatHasGrouping(Spec)
  rule formatIntGroupedDigits(I:Int, Spec:String) => formatIntDigits(I, formatIntType(Spec))
    requires notBool formatHasGrouping(Spec)

  rule formatZeroPaddedGroupedDigits(Digits:String, Sep:String, Size:Int, TargetLen:Int) =>
    formatGroupDigits(Digits, Sep, Size)
    requires lengthString(formatGroupDigits(Digits, Sep, Size)) >=Int TargetLen
  rule formatZeroPaddedGroupedDigits(Digits:String, Sep:String, Size:Int, TargetLen:Int) =>
    formatZeroPaddedGroupedDigits("0" +String Digits, Sep, Size, TargetLen)
    requires lengthString(formatGroupDigits(Digits, Sep, Size)) <Int TargetLen

  rule formatIntText(I:Int, Spec:String) =>
    formatIntSign(Spec, I) +String formatIntAltPrefix(Spec, formatIntType(Spec)) +String formatIntGroupedDigits(I, Spec)

  rule formatIntRender(I:Int, Spec:String) =>
    formatIntSign(Spec, I)
      +String formatIntAltPrefix(Spec, formatIntType(Spec))
      +String formatZeroPaddedGroupedDigits(
        formatIntDigits(I, formatIntType(Spec)),
        formatGrouping(Spec),
        formatGroupingSize(Spec),
        formatWidth(Spec, formatWidthStart(Spec), formatIntWidthDigitsEnd(Spec))
          -Int lengthString(formatIntSign(Spec, I) +String formatIntAltPrefix(Spec, formatIntType(Spec))))
    requires formatIntAlign(Spec) ==String "="
      andBool formatHasGrouping(Spec)
      andBool formatFill(Spec) ==String "0"
  rule formatIntRender(I:Int, Spec:String) =>
    formatPadEqual(
      formatFill(Spec),
      formatIntSign(Spec, I) +String formatIntAltPrefix(Spec, formatIntType(Spec)),
      formatIntGroupedDigits(I, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatIntWidthDigitsEnd(Spec)))
    requires formatIntAlign(Spec) ==String "="
      andBool formatHasGrouping(Spec)
      andBool formatFill(Spec) =/=String "0"
  rule formatIntRender(I:Int, Spec:String) =>
    formatPadEqual(
      formatFill(Spec),
      formatIntSign(Spec, I) +String formatIntAltPrefix(Spec, formatIntType(Spec)),
      formatIntDigits(I, formatIntType(Spec)),
      formatWidth(Spec, formatWidthStart(Spec), formatIntWidthDigitsEnd(Spec)))
    requires formatIntAlign(Spec) ==String "="
      andBool notBool formatHasGrouping(Spec)
  rule formatIntRender(I:Int, Spec:String) =>
    formatPad(
      formatIntAlign(Spec),
      formatFill(Spec),
      formatIntText(I, Spec),
      formatWidth(Spec, formatWidthStart(Spec), formatIntWidthDigitsEnd(Spec)))
    requires formatIntAlign(Spec) =/=String "="

  rule isIntLike(_:Int) => true
  rule isIntLike(_:Float) => false
  rule isIntLike(#complex(_:Float, _:Float)) => false
  rule isIntLike(_:String) => false
  rule isIntLike(#bytes()) => false
  rule isIntLike(bytesVal(_:ValItems)) => false
  rule isIntLike(#bytearray()) => false
  rule isIntLike(bytearrayVal(_:ValItems)) => false
  rule isIntLike(#memoryviewVal(_:Val)) => false
  rule isIntLike(True) => true
  rule isIntLike(False) => true
  rule isIntLike(None) => false
  rule isIntLike(Ellipsis) => false
  rule isIntLike([]) => false
  rule isIntLike(listVal(_:ValItems)) => false
  rule isIntLike(()) => false
  rule isIntLike(tupleVal(_:ValItems)) => false
  rule isIntLike({}) => false
  rule isIntLike(dictVal(_:DictItems)) => false
  rule isIntLike(set()) => false
  rule isIntLike(setVal(_:ValItems)) => false
  rule isIntLike(frozenset()) => false
  rule isIntLike(frozensetVal(_:ValItems)) => false
  rule isIntLike(#kwDefaultMissing) => false
  rule isIntLike(closure(_:Id, _:Exp)) => false
  rule isIntLike(closureArgs(_:IdItems, _:Exp)) => false
  rule isIntLike(closureDefaults(_:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closureVarArgs(_:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closureVarArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closureVarArgsKwOnly(_:IdItems, _:Id, _:IdItems, _:Exp)) => false
  rule isIntLike(closureVarArgsKwDefaults(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closureVarArgsKwOnlyKwArgs(_:IdItems, _:Id, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closureVarArgsKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closureVarKwArgs(_:IdItems, _:Id, _:Id, _:Exp)) => false
  rule isIntLike(closureVarKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Id, _:Exp)) => false
  rule isIntLike(closureKwArgs(_:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closureKwArgsDefaults(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnly(_:IdItems, _:IdItems, _:Exp)) => false
  rule isIntLike(closurePosOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarKwArgs(_:IdItems, _:IdItems, _:Id, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarKwArgsDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgsKwOnly(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgsKwDefaults(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgsKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyVarArgsKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:Id, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwOnly(_:IdItems, _:IdItems, _:IdItems, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwOnlyDefaults(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwOnlyKwArgs(_:IdItems, _:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closurePosOnlyKwDefaultsKwArgs(_:IdItems, _:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closureKwOnly(_:IdItems, _:Exp)) => false
  rule isIntLike(closureKwDefaults(_:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closureKwOnlyKwArgs(_:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closureKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:Id, _:Exp)) => false
  rule isIntLike(closurePosKwOnly(_:IdItems, _:IdItems, _:Exp)) => false
  rule isIntLike(closurePosKwDefaults(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Exp)) => false
  rule isIntLike(closurePosKwOnlyKwArgs(_:IdItems, _:IdItems, _:Id, _:Exp)) => false
  rule isIntLike(closurePosKwDefaultsKwArgs(_:IdItems, _:ArgVals, _:IdItems, _:ArgVals, _:Id, _:Exp)) => false
