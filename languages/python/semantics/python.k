           mapCollect(F, Rest, Strict, Iters, appendArgVal(Acc, V))
       ... </k>
  rule <k> argsVal(#noArgVals) ~> mapForIter(_:Id, _:Block) =>
           stmtNoResult
       ... </k>
  rule <k> argsVal(VS:ArgVals) ~> mapForIter(X:Id, Body:Block) =>
