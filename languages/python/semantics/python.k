  rule <k> #iter(Args:ArgExps) =>
           evalArgs(Args, #noArgVals) ~> iterArgsResult
       ... </k>
  rule <k> argsVal(argValsCons(iteratorRef(I:Int), #noArgVals)) ~> iterArgsResult =>
           iteratorRef(I)
       ... </k>
