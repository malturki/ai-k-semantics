  rule <k> #enumerateVal(VS:ArgVals) ~> forUnpackElseIter(IDS:IdItems, Body:Block, Else:Block) =>
           forUnpackElseItems(IDS, argValsToValItems(VS), Body, Else)
       ... </k>
    requires notBool emptyArgVals(VS)
