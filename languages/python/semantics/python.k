  rule fStringFormatSupported(V:Val) => pyStringConversionSupported(V)

  rule pyFloatStringConversionSupported(F:Float) => isInfinite(F) orBool isNaN(F)

  rule pyStringConversionSupported(_:Int) => true
  rule pyStringConversionSupported(True) => true
  rule pyStringConversionSupported(False) => true
  rule pyStringConversionSupported(None) => true
  rule pyStringConversionSupported(Ellipsis) => true
  rule pyStringConversionSupported(_:String) => true
  rule pyStringConversionSupported(F:Float) => pyFloatStringConversionSupported(F)
  rule pyStringConversionSupported(#bytes()) => true
  rule pyStringConversionSupported(bytesVal(VS:ValItems)) => valItemsAllByteInts(VS)
  rule pyStringConversionSupported(#bytearray()) => true
  rule pyStringConversionSupported(bytearrayVal(VS:ValItems)) => valItemsAllByteInts(VS)
  rule pyStringConversionSupported([]) => true
  rule pyStringConversionSupported(listVal(VS:ValItems)) => pyStringConversionItemsSupported(VS)
  rule pyStringConversionSupported(()) => true
  rule pyStringConversionSupported(tupleVal(VS:ValItems)) => pyStringConversionItemsSupported(VS)
  rule pyStringConversionSupported(({}):Val) => true
  rule pyStringConversionSupported(dictVal(DS:DictItems)) => pyStringConversionDictItemsSupported(DS)
  rule pyStringConversionSupported(set()) => true
  rule pyStringConversionSupported(setVal(VS:ValItems)) => pyStringConversionItemsSupported(VS)
  rule pyStringConversionSupported(frozenset()) => true
  rule pyStringConversionSupported(frozensetVal(VS:ValItems)) => pyStringConversionItemsSupported(VS)
  rule pyStringConversionSupported(rangeVal(_:Int, _:Int)) => true
  rule pyStringConversionSupported(rangeVal(_:Int, _:Int, _:Int)) => true
  rule pyStringConversionSupported(sliceVal(Start:Val, Stop:Val, Step:Val)) =>
    pyStringConversionSupported(Start)
      andBool pyStringConversionSupported(Stop)
      andBool pyStringConversionSupported(Step)
  rule pyStringConversionSupported(_:Val) => false [owise]

  rule pyStringConversionItemsSupported(valItemsLast(V:Val)) =>
    pyStringConversionSupported(V)
  rule pyStringConversionItemsSupported(valItemsCons(V:Val, VS:ValItems)) =>
    pyStringConversionSupported(V) andBool pyStringConversionItemsSupported(VS)

  rule pyStringConversionDictItemsSupported(dictItemsLast(K:Val, V:Val)) =>
    pyStringConversionSupported(K) andBool pyStringConversionSupported(V)
  rule pyStringConversionDictItemsSupported(dictItemsCons(K:Val, V:Val, DS:DictItems)) =>
    pyStringConversionSupported(K)
      andBool pyStringConversionSupported(V)
      andBool pyStringConversionDictItemsSupported(DS)

  rule pyFormatStr(I:Int) => Int2String(I)
  rule pyFormatStr(True) => "True"
  rule pyFormatStr(False) => "False"
  rule pyFormatStr(None) => "None"
  rule pyFormatStr(Ellipsis) => "Ellipsis"
  rule pyFormatStr(S:String) => S
  rule pyFormatStr(F:Float) => pyFloatReprStr(F)
  rule pyFormatStr(#bytes()) => pyReprStr(#bytes())
  rule pyFormatStr(bytesVal(VS:ValItems)) => pyReprStr(bytesVal(VS))
  rule pyFormatStr(#bytearray()) => pyReprStr(#bytearray())
  rule pyFormatStr(bytearrayVal(VS:ValItems)) => pyReprStr(bytearrayVal(VS))
  rule pyFormatStr([]) => pyReprStr([])
  rule pyFormatStr(listVal(VS:ValItems)) => pyReprStr(listVal(VS))
  rule pyFormatStr(()) => pyReprStr(())
  rule pyFormatStr(tupleVal(VS:ValItems)) => pyReprStr(tupleVal(VS))
  rule pyFormatStr(({}):Val) => pyReprStr(({}):Val)
  rule pyFormatStr(dictVal(DS:DictItems)) => pyReprStr(dictVal(DS))
  rule pyFormatStr(set()) => pyReprStr(set())
  rule pyFormatStr(setVal(VS:ValItems)) => pyReprStr(setVal(VS))
  rule pyFormatStr(frozenset()) => pyReprStr(frozenset())
  rule pyFormatStr(frozensetVal(VS:ValItems)) => pyReprStr(frozensetVal(VS))
  rule pyFormatStr(rangeVal(Start:Int, Stop:Int)) => pyReprStr(rangeVal(Start, Stop))
  rule pyFormatStr(rangeVal(Start:Int, Stop:Int, Step:Int)) => pyReprStr(rangeVal(Start, Stop, Step))
  rule pyFormatStr(sliceVal(Start:Val, Stop:Val, Step:Val)) => pyReprStr(sliceVal(Start, Stop, Step))
  rule pyReprStr(I:Int) => Int2String(I)
  rule pyReprStr(True) => "True"
  rule pyReprStr(False) => "False"
  rule pyReprStr(None) => "None"
  rule pyReprStr(Ellipsis) => "Ellipsis"
  rule pyReprStr(F:Float) => pyFloatReprStr(F)
  rule pyReprStr(S:String) =>
    stringReprQuoteChar(stringReprQuoteByte(S))
      +String stringReprPayload(S, stringReprQuoteByte(S), 0)
      +String stringReprQuoteChar(stringReprQuoteByte(S))
  rule pyReprStr(#bytes()) => "b''"
  rule pyReprStr(bytesVal(VS:ValItems)) =>
    "b" +String bytesReprQuoteChar(bytesReprQuoteByte(VS))
      +String bytesReprPayload(VS, bytesReprQuoteByte(VS))
      +String bytesReprQuoteChar(bytesReprQuoteByte(VS))
  rule pyReprStr(#bytearray()) => "bytearray(b'')"
  rule pyReprStr(bytearrayVal(VS:ValItems)) =>
    "bytearray(" +String pyReprStr(bytesVal(VS)) +String ")"
  rule pyReprStr([]) => "[]"
  rule pyReprStr(listVal(VS:ValItems)) => "[" +String pyReprValItems(VS) +String "]"
  rule pyReprStr(()) => "()"
  rule pyReprStr(tupleVal(valItemsLast(V:Val))) => "(" +String pyReprStr(V) +String ",)"
  rule pyReprStr(tupleVal(valItemsCons(V:Val, VS:ValItems))) =>
    "(" +String pyReprStr(V) +String ", " +String pyReprValItems(VS) +String ")"
  rule pyReprStr(({}):Val) => "{}"
  rule pyReprStr(dictVal(DS:DictItems)) => "{" +String pyReprDictItems(DS) +String "}"
  rule pyReprStr(set()) => "set()"
  rule pyReprStr(setVal(VS:ValItems)) => "{" +String pyReprValItems(VS) +String "}"
  rule pyReprStr(frozenset()) => "frozenset()"
  rule pyReprStr(frozensetVal(VS:ValItems)) => "frozenset({" +String pyReprValItems(VS) +String "})"
  rule pyReprStr(rangeVal(Start:Int, Stop:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ")"
  rule pyReprStr(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ")"
    requires Step ==Int 1
  rule pyReprStr(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ", " +String Int2String(Step) +String ")"
    requires Step =/=Int 1
  rule pyReprStr(sliceVal(Start:Val, Stop:Val, Step:Val)) =>
    "slice(" +String pyReprStr(Start) +String ", " +String pyReprStr(Stop) +String ", " +String pyReprStr(Step) +String ")"

  rule pyReprValItems(valItemsLast(V:Val)) => pyReprStr(V)
  rule pyReprValItems(valItemsCons(V:Val, VS:ValItems)) =>
    pyReprStr(V) +String ", " +String pyReprValItems(VS)

  rule pyReprDictItems(dictItemsLast(K:Val, V:Val)) =>
    pyReprStr(K) +String ": " +String pyReprStr(V)
  rule pyReprDictItems(dictItemsCons(K:Val, V:Val, DS:DictItems)) =>
    pyReprStr(K) +String ": " +String pyReprStr(V) +String ", " +String pyReprDictItems(DS)

  rule pyAsciiStr(I:Int) => Int2String(I)
  rule pyAsciiStr(True) => "True"
  rule pyAsciiStr(False) => "False"
  rule pyAsciiStr(None) => "None"
  rule pyAsciiStr(Ellipsis) => "Ellipsis"
  rule pyAsciiStr(F:Float) => pyFloatReprStr(F)
  rule pyAsciiStr(S:String) =>
    stringReprQuoteChar(stringReprQuoteByte(S))
      +String stringAsciiPayload(S, stringReprQuoteByte(S), 0)
      +String stringReprQuoteChar(stringReprQuoteByte(S))
  rule pyAsciiStr(#bytes()) => "b''"
  rule pyAsciiStr(bytesVal(VS:ValItems)) => pyReprStr(bytesVal(VS))
  rule pyAsciiStr(#bytearray()) => "bytearray(b'')"
  rule pyAsciiStr(bytearrayVal(VS:ValItems)) => pyReprStr(bytearrayVal(VS))
  rule pyAsciiStr([]) => "[]"
  rule pyAsciiStr(listVal(VS:ValItems)) => "[" +String pyAsciiValItems(VS) +String "]"
  rule pyAsciiStr(()) => "()"
  rule pyAsciiStr(tupleVal(valItemsLast(V:Val))) => "(" +String pyAsciiStr(V) +String ",)"
  rule pyAsciiStr(tupleVal(valItemsCons(V:Val, VS:ValItems))) =>
    "(" +String pyAsciiStr(V) +String ", " +String pyAsciiValItems(VS) +String ")"
  rule pyAsciiStr(({}):Val) => "{}"
  rule pyAsciiStr(dictVal(DS:DictItems)) => "{" +String pyAsciiDictItems(DS) +String "}"
  rule pyAsciiStr(set()) => "set()"
  rule pyAsciiStr(setVal(VS:ValItems)) => "{" +String pyAsciiValItems(VS) +String "}"
  rule pyAsciiStr(frozenset()) => "frozenset()"
  rule pyAsciiStr(frozensetVal(VS:ValItems)) => "frozenset({" +String pyAsciiValItems(VS) +String "})"
  rule pyAsciiStr(rangeVal(Start:Int, Stop:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ")"
  rule pyAsciiStr(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ")"
    requires Step ==Int 1
  rule pyAsciiStr(rangeVal(Start:Int, Stop:Int, Step:Int)) =>
    "range(" +String Int2String(Start) +String ", " +String Int2String(Stop) +String ", " +String Int2String(Step) +String ")"
    requires Step =/=Int 1
  rule pyAsciiStr(sliceVal(Start:Val, Stop:Val, Step:Val)) =>
    "slice(" +String pyAsciiStr(Start) +String ", " +String pyAsciiStr(Stop) +String ", " +String pyAsciiStr(Step) +String ")"

  rule pyAsciiValItems(valItemsLast(V:Val)) => pyAsciiStr(V)
  rule pyAsciiValItems(valItemsCons(V:Val, VS:ValItems)) =>
    pyAsciiStr(V) +String ", " +String pyAsciiValItems(VS)

  rule pyAsciiDictItems(dictItemsLast(K:Val, V:Val)) =>
    pyAsciiStr(K) +String ": " +String pyAsciiStr(V)
  rule pyAsciiDictItems(dictItemsCons(K:Val, V:Val, DS:DictItems)) =>
    pyAsciiStr(K) +String ": " +String pyAsciiStr(V) +String ", " +String pyAsciiDictItems(DS)

  rule pyFloatReprStr(F:Float) => "nan"
    requires isNaN(F)
  rule pyFloatReprStr(F:Float) => "-inf"
    requires isInfinite(F) andBool signFloat(F)
  rule pyFloatReprStr(F:Float) => "inf"
    requires isInfinite(F) andBool notBool signFloat(F)

  rule bytesContainsByte(valItemsLast(V:Val), B:Int) => intValue(V) ==Int B
    requires isIntLike(V) andBool intValue(V) >=Int 0 andBool intValue(V) <=Int 255
  rule bytesContainsByte(valItemsCons(V:Val, VS:ValItems), B:Int) =>
    intValue(V) ==Int B orBool bytesContainsByte(VS, B)
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool valItemsAllByteInts(VS)

  rule stringReprQuoteByte(S:String) => 34
    requires findString(S, chrChar(39), 0) >=Int 0 andBool findString(S, chrChar(34), 0) <Int 0
  rule stringReprQuoteByte(S:String) => 39
    requires notBool (findString(S, chrChar(39), 0) >=Int 0 andBool findString(S, chrChar(34), 0) <Int 0)

  rule stringReprQuoteChar(Q:Int) => chrChar(Q)
    requires Q ==Int 34 orBool Q ==Int 39

  rule stringReprPayload(S:String, _Quote:Int, I:Int) => ""
    requires I >=Int lengthString(S)
  rule stringReprPayload(S:String, Quote:Int, I:Int) =>
    stringReprChar(substrString(S, I, I +Int 1), Quote)
      +String stringReprPayload(S, Quote, I +Int 1)
    requires I <Int lengthString(S)

  rule stringReprChar(C:String, _Quote:Int) => "\\t"
    requires C ==String chrChar(9)
  rule stringReprChar(C:String, _Quote:Int) => "\\n"
    requires C ==String chrChar(10)
  rule stringReprChar(C:String, _Quote:Int) => "\\r"
    requires C ==String chrChar(13)
  rule stringReprChar(C:String, _Quote:Int) => "\\\\"
    requires C ==String chrChar(92)
  rule stringReprChar(C:String, Quote:Int) => "\\" +String stringReprQuoteChar(Quote)
    requires C ==String stringReprQuoteChar(Quote)
  rule stringReprChar(C:String, _Quote:Int) => "\\" +String "x" +String byteHex(stringAsciiControlCode(C))
    requires (C <String chrChar(32) orBool C ==String chrChar(127))
      andBool C =/=String chrChar(9)
      andBool C =/=String chrChar(10)
      andBool C =/=String chrChar(13)
  rule stringReprChar(C:String, Quote:Int) => C
    requires notBool ((C <String chrChar(32) orBool C ==String chrChar(127))
      orBool C ==String chrChar(92)
      orBool C ==String stringReprQuoteChar(Quote))

  rule stringByte(S:String, I:Int) => ordChar(substrString(S, I, I +Int 1))
    requires I >=Int 0 andBool I <Int lengthString(S)

  rule stringUtf8ContAt(S:String, I:Int) => true
    requires I <Int lengthString(S)
      andBool stringByte(S, I) >=Int 128
      andBool stringByte(S, I) <=Int 191
  rule stringUtf8ContAt(_:String, _:Int) => false [owise]

  rule stringUtf8Valid2At(S:String, I:Int) => true
    requires I +Int 1 <Int lengthString(S)
      andBool stringByte(S, I) >=Int 194
      andBool stringByte(S, I) <=Int 223
      andBool stringUtf8ContAt(S, I +Int 1)
  rule stringUtf8Valid2At(_:String, _:Int) => false [owise]

  rule stringUtf8Valid3At(S:String, I:Int) => true
    requires I +Int 2 <Int lengthString(S)
      andBool ((stringByte(S, I) ==Int 224 andBool stringByte(S, I +Int 1) >=Int 160 andBool stringByte(S, I +Int 1) <=Int 191)
        orBool (stringByte(S, I) >=Int 225 andBool stringByte(S, I) <=Int 236 andBool stringUtf8ContAt(S, I +Int 1))
        orBool (stringByte(S, I) ==Int 237 andBool stringByte(S, I +Int 1) >=Int 128 andBool stringByte(S, I +Int 1) <=Int 159)
        orBool (stringByte(S, I) >=Int 238 andBool stringByte(S, I) <=Int 239 andBool stringUtf8ContAt(S, I +Int 1)))
      andBool stringUtf8ContAt(S, I +Int 2)
  rule stringUtf8Valid3At(_:String, _:Int) => false [owise]

  rule stringUtf8Valid4At(S:String, I:Int) => true
    requires I +Int 3 <Int lengthString(S)
      andBool ((stringByte(S, I) ==Int 240 andBool stringByte(S, I +Int 1) >=Int 144 andBool stringByte(S, I +Int 1) <=Int 191)
        orBool (stringByte(S, I) >=Int 241 andBool stringByte(S, I) <=Int 243 andBool stringUtf8ContAt(S, I +Int 1))
        orBool (stringByte(S, I) ==Int 244 andBool stringByte(S, I +Int 1) >=Int 128 andBool stringByte(S, I +Int 1) <=Int 143))
      andBool stringUtf8ContAt(S, I +Int 2)
      andBool stringUtf8ContAt(S, I +Int 3)
  rule stringUtf8Valid4At(_:String, _:Int) => false [owise]

  rule stringUtf8Code2At(S:String, I:Int) =>
    ((stringByte(S, I) -Int 192) *Int 64)
      +Int (stringByte(S, I +Int 1) -Int 128)
    requires stringUtf8Valid2At(S, I)
  rule stringUtf8Code3At(S:String, I:Int) =>
    ((stringByte(S, I) -Int 224) *Int 4096)
      +Int ((stringByte(S, I +Int 1) -Int 128) *Int 64)
      +Int (stringByte(S, I +Int 2) -Int 128)
    requires stringUtf8Valid3At(S, I)
  rule stringUtf8Code4At(S:String, I:Int) =>
    ((stringByte(S, I) -Int 240) *Int 262144)
      +Int ((stringByte(S, I +Int 1) -Int 128) *Int 4096)
      +Int ((stringByte(S, I +Int 2) -Int 128) *Int 64)
      +Int (stringByte(S, I +Int 3) -Int 128)
    requires stringUtf8Valid4At(S, I)

  rule unicodeScalarCodePoint(C:Int) => true
    requires C >=Int 0
      andBool C <=Int 1114111
      andBool (C <Int 55296 orBool C >Int 57343)
  rule unicodeScalarCodePoint(_:Int) => false [owise]

  rule stringOneUnicodeChar(S:String) => true
    requires lengthString(S) ==Int 1 andBool stringByte(S, 0) <Int 128
  rule stringOneUnicodeChar(S:String) => true
    requires lengthString(S) ==Int 2 andBool stringUtf8Valid2At(S, 0)
  rule stringOneUnicodeChar(S:String) => true
    requires lengthString(S) ==Int 3 andBool stringUtf8Valid3At(S, 0)
  rule stringOneUnicodeChar(S:String) => true
    requires lengthString(S) ==Int 4 andBool stringUtf8Valid4At(S, 0)
  rule stringOneUnicodeChar(_:String) => false [owise]

  rule stringCodePointAt(S:String, I:Int) => stringByte(S, I)
    requires I <Int lengthString(S) andBool stringByte(S, I) <Int 128
  rule stringCodePointAt(S:String, I:Int) => stringUtf8Code2At(S, I)
    requires stringUtf8Valid2At(S, I)
  rule stringCodePointAt(S:String, I:Int) => stringUtf8Code3At(S, I)
    requires stringUtf8Valid3At(S, I)
  rule stringCodePointAt(S:String, I:Int) => stringUtf8Code4At(S, I)
    requires stringUtf8Valid4At(S, I)

  rule stringCodePointByteLenAt(S:String, I:Int) => 1
    requires I <Int lengthString(S) andBool stringByte(S, I) <Int 128
  rule stringCodePointByteLenAt(S:String, I:Int) => 2
    requires stringUtf8Valid2At(S, I)
  rule stringCodePointByteLenAt(S:String, I:Int) => 3
    requires stringUtf8Valid3At(S, I)
  rule stringCodePointByteLenAt(S:String, I:Int) => 4
    requires stringUtf8Valid4At(S, I)
  rule stringCodePointByteLenAt(S:String, I:Int) => 1
    requires I <Int lengthString(S)
      andBool stringByte(S, I) >=Int 128
      andBool notBool stringUtf8Valid2At(S, I)
      andBool notBool stringUtf8Valid3At(S, I)
      andBool notBool stringUtf8Valid4At(S, I)

  rule stringCodePointLen(S:String, I:Int) => 0
    requires I >=Int lengthString(S)
  rule stringCodePointLen(S:String, I:Int) => 1 +Int stringCodePointLen(S, I +Int 1)
    requires I <Int lengthString(S) andBool stringByte(S, I) <Int 128
  rule stringCodePointLen(S:String, I:Int) => 1 +Int stringCodePointLen(S, I +Int 2)
    requires stringUtf8Valid2At(S, I)
  rule stringCodePointLen(S:String, I:Int) => 1 +Int stringCodePointLen(S, I +Int 3)
    requires stringUtf8Valid3At(S, I)
  rule stringCodePointLen(S:String, I:Int) => 1 +Int stringCodePointLen(S, I +Int 4)
    requires stringUtf8Valid4At(S, I)
  rule stringCodePointLen(S:String, I:Int) => 1 +Int stringCodePointLen(S, I +Int 1)
    requires I <Int lengthString(S)
      andBool stringByte(S, I) >=Int 128
      andBool notBool stringUtf8Valid2At(S, I)
      andBool notBool stringUtf8Valid3At(S, I)
      andBool notBool stringUtf8Valid4At(S, I)

  rule stringCodePointPrefixByteLen(_S:String, Count:Int, I:Int) => I
    requires Count <=Int 0
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) => lengthString(S)
    requires Count >Int 0 andBool I >=Int lengthString(S)
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) =>
    stringCodePointPrefixByteLen(S, Count -Int 1, I +Int 1)
    requires Count >Int 0
      andBool I <Int lengthString(S)
      andBool stringByte(S, I) <Int 128
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) =>
    stringCodePointPrefixByteLen(S, Count -Int 1, I +Int 2)
    requires Count >Int 0 andBool stringUtf8Valid2At(S, I)
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) =>
    stringCodePointPrefixByteLen(S, Count -Int 1, I +Int 3)
    requires Count >Int 0 andBool stringUtf8Valid3At(S, I)
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) =>
    stringCodePointPrefixByteLen(S, Count -Int 1, I +Int 4)
    requires Count >Int 0 andBool stringUtf8Valid4At(S, I)
  rule stringCodePointPrefixByteLen(S:String, Count:Int, I:Int) =>
    stringCodePointPrefixByteLen(S, Count -Int 1, I +Int 1)
    requires Count >Int 0
      andBool I <Int lengthString(S)
      andBool stringByte(S, I) >=Int 128
      andBool notBool stringUtf8Valid2At(S, I)
      andBool notBool stringUtf8Valid3At(S, I)
      andBool notBool stringUtf8Valid4At(S, I)

  rule stringAsciiPayload(S:String, _Quote:Int, I:Int) => ""
    requires I >=Int lengthString(S)
  rule stringAsciiPayload(S:String, Quote:Int, I:Int) =>
    stringReprChar(substrString(S, I, I +Int 1), Quote)
      +String stringAsciiPayload(S, Quote, I +Int 1)
    requires I <Int lengthString(S) andBool stringByte(S, I) <Int 128
  rule stringAsciiPayload(S:String, Quote:Int, I:Int) =>
    stringAsciiEscape(stringUtf8Code2At(S, I)) +String stringAsciiPayload(S, Quote, I +Int 2)
    requires stringUtf8Valid2At(S, I)
  rule stringAsciiPayload(S:String, Quote:Int, I:Int) =>
    stringAsciiEscape(stringUtf8Code3At(S, I)) +String stringAsciiPayload(S, Quote, I +Int 3)
    requires stringUtf8Valid3At(S, I)
  rule stringAsciiPayload(S:String, Quote:Int, I:Int) =>
    stringAsciiEscape(stringUtf8Code4At(S, I)) +String stringAsciiPayload(S, Quote, I +Int 4)
    requires stringUtf8Valid4At(S, I)
  rule stringAsciiPayload(S:String, Quote:Int, I:Int) =>
    "\\x" +String fixedHex(stringByte(S, I), 2) +String stringAsciiPayload(S, Quote, I +Int 1)
    requires I <Int lengthString(S)
      andBool stringByte(S, I) >=Int 128
      andBool notBool stringUtf8Valid2At(S, I)
      andBool notBool stringUtf8Valid3At(S, I)
      andBool notBool stringUtf8Valid4At(S, I)

  rule stringAsciiEscape(Code:Int) => "\\x" +String fixedHex(Code, 2)
    requires Code >=Int 128 andBool Code <=Int 255
  rule stringAsciiEscape(Code:Int) => "\\u" +String fixedHex(Code, 4)
    requires Code >=Int 256 andBool Code <=Int 65535
  rule stringAsciiEscape(Code:Int) => "\\U" +String fixedHex(Code, 8)
    requires Code >=Int 65536 andBool Code <=Int 1114111

  rule fixedHex(_I:Int, Width:Int) => ""
    requires Width <=Int 0
  rule fixedHex(I:Int, Width:Int) =>
    fixedHex(I /Int 16, Width -Int 1) +String byteHexDigit(I %Int 16)
    requires I >=Int 0 andBool Width >Int 0

  rule stringAsciiControlCode(C:String) => 0 requires C ==String chrChar(0)
  rule stringAsciiControlCode(C:String) => 1 requires C ==String chrChar(1)
  rule stringAsciiControlCode(C:String) => 2 requires C ==String chrChar(2)
  rule stringAsciiControlCode(C:String) => 3 requires C ==String chrChar(3)
  rule stringAsciiControlCode(C:String) => 4 requires C ==String chrChar(4)
  rule stringAsciiControlCode(C:String) => 5 requires C ==String chrChar(5)
  rule stringAsciiControlCode(C:String) => 6 requires C ==String chrChar(6)
  rule stringAsciiControlCode(C:String) => 7 requires C ==String chrChar(7)
  rule stringAsciiControlCode(C:String) => 8 requires C ==String chrChar(8)
  rule stringAsciiControlCode(C:String) => 11 requires C ==String chrChar(11)
  rule stringAsciiControlCode(C:String) => 12 requires C ==String chrChar(12)
  rule stringAsciiControlCode(C:String) => 14 requires C ==String chrChar(14)
  rule stringAsciiControlCode(C:String) => 15 requires C ==String chrChar(15)
  rule stringAsciiControlCode(C:String) => 16 requires C ==String chrChar(16)
  rule stringAsciiControlCode(C:String) => 17 requires C ==String chrChar(17)
  rule stringAsciiControlCode(C:String) => 18 requires C ==String chrChar(18)
  rule stringAsciiControlCode(C:String) => 19 requires C ==String chrChar(19)
  rule stringAsciiControlCode(C:String) => 20 requires C ==String chrChar(20)
  rule stringAsciiControlCode(C:String) => 21 requires C ==String chrChar(21)
  rule stringAsciiControlCode(C:String) => 22 requires C ==String chrChar(22)
  rule stringAsciiControlCode(C:String) => 23 requires C ==String chrChar(23)
  rule stringAsciiControlCode(C:String) => 24 requires C ==String chrChar(24)
  rule stringAsciiControlCode(C:String) => 25 requires C ==String chrChar(25)
  rule stringAsciiControlCode(C:String) => 26 requires C ==String chrChar(26)
  rule stringAsciiControlCode(C:String) => 27 requires C ==String chrChar(27)
  rule stringAsciiControlCode(C:String) => 28 requires C ==String chrChar(28)
  rule stringAsciiControlCode(C:String) => 29 requires C ==String chrChar(29)
  rule stringAsciiControlCode(C:String) => 30 requires C ==String chrChar(30)
  rule stringAsciiControlCode(C:String) => 31 requires C ==String chrChar(31)
  rule stringAsciiControlCode(C:String) => 127 requires C ==String chrChar(127)

  rule bytesReprQuoteByte(VS:ValItems) => 34
    requires bytesContainsByte(VS, 39) andBool notBool bytesContainsByte(VS, 34)
  rule bytesReprQuoteByte(VS:ValItems) => 39
    requires notBool (bytesContainsByte(VS, 39) andBool notBool bytesContainsByte(VS, 34))

  rule bytesReprQuoteChar(Q:Int) => chrChar(Q)
    requires Q ==Int 34 orBool Q ==Int 39

  rule bytesReprPayload(valItemsLast(V:Val), Quote:Int) => bytesReprByte(V, Quote)
  rule bytesReprPayload(valItemsCons(V:Val, VS:ValItems), Quote:Int) =>
    bytesReprByte(V, Quote) +String bytesReprPayload(VS, Quote)

  rule bytesReprByte(V:Val, _Quote:Int) => "\\t"
    requires isIntLike(V) andBool intValue(V) ==Int 9
  rule bytesReprByte(V:Val, _Quote:Int) => "\\n"
    requires isIntLike(V) andBool intValue(V) ==Int 10
  rule bytesReprByte(V:Val, _Quote:Int) => "\\r"
    requires isIntLike(V) andBool intValue(V) ==Int 13
  rule bytesReprByte(V:Val, _Quote:Int) => "\\\\"
    requires isIntLike(V) andBool intValue(V) ==Int 92
  rule bytesReprByte(V:Val, Quote:Int) => "\\" +String bytesReprQuoteChar(Quote)
    requires isIntLike(V) andBool intValue(V) ==Int Quote
  rule bytesReprByte(V:Val, Quote:Int) => chrChar(intValue(V))
    requires isIntLike(V)
      andBool intValue(V) >=Int 32
      andBool intValue(V) <=Int 126
      andBool intValue(V) =/=Int 92
      andBool intValue(V) =/=Int Quote
  rule bytesReprByte(V:Val, _Quote:Int) => "\\" +String "x" +String byteHex(intValue(V))
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
      andBool (intValue(V) <Int 32 orBool intValue(V) >Int 126)
      andBool intValue(V) =/=Int 9
      andBool intValue(V) =/=Int 10
      andBool intValue(V) =/=Int 13

  rule byteHex(B:Int) => byteHexDigit(B /Int 16) +String byteHexDigit(B %Int 16)
    requires B >=Int 0 andBool B <=Int 255
  rule byteHexDigit(I:Int) => Int2String(I)
    requires I >=Int 0 andBool I <=Int 9
  rule byteHexDigit(10) => "a"
  rule byteHexDigit(11) => "b"
  rule byteHexDigit(12) => "c"
  rule byteHexDigit(13) => "d"
  rule byteHexDigit(14) => "e"
  rule byteHexDigit(15) => "f"
  rule bytearrayHex(#bytearray()) => ""
  rule bytearrayHex(bytearrayVal(VS:ValItems)) => bytearrayHexItems(VS)
  rule bytearrayHexItems(valItemsLast(V:Val)) => byteHex(intValue(V))
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
  rule bytearrayHexItems(valItemsCons(V:Val, VS:ValItems)) =>
    byteHex(intValue(V)) +String bytearrayHexItems(VS)
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
  rule bytearrayHexWithSep(#bytearray(), _Sep:String, _BytesPerSep:Int) => ""
  rule bytearrayHexWithSep(bytearrayVal(VS:ValItems), Sep:String, BytesPerSep:Int) =>
    bytearrayHexSepItems(VS, Sep, BytesPerSep, valItemsLen(VS), 0)
  rule bytearrayHexSepItems(valItemsLast(V:Val), Sep:String, BytesPerSep:Int, Len:Int, I:Int) =>
    bytearrayHexSepPrefix(Sep, BytesPerSep, Len, I) +String byteHex(intValue(V))
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
  rule bytearrayHexSepItems(valItemsCons(V:Val, VS:ValItems), Sep:String, BytesPerSep:Int, Len:Int, I:Int) =>
    bytearrayHexSepPrefix(Sep, BytesPerSep, Len, I) +String byteHex(intValue(V))
      +String bytearrayHexSepItems(VS, Sep, BytesPerSep, Len, I +Int 1)
    requires isIntLike(V)
      andBool intValue(V) >=Int 0
      andBool intValue(V) <=Int 255
  rule bytearrayHexSepPrefix(_Sep:String, _BytesPerSep:Int, _Len:Int, 0) => ""
  rule bytearrayHexSepPrefix(_Sep:String, 0, _Len:Int, _I:Int) => ""
  rule bytearrayHexSepPrefix(Sep:String, BytesPerSep:Int, Len:Int, I:Int) => Sep
    requires BytesPerSep >Int 0
      andBool I >Int 0
      andBool ((Len -Int I) %Int BytesPerSep) ==Int 0
  rule bytearrayHexSepPrefix(_Sep:String, BytesPerSep:Int, Len:Int, I:Int) => ""
    requires BytesPerSep >Int 0
      andBool I >Int 0
      andBool ((Len -Int I) %Int BytesPerSep) =/=Int 0
  rule bytearrayHexSepPrefix(Sep:String, BytesPerSep:Int, _Len:Int, I:Int) => Sep
    requires BytesPerSep <Int 0
      andBool I >Int 0
      andBool (I %Int (0 -Int BytesPerSep)) ==Int 0
  rule bytearrayHexSepPrefix(_Sep:String, BytesPerSep:Int, _Len:Int, I:Int) => ""
    requires BytesPerSep <Int 0
      andBool I >Int 0
      andBool (I %Int (0 -Int BytesPerSep)) =/=Int 0
  rule bytearrayHexSepString(S:String) => S
    requires bytearrayHexSepOk(S)
  rule bytearrayHexSepString(bytesVal(VS:ValItems)) => bytesAsciiString(VS)
    requires bytearrayHexSepOk(bytesVal(VS))
  rule bytesHex(#bytes()) => ""
  rule bytesHex(bytesVal(VS:ValItems)) => bytearrayHexItems(VS)
