       <iterators> ... I |-> #noArgVals ... </iterators>
  rule <k> V:Val ~> callableIteratorNext(I:Int, Sentinel:Val) =>
           exceptionSignal(#exception(#token("StopIteration", "Id")))
       ... </k>
       <iterators> ... I |-> (callableIterator(_:Val, Sentinel) => #noArgVals) ... </iterators>
