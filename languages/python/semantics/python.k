           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCase(#matchOr(P1:MatchPattern, P2:MatchPattern), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCase(#matchOr(P1:MatchPattern, P2:MatchPattern), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCases(#matchOr(P1:MatchPattern, P2:MatchPattern), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCases(#matchOr(P1:MatchPattern, P2:MatchPattern), {}, _Rest:MatchCases)) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchOr(P1, P2)) </env>
    requires matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCases(#matchOr(P1:MatchPattern, P2:MatchPattern), _Body:Block, Rest:MatchCases)) =>
           matchDispatch(V, Rest)
      ... </k>
    requires notBool matchSimplePattern(V, #matchOr(P1, P2))
  rule <k> matchDispatch(V:Val, #matchCase(#matchAs(P:MatchPattern, Name:Id), block(SS:Stmts))) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchAs(P, Name)) </env>
    requires matchSimplePattern(V, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchAs(P:MatchPattern, Name:Id), {})) =>
           stmtNoResult
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchAs(P, Name)) </env>
    requires matchSimplePattern(V, P)
  rule <k> matchDispatch(V:Val, #matchCase(#matchAs(P:MatchPattern, _Name:Id), _Body:Block)) =>
           stmtNoResult
      ... </k>
    requires notBool matchSimplePattern(V, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchAs(P:MatchPattern, Name:Id), block(SS:Stmts), _Rest:MatchCases)) =>
           SS ~> matchDone
      ... </k>
      <env> Rho => bindMatchPattern(Rho, V, #matchAs(P, Name)) </env>
    requires matchSimplePattern(V, P)
  rule <k> matchDispatch(V:Val, #matchCases(#matchAs(P:MatchPattern, Name:Id), {}, _Rest:MatchCases)) =>
