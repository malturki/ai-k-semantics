  rule <k> forTargetUnpackStmt(TS:Targets, E:Exp, Body:Block) =>
           E ~> forTargetUnpackIter(TS, Body)
       ... </k>
  rule <k> [] ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> () ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, VS, Body)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackIter(_:Targets, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetUnpackIter(TS:Targets, Body:Block) =>
           forTargetUnpackItems(TS, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forTargetUnpackItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forTargetUnpackItems(TS, Rest, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsLast(V:Val), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsCons(V:Val, Rest:ValItems), {}) =>
           forTargetUnpackItems(TS, Rest, {})
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)
  rule <k> forTargetUnpackItems(TS:Targets, valItemsLast(V:Val), {}) =>
           stmtNoResult
       ... </k>
       <env> Rho => bindTarget(Rho, targetSeq(TS), V) </env>
    requires targetValueArityOk(targetSeq(TS), V)

  rule <k> forTargetStmt(T:Target, E:Exp, Body:Block) =>
           E ~> forTargetIter(T, Body)
       ... </k>
  rule <k> [] ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> listVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> () ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> tupleVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> #bytes() ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> S:String ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires lengthString(S) ==Int 0
  rule <k> S:String ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, stringToValItems(S, 0, lengthString(S)), Body)
       ... </k>
    requires lengthString(S) >Int 0
  rule <k> ({}):Val ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> dictVal(DS:DictItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, dictKeysToValItems(DS), Body)
       ... </k>
  rule <k> set() ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
  rule <k> setVal(VS:ValItems) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, VS, Body)
       ... </k>
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, rangeToValItems(Start, Stop, 1, 0, pyRangeLen(Start, Stop, 1)), Body)
       ... </k>
    requires pyRangeLen(Start, Stop, 1) >Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetIter(_:Target, _:Block) => stmtNoResult ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule <k> rangeVal(Start:Int, Stop:Int, Step:Int) ~> forTargetIter(T:Target, Body:Block) =>
           forTargetItems(T, rangeToValItems(Start, Stop, Step, 0, pyRangeLen(Start, Stop, Step)), Body)
       ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) >Int 0

  rule <k> forTargetItems(T:Target, valItemsCons(V:Val, Rest:ValItems), block(SS:Stmts)) =>
           SS ~> forTargetItems(T, Rest, block(SS))
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
    requires targetValueArityOk(T, V)
  rule <k> forTargetItems(T:Target, valItemsLast(V:Val), block(SS:Stmts)) =>
           SS ~> forDone
       ... </k>
       <env> Rho => bindTarget(Rho, T, V) </env>
