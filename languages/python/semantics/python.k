           stmtNoResult
       ... </k>
       <env> Rho => bindStarUnpack(Rho, Prefix, Star, Suffix, stringToValItems(S, 0, lengthString(S))) </env>
    requires lengthString(S) >Int 0
      andBool starUnpackArityOk(Prefix, Suffix, lengthString(S))
