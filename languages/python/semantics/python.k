requires "domains.md"

module PYTHON-SYNTAX
  imports INT-SYNTAX
  imports ID-SYNTAX
  imports STRING-SYNTAX
  imports FLOAT-SYNTAX

  syntax Val ::= Int
               | Float
               | "#complex" "(" Float "," Float ")" [symbol(complexVal)]
               | String
               | "True" [symbol(pyTrue)]
               | "False" [symbol(pyFalse)]
               | "None" [symbol(pyNone)]
               | "Ellipsis" [symbol(pyEllipsis)]
               | "#bytes" "(" ")" [symbol(emptyBytesVal)]
               | "#bytes" "(" ValItems ")" [symbol(bytesVal)]
               | "[" "]" [symbol(emptyListVal)]
               | "[" ValItems "]" [symbol(listVal)]
               | "(" ")" [symbol(emptyTupleVal)]
               | "(" ValItems ")" [symbol(tupleVal)]
               | "{" "}" [symbol(emptyDictVal)]
               | "{" DictItems "}" [symbol(dictVal)]
               | "set" "(" ")" [symbol(emptySetVal)]
               | "{" ValItems "}" [symbol(setVal)]
               | "#kwDefaultMissing" [symbol(kwDefaultMissing)]
               | "#exception" "(" Id ")" [symbol(exceptionVal)]

  syntax ValItems ::= Val "," [symbol(valItemsLast)]
                    | Val "," ValItems [symbol(valItemsCons)]

  syntax DictItems ::= Val ":" Val "," [symbol(dictItemsLast)]
                     | Val ":" Val "," DictItems [symbol(dictItemsCons)]

  syntax IdItems ::= "#id" "(" Id ")" [symbol(idItemsLast)]
                   | "#noIds" [symbol(noIdItems)]
                   | "#ids" "(" Id "," IdItems ")" [symbol(idItemsCons)]

  syntax Target ::= "#targetName" "(" Id ")" [symbol(targetName)]
                  | "#targetSeq" "(" Targets ")" [symbol(targetSeq)]
                  | "#targetStarSeq" "(" MaybeTargets ";" Id ";" MaybeTargets ")" [symbol(targetStarSeq)]

  syntax Targets ::= "#targetLast" "(" Target ")" [symbol(targetsLast)]
                   | "#targetCons" "(" Target "," Targets ")" [symbol(targetsCons)]

  syntax MaybeTargets ::= "#noTargets" [symbol(noTargets)]
                        | "#targets" "(" Targets ")" [symbol(someTargets)]

  syntax ArgExps ::= "#noArgs" [symbol(noArgExps)]
                   | "#arg" "(" Exp ")" [symbol(argExp)]
                   | "#args" "(" Exp "," ArgExps ")" [symbol(argExpsCons)]
                   | "#starArg" "(" Exp ")" [symbol(starArgExp)]
                   | "#starArgs" "(" Exp "," ArgExps ")" [symbol(starArgExpsCons)]

  syntax KwArgExps ::= "#noKwArgs" [symbol(noKwArgExps)]
                     | "#kwArg" "(" Id "," Exp ")" [symbol(kwArgExp)]
                     | "#kwArgs" "(" Id "," Exp "," KwArgExps ")" [symbol(kwArgExpsCons)]
                     | "#kwStarArg" "(" Exp ")" [symbol(kwStarArgExp)]
                     | "#kwStarArgs" "(" Exp "," KwArgExps ")" [symbol(kwStarArgExpsCons)]

  syntax DictExps ::= "#noDictItems" [symbol(noDictExps)]
                    | "#dictItem" "(" Exp "," Exp ")" [symbol(dictExpItem)]
                    | "#dictItems" "(" Exp "," Exp "," DictExps ")" [symbol(dictExpsCons)]
                    | "#dictStarItem" "(" Exp ")" [symbol(dictStarExpItem)]
                    | "#dictStarItems" "(" Exp "," DictExps ")" [symbol(dictStarExpsCons)]

  syntax CompFilters ::= "#filter" "(" Exp ")" [symbol(compFilterLast)]
                       | "#filters" "(" Exp "," CompFilters ")" [symbol(compFiltersCons)]

  syntax MaybeCompFilters ::= "#noFilters" [symbol(noCompFilters)]
                            | CompFilters

  syntax CompClauses ::= "#compClause" "(" Exp "," Target "," MaybeCompFilters ")" [symbol(compClause)]
                       | "#compClauses" "(" Exp "," Target "," MaybeCompFilters "," CompClauses ")" [symbol(compClausesCons)]

  syntax MaybeCompClauses ::= "#noCompClauses" [symbol(noCompClauses)]
                            | "#compRest" "(" CompClauses ")" [symbol(compRest)]

  syntax MatchPattern ::= "#matchValue" "(" Exp ")" [symbol(matchValuePattern)]
                        | "#matchSingleton" "(" Val ")" [symbol(matchSingletonPattern)]
                        | "#matchCapture" "(" Id ")" [symbol(matchCapturePattern)]
                        | "#matchOr" "(" MatchPattern "," MatchPattern ")" [symbol(matchOrPattern)]
                        | "#matchAs" "(" MatchPattern "," Id ")" [symbol(matchAsPattern)]
                        | "#matchClass" "(" Id ")" [symbol(matchClassPattern)]
                        | "#matchClassArg" "(" Id "," MatchPattern ")" [symbol(matchClassArgPattern)]
                        | "#matchClassKw" "(" Id "," MatchAttrPatterns ")" [symbol(matchClassKwPattern)]
                        | "#matchClassArgKw" "(" Id "," MatchPattern "," MatchAttrPatterns ")" [symbol(matchClassArgKwPattern)]
                        | "#matchSequence" "(" MatchPatterns ")" [symbol(matchSequencePattern)]
                        | "#matchSequenceStar" "(" MatchPatterns "," MatchPatterns ")" [symbol(matchSequenceStarPattern)]
                        | "#matchSequenceStarCapture" "(" MatchPatterns "," Id "," MatchPatterns ")" [symbol(matchSequenceStarCapturePattern)]
                        | "#matchMapping" "(" MatchMapPatterns ")" [symbol(matchMappingPattern)]
                        | "#matchMappingRest" "(" MatchMapPatterns "," Id ")" [symbol(matchMappingRestPattern)]
                        | "#matchWildcard" [symbol(matchWildcardPattern)]

  syntax MatchPatterns ::= "#matchNoPatterns" [symbol(matchNoPatterns)]
                         | "#matchPattern" "(" MatchPattern "," MatchPatterns ")" [symbol(matchPatternCons)]

  syntax MatchMapPatterns ::= "#matchNoMapPatterns" [symbol(matchNoMapPatterns)]
                            | "#matchMapPattern" "(" Val "," MatchPattern "," MatchMapPatterns ")" [symbol(matchMapPatternCons)]

  syntax MatchAttrPatterns ::= "#matchNoAttrPatterns" [symbol(matchNoAttrPatterns)]
                             | "#matchAttrPattern" "(" Id "," MatchPattern "," MatchAttrPatterns ")" [symbol(matchAttrPatternCons)]

  syntax MatchCases ::= "#matchCase" "(" MatchPattern "," Block ")" [symbol(matchCaseLast)]
                      | "#matchCases" "(" MatchPattern "," Block "," MatchCases ")" [symbol(matchCasesCons)]
                      | "#matchCaseGuard" "(" MatchPattern "," Exp "," Block ")" [symbol(matchCaseGuardLast)]
                      | "#matchCasesGuard" "(" MatchPattern "," Exp "," Block "," MatchCases ")" [symbol(matchCasesGuardCons)]

  syntax MaybeMatchCases ::= "#noMatchCases" [symbol(noMatchCases)]
                           | "#someMatchCases" "(" MatchCases ")" [symbol(someMatchCases)]

  syntax ExceptHandlers ::= "#except" "(" Id "," Block ")" [symbol(exceptHandlersLast)]
                          | "#exceptAs" "(" Id "," Id "," Block ")" [symbol(exceptHandlersAsLast)]
                          | "#exceptTuple" "(" IdItems "," Block ")" [symbol(exceptHandlersTupleLast)]
                          | "#exceptTupleAs" "(" IdItems "," Id "," Block ")" [symbol(exceptHandlersTupleAsLast)]
                          | "#exceptAny" "(" Block ")" [symbol(exceptHandlersAnyLast)]
                          | "#excepts" "(" Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersCons)]
                          | "#exceptsAs" "(" Id "," Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersAsCons)]
                          | "#exceptsTuple" "(" IdItems "," Block "," ExceptHandlers ")" [symbol(exceptHandlersTupleCons)]
                          | "#exceptsTupleAs" "(" IdItems "," Id "," Block "," ExceptHandlers ")" [symbol(exceptHandlersTupleAsCons)]

  syntax CmpOp ::= "#lt" [symbol(cmpLt)]
                 | "#le" [symbol(cmpLe)]
                 | "#gt" [symbol(cmpGt)]
                 | "#ge" [symbol(cmpGe)]
                 | "#eq" [symbol(cmpEq)]
                 | "#ne" [symbol(cmpNe)]
                 | "#is" [symbol(cmpIs)]
                 | "#isNot" [symbol(cmpIsNot)]
                 | "#in" [symbol(cmpIn)]
                 | "#notIn" [symbol(cmpNotIn)]

  syntax AugOp ::= "#augAdd" [symbol(augAddOp)]
                 | "#augSub" [symbol(augSubOp)]
                 | "#augMul" [symbol(augMulOp)]
                 | "#augTrueDiv" [symbol(augTrueDivOp)]
                 | "#augFloorDiv" [symbol(augFloorDivOp)]
                 | "#augMod" [symbol(augModOp)]
                 | "#augPow" [symbol(augPowOp)]
                 | "#augLShift" [symbol(augLShiftOp)]
                 | "#augRShift" [symbol(augRShiftOp)]
                 | "#augBitAnd" [symbol(augBitAndOp)]
                 | "#augBitXor" [symbol(augBitXorOp)]
                 | "#augBitOr" [symbol(augBitOrOp)]

  syntax CmpChain ::= "#cmpLast" "(" CmpOp "," Exp ")" [symbol(cmpChainLast)]
                    | "#cmpCons" "(" CmpOp "," Exp "," CmpChain ")" [symbol(cmpChainCons)]

  syntax Stmts ::= Stmt ";" Stmts [symbol(stmtsCons)]
                 | Stmt ";" [symbol(stmtsLast)]

  syntax Block ::= "{" "}" [symbol(emptyBlock)]
                 | "{" Stmts "}" [symbol(block)]

  syntax FunctionSpec ::= "#function" "(" Id "," Block ")" [symbol(functionSpecOne)]
                        | "#functionArgs" "(" IdItems "," Block ")" [symbol(functionSpecArgs)]
                        | "#functionDefaults" "(" IdItems "," ArgExps "," Block ")" [symbol(functionSpecDefaults)]
                        | "#functionVarArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecVarArgs)]
                        | "#functionVarArgsKwOnly" "(" IdItems "," Id "," IdItems "," Block ")" [symbol(functionSpecVarArgsKwOnly)]
                        | "#functionVarArgsKwOnlyKwArgs" "(" IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionSpecVarArgsKwOnlyKwArgs)]
                        | "#functionVarKwArgs" "(" IdItems "," Id "," Id "," Block ")" [symbol(functionSpecVarKwArgs)]
                        | "#functionKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecKwArgs)]
                        | "#functionPosOnly" "(" IdItems "," IdItems "," Block ")" [symbol(functionSpecPosOnly)]
                        | "#functionPosOnlyVarArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyVarArgs)]
                        | "#functionPosOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyKwArgs)]
                        | "#functionPosOnlyVarKwArgs" "(" IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionSpecPosOnlyVarKwArgs)]
                        | "#functionPosOnlyVarArgsKwOnly" "(" IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionSpecPosOnlyVarArgsKwOnly)]
                        | "#functionPosOnlyVarArgsKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyVarArgsKwOnlyKwArgs)]
                        | "#functionPosOnlyKwOnly" "(" IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionSpecPosOnlyKwOnly)]
                        | "#functionPosOnlyKwOnlyKwArgs" "(" IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosOnlyKwOnlyKwArgs)]
                        | "#functionKwOnly" "(" IdItems "," Block ")" [symbol(functionSpecKwOnly)]
                        | "#functionKwOnlyKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionSpecKwOnlyKwArgs)]
                        | "#functionPosKwOnly" "(" IdItems "," IdItems "," Block ")" [symbol(functionSpecPosKwOnly)]
                        | "#functionPosKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionSpecPosKwOnlyKwArgs)]
                        | "#functionDefaultSpec" "(" ArgExps "," FunctionDefaultBuilder ")" [symbol(functionSpecDefaultBuilder)]
                        | "#functionTwoDefaultSpec" "(" ArgExps "," ArgExps "," FunctionTwoDefaultBuilder ")" [symbol(functionSpecTwoDefaultBuilder)]

  syntax FunctionDefaultBuilder ::= "#buildFunctionDefaults" "(" IdItems "," Block ")" [symbol(functionDefaultBuilderDefaults)]
                                  | "#buildFunctionVarArgsDefaults" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderVarArgsDefaults)]
                                  | "#buildFunctionVarKwArgsDefaults" "(" IdItems "," Id "," Id "," Block ")" [symbol(functionDefaultBuilderVarKwArgsDefaults)]
                                  | "#buildFunctionKwArgsDefaults" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderKwArgsDefaults)]
                                  | "#buildFunctionPosOnlyDefaults" "(" IdItems "," IdItems "," Block ")" [symbol(functionDefaultBuilderPosOnlyDefaults)]
                                  | "#buildFunctionPosOnlyVarArgsDefaults" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyVarArgsDefaults)]
                                  | "#buildFunctionPosOnlyKwArgsDefaults" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyKwArgsDefaults)]
                                  | "#buildFunctionPosOnlyVarKwArgsDefaults" "(" IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefaultBuilderPosOnlyVarKwArgsDefaults)]
                                  | "#buildFunctionKwDefaults" "(" IdItems "," Block ")" [symbol(functionDefaultBuilderKwDefaults)]
                                  | "#buildFunctionKwDefaultsKwArgs" "(" IdItems "," Id "," Block ")" [symbol(functionDefaultBuilderKwDefaultsKwArgs)]

  syntax FunctionTwoDefaultBuilder ::= "#buildFunctionVarArgsKwDefaults" "(" IdItems "," Id "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderVarArgsKwDefaults)]
                                     | "#buildFunctionVarArgsKwDefaultsKwArgs" "(" IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderVarArgsKwDefaultsKwArgs)]
                                     | "#buildFunctionPosOnlyVarArgsKwDefaults" "(" IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyVarArgsKwDefaults)]
                                     | "#buildFunctionPosOnlyVarArgsKwDefaultsKwArgs" "(" IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyVarArgsKwDefaultsKwArgs)]
                                     | "#buildFunctionPosOnlyKwOnlyDefaults" "(" IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyKwOnlyDefaults)]
                                     | "#buildFunctionPosOnlyKwDefaultsKwArgs" "(" IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosOnlyKwDefaultsKwArgs)]
                                     | "#buildFunctionPosKwDefaults" "(" IdItems "," IdItems "," Block ")" [symbol(functionTwoDefaultBuilderPosKwDefaults)]
                                     | "#buildFunctionPosKwDefaultsKwArgs" "(" IdItems "," IdItems "," Id "," Block ")" [symbol(functionTwoDefaultBuilderPosKwDefaultsKwArgs)]

  syntax Stmt ::= Exp
                | "pass" [symbol(passStmt)]
                | "break" [symbol(breakStmt)]
                | "continue" [symbol(continueStmt)]
                | "assert" Exp [symbol(assertStmt), strict]
                | "#assertMsg" "(" Exp "," Exp ")" [symbol(assertMsgStmt), strict(1)]
                | "global" Id [symbol(globalStmt)]
                | "#globalMany" "(" IdItems ")" [symbol(globalManyStmt)]
                | "del" Id [symbol(delNameStmt)]
                | "#delMany" "(" IdItems ")" [symbol(delManyStmt)]
                | "#delSubscript" "(" Id "," Exp ")" [symbol(delSubscriptStmt)]
                | "#delSlice" "(" Id "," Exp "," Exp ")" [symbol(delSliceStmt)]
                | "#delSliceStep" "(" Id "," Exp "," Exp "," Exp ")" [symbol(delSliceStepStmt)]
                | Id "=" Exp [symbol(assignStmt), strict(2)]
                | "#assignName" "(" Id "," Exp ")" [symbol(assignNameStmt), strict(2)]
                | Id "+=" Exp [symbol(augAddStmt)]
                | Id "-=" Exp [symbol(augSubStmt)]
                | Id "*=" Exp [symbol(augMulStmt)]
                | Id "/=" Exp [symbol(augTrueDivStmt)]
                | Id "%=" Exp [symbol(augModStmt)]
                | Id "**=" Exp [symbol(augPowStmt)]
                | Id "<<=" Exp [symbol(augLShiftStmt)]
                | Id ">>=" Exp [symbol(augRShiftStmt)]
                | Id "&=" Exp [symbol(augBitAndStmt)]
                | Id "^=" Exp [symbol(augBitXorStmt)]
                | Id "|=" Exp [symbol(augBitOrStmt)]
                | "#floorDivAssign" "(" Id "," Exp ")" [symbol(augFloorDivStmt)]
                | "#assignMany" "(" IdItems ";" Exp ")" [symbol(assignManyStmt), strict(2)]
                | "#subscriptAssign" "(" Id "," Exp "," Exp ")" [symbol(subscriptAssignStmt)]
                | "#subscriptAug" "(" Id "," Exp "," AugOp "," Exp ")" [symbol(subscriptAugStmt)]
                | "#sliceAssign" "(" Id "," Exp "," Exp "," Exp ")" [symbol(sliceAssignStmt)]
                | "#sliceStepAssign" "(" Id "," Exp "," Exp "," Exp "," Exp ")" [symbol(sliceStepAssignStmt)]
                | "#unpackAssign" "(" IdItems ";" Exp ")" [symbol(unpackAssignStmt), strict(2)]
                | "#unpackStarAssign" "(" IdItems ";" Id ";" IdItems ";" Exp ")" [symbol(unpackStarAssignStmt), strict(4)]
                | "#unpackTargetAssign" "(" Targets ";" Exp ")" [symbol(unpackTargetAssignStmt), strict(2)]
                | "#targetAssign" "(" Target ";" Exp ")" [symbol(targetAssignStmt), strict(2)]
                | "#annAssign" "(" Id "," Exp ")" [symbol(annAssignStmt), strict(2)]
                | "#annOnly" "(" Id ")" [symbol(annOnlyStmt)]
                | "return" [symbol(returnNoneStmt)]
                | "return" Exp [symbol(returnStmt), strict]
                | "#def" "(" Id "," Id "," Block ")" [symbol(functionDefStmt)]
                | "#defArgs" "(" Id "," IdItems "," Block ")" [symbol(functionDefArgsStmt)]
                | "#defDefaults" "(" Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefDefaultsStmt)]
                | "#defVarArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefVarArgsStmt)]
                | "#defVarArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefVarArgsDefaultsStmt)]
                | "#defVarArgsKwOnly" "(" Id "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionDefVarArgsKwOnlyStmt)]
                | "#defVarArgsKwDefaults" "(" Id "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefVarArgsKwDefaultsStmt)]
                | "#defVarArgsKwOnlyKwArgs" "(" Id "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionDefVarArgsKwOnlyKwArgsStmt)]
                | "#defVarArgsKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefVarArgsKwDefaultsKwArgsStmt)]
                | "#defVarKwArgs" "(" Id "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefVarKwArgsStmt)]
                | "#defVarKwArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Id "," Block ")" [symbol(functionDefVarKwArgsDefaultsStmt)]
                | "#defKwArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefKwArgsStmt)]
                | "#defKwArgsDefaults" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefKwArgsDefaultsStmt)]
                | "#defPosOnly" "(" Id "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosOnlyStmt)]
                | "#defPosOnlyDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyDefaultsStmt)]
                | "#defPosOnlyVarArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsStmt)]
                | "#defPosOnlyVarArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsDefaultsStmt)]
                | "#defPosOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyKwArgsStmt)]
                | "#defPosOnlyKwArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyKwArgsDefaultsStmt)]
                | "#defPosOnlyVarKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Id "," Block ")" [symbol(functionDefPosOnlyVarKwArgsStmt)]
                | "#defPosOnlyVarKwArgsDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," Id "," Block ")" [symbol(functionDefPosOnlyVarKwArgsDefaultsStmt)]
                | "#defPosOnlyVarArgsKwOnly" "(" Id "," IdItems "," IdItems "," Id "," IdItems "," Block ")" [symbol(functionDefPosOnlyVarArgsKwOnlyStmt)]
                | "#defPosOnlyVarArgsKwDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyVarArgsKwDefaultsStmt)]
                | "#defPosOnlyVarArgsKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsKwOnlyKwArgsStmt)]
                | "#defPosOnlyVarArgsKwDefaultsKwArgs" "(" Id "," IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyVarArgsKwDefaultsKwArgsStmt)]
                | "#defPosOnlyKwOnly" "(" Id "," IdItems "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosOnlyKwOnlyStmt)]
                | "#defPosOnlyKwOnlyDefaults" "(" Id "," IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosOnlyKwOnlyDefaultsStmt)]
                | "#defPosOnlyKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosOnlyKwOnlyKwArgsStmt)]
                | "#defPosOnlyKwDefaultsKwArgs" "(" Id "," IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosOnlyKwDefaultsKwArgsStmt)]
                | "#defKwOnly" "(" Id "," IdItems "," Block ")" [symbol(functionDefKwOnlyStmt)]
                | "#defKwDefaults" "(" Id "," IdItems "," ArgExps "," Block ")" [symbol(functionDefKwDefaultsStmt)]
                | "#defKwOnlyKwArgs" "(" Id "," IdItems "," Id "," Block ")" [symbol(functionDefKwOnlyKwArgsStmt)]
                | "#defKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefKwDefaultsKwArgsStmt)]
                | "#defPosKwOnly" "(" Id "," IdItems "," IdItems "," Block ")" [symbol(functionDefPosKwOnlyStmt)]
                | "#defPosKwDefaults" "(" Id "," IdItems "," ArgExps "," IdItems "," ArgExps "," Block ")" [symbol(functionDefPosKwDefaultsStmt)]
                | "#defPosKwOnlyKwArgs" "(" Id "," IdItems "," IdItems "," Id "," Block ")" [symbol(functionDefPosKwOnlyKwArgsStmt)]
                | "#defPosKwDefaultsKwArgs" "(" Id "," IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Block ")" [symbol(functionDefPosKwDefaultsKwArgsStmt)]
                | "#defDecorated" "(" Id "," ArgExps "," FunctionSpec ")" [symbol(functionDefDecoratedStmt)]
                | "#if" "(" Exp "," Block "," Block ")" [symbol(ifStmt)]
                | "#while" "(" Exp "," Block ")" [symbol(whileStmt)]
                | "#whileElse" "(" Exp "," Block "," Block ")" [symbol(whileElseStmt)]
                | "#for" "(" Id "," Exp "," Block ")" [symbol(forStmt)]
                | "#forElse" "(" Id "," Exp "," Block "," Block ")" [symbol(forElseStmt)]
                | "#forUnpack" "(" IdItems "," Exp "," Block ")" [symbol(forUnpackStmt)]
                | "#forUnpackElse" "(" IdItems "," Exp "," Block "," Block ")" [symbol(forUnpackElseStmt)]
                | "#forTargetUnpack" "(" Targets "," Exp "," Block ")" [symbol(forTargetUnpackStmt)]
                | "#forTargetUnpackElse" "(" Targets "," Exp "," Block "," Block ")" [symbol(forTargetUnpackElseStmt)]
                | "#forTarget" "(" Target "," Exp "," Block ")" [symbol(forTargetStmt)]
                | "#forTargetElse" "(" Target "," Exp "," Block "," Block ")" [symbol(forTargetElseStmt)]
                | "#forStarUnpack" "(" IdItems "," Id "," IdItems "," Exp "," Block ")" [symbol(forStarUnpackStmt)]
                | "#forStarUnpackElse" "(" IdItems "," Id "," IdItems "," Exp "," Block "," Block ")" [symbol(forStarUnpackElseStmt)]
                | "raise" [symbol(reraiseStmt)]
                | "raise" Exp [symbol(raiseStmt), strict]
                | "#raiseFromNone" "(" Exp ")" [symbol(raiseFromNoneStmt), strict]
                | "#raiseFrom" "(" Exp "," Exp ")" [symbol(raiseFromStmt), strict]
                | "#match" "(" Exp "," MatchCases ")" [symbol(matchStmt)]
                | "#tryExcept" "(" Block "," Id "," Block ")" [symbol(tryExceptStmt)]
                | "#tryExceptElse" "(" Block "," Id "," Block "," Block ")" [symbol(tryExceptElseStmt)]
                | "#tryExceptCases" "(" Block "," ExceptHandlers ")" [symbol(tryExceptCasesStmt)]
                | "#tryExceptCasesElse" "(" Block "," ExceptHandlers "," Block ")" [symbol(tryExceptCasesElseStmt)]
                | "#tryFinally" "(" Block "," Block ")" [symbol(tryFinallyStmt)]

  syntax Exp ::= Val
               | Id
               | "#name" "(" Id ")" [symbol(nameExp)]
               | "#debug" [symbol(debugExp)]
               | "#namedExpr" "(" Id "," Exp ")" [symbol(namedExprExp), strict(2)]
               | "(" Exp ")" [bracket]
               | Exp "(" Exp ")" [symbol(callExp)]
               | "#call" "(" Exp "," ArgExps ")" [symbol(callArgsExp)]
               | "#callKw" "(" Exp "," KwArgExps ")" [symbol(callKwArgsExp)]
               | "#callMixed" "(" Exp "," ArgExps "," KwArgExps ")" [symbol(callMixedArgsExp)]
               | "#exceptionCall" "(" Id "," ArgExps ")" [symbol(exceptionCallExp)]
               | "#attr" "(" Exp "," Id ")" [symbol(attrExp), strict(1)]
               | "#list" "(" ArgExps ")" [symbol(listDisplayExp)]
               | "#tuple" "(" ArgExps ")" [symbol(tupleDisplayExp)]
               | "#dict" "(" DictExps ")" [symbol(dictDisplayExp)]
               | "#set" "(" ArgExps ")" [symbol(setDisplayExp)]
               | "#listComp" "(" Exp "," Id "," Exp ")" [symbol(listCompExp), strict(1)]
               | "#listCompTarget" "(" Exp "," Target "," Exp ")" [symbol(listCompTargetExp), strict(1)]
               | "#listCompTargetIfs" "(" Exp "," Target "," CompFilters "," Exp ")" [symbol(listCompTargetIfsExp), strict(1)]
               | "#listCompIf" "(" Exp "," Id "," Exp "," Exp ")" [symbol(listCompIfExp), strict(1)]
               | "#listCompIfs" "(" Exp "," Id "," CompFilters "," Exp ")" [symbol(listCompIfsExp), strict(1)]
               | "#listCompFor" "(" Exp "," Id "," Exp "," Id "," Exp ")" [symbol(listCompForExp), strict(1)]
               | "#listCompTargetFor" "(" Exp "," Target "," Exp "," Target "," Exp ")" [symbol(listCompTargetForExp), strict(1)]
               | "#listCompTargetForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp ")" [symbol(listCompTargetForIfsExp), strict(1)]
               | "#listCompForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp ")" [symbol(listCompForIfsExp), strict(1)]
               | "#listCompForFor" "(" Exp "," Id "," Exp "," Id "," Exp "," Id "," Exp ")" [symbol(listCompForForExp), strict(1)]
               | "#listCompTargetForFor" "(" Exp "," Target "," Exp "," Target "," Exp "," Target "," Exp ")" [symbol(listCompTargetForForExp), strict(1)]
               | "#listCompForForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp ")" [symbol(listCompForForIfsExp), strict(1)]
               | "#listCompTargetForForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp ")" [symbol(listCompTargetForForIfsExp), strict(1)]
               | "#listCompMany" "(" Exp "," Target "," MaybeCompFilters "," MaybeCompClauses "," Exp ")" [symbol(listCompManyExp), strict(1)]
               | "#dictComp" "(" Exp "," Id "," Exp "," Exp ")" [symbol(dictCompExp), strict(1)]
               | "#dictCompTarget" "(" Exp "," Target "," Exp "," Exp ")" [symbol(dictCompTargetExp), strict(1)]
               | "#dictCompTargetIfs" "(" Exp "," Target "," CompFilters "," Exp "," Exp ")" [symbol(dictCompTargetIfsExp), strict(1)]
               | "#dictCompIf" "(" Exp "," Id "," Exp "," Exp "," Exp ")" [symbol(dictCompIfExp), strict(1)]
               | "#dictCompIfs" "(" Exp "," Id "," CompFilters "," Exp "," Exp ")" [symbol(dictCompIfsExp), strict(1)]
               | "#dictCompFor" "(" Exp "," Id "," Exp "," Id "," Exp "," Exp ")" [symbol(dictCompForExp), strict(1)]
               | "#dictCompTargetFor" "(" Exp "," Target "," Exp "," Target "," Exp "," Exp ")" [symbol(dictCompTargetForExp), strict(1)]
               | "#dictCompTargetForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp "," Exp ")" [symbol(dictCompTargetForIfsExp), strict(1)]
               | "#dictCompForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp "," Exp ")" [symbol(dictCompForIfsExp), strict(1)]
               | "#dictCompForFor" "(" Exp "," Id "," Exp "," Id "," Exp "," Id "," Exp "," Exp ")" [symbol(dictCompForForExp), strict(1)]
               | "#dictCompTargetForFor" "(" Exp "," Target "," Exp "," Target "," Exp "," Target "," Exp "," Exp ")" [symbol(dictCompTargetForForExp), strict(1)]
               | "#dictCompForForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp "," Exp ")" [symbol(dictCompForForIfsExp), strict(1)]
               | "#dictCompTargetForForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp "," Exp ")" [symbol(dictCompTargetForForIfsExp), strict(1)]
               | "#dictCompMany" "(" Exp "," Target "," MaybeCompFilters "," MaybeCompClauses "," Exp "," Exp ")" [symbol(dictCompManyExp), strict(1)]
               | "#setComp" "(" Exp "," Id "," Exp ")" [symbol(setCompExp), strict(1)]
               | "#setCompTarget" "(" Exp "," Target "," Exp ")" [symbol(setCompTargetExp), strict(1)]
               | "#setCompTargetIfs" "(" Exp "," Target "," CompFilters "," Exp ")" [symbol(setCompTargetIfsExp), strict(1)]
               | "#setCompIf" "(" Exp "," Id "," Exp "," Exp ")" [symbol(setCompIfExp), strict(1)]
               | "#setCompIfs" "(" Exp "," Id "," CompFilters "," Exp ")" [symbol(setCompIfsExp), strict(1)]
               | "#setCompFor" "(" Exp "," Id "," Exp "," Id "," Exp ")" [symbol(setCompForExp), strict(1)]
               | "#setCompTargetFor" "(" Exp "," Target "," Exp "," Target "," Exp ")" [symbol(setCompTargetForExp), strict(1)]
               | "#setCompTargetForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp ")" [symbol(setCompTargetForIfsExp), strict(1)]
               | "#setCompForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp ")" [symbol(setCompForIfsExp), strict(1)]
               | "#setCompForFor" "(" Exp "," Id "," Exp "," Id "," Exp "," Id "," Exp ")" [symbol(setCompForForExp), strict(1)]
               | "#setCompTargetForFor" "(" Exp "," Target "," Exp "," Target "," Exp "," Target "," Exp ")" [symbol(setCompTargetForForExp), strict(1)]
               | "#setCompForForIfs" "(" Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp "," Id "," MaybeCompFilters "," Exp ")" [symbol(setCompForForIfsExp), strict(1)]
               | "#setCompTargetForForIfs" "(" Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp "," Target "," MaybeCompFilters "," Exp ")" [symbol(setCompTargetForForIfsExp), strict(1)]
               | "#setCompMany" "(" Exp "," Target "," MaybeCompFilters "," MaybeCompClauses "," Exp ")" [symbol(setCompManyExp), strict(1)]
               | "#listCtor" "(" ")" [symbol(listCtorExp)]
               | "#listCtor" "(" Exp ")" [symbol(listCtor1Exp), strict]
               | "#tupleCtor" "(" ")" [symbol(tupleCtorExp)]
               | "#tupleCtor" "(" Exp ")" [symbol(tupleCtor1Exp), strict]
               | "#dictCtor" "(" ")" [symbol(dictCtorExp)]
               | "#dictCtor" "(" Exp ")" [symbol(dictCtor1Exp), strict]
               | "#dictCtorKw" "(" KwArgExps ")" [symbol(dictCtorKwExp)]
               | "#dictCtorMixed" "(" Exp "," KwArgExps ")" [symbol(dictCtorMixedExp), strict(1)]
               | "#setCtor" "(" ")" [symbol(setCtorExp)]
               | "#setCtor" "(" Exp ")" [symbol(setCtor1Exp), strict]
               | "#boolCtor" "(" ")" [symbol(boolCtor0Exp)]
               | "#boolCtor" "(" Exp ")" [symbol(boolCtor1Exp), strict]
               | "#all" "(" Exp ")" [symbol(allExp), strict]
               | "#any" "(" Exp ")" [symbol(anyExp), strict]
               | "#sum" "(" Exp ")" [symbol(sum1Exp), strict]
               | "#sum" "(" Exp "," Exp ")" [symbol(sum2Exp), strict]
               | "#min" "(" Exp ")" [symbol(minExp), strict]
               | "#max" "(" Exp ")" [symbol(maxExp), strict]
               | "#minArgs" "(" ArgExps ")" [symbol(minArgsExp)]
               | "#maxArgs" "(" ArgExps ")" [symbol(maxArgsExp)]
               | "#sliceCtor" "(" Exp ")" [symbol(sliceCtor1Exp), strict]
               | "#sliceCtor" "(" Exp "," Exp ")" [symbol(sliceCtor2Exp), strict]
               | "#sliceCtor" "(" Exp "," Exp "," Exp ")" [symbol(sliceCtor3Exp), strict]
               | "#intCtor" "(" ")" [symbol(intCtor0Exp)]
               | "#intCtor" "(" Exp ")" [symbol(intCtor1Exp), strict]
               | "#intCtor" "(" Exp "," Exp ")" [symbol(intCtor2Exp), strict]
               | "#floatCtor" "(" ")" [symbol(floatCtor0Exp)]
               | "#floatCtor" "(" Exp ")" [symbol(floatCtor1Exp), strict]
               | "#complexCtor" "(" ")" [symbol(complexCtor0Exp)]
               | "#complexCtor" "(" Exp ")" [symbol(complexCtor1Exp), strict]
               | "#complexCtor" "(" Exp "," Exp ")" [symbol(complexCtor2Exp), strict]
               | "#complexCtorKw" "(" KwArgExps ")" [symbol(complexCtorKwExp)]
               | "#complexCtorMixed" "(" Exp "," KwArgExps ")" [symbol(complexCtorMixedExp), strict(1)]
               | "#conjugate" "(" Exp ")" [symbol(conjugateExp), strict]
               | "#abs" "(" Exp ")" [symbol(absExp), strict]
               | "#divmod" "(" Exp "," Exp ")" [symbol(divmodExp), strict]
               | "#pow" "(" Exp "," Exp ")" [symbol(powBuiltinExp), strict]
               | "#pow" "(" Exp "," Exp "," Exp ")" [symbol(powModBuiltinExp), strict]
               | "#compareChain" "(" Exp "," CmpChain ")" [symbol(compareChainExp)]
               | "#len" "(" Exp ")" [symbol(lenExp), strict]
               | "#floorDiv" "(" Exp "," Exp ")" [symbol(floorDivInternal), strict]
               | "#trueDiv" "(" Exp "," Exp ")" [symbol(trueDivInternal), strict]
               | "#slice" "(" Exp "," Exp "," Exp ")" [symbol(sliceExp), strict]
               | "#sliceStep" "(" Exp "," Exp "," Exp "," Exp ")" [symbol(sliceStepExp), strict]
               | "+" Exp [symbol(posExp), strict]
               | "-" Exp [symbol(negExp), strict]
               | "~" Exp [symbol(invertExp), strict]
               > Exp "**" Exp [symbol(powExp), right, strict]
               > Exp "*" Exp [symbol(mulExp), left, strict]
               | Exp "//" Exp [symbol(floorDivExp), left, strict]
               | Exp "%" Exp [symbol(modExp), left, strict]
               > Exp "+" Exp [symbol(addExp), left, strict]
               | Exp "-" Exp [symbol(subExp), left, strict]
               > Exp "<<" Exp [symbol(lshiftExp), left, strict]
               | Exp ">>" Exp [symbol(rshiftExp), left, strict]
               > Exp "&" Exp [symbol(bitAndExp), left, strict]
               > Exp "^" Exp [symbol(bitXorExp), left, strict]
               > Exp "|" Exp [symbol(bitOrExp), left, strict]
               > Exp "<" Exp [symbol(ltExp), strict]
               | Exp "<=" Exp [symbol(leExp), strict]
               | Exp ">" Exp [symbol(gtExp), strict]
               | Exp ">=" Exp [symbol(geExp), strict]
               | Exp "==" Exp [symbol(eqExp), strict]
               | Exp "!=" Exp [symbol(neExp), strict]
               | Exp "is" Exp [symbol(identityExp), strict]
               | Exp "is" "not" Exp [symbol(identityNotExp), strict]
               | Exp "in" Exp [symbol(inExp), strict]
               | Exp "not" "in" Exp [symbol(notInExp), strict]
               | Exp "[" Exp "]" [symbol(subscriptExp), strict]
               | "#range" "(" Exp ")" [symbol(range1Exp), strict]
               | "#range" "(" Exp "," Exp ")" [symbol(range2Exp), strict]
               | "#range" "(" Exp "," Exp "," Exp ")" [symbol(range3Exp), strict]
               > "not" Exp [symbol(notExp), strict]
               > Exp "and" Exp [symbol(andExp), left]
               > Exp "or" Exp [symbol(orExp), left]
               > Exp "if" Exp "else" Exp [symbol(ifExp), right]
               > "lambda" Id ":" Exp [symbol(lambdaExp)]
               | "#lambdaArgs" "(" IdItems "," Exp ")" [symbol(lambdaArgsExp)]
               | "#lambdaDefaults" "(" IdItems "," ArgExps "," Exp ")" [symbol(lambdaDefaultsExp)]
               | "#lambdaVarArgs" "(" IdItems "," Id "," Exp ")" [symbol(lambdaVarArgsExp)]
               | "#lambdaVarArgsDefaults" "(" IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaVarArgsDefaultsExp)]
               | "#lambdaVarArgsKwOnly" "(" IdItems "," Id "," IdItems "," Exp ")" [symbol(lambdaVarArgsKwOnlyExp)]
               | "#lambdaVarArgsKwDefaults" "(" IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Exp ")" [symbol(lambdaVarArgsKwDefaultsExp)]
               | "#lambdaVarArgsKwOnlyKwArgs" "(" IdItems "," Id "," IdItems "," Id "," Exp ")" [symbol(lambdaVarArgsKwOnlyKwArgsExp)]
               | "#lambdaVarArgsKwDefaultsKwArgs" "(" IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaVarArgsKwDefaultsKwArgsExp)]
               | "#lambdaVarKwArgs" "(" IdItems "," Id "," Id "," Exp ")" [symbol(lambdaVarKwArgsExp)]
               | "#lambdaVarKwArgsDefaults" "(" IdItems "," ArgExps "," Id "," Id "," Exp ")" [symbol(lambdaVarKwArgsDefaultsExp)]
               | "#lambdaKwArgs" "(" IdItems "," Id "," Exp ")" [symbol(lambdaKwArgsExp)]
               | "#lambdaKwArgsDefaults" "(" IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaKwArgsDefaultsExp)]
               | "#lambdaPosOnly" "(" IdItems "," IdItems "," Exp ")" [symbol(lambdaPosOnlyExp)]
               | "#lambdaPosOnlyDefaults" "(" IdItems "," IdItems "," ArgExps "," Exp ")" [symbol(lambdaPosOnlyDefaultsExp)]
               | "#lambdaPosOnlyVarArgs" "(" IdItems "," IdItems "," Id "," Exp ")" [symbol(lambdaPosOnlyVarArgsExp)]
               | "#lambdaPosOnlyVarArgsDefaults" "(" IdItems "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaPosOnlyVarArgsDefaultsExp)]
               | "#lambdaPosOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Exp ")" [symbol(lambdaPosOnlyKwArgsExp)]
               | "#lambdaPosOnlyKwArgsDefaults" "(" IdItems "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaPosOnlyKwArgsDefaultsExp)]
               | "#lambdaPosOnlyVarKwArgs" "(" IdItems "," IdItems "," Id "," Id "," Exp ")" [symbol(lambdaPosOnlyVarKwArgsExp)]
               | "#lambdaPosOnlyVarKwArgsDefaults" "(" IdItems "," IdItems "," ArgExps "," Id "," Id "," Exp ")" [symbol(lambdaPosOnlyVarKwArgsDefaultsExp)]
               | "#lambdaPosOnlyVarArgsKwOnly" "(" IdItems "," IdItems "," Id "," IdItems "," Exp ")" [symbol(lambdaPosOnlyVarArgsKwOnlyExp)]
               | "#lambdaPosOnlyVarArgsKwDefaults" "(" IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Exp ")" [symbol(lambdaPosOnlyVarArgsKwDefaultsExp)]
               | "#lambdaPosOnlyVarArgsKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," IdItems "," Id "," Exp ")" [symbol(lambdaPosOnlyVarArgsKwOnlyKwArgsExp)]
               | "#lambdaPosOnlyVarArgsKwDefaultsKwArgs" "(" IdItems "," IdItems "," ArgExps "," Id "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaPosOnlyVarArgsKwDefaultsKwArgsExp)]
               | "#lambdaPosOnlyKwOnly" "(" IdItems "," IdItems "," IdItems "," Exp ")" [symbol(lambdaPosOnlyKwOnlyExp)]
               | "#lambdaPosOnlyKwOnlyDefaults" "(" IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Exp ")" [symbol(lambdaPosOnlyKwOnlyDefaultsExp)]
               | "#lambdaPosOnlyKwOnlyKwArgs" "(" IdItems "," IdItems "," IdItems "," Id "," Exp ")" [symbol(lambdaPosOnlyKwOnlyKwArgsExp)]
               | "#lambdaPosOnlyKwDefaultsKwArgs" "(" IdItems "," IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaPosOnlyKwDefaultsKwArgsExp)]
               | "#lambdaKwOnly" "(" IdItems "," Exp ")" [symbol(lambdaKwOnlyExp)]
               | "#lambdaKwDefaults" "(" IdItems "," ArgExps "," Exp ")" [symbol(lambdaKwDefaultsExp)]
               | "#lambdaKwOnlyKwArgs" "(" IdItems "," Id "," Exp ")" [symbol(lambdaKwOnlyKwArgsExp)]
               | "#lambdaKwDefaultsKwArgs" "(" IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaKwDefaultsKwArgsExp)]
               | "#lambdaPosKwOnly" "(" IdItems "," IdItems "," Exp ")" [symbol(lambdaPosKwOnlyExp)]
               | "#lambdaPosKwDefaults" "(" IdItems "," ArgExps "," IdItems "," ArgExps "," Exp ")" [symbol(lambdaPosKwDefaultsExp)]
               | "#lambdaPosKwOnlyKwArgs" "(" IdItems "," IdItems "," Id "," Exp ")" [symbol(lambdaPosKwOnlyKwArgsExp)]
               | "#lambdaPosKwDefaultsKwArgs" "(" IdItems "," ArgExps "," IdItems "," ArgExps "," Id "," Exp ")" [symbol(lambdaPosKwDefaultsKwArgsExp)]
endmodule

module PYTHON
  imports PYTHON-SYNTAX
  imports INT
  imports BOOL
  imports STRING
  imports ID
  imports FLOAT
  imports MAP

  syntax Val ::= closure(Id, Exp) [symbol(closure)]
               | closureArgs(IdItems, Exp) [symbol(closureArgs)]
               | closureDefaults(IdItems, ArgVals, Exp) [symbol(closureDefaults)]
               | closureVarArgs(IdItems, Id, Exp) [symbol(closureVarArgs)]
               | closureVarArgsDefaults(IdItems, ArgVals, Id, Exp) [symbol(closureVarArgsDefaults)]
               | closureVarArgsKwOnly(IdItems, Id, IdItems, Exp) [symbol(closureVarArgsKwOnly)]
               | closureVarArgsKwDefaults(IdItems, ArgVals, Id, IdItems, ArgVals, Exp) [symbol(closureVarArgsKwDefaults)]
               | closureVarArgsKwOnlyKwArgs(IdItems, Id, IdItems, Id, Exp) [symbol(closureVarArgsKwOnlyKwArgs)]
               | closureVarArgsKwDefaultsKwArgs(IdItems, ArgVals, Id, IdItems, ArgVals, Id, Exp) [symbol(closureVarArgsKwDefaultsKwArgs)]
               | closureVarKwArgs(IdItems, Id, Id, Exp) [symbol(closureVarKwArgs)]
               | closureVarKwArgsDefaults(IdItems, ArgVals, Id, Id, Exp) [symbol(closureVarKwArgsDefaults)]
               | closureKwArgs(IdItems, Id, Exp) [symbol(closureKwArgs)]
               | closureKwArgsDefaults(IdItems, ArgVals, Id, Exp) [symbol(closureKwArgsDefaults)]
               | closurePosOnly(IdItems, IdItems, Exp) [symbol(closurePosOnly)]
               | closurePosOnlyDefaults(IdItems, IdItems, ArgVals, Exp) [symbol(closurePosOnlyDefaults)]
               | closurePosOnlyVarArgs(IdItems, IdItems, Id, Exp) [symbol(closurePosOnlyVarArgs)]
               | closurePosOnlyVarArgsDefaults(IdItems, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyVarArgsDefaults)]
               | closurePosOnlyKwArgs(IdItems, IdItems, Id, Exp) [symbol(closurePosOnlyKwArgs)]
               | closurePosOnlyKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyKwArgsDefaults)]
               | closurePosOnlyVarKwArgs(IdItems, IdItems, Id, Id, Exp) [symbol(closurePosOnlyVarKwArgs)]
               | closurePosOnlyVarKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Id, Exp) [symbol(closurePosOnlyVarKwArgsDefaults)]
               | closurePosOnlyVarArgsKwOnly(IdItems, IdItems, Id, IdItems, Exp) [symbol(closurePosOnlyVarArgsKwOnly)]
               | closurePosOnlyVarArgsKwDefaults(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Exp) [symbol(closurePosOnlyVarArgsKwDefaults)]
               | closurePosOnlyVarArgsKwOnlyKwArgs(IdItems, IdItems, Id, IdItems, Id, Exp) [symbol(closurePosOnlyVarArgsKwOnlyKwArgs)]
               | closurePosOnlyVarArgsKwDefaultsKwArgs(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyVarArgsKwDefaultsKwArgs)]
               | closurePosOnlyKwOnly(IdItems, IdItems, IdItems, Exp) [symbol(closurePosOnlyKwOnly)]
               | closurePosOnlyKwOnlyDefaults(IdItems, IdItems, ArgVals, IdItems, ArgVals, Exp) [symbol(closurePosOnlyKwOnlyDefaults)]
               | closurePosOnlyKwOnlyKwArgs(IdItems, IdItems, IdItems, Id, Exp) [symbol(closurePosOnlyKwOnlyKwArgs)]
               | closurePosOnlyKwDefaultsKwArgs(IdItems, IdItems, ArgVals, IdItems, ArgVals, Id, Exp) [symbol(closurePosOnlyKwDefaultsKwArgs)]
               | closureKwOnly(IdItems, Exp) [symbol(closureKwOnly)]
               | closureKwDefaults(IdItems, ArgVals, Exp) [symbol(closureKwDefaults)]
               | closureKwOnlyKwArgs(IdItems, Id, Exp) [symbol(closureKwOnlyKwArgs)]
               | closureKwDefaultsKwArgs(IdItems, ArgVals, Id, Exp) [symbol(closureKwDefaultsKwArgs)]
               | closurePosKwOnly(IdItems, IdItems, Exp) [symbol(closurePosKwOnly)]
               | closurePosKwDefaults(IdItems, ArgVals, IdItems, ArgVals, Exp) [symbol(closurePosKwDefaults)]
               | closurePosKwOnlyKwArgs(IdItems, IdItems, Id, Exp) [symbol(closurePosKwOnlyKwArgs)]
               | closurePosKwDefaultsKwArgs(IdItems, ArgVals, IdItems, ArgVals, Id, Exp) [symbol(closurePosKwDefaultsKwArgs)]
               | functionVal(Id, Block) [symbol(functionVal)]
               | functionValArgs(IdItems, Block) [symbol(functionValArgs)]
               | functionValDefaults(IdItems, ArgVals, Block) [symbol(functionValDefaults)]
               | functionValVarArgs(IdItems, Id, Block) [symbol(functionValVarArgs)]
               | functionValVarArgsDefaults(IdItems, ArgVals, Id, Block) [symbol(functionValVarArgsDefaults)]
               | functionValVarArgsKwOnly(IdItems, Id, IdItems, Block) [symbol(functionValVarArgsKwOnly)]
               | functionValVarArgsKwDefaults(IdItems, ArgVals, Id, IdItems, ArgVals, Block) [symbol(functionValVarArgsKwDefaults)]
               | functionValVarArgsKwOnlyKwArgs(IdItems, Id, IdItems, Id, Block) [symbol(functionValVarArgsKwOnlyKwArgs)]
               | functionValVarArgsKwDefaultsKwArgs(IdItems, ArgVals, Id, IdItems, ArgVals, Id, Block) [symbol(functionValVarArgsKwDefaultsKwArgs)]
               | functionValVarKwArgs(IdItems, Id, Id, Block) [symbol(functionValVarKwArgs)]
               | functionValVarKwArgsDefaults(IdItems, ArgVals, Id, Id, Block) [symbol(functionValVarKwArgsDefaults)]
               | functionValKwArgs(IdItems, Id, Block) [symbol(functionValKwArgs)]
               | functionValKwArgsDefaults(IdItems, ArgVals, Id, Block) [symbol(functionValKwArgsDefaults)]
               | functionValPosOnly(IdItems, IdItems, Block) [symbol(functionValPosOnly)]
               | functionValPosOnlyDefaults(IdItems, IdItems, ArgVals, Block) [symbol(functionValPosOnlyDefaults)]
               | functionValPosOnlyVarArgs(IdItems, IdItems, Id, Block) [symbol(functionValPosOnlyVarArgs)]
               | functionValPosOnlyVarArgsDefaults(IdItems, IdItems, ArgVals, Id, Block) [symbol(functionValPosOnlyVarArgsDefaults)]
               | functionValPosOnlyKwArgs(IdItems, IdItems, Id, Block) [symbol(functionValPosOnlyKwArgs)]
               | functionValPosOnlyKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Block) [symbol(functionValPosOnlyKwArgsDefaults)]
               | functionValPosOnlyVarKwArgs(IdItems, IdItems, Id, Id, Block) [symbol(functionValPosOnlyVarKwArgs)]
               | functionValPosOnlyVarKwArgsDefaults(IdItems, IdItems, ArgVals, Id, Id, Block) [symbol(functionValPosOnlyVarKwArgsDefaults)]
               | functionValPosOnlyVarArgsKwOnly(IdItems, IdItems, Id, IdItems, Block) [symbol(functionValPosOnlyVarArgsKwOnly)]
               | functionValPosOnlyVarArgsKwDefaults(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Block) [symbol(functionValPosOnlyVarArgsKwDefaults)]
               | functionValPosOnlyVarArgsKwOnlyKwArgs(IdItems, IdItems, Id, IdItems, Id, Block) [symbol(functionValPosOnlyVarArgsKwOnlyKwArgs)]
               | functionValPosOnlyVarArgsKwDefaultsKwArgs(IdItems, IdItems, ArgVals, Id, IdItems, ArgVals, Id, Block) [symbol(functionValPosOnlyVarArgsKwDefaultsKwArgs)]
               | functionValPosOnlyKwOnly(IdItems, IdItems, IdItems, Block) [symbol(functionValPosOnlyKwOnly)]
               | functionValPosOnlyKwOnlyDefaults(IdItems, IdItems, ArgVals, IdItems, ArgVals, Block) [symbol(functionValPosOnlyKwOnlyDefaults)]
               | functionValPosOnlyKwOnlyKwArgs(IdItems, IdItems, IdItems, Id, Block) [symbol(functionValPosOnlyKwOnlyKwArgs)]
               | functionValPosOnlyKwDefaultsKwArgs(IdItems, IdItems, ArgVals, IdItems, ArgVals, Id, Block) [symbol(functionValPosOnlyKwDefaultsKwArgs)]
               | functionValKwOnly(IdItems, Block) [symbol(functionValKwOnly)]
               | functionValKwDefaults(IdItems, ArgVals, Block) [symbol(functionValKwDefaults)]
               | functionValKwOnlyKwArgs(IdItems, Id, Block) [symbol(functionValKwOnlyKwArgs)]
               | functionValKwDefaultsKwArgs(IdItems, ArgVals, Id, Block) [symbol(functionValKwDefaultsKwArgs)]
               | functionValPosKwOnly(IdItems, IdItems, Block) [symbol(functionValPosKwOnly)]
               | functionValPosKwDefaults(IdItems, ArgVals, IdItems, ArgVals, Block) [symbol(functionValPosKwDefaults)]
               | functionValPosKwOnlyKwArgs(IdItems, IdItems, Id, Block) [symbol(functionValPosKwOnlyKwArgs)]
               | functionValPosKwDefaultsKwArgs(IdItems, ArgVals, IdItems, ArgVals, Id, Block) [symbol(functionValPosKwDefaultsKwArgs)]
               | "#exceptionInstance" "(" Id "," ArgVals ")" [symbol(exceptionInstanceVal)]
               | buildFunctionDefault(FunctionDefaultBuilder, ArgVals) [function, symbol(buildFunctionDefault)]
               | buildFunctionTwoDefaults(FunctionTwoDefaultBuilder, ArgVals, ArgVals) [function, symbol(buildFunctionTwoDefaults)]
               | rangeVal(Int, Int) [symbol(rangeVal)]
               | rangeVal(Int, Int, Int) [symbol(rangeValStep)]
               | sliceVal(Val, Val, Val) [symbol(sliceVal)]
               | argsVal(ArgVals) [symbol(argsVal)]
               | dictArgsVal(DictVals) [symbol(dictArgsVal)]

  syntax CompArgStack ::= "#noCompArgStack" [symbol(noCompArgStack)]
                        | compArgFrame(Target, MaybeCompFilters, MaybeCompClauses, Exp, ArgVals, Map, CompArgStack) [symbol(compArgFrame)]

  syntax CompDictStack ::= "#noCompDictStack" [symbol(noCompDictStack)]
                         | compDictFrame(Target, MaybeCompFilters, MaybeCompClauses, Exp, Exp, ArgVals, Map, CompDictStack) [symbol(compDictFrame)]

  syntax ActiveException ::= "noException" [symbol(noException)]
                           | currentException(Val) [symbol(currentException)]

  syntax KResult ::= Val
  syntax KItem ::= stmtNext(Stmts) [symbol(stmtNext)]
                 | "stmtEnd" [symbol(stmtEnd)]
                 | "stmtNoResult" [symbol(stmtNoResult)]
                 | andThen(Exp) [symbol(andThen)]
                 | orElse(Exp) [symbol(orElse)]
                 | ifThenElse(Exp, Exp) [symbol(ifThenElse)]
                 | callArg(Exp) [symbol(callArg)]
                 | callApply(Val) [symbol(callApply)]
                 | callArgs(ArgExps) [symbol(callArgs)]
                 | evalArgs(ArgExps, ArgVals) [symbol(evalArgs)]
                 | evalArgNext(ArgExps, ArgVals) [symbol(evalArgNext)]
                 | evalStarArgNext(ArgExps, ArgVals) [symbol(evalStarArgNext)]
                 | callApplyArgs(Val) [symbol(callApplyArgs)]
                 | buildException(Id) [symbol(buildException)]
                 | callKwArgs(KwArgExps) [symbol(callKwArgs)]
                 | evalKwArgs(KwArgExps, KwArgVals) [symbol(evalKwArgs)]
                 | evalKwArgNext(Id, KwArgExps, KwArgVals) [symbol(evalKwArgNext)]
                 | evalKwStarArgNext(KwArgExps, KwArgVals) [symbol(evalKwStarArgNext)]
                 | callApplyKwArgs(Val) [symbol(callApplyKwArgs)]
                 | kwArgsVal(KwArgVals) [symbol(kwArgsVal)]
                 | callMixedArgs(ArgExps, KwArgExps) [symbol(callMixedArgs)]
                 | evalMixedKwArgs(KwArgExps, Val) [symbol(evalMixedKwArgs)]
                 | callApplyMixedArgs(Val, ArgVals) [symbol(callApplyMixedArgs)]
                 | bindLambdaDefaults(IdItems, Exp) [symbol(bindLambdaDefaults)]
                 | bindLambdaVarArgsDefaults(IdItems, Id, Exp) [symbol(bindLambdaVarArgsDefaults)]
                 | bindLambdaVarArgsKwDefaults(IdItems, ArgExps, Id, IdItems, Exp) [symbol(bindLambdaVarArgsKwDefaults)]
                 | bindLambdaVarArgsKwDefaultVals(IdItems, ArgVals, Id, IdItems, Exp) [symbol(bindLambdaVarArgsKwDefaultVals)]
                 | bindLambdaVarArgsKwDefaultsKwArgs(IdItems, ArgExps, Id, IdItems, Id, Exp) [symbol(bindLambdaVarArgsKwDefaultsKwArgs)]
                 | bindLambdaVarArgsKwDefaultValsKwArgs(IdItems, ArgVals, Id, IdItems, Id, Exp) [symbol(bindLambdaVarArgsKwDefaultValsKwArgs)]
                 | bindLambdaVarKwArgsDefaults(IdItems, Id, Id, Exp) [symbol(bindLambdaVarKwArgsDefaults)]
                 | bindLambdaKwArgsDefaults(IdItems, Id, Exp) [symbol(bindLambdaKwArgsDefaults)]
                 | bindLambdaKwDefaults(IdItems, Exp) [symbol(bindLambdaKwDefaults)]
                 | bindLambdaKwDefaultsKwArgs(IdItems, Id, Exp) [symbol(bindLambdaKwDefaultsKwArgs)]
                 | bindLambdaPosOnlyDefaults(IdItems, IdItems, Exp) [symbol(bindLambdaPosOnlyDefaults)]
                 | bindLambdaPosOnlyVarArgsDefaults(IdItems, IdItems, Id, Exp) [symbol(bindLambdaPosOnlyVarArgsDefaults)]
                 | bindLambdaPosOnlyKwArgsDefaults(IdItems, IdItems, Id, Exp) [symbol(bindLambdaPosOnlyKwArgsDefaults)]
