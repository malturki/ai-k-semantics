       <env> ... X |-> ([] => listVal(RS)) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) ==Int 1
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, [], _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, (), _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step) andBool intValue(Step) =/=Int 0
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> ([] => listVal(concreteIterableExtraItems(RHS))) ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) ==Int 1
      andBool concreteIterableExtraNonEmpty(RHS)
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, _Lower:Val, _Upper:Val) => stmtNoResult ... </k>
       <env> ... X |-> [] ... </env>
       <result> _ => .K </result>
    requires isIntLike(Step)
      andBool intValue(Step) =/=Int 0
      andBool concreteIterableExtraEmpty(RHS)
  rule <k> Step:Val ~> sliceStepAssignApply(X:Id, RHS:Val, _Lower:Val, _Upper:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
       <env> ... X |-> [] ... </env>
    requires isIntLike(Step)
      andBool intValue(Step) =/=Int 0
      andBool intValue(Step) =/=Int 1
      andBool sliceStepAssignRhsSupported(RHS)
      andBool sliceStepAssignRhsLen(RHS) =/=Int 0

  rule <k> augAddStmt(X:Id, E:Exp) => assignStmt(X, X + E) ... </k>
  rule <k> augSubStmt(X:Id, E:Exp) => assignStmt(X, X - E) ... </k>
  rule <k> augMulStmt(X:Id, E:Exp) => assignStmt(X, X * E) ... </k>
  rule <k> augMatMulStmt(X:Id, E:Exp) => E ~> augMatMulApply(X) ... </k>
  rule <k> R:Val ~> augMatMulApply(X:Id) =>
           L @ R ~> augMatMulStore(X)
       ... </k>
       <env> ... X |-> L:Val ... </env>
  rule <k> exceptionSignal(E:Val) ~> augMatMulApply(_:Id) => exceptionSignal(E) ... </k>
  rule <k> V:Val ~> augMatMulStore(X:Id) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> exceptionSignal(E:Val) ~> augMatMulStore(_:Id) => exceptionSignal(E) ... </k>
  rule <k> augTrueDivStmt(X:Id, E:Exp) => assignStmt(X, #trueDiv(X, E)) ... </k>
  rule <k> augModStmt(X:Id, E:Exp) => assignStmt(X, X % E) ... </k>
  rule <k> augPowStmt(X:Id, E:Exp) => assignStmt(X, X ** E) ... </k>
  rule <k> augLShiftStmt(X:Id, E:Exp) => assignStmt(X, X << E) ... </k>
  rule <k> augRShiftStmt(X:Id, E:Exp) => assignStmt(X, X >> E) ... </k>
  rule <k> augBitAndStmt(X:Id, E:Exp) => assignStmt(X, X & E) ... </k>
  rule <k> augBitXorStmt(X:Id, E:Exp) => assignStmt(X, X ^ E) ... </k>
  rule <k> augBitOrStmt(X:Id, E:Exp) => E ~> augBitOrApply(X, L) ... </k>
       <env> ... X |-> L:Val ... </env>
  rule <k> augBitOrStmt(X:Id, _E:Exp) =>
           exceptionSignal(#exception(#token("NameError", "Id")))
       ... </k>
       <env> Rho </env>
    requires notBool (X in_keys(Rho))
  rule <k> R:Val ~> augBitOrApply(X:Id, L:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- dictUpdateValue(L, R) ] </env>
       <result> _ => .K </result>
    requires isDictVal(L)
      andBool dictUpdateSourceSupported(R)
      andBool notBool dictUpdateSourceValueError(R)
      andBool notBool dictUpdateSourceTypeError(R)
  rule <k> R:Val ~> augBitOrApply(_X:Id, L:Val) =>
           exceptionSignal(#exception(#token("ValueError", "Id")))
       ... </k>
    requires isDictVal(L)
      andBool dictUpdateSourceValueError(R)
  rule <k> R:Val ~> augBitOrApply(_X:Id, L:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires isDictVal(L)
      andBool dictUpdateSourceTypeError(R)
  rule <k> R:Val ~> augBitOrApply(X:Id, L:Val) =>
           L | R ~> augBitOrStore(X)
       ... </k>
    requires notBool isDictVal(L)
  rule <k> exceptionSignal(E:Val) ~> augBitOrApply(_:Id, _:Val) => exceptionSignal(E) ... </k>
  rule <k> V:Val ~> augBitOrStore(X:Id) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> exceptionSignal(E:Val) ~> augBitOrStore(_:Id) => exceptionSignal(E) ... </k>
  rule <k> augFloorDivStmt(X:Id, E:Exp) => assignStmt(X, #floorDiv(X, E)) ... </k>

  rule <k> assignManyStmt(IDS:IdItems, V:Val) => assignMany(IDS, V) ... </k>
  rule <k> assignMany(idItemsLast(X:Id), V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> assignMany(idItemsCons(X:Id, IDS:IdItems), V:Val) => assignMany(IDS, V) ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>

  rule <k> annAssignStmt(X:Id, V:Val) => stmtNoResult ... </k>
       <env> Rho => Rho [ X <- V ] </env>
       <result> _ => .K </result>
  rule <k> annOnlyStmt(_:Id) => stmtNoResult ... </k>
       <result> _ => .K </result>

  rule <k> unpackAssignStmt(IDS:IdItems, iteratorRef(I:Int)) =>
           #listCtor(iteratorRef(I)) ~> unpackAssignIterator(IDS)
       ... </k>
  rule <k> V:Val ~> unpackAssignIterator(IDS:IdItems) =>
           unpackAssignStmt(IDS, V)
       ... </k>
  rule <k> unpackAssignStmt(IDS:IdItems, listVal(VS:ValItems)) => stmtNoResult ... </k>
       <env> Rho => bindVals(Rho, IDS, VS) </env>
