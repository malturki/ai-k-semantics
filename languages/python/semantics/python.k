  rule <k> #min([]) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min(()) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min("") => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min(#bytes()) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule #min(#memoryviewVal(V:Val)) => #min(V)
  rule <k> #min(({}):Val) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min(set()) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min(frozenset()) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
  rule <k> #min(rangeVal(Start:Int, Stop:Int)) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
    requires pyRangeLen(Start, Stop, 1) ==Int 0
  rule <k> #min(rangeVal(Start:Int, Stop:Int, Step:Int)) => exceptionSignal(#exception(#token("ValueError", "Id"))) ... </k>
    requires Step =/=Int 0 andBool pyRangeLen(Start, Stop, Step) ==Int 0
  rule #min(S:String) => minStringItems(stringToValItems(S, 0, lengthString(S)))
    requires lengthString(S) >Int 0
  rule #min(listVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(listVal(VS:ValItems)) => minNumericItems(VS)
    requires (notBool valItemsAllIntLike(VS)) andBool valItemsAllNumericComparable(VS)
  rule #min(tupleVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(tupleVal(VS:ValItems)) => minNumericItems(VS)
    requires (notBool valItemsAllIntLike(VS)) andBool valItemsAllNumericComparable(VS)
  rule #min(bytesVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(dictVal(DS:DictItems)) => minValItems(dictKeysToValItems(DS))
    requires valItemsAllIntLike(dictKeysToValItems(DS))
  rule #min(dictVal(DS:DictItems)) => minNumericItems(dictKeysToValItems(DS))
    requires (notBool valItemsAllIntLike(dictKeysToValItems(DS)))
      andBool valItemsAllNumericComparable(dictKeysToValItems(DS))
  rule #min(setVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(setVal(VS:ValItems)) => minNumericItems(VS)
    requires (notBool valItemsAllIntLike(VS)) andBool valItemsAllNumericComparable(VS)
  rule #min(frozensetVal(VS:ValItems)) => minValItems(VS)
    requires valItemsAllIntLike(VS)
  rule #min(frozensetVal(VS:ValItems)) => minNumericItems(VS)
    requires (notBool valItemsAllIntLike(VS)) andBool valItemsAllNumericComparable(VS)
  rule #min(rangeVal(Start:Int, Stop:Int)) => rangeMin(Start, Stop, 1)
    requires pyRangeLen(Start, Stop, 1) >Int 0
