  rule <k> V:Val ~> restoreEnv(Rho:Map) => V ... </k>
       <env> _ => Rho </env>
  rule <k> exceptionSignal(V:Val) ~> restoreEnv(Rho:Map) => exceptionSignal(V) ... </k>
       <env> _ => Rho </env>

  rule <k> callArgsExp(F:Exp, Args:ArgExps) => F ~> callArgs(Args) ... </k>
  rule <k> F:Val ~> callArgs(Args:ArgExps) =>
           evalArgs(Args, #noArgVals) ~> callApplyArgs(F)
       ... </k>
  rule <k> exceptionCallExp(E:Id, Args:ArgExps) =>
           evalArgs(Args, #noArgVals) ~> buildException(E)
       ... </k>
  rule <k> argsVal(Args:ArgVals) ~> buildException(E:Id) =>
           #exceptionInstance(E, Args)
       ... </k>
  rule <k> evalArgs(#noArgs, VS:ArgVals) => argsVal(VS) ... </k>
  rule <k> evalArgs(argExp(E:Exp), VS:ArgVals) =>
           E ~> evalArgNext(#noArgs, VS)
       ... </k>
  rule <k> evalArgs(argExpsCons(E:Exp, ES:ArgExps), VS:ArgVals) =>
           E ~> evalArgNext(ES, VS)
       ... </k>
  rule <k> evalArgs(starArgExp(E:Exp), VS:ArgVals) =>
           E ~> evalStarArgNext(#noArgs, VS)
       ... </k>
  rule <k> evalArgs(starArgExpsCons(E:Exp, ES:ArgExps), VS:ArgVals) =>
           E ~> evalStarArgNext(ES, VS)
       ... </k>
  rule <k> V:Val ~> evalArgNext(ES:ArgExps, VS:ArgVals) =>
           evalArgs(ES, appendArgVal(VS, V))
       ... </k>
  rule <k> V:Val ~> evalStarArgNext(ES:ArgExps, VS:ArgVals) =>
           evalArgs(ES, concatArgVals(VS, iterableArgVals(V)))
       ... </k>
  rule <k> argsVal(_:ArgVals) ~> callApplyArgs(F:Val) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool callableVal(F)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closure(X:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindArgs(Rho, idItemsLast(X), VS) </env>
    requires sameArity(idItemsLast(X), VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closure(X:Id, _Body:Exp)) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool sameArity(idItemsLast(X), VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureArgs(IDS:IdItems, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindArgs(Rho, IDS, VS) </env>
    requires sameArity(IDS, VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureArgs(IDS:IdItems, _Body:Exp)) =>
           exceptionSignal(#exception(#token("TypeError", "Id")))
       ... </k>
    requires notBool sameArity(IDS, VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureDefaults(IDS:IdItems, Defaults:ArgVals, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindArgs(Rho, IDS, completeDefaultArgs(IDS, VS, Defaults)) </env>
    requires defaultsCallArityOk(IDS, VS, Defaults)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarArgs(IDS:IdItems, Var:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindVarArgs(Rho, IDS, Var, VS) </env>
    requires varArgsCallArityOk(IDS, VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarArgsDefaults(IDS:IdItems, Defaults:ArgVals, Var:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindVarArgs(Rho, IDS, Var, completeVarArgsDefaultArgs(IDS, VS, Defaults)) </env>
    requires varArgsDefaultsCallArityOk(IDS, VS, Defaults)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarArgsKwDefaults(IDS:IdItems, Defaults:ArgVals, Var:Id, KwOnly:IdItems, KwDefaults:ArgVals, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindArgs(bindVarArgs(Rho, IDS, Var, completeVarArgsDefaultArgs(IDS, VS, Defaults)), KwOnly, buildKwDefaultArgs(KwOnly, #noKwArgVals, KwDefaults)) </env>
    requires varArgsKwOnlyMixedDefaultsCallArityOk(IDS, KwOnly, VS, #noKwArgVals, Defaults, KwDefaults)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarArgsKwDefaultsKwArgs(IDS:IdItems, Defaults:ArgVals, Var:Id, KwOnly:IdItems, KwDefaults:ArgVals, Kw:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => (bindArgs(bindVarArgs(Rho, IDS, Var, completeVarArgsDefaultArgs(IDS, VS, Defaults)), KwOnly, buildKwDefaultArgs(KwOnly, #noKwArgVals, KwDefaults))) [ Kw <- ({}):Val ] </env>
    requires varArgsKwOnlyKwArgsMixedDefaultsCallArityOk(IDS, KwOnly, VS, #noKwArgVals, Defaults, KwDefaults)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarKwArgs(IDS:IdItems, Var:Id, Kw:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindVarKwArgs(Rho, IDS, Var, Kw, VS, #noKwArgVals) </env>
    requires varArgsCallArityOk(IDS, VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureVarKwArgsDefaults(IDS:IdItems, Defaults:ArgVals, Var:Id, Kw:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindVarKwArgs(Rho, IDS, Var, Kw, completeVarArgsDefaultArgs(IDS, VS, Defaults), #noKwArgVals) </env>
    requires varArgsDefaultsCallArityOk(IDS, VS, Defaults)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureKwArgs(IDS:IdItems, Kw:Id, Body:Exp)) =>
           Body ~> restoreEnv(Rho)
       ... </k>
       <env> Rho => bindKwArgs(Rho, IDS, Kw, VS, #noKwArgVals) </env>
    requires kwargsPosCallArityOk(IDS, VS)
  rule <k> argsVal(VS:ArgVals) ~> callApplyArgs(closureKwArgsDefaults(IDS:IdItems, Defaults:ArgVals, Kw:Id, Body:Exp)) =>
